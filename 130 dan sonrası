class WavDecoder final
{
public:
    WavDecoder() = default;
    ~WavDecoder();

    WavDecoder(
        const WavDecoder&) = delete;

    WavDecoder& operator=(
        const WavDecoder&) = delete;

    WavDecoder(
        WavDecoder&&) = delete;

    WavDecoder& operator=(
        WavDecoder&&) = delete;

    //================================================
    // STREAM LIFECYCLE
    //================================================

    RuntimeResult open(
        const char* path,
        const WavDecoderConfig& config =
            WavDecoderConfig{});

    void close();

    bool open() const;
    bool ready() const;
    bool headerReady() const;
    bool eof() const;

    //================================================
    // HEADER PARSING AND PCM DECODING
    //================================================

    // Advances RIFF/chunk parsing using already
    // buffered source data.
    // byteBudget == 0 uses a bounded implementation
    // default.
    RuntimeResult parseHeader(
        uint32_t nowMs,
        size_t byteBudget = 0);

    // Parses the header when needed, converts source
    // frames to signed 16-bit PCM and appends them
    // to destination.
    //
    // maximumFrames == 0 uses
    // config.defaultFramesPerDecodeCall.
    RuntimeResult decode(
        PcmRingBuffer& destination,
        uint32_t nowMs,
        size_t maximumFrames,
        size_t& decodedFrames);

    RuntimeResult decode(
        PcmRingBuffer& destination,
        uint32_t nowMs,
        size_t& decodedFrames);

    //================================================
    // SEEKING
    //================================================

    // The destination PCM buffer must be emptied or
    // reset by the caller before seeking. Otherwise,
    // old and new timeline frames may mix.
    RuntimeResult seekFrame(
        uint64_t frameIndex);

    RuntimeResult seekMilliseconds(
        uint32_t milliseconds);

    RuntimeResult rewind();

    //================================================
    // FORMAT, POSITION AND STATUS
    //================================================

    WavSourceFormat sourceFormat() const;

    I2sAudioFormat outputFormat() const;

    uint64_t totalFrames() const;
    uint64_t currentFrame() const;

    uint32_t durationMilliseconds() const;
    uint32_t currentMilliseconds() const;

    uint32_t dataOffsetBytes() const;
    uint32_t dataSizeBytes() const;
    uint32_t remainingDataBytes() const;

    const char* path() const;

    WavDecoderStatus status() const;

    //================================================
    // DIAGNOSTICS
    //================================================

    void setObserver(
        WavDecoderObserver observer);

    WavDecoderError lastError() const;

    void clearError();

    static bool validConfig(
        const WavDecoderConfig& config);

    static bool supportedSourceFormat(
        const WavSourceFormat& format,
        const WavDecoderConfig& config,
        WavDecoderError* rejectionReason =
            nullptr);

    static const char* stateText(
        WavDecoderState value);

    static const char* encodingText(
        WavSampleEncoding value);

    static const char* errorText(
        WavDecoderError value);

private:
    enum class HeaderPhase : uint8_t
    {
        RiffHeader = 0,
        ChunkHeader,
        FormatPayload,
        SkipPayload,
        Complete
    };

    WavDecoderConfig config_ = {};

    WavDecoderStatus status_ = {};

    SdStreamHandle stream_ = {};

    HeaderPhase headerPhase_ =
        HeaderPhase::RiffHeader;

    uint8_t currentChunkId_[4] = {};

    uint32_t currentChunkSize_ = 0;

    uint32_t currentChunkPayloadOffset_ = 0;

    uint32_t currentChunkBytesRemaining_ = 0;

    uint8_t currentChunkPaddingBytes_ = 0;

    bool formatChunkFound_ = false;

    bool dataChunkFound_ = false;

    uint8_t headerScratch_[
        WAV_DECODER_HEADER_SCRATCH_BYTES] = {};

    uint8_t sourceFrameScratch_[
        WAV_DECODER_MAX_SOURCE_FRAME_BYTES] = {};

    WavDecoderObserver observer_ = nullptr;

    static bool multiplyWouldOverflow(
        uint64_t first,
        uint64_t second);

    static bool addWouldOverflow(
        uint64_t first,
        uint64_t second);

    static uint16_t readLe16(
        const uint8_t* bytes);

    static uint32_t readLe32(
        const uint8_t* bytes);

    static int16_t decodeIntegerSample(
        const uint8_t* bytes,
        uint16_t bitsPerSample,
        uint16_t validBitsPerSample,
        bool clamp,
        bool& clipped);

    static int16_t decodeFloatSample(
        const uint8_t* bytes,
        bool clamp,
        bool& clipped);

    RuntimeResult ensureSourceBytes(
        uint32_t nowMs,
        size_t requiredBytes);

    RuntimeResult readSourceExact(
        uint32_t nowMs,
        void* destination,
        size_t sizeBytes);

    RuntimeResult skipSourceExact(
        uint32_t nowMs,
        size_t sizeBytes);

    RuntimeResult parseRiffHeader(
        uint32_t nowMs);

    RuntimeResult parseChunkHeader(
        uint32_t nowMs);

    RuntimeResult parseFormatPayload(
        uint32_t nowMs);

    RuntimeResult skipCurrentPayload(
        uint32_t nowMs,
        size_t byteBudget);

    RuntimeResult finalizeHeader();

    RuntimeResult validateDestination(
        const PcmRingBuffer& destination) const;

    RuntimeResult decodeAvailableFrames(
        PcmRingBuffer& destination,
        uint32_t nowMs,
        size_t maximumFrames,
        size_t& decodedFrames);

    RuntimeResult consumeSourceFrame(
        uint32_t nowMs,
        int16_t* outputSamples,
        bool& clippedAny);

    RuntimeResult seekToDataByteOffset(
        uint32_t dataRelativeOffset);

    void refreshDerivedStatus();

    RuntimeResult setError(
        WavDecoderError error,
        RuntimeResult result);

    void notifyStateChanged() const;
};

static_assert(
    WAV_DECODER_MIN_CHANNEL_COUNT == 1U &&
        WAV_DECODER_MAX_CHANNEL_COUNT == 2U,
    "WAV decoder supports mono and stereo only");

static_assert(
    WAV_DECODER_MAX_SOURCE_FRAME_BYTES >=
        WAV_DECODER_MAX_CHANNEL_COUNT *
            (WAV_DECODER_MAX_BITS_PER_SAMPLE / 8U),
    "WAV source-frame scratch buffer is too small");

static_assert(
    WAV_DECODER_HEADER_SCRATCH_BYTES >=
        WAV_DECODER_EXTENSIBLE_FMT_BYTES,
    "WAV header scratch buffer cannot hold "
    "extensible fmt data");

static_assert(
    WAV_DECODER_DEFAULT_FRAMES_PER_CALL > 0U &&
        WAV_DECODER_DEFAULT_FRAMES_PER_CALL <=
            WAV_DECODER_MAX_FRAMES_PER_CALL,
    "WAV decode frame limits are invalid");
}
