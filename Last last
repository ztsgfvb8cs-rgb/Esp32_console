int16_t PlaytimeManager::find(
    const String& gameName
)
{
    if(!managerInitialized)
    {
        return
            PLAYTIME_INVALID_GAME_INDEX;
    }


    if(!validGameName(
        gameName
    ))
    {
        return
            PLAYTIME_INVALID_GAME_INDEX;
    }


    for(uint16_t i = 0;
        i < recordCount;
        i++)
    {
        if(
            records[i].valid &&
            gameNamesEqual(
                records[i].gameName,
                gameName
            )
        )
        {
            return
                (int16_t)i;
        }
    }


    return
        PLAYTIME_INVALID_GAME_INDEX;
}



