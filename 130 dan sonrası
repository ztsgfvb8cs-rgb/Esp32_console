namespace egs {
    namespace {
        uint32_t nextGeneration(uint32_t current) {
            return current == UINT32_MAX ? 1U : current + 1U;
        }

        uint32_t saturatingIncrement32(uint32_t value) {
            return value == UINT32_MAX ? UINT32_MAX : value + 1U;
        }

        uint64_t saturatingAdd64(uint64_t first, uint64_t second) {
            return second > UINT64_MAX - first
                ? UINT64_MAX
                : first + second;
        }

        size_t minimumSize(size_t first, size_t second) {
            return first < second ? first : second;
        }

        bool timeReached(uint32_t nowMs, uint32_t targetMs) {
            return static_cast<int32_t>(nowMs - targetMs) >= 0;
        }

        size_t boundedStringLength(
            const char* text,
            size_t capacity) {
            if (text == nullptr) {
                return 0;
            }

            size_t length = 0;

            while (length < capacity &&
                   text[length] != '\0') {
                ++length;
            }

            return length;
        }

        bool validMemoryPreference(
            MemoryPreference preference) {
            switch (preference) {
                case MemoryPreference::InternalOnly:
                case MemoryPreference::PsramPreferred:
                case MemoryPreference::PsramOnly:
                    return true;

                default:
                    return false;
            }
        }
    }

    struct SdStreamService::StreamSlot {
        File file = {};
        StreamRingBuffer buffer = {};
        SdStreamOpenOptions options = {};
        SdStreamStatus status = {};

        bool occupied = false;
        bool prefetchRequested = false;

        uint8_t consecutiveReadFailures = 0;
        uint32_t generation = 0;
    };

    SdStreamService::StreamSlot
        SdStreamService::slots_[
            SD_STREAM_MAX_STREAMS] = {};

    SdStreamServiceConfig
        SdStreamService::config_ = {};

    SdStreamServiceStatus
        SdStreamService::currentStatus_ = {};

    SdStreamObserver
        SdStreamService::observer_ = nullptr;

    bool SdStreamService::begin(
        const SdStreamServiceConfig& config) {
        if (currentStatus_.initialized) {
            return true;
        }

        currentStatus_ = {};

        if (!validateServiceConfig(config)) {
            currentStatus_.error =
                SdStreamError::InvalidConfiguration;

            return false;
        }

        config_ = config;

        bool storageReady =
            StorageManager::ready();

        if (!storageReady &&
            config_.automaticallyBeginStorage) {
            storageReady =
                StorageManager::begin();
        }

        if (!storageReady) {
            currentStatus_.storageReady = false;
            currentStatus_.error =
                SdStreamError::StorageNotReady;

            config_ = {};

            return false;
        }

        for (uint8_t index = 0;
             index < SD_STREAM_MAX_STREAMS;
             ++index) {
            StreamSlot& slot = slots_[index];

            if (slot.file) {
                slot.file.close();
            }

            slot.buffer.end();

            slot.file = File();
            slot.options = {};
            slot.status = {};
            slot.occupied = false;
            slot.prefetchRequested = false;
            slot.consecutiveReadFailures = 0;
            slot.generation =
                nextGeneration(slot.generation);
            slot.status.generation =
                slot.generation;
        }

        currentStatus_ = {};

        currentStatus_.initialized = true;
        currentStatus_.storageReady = true;
        currentStatus_.maximumBytesPerUpdate =
            config_.maximumBytesPerUpdate;
        currentStatus_.nextServiceSlot = 0;
        currentStatus_.error =
            SdStreamError::None;

        refreshServiceStatus();

        return true;
    }

    void SdStreamService::update(
        uint32_t nowMs,
        size_t byteBudgetOverride) {
        if (!currentStatus_.initialized) {
            setError(
                SdStreamError::NotInitialized,
                RuntimeResult::NotReady);

            return;
        }

        currentStatus_.updateSequence =
            saturatingIncrement32(
                currentStatus_.updateSequence);

        currentStatus_.bytesReadThisUpdate = 0;
        currentStatus_.storageReady =
            StorageManager::ready();

        if (!currentStatus_.storageReady) {
            currentStatus_.error =
                SdStreamError::StorageNotReady;

            if (config_.
                    closeStreamsOnStorageFailure) {
                closeAll();

                currentStatus_.storageReady =
                    false;

                currentStatus_.error =
                    SdStreamError::
                        StorageNotReady;
            }

            return;
        }

        if (currentStatus_.suspended) {
            refreshServiceStatus();
            return;
        }

        size_t remainingBudget =
            byteBudgetOverride > 0
                ? byteBudgetOverride
                : config_.maximumBytesPerUpdate;

        if (remainingBudget == 0) {
            refreshServiceStatus();
            return;
        }

        const uint8_t startSlot =
            currentStatus_.nextServiceSlot <
                    SD_STREAM_MAX_STREAMS
                ? currentStatus_.nextServiceSlot
                : 0U;

        uint8_t inspected = 0;
        uint8_t serviced = 0;
        uint8_t nextSlot = startSlot;

        while (
            inspected < SD_STREAM_MAX_STREAMS &&
            serviced <
                config_.maximumStreamsPerUpdate &&
            remainingBudget > 0) {
            const uint8_t slotIndex =
                static_cast<uint8_t>(
                    (startSlot + inspected) %
                    SD_STREAM_MAX_STREAMS);

            nextSlot = static_cast<uint8_t>(
                (slotIndex + 1U) %
                SD_STREAM_MAX_STREAMS);

            ++inspected;

            StreamSlot& slot =
                slots_[slotIndex];

            if (!slot.occupied ||
                !slot.file ||
                !slot.buffer.ready() ||
                slot.status.paused ||
                slot.status.state ==
                    SdStreamState::Failed) {
                continue;
            }

            refreshStreamStatus(slot);

            const bool belowThreshold =
                slot.status.bufferedBytes <=
                slot.options.refillThresholdBytes;

            const bool shouldPrefetch =
                slot.prefetchRequested ||
                (slot.options.
                     automaticallyPrefetch &&
                 belowThreshold);

            if (!shouldPrefetch ||
                (slot.status.eof &&
                 slot.status.bufferedBytes == 0)) {
                continue;
            }

            const size_t streamBudget =
                minimumSize(
                    remainingBudget,
                    slot.options.readChunkBytes);

            size_t loadedBytes = 0;

            const RuntimeResult result =
                prefetchSlot(
                    slot,
                    nowMs,
                    streamBudget,
                    loadedBytes);

            ++serviced;

            if (loadedBytes >
                remainingBudget) {
                remainingBudget = 0;
            } else {
                remainingBudget -= loadedBytes;
            }

            currentStatus_.
                bytesReadThisUpdate +=
                    loadedBytes;

            if (result ==
                    RuntimeResult::IoError &&
                slot.status.state ==
                    SdStreamState::Failed) {
                currentStatus_.error =
                    slot.status.error;
            }
        }

        currentStatus_.nextServiceSlot =
            nextSlot;

        refreshServiceStatus();
    }

    void SdStreamService::end() {
        if (!currentStatus_.initialized) {
            return;
        }

        closeAll();

        config_ = {};
        currentStatus_ = {};
        observer_ = nullptr;
    }

    bool SdStreamService::ready() {
        return
            currentStatus_.initialized &&
            StorageManager::ready();
    }

    SdStreamServiceStatus
    SdStreamService::status() {
        refreshServiceStatus();

        return currentStatus_;
    }

    void SdStreamService::setSuspended(
        bool suspendedValue) {
        if (!currentStatus_.initialized) {
            setError(
                SdStreamError::NotInitialized,
                RuntimeResult::NotReady);

            return;
        }

        currentStatus_.suspended =
            suspendedValue;

        refreshServiceStatus();
    }

    bool SdStreamService::suspended() {
        return currentStatus_.suspended;
    }

    RuntimeResult SdStreamService::open(
        const char* path,
        SdStreamHandle& handle,
        const SdStreamOpenOptions& options) {
        invalidateHandle(handle);

        if (!ready()) {
            currentStatus_.failedOpenCount =
                saturatingIncrement32(
                    currentStatus_.
                        failedOpenCount);

            return setError(
                currentStatus_.initialized
                    ? SdStreamError::
                        StorageNotReady
                    : SdStreamError::
                        NotInitialized,
                RuntimeResult::NotReady);
        }

        const size_t pathLength =
            boundedStringLength(
                path,
                SD_STREAM_PATH_CAPACITY);

        if (path == nullptr ||
            pathLength == 0 ||
            pathLength >=
                SD_STREAM_PATH_CAPACITY) {
            currentStatus_.failedOpenCount =
                saturatingIncrement32(
                    currentStatus_.
                        failedOpenCount);

            return setError(
                SdStreamError::InvalidPath,
                RuntimeResult::InvalidArgument);
        }

        if (!validateOpenOptions(options)) {
            currentStatus_.failedOpenCount =
                saturatingIncrement32(
                    currentStatus_.
                        failedOpenCount);

            return setError(
                SdStreamError::
                    InvalidConfiguration,
                RuntimeResult::InvalidArgument);
        }

        uint8_t freeSlot =
            SD_STREAM_INVALID_SLOT;

        for (uint8_t index = 0;
             index < SD_STREAM_MAX_STREAMS;
             ++index) {
            if (!slots_[index].occupied) {
                freeSlot = index;
                break;
            }
        }

        if (freeSlot ==
            SD_STREAM_INVALID_SLOT) {
            currentStatus_.failedOpenCount =
                saturatingIncrement32(
                    currentStatus_.
                        failedOpenCount);

            return setError(
                SdStreamError::NoFreeSlot,
                RuntimeResult::Busy);
        }

        if (!StorageManager::exists(path)) {
            currentStatus_.failedOpenCount =
                saturatingIncrement32(
                    currentStatus_.
                        failedOpenCount);

            return setError(
                SdStreamError::OpenFailed,
                RuntimeResult::IoError);
        }

        StreamSlot& slot =
            slots_[freeSlot];

        if (slot.file) {
            slot.file.close();
        }

        slot.buffer.end();

        slot.file =
            SD.open(path, FILE_READ);

        if (!slot.file ||
            slot.file.isDirectory()) {
            if (slot.file) {
                slot.file.close();
            }

            slot.file = File();

            currentStatus_.failedOpenCount =
                saturatingIncrement32(
                    currentStatus_.
                        failedOpenCount);

            return setError(
                SdStreamError::OpenFailed,
                RuntimeResult::IoError);
        }

        const uint64_t fileSizeValue =
            static_cast<uint64_t>(
                slot.file.size());

        if (fileSizeValue > UINT32_MAX ||
            options.startOffsetBytes >
                fileSizeValue) {
            slot.file.close();
            slot.file = File();

            currentStatus_.failedOpenCount =
                saturatingIncrement32(
                    currentStatus_.
                        failedOpenCount);

            return setError(
                options.startOffsetBytes >
                        fileSizeValue
                    ? SdStreamError::InvalidSeek
                    : SdStreamError::
                        InvalidConfiguration,
                RuntimeResult::InvalidArgument);
        }

        if (options.startOffsetBytes > 0 &&
            !slot.file.seek(
                options.startOffsetBytes)) {
            slot.file.close();
            slot.file = File();

            currentStatus_.failedOpenCount =
                saturatingIncrement32(
                    currentStatus_.
                        failedOpenCount);

