//---------------- File Control ----------------

bool createPlaytimeStorageFile()
{
    if(!ensureStorageFolder())
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_SD_ERROR;


        return false;
    }


    clearMemoryRecords();


    if(!writeStorageToFile(
        PLAYTIME_STORAGE_FILE
    ))
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_WRITE_ERROR;


        return false;
    }


    playtimeStorageReady =
        true;


    playtimeStorageStatus =
        PLAYTIME_STORAGE_READY;


    return true;
}



bool loadPlaytimeStorage()
{
    if(!SD.exists(
        PLAYTIME_STORAGE_FILE
    ))
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_FILE_ERROR;


        return false;
    }


    if(!readStorageFromFile(
        PLAYTIME_STORAGE_FILE
    ))
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_READ_ERROR;


        return false;
    }


    playtimeStorageReady =
        true;


    playtimeStorageStatus =
        PLAYTIME_STORAGE_READY;


    return true;
}



bool savePlaytimeStorage()
{
    if(!ensureStorageFolder())
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_SD_ERROR;


        return false;
    }


    if(SD.exists(
        PLAYTIME_STORAGE_TEMP_FILE
    ))
    {
        SD.remove(
            PLAYTIME_STORAGE_TEMP_FILE
        );
    }


    if(!writeStorageToFile(
        PLAYTIME_STORAGE_TEMP_FILE
    ))
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_WRITE_ERROR;


        return false;
    }


    if(SD.exists(
        PLAYTIME_STORAGE_FILE
    ))
    {
        if(!copyFile(
            PLAYTIME_STORAGE_FILE,
            PLAYTIME_STORAGE_BACKUP_FILE
        ))
        {
            SD.remove(
                PLAYTIME_STORAGE_TEMP_FILE
            );


            playtimeStorageStatus =
                PLAYTIME_STORAGE_WRITE_ERROR;


            return false;
        }


        SD.remove(
            PLAYTIME_STORAGE_FILE
        );
    }


    if(!SD.rename(
        PLAYTIME_STORAGE_TEMP_FILE,
        PLAYTIME_STORAGE_FILE
    ))
    {
        copyFile(
            PLAYTIME_STORAGE_BACKUP_FILE,
            PLAYTIME_STORAGE_FILE
        );


        SD.remove(
            PLAYTIME_STORAGE_TEMP_FILE
        );


        playtimeStorageStatus =
            PLAYTIME_STORAGE_WRITE_ERROR;


        return false;
    }


    playtimeStorageReady =
        true;


    playtimeStorageStatus =
        PLAYTIME_STORAGE_READY;


    return true;
}



bool backupPlaytimeStorage()
{
    if(!SD.exists(
        PLAYTIME_STORAGE_FILE
    ))
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_FILE_ERROR;


        return false;
    }


    if(!copyFile(
        PLAYTIME_STORAGE_FILE,
        PLAYTIME_STORAGE_BACKUP_FILE
    ))
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_WRITE_ERROR;


        return false;
    }


    playtimeStorageStatus =
        PLAYTIME_STORAGE_READY;


    return true;
}



bool restorePlaytimeStorageBackup()
{
    if(!SD.exists(
        PLAYTIME_STORAGE_BACKUP_FILE
    ))
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_FILE_ERROR;


        return false;
    }


    if(!copyFile(
        PLAYTIME_STORAGE_BACKUP_FILE,
        PLAYTIME_STORAGE_FILE
    ))
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_WRITE_ERROR;


