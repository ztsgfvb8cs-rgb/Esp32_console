//---------------- Profile Search ----------------

int8_t findProfileSelectorIndexByID(
    uint16_t profileID
)
{
    if(profileID ==
       PROFILE_INVALID_ID)
    {
        return -1;
    }


    for(uint8_t i = 0;
        i < selectorEntryCount;
        i++)
    {
        if(selectorEntries[i].valid &&
           selectorEntries[i].profileID == profileID)
        {
            return (int8_t)i;
        }
    }


    return -1;
}



int8_t findProfileSelectorIndexByName(
    const char* playerName
)
{
    if(playerName == nullptr)
    {
        return -1;
    }


    if(playerName[0] ==
       '\0')
    {
        return -1;
    }


    for(uint8_t i = 0;
        i < selectorEntryCount;
        i++)
    {
        if(!selectorEntries[i].valid)
        {
            continue;
        }


        if(strcmp(
            selectorEntries[i].playerName,
            playerName
        ) == 0)
        {
            return (int8_t)i;
        }
    }


    return -1;
}



