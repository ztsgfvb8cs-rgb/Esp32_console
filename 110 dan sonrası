void AiPerceptionSystem::processStimulus(
    const AiPerceptionStimulus& stimulus,
    uint32_t nowMs)
{
    int index = findObservationIndex(stimulus.entityId);

    if (!stimulus.active)
    {
        if (index >= 0)
        {
            removeObservationAt(
                static_cast<size_t>(index));
        }

        return;
    }

    if (stimulus.entityId == observerState_.entityId)
    {
        return;
    }

    const uint32_t distance = pointDistance(
        observerState_.position,
        stimulus.position);

    bool contact = false;
    bool centralVision = false;
    bool peripheralVision = false;
    bool heard = false;
    bool gameRule = false;
    bool visualOccluded = false;

    if ((stimulus.sourceFlags &
         AiPerceptionSourceContact) != 0U &&
        policy_.allowContact &&
        observerState_.contactRange > 0 &&
        distance <= observerState_.contactRange)
    {
        contact = true;
    }

    if ((stimulus.sourceFlags &
         AiPerceptionSourceGameRule) != 0U)
    {
        gameRule = true;
    }

    if ((stimulus.sourceFlags &
         AiPerceptionSourceVision) != 0U &&
        observerState_.visionRange > 0 &&
        distance <= observerState_.visionRange)
    {
        const bool centralArc = insideVisionArc(
            observerState_,
            stimulus.position,
            observerState_.visionArcPermille);

        const uint16_t expandedArc =
            observerState_.visionArcPermille >= 750U
                ? AI_PERMILLE_MAX
                : static_cast<uint16_t>(
                    observerState_.visionArcPermille + 250U);

        const bool peripheralArc =
            policy_.allowPeripheralVision &&
            !centralArc &&
            insideVisionArc(
                observerState_,
                stimulus.position,
                expandedArc);

        bool lineOfSight = true;

        if (policy_.requireLineOfSightForVision &&
            lineOfSightCallback_ != nullptr)
        {
            lineOfSight = lineOfSightCallback_(
                observerState_.position,
                stimulus.position,
                lineOfSightContext_);
        }

        if (lineOfSight)
        {
            centralVision = centralArc;
            peripheralVision = peripheralArc;
        }
        else if (centralArc || peripheralArc)
        {
            visualOccluded = true;
        }
    }

    if ((stimulus.sourceFlags &
         AiPerceptionSourceHearing) != 0U &&
        policy_.allowHearing &&
        observerState_.hearingRange > 0 &&
        stimulus.emittedNoisePermille > 0)
    {
        const uint32_t effectiveHearingRange =
            scaledRange(
                observerState_.hearingRange,
                stimulus.emittedNoisePermille);

        heard = distance <= effectiveHearingRange;
    }

    const bool legallyPerceived =
        contact ||
        gameRule ||
        centralVision ||
        peripheralVision ||
        heard;

    if (!legallyPerceived)
    {
        if (index >= 0 &&
            visualOccluded &&
            policy_.rememberOccludedEntities)
        {
            AiPerceptionObservation& existing =
                observations_[static_cast<size_t>(index)];

            existing.currentlyPerceived = false;
            existing.visibility =
                AiVisibilityState::Occluded;
        }

        return;
    }

    if (index < 0)
    {
        if (currentStatus_.observationCount <
            AI_PERCEPTION_MAX_TRACKED_ENTITIES)
        {
            index = static_cast<int>(
                currentStatus_.observationCount);

            ++currentStatus_.observationCount;
        }
        else
        {
            index = selectReplacementIndex();
            currentStatus_.observationOverflowed = true;

            if (index < 0)
            {
                setError(
                    AiPerceptionError::
                        ObservationCapacityExceeded);

                return;
            }
        }

        observations_[static_cast<size_t>(index)] = {};

        observations_[static_cast<size_t>(index)].
            entityId = stimulus.entityId;

        observations_[static_cast<size_t>(index)].
            firstPerceivedAtMs = nowMs;
    }

    AiPerceptionObservation& observation =
        observations_[static_cast<size_t>(index)];

    if (observation.firstPerceivedAtMs == 0)
    {
        observation.firstPerceivedAtMs = nowMs;
    }

    const bool bypassReactionDelay =
        contact || gameRule;

    const bool reactionComplete =
        bypassReactionDelay ||
        nowMs - observation.firstPerceivedAtMs >=
            difficultyProfile_.reactionDelayMs;

    observation.category = stimulus.category;
    observation.relation = stimulus.relation;
    observation.position = stimulus.position;
    observation.velocity = stimulus.velocity;
    observation.predictedPosition = stimulus.position;
    observation.halfWidth = stimulus.halfWidth;
    observation.halfHeight = stimulus.halfHeight;
    observation.threatPermille =
        stimulus.threatPermille;
    observation.valuePermille =
        stimulus.valuePermille;
    observation.distance = distance;
    observation.targetable = stimulus.targetable;
    observation.collidable = stimulus.collidable;

    uint16_t perceivedSources =
        AiPerceptionSourceNone;

    if (centralVision || peripheralVision)
    {
        perceivedSources |=
            AiPerceptionSourceVision;
    }

    if (heard)
    {
        perceivedSources |=
            AiPerceptionSourceHearing;
    }

    if (contact)
    {
        perceivedSources |=
            AiPerceptionSourceContact;
    }

    if (gameRule)
    {
        perceivedSources |=
            AiPerceptionSourceGameRule;
    }

    observation.sourceFlags = perceivedSources;

    const uint32_t memoryDurationMs =
        memoryDurationForSources(
            perceivedSources,
            policy_);

    if (!reactionComplete)
    {
        observation.currentlyPerceived = false;
        observation.visibility =
            AiVisibilityState::Unknown;
        observation.confidencePermille = 0;

        observation.expiresAtMs =
            nowMs +
            difficultyProfile_.reactionDelayMs +
            memoryDurationMs;

        return;
    }

    if (contact)
    {
        observation.visibility =
            AiVisibilityState::Contact;
    }
    else if (gameRule || centralVision)
    {
        observation.visibility =
            AiVisibilityState::Visible;
    }
    else if (peripheralVision)
    {
        observation.visibility =
            AiVisibilityState::Peripheral;
    }
    else
    {
        observation.visibility =
            AiVisibilityState::Heard;
    }

    observation.currentlyPerceived = true;
    observation.lastPerceivedAtMs = nowMs;

    observation.expiresAtMs =
        nowMs + memoryDurationMs;

    observation.confidencePermille =
        baseConfidenceForObservation(
            observation,
            policy_,
            difficultyProfile_);

    ++currentStatus_.observationSequence;
}

void AiPerceptionSystem::decayAndPredict(
    uint32_t nowMs)
{
    size_t index = 0;

    while (index <
        currentStatus_.observationCount)
    {
        AiPerceptionObservation& observation =
            observations_[index];

        if (observation.entityId ==
                AI_INVALID_ENTITY_ID ||
            (observation.expiresAtMs != 0 &&
             timeReached(
                 nowMs,
                 observation.expiresAtMs)))
        {
            removeObservationAt(index);
            continue;
        }

        observation.currentlyPerceived = false;

        if (observation.lastPerceivedAtMs == 0)
        {
            observation.visibility =
                AiVisibilityState::Unknown;

            observation.confidencePermille = 0;

            ++index;
            continue;
        }

        const uint32_t elapsedMs =
            nowMs -
            observation.lastPerceivedAtMs;

        const uint16_t baseConfidence =
            baseConfidenceForObservation(
                observation,
                policy_,
                difficultyProfile_);

        const uint64_t decayAmount =
            static_cast<uint64_t>(
                policy_.
                    confidenceDecayPerSecondPermille) *
            elapsedMs /
            1000UL;

        uint16_t confidence =
            decayAmount >= baseConfidence
                ? 0U
                : static_cast<uint16_t>(
                    baseConfidence - decayAmount);

        observation.predictedPosition =
            observation.position;

        const uint32_t predictionLimitMs =
            policy_.maximumPredictionMs <
                    difficultyProfile_.
                        predictionHorizonMs
                ? policy_.maximumPredictionMs
                : difficultyProfile_.
                    predictionHorizonMs;

        const uint32_t predictionHorizonMs =
            elapsedMs < predictionLimitMs
                ? elapsedMs
                : predictionLimitMs;

        const bool canPredict =
            policy_.enablePrediction &&
            predictionHorizonMs > 0 &&
            difficultyProfile_.
                    predictionStrengthPermille >
                0 &&
            (observation.velocity.x != 0 ||
             observation.velocity.y != 0);

        if (canPredict)
        {
            observation.predictedPosition.x =
                predictedCoordinate(
                    observation.position.x,
                    observation.velocity.x,
                    predictionHorizonMs,
                    difficultyProfile_.
                        predictionStrengthPermille);

            observation.predictedPosition.y =
                predictedCoordinate(
                    observation.position.y,
                    observation.velocity.y,
                    predictionHorizonMs,
                    difficultyProfile_.
                        predictionStrengthPermille);

            confidence = multipliedPermille(
                confidence,
                static_cast<uint16_t>(
                    AI_PERMILLE_MAX -
                    policy_.
                        predictionConfidenceCostPermille));

            observation.visibility =
                AiVisibilityState::Predicted;

            observation.sourceFlags |=
                AiPerceptionSourcePrediction;
        }
        else if (
            observation.visibility ==
                AiVisibilityState::Occluded)
        {
            observation.visibility =
                AiVisibilityState::Occluded;
        }
        else
        {
            observation.visibility =
                AiVisibilityState::Remembered;

            observation.sourceFlags &=
                static_cast<uint16_t>(
                    ~AiPerceptionSourcePrediction);
        }

        observation.confidencePermille =
            confidence;

        observation.distance = pointDistance(
            observerState_.position,
            observation.predictedPosition);

        if (confidence <
            policy_.
                minimumRetainedConfidencePermille)
        {
            removeObservationAt(index);
            continue;
        }

        ++index;
    }

    refreshCounts();
}

int AiPerceptionSystem::findObservationIndex(
    uint16_t entityId)
{
    if (entityId == AI_INVALID_ENTITY_ID)
    {
        return -1;
    }

    for (size_t i = 0;
         i < currentStatus_.observationCount;
         ++i)
    {
        if (observations_[i].entityId ==
            entityId)
        {
            return static_cast<int>(i);
        }
    }

    return -1;
}

int AiPerceptionSystem::selectReplacementIndex()
{
    if (currentStatus_.observationCount == 0)
    {
        return -1;
    }

    size_t selected = 0;

    for (size_t i = 1;
         i < currentStatus_.observationCount;
         ++i)
    {
        const AiPerceptionObservation& candidate =
            observations_[i];

        const AiPerceptionObservation& current =
            observations_[selected];

        if (candidate.confidencePermille <
                current.confidencePermille ||
            (candidate.confidencePermille ==
                 current.confidencePermille &&
             candidate.lastPerceivedAtMs <
                 current.lastPerceivedAtMs))
        {
            selected = i;
        }
    }

    return static_cast<int>(selected);
}

void AiPerceptionSystem::removeObservationAt(
    size_t index)
{
    if (index >= currentStatus_.observationCount)
    {
        return;
    }

    for (size_t i = index + 1;
         i < currentStatus_.observationCount;
         ++i)
    {
        observations_[i - 1U] =
            observations_[i];
    }

    if (currentStatus_.observationCount > 0)
    {
        --currentStatus_.observationCount;

        observations_[
            currentStatus_.observationCount] = {};
    }
}

void AiPerceptionSystem::refreshCounts()
{
    uint16_t perceivedCount = 0;
    uint16_t rememberedCount = 0;

    for (size_t i = 0;
         i < currentStatus_.observationCount;
         ++i)
    {
        if (observations_[i].currentlyPerceived)
        {
            ++perceivedCount;
        }
        else if (
            observations_[i].visibility !=
                AiVisibilityState::Unknown)
        {
            ++rememberedCount;
        }
    }

    currentStatus_.currentlyPerceivedCount =
        perceivedCount;

    currentStatus_.rememberedCount =
        rememberedCount;
}

void AiPerceptionSystem::setError(
    AiPerceptionError error)
{
    currentStatus_.error = error;

    notifyStateChanged();
}

void AiPerceptionSystem::notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(currentStatus_);
    }
}
