PsramPoolBlock PsramPool::acquire(
    size_t requestedBytes,
    PsramPoolClearMode clearMode)
{
    if (!ready())
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::NotInitialized,
            RuntimeResult::NotReady);

        return {};
    }

    if (requestedBytes == 0 ||
        !validClearMode(clearMode))
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::InvalidBlock,
            RuntimeResult::InvalidArgument);

        return {};
    }

    const uint8_t firstClass =
        bestClassFor(requestedBytes);

    if (firstClass == PSRAM_POOL_INVALID_CLASS)
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::RequestTooLarge,
            RuntimeResult::OutOfMemory);

        return {};
    }

    uint8_t selectedClass = firstClass;

    while (selectedClass < config_.classCount)
    {
        if (findFreeSlotInClass(selectedClass) >= 0)
        {
            return acquireFromResolvedClass(
                selectedClass,
                requestedBytes,
                clearMode);
        }

        if (!config_.allowLargerClassFallback)
        {
            break;
        }

        ++selectedClass;
    }

    if (status_.failedAllocationCount < UINT32_MAX)
    {
        ++status_.failedAllocationCount;
    }

    refreshStatus();

    setError(
        PsramPoolError::PoolExhausted,
        RuntimeResult::OutOfMemory);

    return {};
}

PsramPoolBlock PsramPool::acquireFromClass(
    uint8_t classIndex,
    size_t requestedBytes,
    PsramPoolClearMode clearMode)
{
    if (!ready())
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::NotInitialized,
            RuntimeResult::NotReady);

        return {};
    }

    if (classIndex >= config_.classCount)
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::InvalidClass,
            RuntimeResult::InvalidArgument);

        return {};
    }

    if (requestedBytes == 0 ||
        !validClearMode(clearMode))
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::InvalidBlock,
            RuntimeResult::InvalidArgument);

        return {};
    }

    if (requestedBytes >
        config_.classes[classIndex].blockSizeBytes)
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::RequestTooLarge,
            RuntimeResult::OutOfMemory);

        return {};
    }

    if (findFreeSlotInClass(classIndex) < 0)
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        refreshStatus();

        setError(
            PsramPoolError::PoolExhausted,
            RuntimeResult::OutOfMemory);

        return {};
    }

    return acquireFromResolvedClass(
        classIndex,
        requestedBytes,
        clearMode);
}
