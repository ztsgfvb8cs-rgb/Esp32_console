uint32_t nextGeneration(uint32_t current)
{
    return current == UINT32_MAX
        ? 1U
        : current + 1U;
}

uint32_t nextLease(uint32_t current)
{
    return current == UINT32_MAX
        ? 1U
        : current + 1U;
}

bool validClearMode(PsramPoolClearMode mode)
{
    switch (mode)
    {
        case PsramPoolClearMode::Default:
        case PsramPoolClearMode::Preserve:
        case PsramPoolClearMode::Clear:
            return true;

        default:
            return false;
    }
}
