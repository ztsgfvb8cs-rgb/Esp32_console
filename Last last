uint64_t PlaytimeManager::totalMilliseconds(
    const String& id
)
{
    int16_t index = find(id);

    if (index < 0)
        return 0;

    uint64_t result =
        entries[index].totalMilliseconds;

    if (!active ||
        paused ||
        activeIndex != index)
    {
        return result;
    }

    uint64_t pending =
        pendingActiveMilliseconds();

    if (result >
        PLAYTIME_UINT64_MAX - pending)
    {
        return PLAYTIME_UINT64_MAX;
    }

    return result + pending;
}


uint64_t PlaytimeManager::totalSeconds(
    const String& id
