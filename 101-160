    currentStatus.lastUpdateTime = 0;
    currentStatus.sampleSequence = 0;

    currentStatus.state = BatteryState::UNKNOWN;
    currentStatus.error = BatteryError::NONE;

    resetSampler();
}

void BatteryManager::resetSampler()
{
    sampleAccumulator = 0;
    collectedSampleCount = 0;
    currentStatus.sampling = false;
}

bool BatteryManager::validateConfiguration()
{
    if (BoardConfig::BATTERY_ADC_MAX_VALUE == 0 ||
        BoardConfig::BATTERY_ADC_REFERENCE_V <= 0.0f ||
        BoardConfig::BATTERY_DIVIDER_RATIO <= 0.0f ||
        BoardConfig::BATTERY_SAMPLE_COUNT == 0 ||
        BoardConfig::BATTERY_UPDATE_INTERVAL_MS == 0)
    {
        return false;
    }

    if (!(BoardConfig::BATTERY_EMPTY_VOLTAGE <
              BoardConfig::BATTERY_CRITICAL_VOLTAGE &&
          BoardConfig::BATTERY_CRITICAL_VOLTAGE <
              BoardConfig::BATTERY_LOW_VOLTAGE &&
          BoardConfig::BATTERY_LOW_VOLTAGE <
              BoardConfig::BATTERY_FULL_VOLTAGE))
    {
        return false;
    }

    float previousThreshold =
        BoardConfig::BATTERY_EMPTY_VOLTAGE;

    for (uint8_t index = 0;
         index < BoardConfig::BATTERY_BAR_COUNT;
         ++index)
    {
        const float threshold =
            BoardConfig::BATTERY_BAR_THRESHOLDS_V[index];

        if (!validFiniteValue(threshold) ||
            threshold <= previousThreshold ||
            threshold > BoardConfig::BATTERY_FULL_VOLTAGE)
        {
            return false;
        }

        previousThreshold = threshold;
    }

    return
        validFiniteValue(currentCalibrationScale) &&
        validFiniteValue(currentCalibrationOffsetV) &&
        validFiniteValue(currentSmoothingFactor) &&
        currentCalibrationScale >= MIN_CALIBRATION_SCALE &&
        currentCalibrationScale <= MAX_CALIBRATION_SCALE &&
        currentCalibrationOffsetV >= MIN_CALIBRATION_OFFSET_V &&
        currentCalibrationOffsetV <= MAX_CALIBRATION_OFFSET_V &&
        currentSmoothingFactor > 0.0f &&
        currentSmoothingFactor <= 1.0f;
}

bool BatteryManager::startSampling()
{
    resetSampler();
    currentStatus.sampling = true;
    return true;
}

bool BatteryManager::collectOneSample()
{
    if (!currentStatus.sampling)
    {
        return false;
    }

    const int rawValue =
        HardwareManager::rawBatteryAdc();

    if (rawValue < 0 ||
        rawValue >
            static_cast<int>(
                BoardConfig::BATTERY_ADC_MAX_VALUE))
    {
        resetSampler();
        currentStatus.error =
            BatteryError::ADC_READ_FAILED;

        return false;
    }

    sampleAccumulator +=
        static_cast<uint16_t>(rawValue);

    ++collectedSampleCount;

    if (collectedSampleCount >=
        BoardConfig::BATTERY_SAMPLE_COUNT)
    {
        return finishSampling();
    }

    return true;
}

bool BatteryManager::finishSampling()
{
    if (collectedSampleCount == 0)
    {
        resetSampler();
        currentStatus.error =
            BatteryError::ADC_READ_FAILED;

        return false;
    }

    const uint32_t roundedAverage =
        (sampleAccumulator +
         (collectedSampleCount / 2U)) /
        collectedSampleCount;

    resetSampler();

    return processRawAverage(
        static_cast<uint16_t>(roundedAverage));
}

//====================================================
// PRIVATE VALUE PROCESSING
//====================================================

bool BatteryManager::processRawAverage(
    uint16_t averageRaw)
{
    const bool previousValueValid =
        currentStatus.valid;

    const float previousFilteredVoltage =
        currentStatus.filteredVoltage;

    const uint8_t previousBars =
        currentStatus.bars;

    const BatteryState previousState =
        currentStatus.state;

    const float measuredAdcVoltage =
        rawToAdcVoltage(averageRaw);

    const float measuredBatteryVoltage =
        calibratedBatteryVoltage(measuredAdcVoltage);

    if (!validFiniteValue(measuredAdcVoltage) ||
        !validFiniteValue(measuredBatteryVoltage))
    {
        currentStatus.error =
            BatteryError::ADC_READ_FAILED;

        return false;
    }

    const float filteredVoltage =
        previousValueValid
            ? previousFilteredVoltage +
                  currentSmoothingFactor *
                      (measuredBatteryVoltage -
                       previousFilteredVoltage)
            : measuredBatteryVoltage;

    currentStatus.rawAdc = averageRaw;
    currentStatus.adcVoltage = measuredAdcVoltage;
    currentStatus.batteryVoltage = measuredBatteryVoltage;
    currentStatus.filteredVoltage = filteredVoltage;

    currentStatus.bars = calculateBars(
        filteredVoltage,
        previousBars,
        previousValueValid);

    currentStatus.percentage =
        calculatePercentage(filteredVoltage);

    currentStatus.state = classifyState(
        filteredVoltage,
        previousState);

    currentStatus.critical =
        currentStatus.state == BatteryState::CRITICAL;

    currentStatus.low =
        currentStatus.state == BatteryState::LOW ||
        currentStatus.critical;

    currentStatus.full =
        currentStatus.state == BatteryState::FULL;

    currentStatus.valid = true;
    currentStatus.lastUpdateTime = millis();
    ++currentStatus.sampleSequence;
    currentStatus.error = BatteryError::NONE;

    currentStatus.changed =
        !previousValueValid ||
        currentStatus.state != previousState ||
        currentStatus.bars != previousBars ||
        absoluteFloat(
            filteredVoltage - previousFilteredVoltage) >=
            CHANGE_EPSILON_V;

    if (stateCallback != nullptr &&
        currentStatus.state != previousState)
    {
        stateCallback(
            previousState,
            currentStatus.state,
            currentStatus);
    }

    return true;
}

float BatteryManager::rawToAdcVoltage(
    uint16_t rawValue)
{
    const float normalized =
        static_cast<float>(rawValue) /
        static_cast<float>(
            BoardConfig::BATTERY_ADC_MAX_VALUE);

    return
        normalized *
        BoardConfig::BATTERY_ADC_REFERENCE_V;
}

float BatteryManager::calibratedBatteryVoltage(
    float measuredAdcVoltage)
{
    return
        measuredAdcVoltage *
            BoardConfig::BATTERY_DIVIDER_RATIO *
            currentCalibrationScale +
        currentCalibrationOffsetV;
}

BatteryState BatteryManager::classifyState(
    float filteredVoltage,
    BatteryState previousState)
{
    const float criticalThreshold =
        BoardConfig::BATTERY_CRITICAL_VOLTAGE;

    const float lowThreshold =
        BoardConfig::BATTERY_LOW_VOLTAGE;

    const float fullThreshold =
        BoardConfig::BATTERY_BAR_THRESHOLDS_V[
            BoardConfig::BATTERY_BAR_COUNT - 1U];

    if (previousState == BatteryState::CRITICAL &&
        filteredVoltage <
            criticalThreshold + STATE_HYSTERESIS_V)
    {
        return BatteryState::CRITICAL;
    }

    if (filteredVoltage <= criticalThreshold)
    {
        return BatteryState::CRITICAL;
    }

    if (previousState == BatteryState::LOW &&
        filteredVoltage <
            lowThreshold + STATE_HYSTERESIS_V)
    {
        return BatteryState::LOW;
    }

    if (filteredVoltage <= lowThreshold)
    {
        return BatteryState::LOW;
    }

    if (previousState == BatteryState::FULL &&
        filteredVoltage >
            fullThreshold - STATE_HYSTERESIS_V)
    {
        return BatteryState::FULL;
    }

    if (filteredVoltage >= fullThreshold)
    {
        return BatteryState::FULL;
    }

    return BatteryState::NORMAL;
}

uint8_t BatteryManager::calculateBars(
    float filteredVoltage,
    uint8_t previousBars,
    bool previousValueValid)
{
    uint8_t directBars = 0;

    for (uint8_t index = 0;
         index < BoardConfig::BATTERY_BAR_COUNT;
         ++index)
    {
        if (filteredVoltage >=
            BoardConfig::BATTERY_BAR_THRESHOLDS_V[index])
        {
            directBars = index + 1U;
        }
    }

    if (!previousValueValid ||
        previousBars > BoardConfig::BATTERY_BAR_COUNT)
    {
        return directBars;
    }

    uint8_t stableBars = previousBars;

    while (stableBars < BoardConfig::BATTERY_BAR_COUNT)
    {
        const float riseThreshold =
            BoardConfig::BATTERY_BAR_THRESHOLDS_V[
                stableBars] +
            BAR_HYSTERESIS_V;

        if (filteredVoltage < riseThreshold)
        {
            break;
        }

        ++stableBars;
    }

    while (stableBars > 0)
    {
        const float fallThreshold =
            BoardConfig::BATTERY_BAR_THRESHOLDS_V[
                stableBars - 1U] -
            BAR_HYSTERESIS_V;

        if (filteredVoltage >= fallThreshold)
        {
            break;
        }

        --stableBars;
    }

    return stableBars;
}

uint8_t BatteryManager::calculatePercentage(
    float filteredVoltage)
{
    struct VoltagePoint
    {
        float voltage;
        uint8_t percentage;
    };

    static constexpr VoltagePoint CURVE[] =
    {
        {3.00f, 0},
        {3.20f, 3},
        {3.30f, 6},
        {3.40f, 10},
        {3.50f, 15},
        {3.60f, 25},
        {3.70f, 40},
        {3.80f, 55},
        {3.90f, 70},
        {4.00f, 82},
        {4.10f, 92},
        {4.20f, 100}
    };

    constexpr uint8_t POINT_COUNT =
        static_cast<uint8_t>(
            sizeof(CURVE) / sizeof(CURVE[0]));

    if (filteredVoltage <= CURVE[0].voltage)
    {
        return CURVE[0].percentage;
    }

    if (filteredVoltage >=
        CURVE[POINT_COUNT - 1U].voltage)
    {
        return CURVE[POINT_COUNT - 1U].percentage;
    }

    for (uint8_t index = 1;
         index < POINT_COUNT;
         ++index)
    {
        if (filteredVoltage <= CURVE[index].voltage)
        {
            const VoltagePoint& lower = CURVE[index - 1U];
            const VoltagePoint& upper = CURVE[index];

            const float position =
                (filteredVoltage - lower.voltage) /
                (upper.voltage - lower.voltage);

            const float interpolated =
                static_cast<float>(lower.percentage) +
                position *
                    static_cast<float>(
                        upper.percentage -
                        lower.percentage);

            return static_cast<uint8_t>(
                clampFloat(
                    interpolated + 0.5f,
                    0.0f,
                    100.0f));
        }
    }

    return 100;
}

//====================================================
// PRIVATE NUMERIC HELPERS
//====================================================

bool BatteryManager::validFiniteValue(float value)
{
    return isfinite(value) != 0;
}

float BatteryManager::absoluteFloat(float value)
{
    return value < 0.0f ? -value : value;
}

float BatteryManager::clampFloat(
    float value,
    float minimum,
    float maximum)
{
    if (value < minimum)
    {
        return minimum;
    }

    if (value > maximum)
    {
        return maximum;
    }

    return value;
}
