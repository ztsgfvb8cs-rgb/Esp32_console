constexpr size_t kibibytes(size_t value)
{
    return value * 1024UL;
}

bool musicPausedByRuntimeManager = false;

#if defined(ARDUINO_ARCH_ESP32)
bool safeFits(size_t available, size_t required, size_t reserve)
{
    return required <= available && reserve <= (available - required);
}
#endif

bool isEmulatorEngine(EngineKind engine)
{
    return engine != EngineKind::None && engine != EngineKind::Builtin;
}

RuntimeResult resultForMemoryError(RuntimeModuleError error)
{
    switch (error)
    {
        case RuntimeModuleError::InsufficientInternalRam:
        case RuntimeModuleError::InsufficientPsram:
        case RuntimeModuleError::InsufficientDmaMemory:
            return RuntimeResult::OutOfMemory;

        default:
            return RuntimeResult::InternalError;
    }
}
}

RuntimeModuleStatus RuntimeModuleManager::currentStatus_ = {};
RuntimeMusicPreferences RuntimeModuleManager::musicPreferences_ = {};
RuntimeAudioPolicy RuntimeModuleManager::audioPolicyOverride_ = {};
bool RuntimeModuleManager::audioPolicyOverrideActive_ = false;
RuntimeModuleStateCallback RuntimeModuleManager::stateCallback_ = nullptr;
ContentItem RuntimeModuleManager::activeContent_ = {};

bool RuntimeModuleManager::begin()
{
    if (currentStatus_.initialized)
    {
        return true;
    }

    currentStatus_ = {};
    currentStatus_.initialized = true;
    currentStatus_.state = RuntimeModuleState::Stopped;
    currentStatus_.backgroundMusicAllowed = true;

    musicPreferences_ = {};
    audioPolicyOverride_ = {};
    audioPolicyOverrideActive_ = false;
    activeContent_ = {};
    musicPausedByRuntimeManager = false;

    Logger::info(
        LogSource::Application,
        "RUNTIME",
        "Foreground runtime manager ready");

    return true;
}

void RuntimeModuleManager::update(uint32_t nowMs)
{
    if (!currentStatus_.initialized ||
        !currentStatus_.foregroundActive ||
        currentStatus_.state != RuntimeModuleState::Running)
    {
        return;
    }

    if (currentStatus_.stopRequested)
    {
        closeForeground();
        return;
    }

    switch (currentStatus_.kind)
    {
        case RuntimeModuleKind::BuiltinGame:
        case RuntimeModuleKind::Emulator:
            GameSession::update(nowMs);

            if (!GameSession::active())
            {
                closeForeground();
            }
            break;

        case RuntimeModuleKind::PdfReader:
            // PDF page changes are event-driven. The reader does not
            // require a continuous update callback.
            break;

        case RuntimeModuleKind::MediaViewer:
        case RuntimeModuleKind::SystemTool:
        case RuntimeModuleKind::None:
        default:
            currentStatus_.error =
                RuntimeModuleError::UnsupportedModule;

            currentStatus_.stopRequested = true;
            break;
    }
}

void RuntimeModuleManager::render()
{
    if (!currentStatus_.initialized ||
        !currentStatus_.foregroundActive ||
        currentStatus_.state != RuntimeModuleState::Running)
    {
        return;
    }

    switch (currentStatus_.kind)
    {
        case RuntimeModuleKind::BuiltinGame:
        case RuntimeModuleKind::Emulator:
            GameSession::render();
            break;

        case RuntimeModuleKind::PdfReader:
            if (PdfReader::renderCurrentPage() != RuntimeResult::Ok)
            {
                Logger::error(
                    LogSource::Application,
                    "RUNTIME",
                    "PDF foreground render failed");

                stopActiveBackend();

                if (musicPausedByRuntimeManager &&
                    AudioPlayer::state() ==
                        AudioPlayerState::Paused)
                {
                    AudioPlayer::resume();
                }

                musicPausedByRuntimeManager = false;
                currentStatus_.foregroundActive = false;
                currentStatus_.memoryBudgetAccepted = false;
                currentStatus_.error =
                    RuntimeModuleError::StartFailed;

                transitionTo(RuntimeModuleState::Failed);
            }
            break;

        case RuntimeModuleKind::MediaViewer:
        case RuntimeModuleKind::SystemTool:
        case RuntimeModuleKind::None:
        default:
            break;
    }
}

void RuntimeModuleManager::end()
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    closeForeground();

    currentStatus_.initialized = false;
    currentStatus_.state = RuntimeModuleState::Stopped;
    currentStatus_.foregroundActive = false;
    currentStatus_.stopRequested = false;
    currentStatus_.memoryBudgetAccepted = false;
    currentStatus_.backgroundMusicAllowed = true;

    Logger::info(
        LogSource::Application,
        "RUNTIME",
        "Foreground runtime manager stopped");
}

bool RuntimeModuleManager::ready()
{
    return currentStatus_.initialized;
}

RuntimeModuleStatus RuntimeModuleManager::status()
{
    return currentStatus_;
}

RuntimeResult RuntimeModuleManager::launch(
    const ContentItem& item)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeModuleError::NotInitialized,
            RuntimeResult::NotReady);
    }

    switch (classifyContent(item))
    {
        case RuntimeModuleKind::BuiltinGame:
            return launchBuiltinGame(item);

        case RuntimeModuleKind::Emulator:
            return launchEmulator(item);

        case RuntimeModuleKind::PdfReader:
            return openPdf(item);

        case RuntimeModuleKind::MediaViewer:
        case RuntimeModuleKind::SystemTool:
        case RuntimeModuleKind::None:
        default:
            return fail(
                RuntimeModuleError::UnsupportedModule,
                RuntimeResult::Unsupported);
    }
}

RuntimeResult RuntimeModuleManager::launchBuiltinGame(
    const ContentItem& item)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeModuleError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (currentStatus_.foregroundActive ||
        currentStatus_.state == RuntimeModuleState::Starting ||
        currentStatus_.state == RuntimeModuleState::Stopping)
    {
        return fail(
            RuntimeModuleError::AlreadyBusy,
            RuntimeResult::Busy);
    }

    if (!validateContent(
            item,
            RuntimeModuleKind::BuiltinGame))
    {
        return fail(
            RuntimeModuleError::InvalidContent,
            RuntimeResult::InvalidArgument);
    }

    const RuntimeMemoryBudget budget =
        defaultMemoryBudget(
            RuntimeModuleKind::BuiltinGame,
            item.engine);

    RuntimeModuleError memoryError =
        RuntimeModuleError::None;

    if (!memoryAvailable(budget, &memoryError))
    {
        return fail(
            memoryError,
            resultForMemoryError(memoryError));
    }

    currentStatus_.error = RuntimeModuleError::None;
    currentStatus_.kind = RuntimeModuleKind::BuiltinGame;
    currentStatus_.engine = item.engine;
    currentStatus_.memory = budget;
    currentStatus_.memoryBudgetAccepted = true;

    currentStatus_.audio = resolveAudioPolicy(
        RuntimeModuleKind::BuiltinGame,
        item.engine);

    currentStatus_.backgroundMusicAllowed =
        currentStatus_.audio.backgroundMusic ==
            BackgroundMusicPolicy::Continue;

    currentStatus_.stopRequested = false;
    activeContent_ = item;

    transitionTo(RuntimeModuleState::Starting);

    const RuntimeResult result = startGameSession(
        item,
        RuntimeModuleKind::BuiltinGame);

    if (result != RuntimeResult::Ok)
    {
        currentStatus_.foregroundActive = false;
        currentStatus_.memoryBudgetAccepted = false;

        return fail(
            RuntimeModuleError::StartFailed,
            result);
    }

    currentStatus_.foregroundActive = true;

    applyAudioPolicy();
    transitionTo(RuntimeModuleState::Running);

    return RuntimeResult::Ok;
}

