RuntimeResult RuntimeAudioCoordinator::scaleInterleavedSamples(
    int16_t* samples,
    size_t frameCount,
    uint8_t channelCount,
    RuntimeAudioBus bus)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeAudioError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!validBus(bus))
    {
        return fail(
            RuntimeAudioError::InvalidBus,
            RuntimeResult::InvalidArgument);
    }

    if (channelCount == 0 ||
        (samples == nullptr && frameCount > 0) ||
        (channelCount > 0 &&
         frameCount > SIZE_MAX / channelCount))
    {
        return RuntimeResult::InvalidArgument;
    }

    if (frameCount == 0)
    {
        return RuntimeResult::Ok;
    }

    const uint16_t gainValue = gainPermille(bus);
    const size_t sampleCount =
        frameCount * static_cast<size_t>(channelCount);

    if (gainValue == RUNTIME_AUDIO_UNITY_PERMILLE)
    {
        return RuntimeResult::Ok;
    }

    for (size_t i = 0; i < sampleCount; ++i)
    {
        samples[i] = scaleSample(samples[i], gainValue);
    }

    currentStatus_.error = RuntimeAudioError::None;
    return RuntimeResult::Ok;
}

