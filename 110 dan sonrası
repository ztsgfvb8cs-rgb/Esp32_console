RuntimeScreenStatus RuntimeScreenRouter::currentStatus_ = {};
RuntimeScreenPolicy RuntimeScreenRouter::policy_ = {};
RuntimeScreenObserver RuntimeScreenRouter::observer_ = nullptr;

bool RuntimeScreenRouter::begin()
{
    if (currentStatus_.initialized)
    {
        return true;
    }

    currentStatus_ = {};
    policy_ = {};
    observer_ = nullptr;

    if (!DisplayDriver::ready())
    {
        currentStatus_.error =
            RuntimeScreenError::DisplayNotReady;

        return false;
    }

    if (!RuntimeModuleManager::ready() &&
        !RuntimeModuleManager::begin())
    {
        currentStatus_.error =
            RuntimeScreenError::ModuleManagerNotReady;

        return false;
    }

    if (!RuntimeSessionBridge::ready() &&
        !RuntimeSessionBridge::begin())
    {
        currentStatus_.error =
            RuntimeScreenError::SessionBridgeNotReady;

        return false;
    }

    currentStatus_.initialized = true;
    currentStatus_.dirty = true;
    currentStatus_.forceRequested = true;
    currentStatus_.refreshReason =
        RuntimeScreenRefreshReason::Startup;

    synchronizeStatus();

    Logger::info(
        LogSource::Display,
        "SCREEN_RT",
        "Runtime screen router ready");

    notifyStateChanged();

    return true;
}

void RuntimeScreenRouter::update(
    uint32_t nowMs,
    uint32_t nowUs)
{
    if (!currentStatus_.initialized ||
        currentStatus_.suspended)
    {
        return;
    }

    synchronizeStatus();

    if (periodicRefreshDue(nowMs))
    {
        currentStatus_.dirty = true;
        currentStatus_.refreshReason =
            RuntimeScreenRefreshReason::Periodic;

        currentStatus_.lastPeriodicRefreshAtMs =
            nowMs;

        if (!currentStatus_.foregroundOwned)
        {
            ScreenManager::invalidate();
        }
    }

    const RuntimeResult result =
        renderNow(nowMs, nowUs);

    if (result == RuntimeResult::Busy)
    {
        return;
    }
}

void RuntimeScreenRouter::end()
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    currentStatus_.initialized = false;
    currentStatus_.suspended = false;
    currentStatus_.dirty = false;
    currentStatus_.forceRequested = false;
    currentStatus_.rendering = false;
    currentStatus_.foregroundOwned = false;

    currentStatus_.mode =
        RuntimeScreenMode::None;

    currentStatus_.refreshReason =
        RuntimeScreenRefreshReason::None;

    currentStatus_.error =
        RuntimeScreenError::None;

    currentStatus_.moduleKind =
        RuntimeModuleKind::None;

    currentStatus_.moduleState =
        RuntimeModuleState::Stopped;

    observer_ = nullptr;
}

