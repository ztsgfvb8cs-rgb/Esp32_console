//---------------- Achievement Registration ----------------

bool registerAchievement(
    uint16_t achievementID,
    uint16_t gameID,
    const char* name,
    const char* description,
    AchievementCategory category,
    AchievementRarity rarity,
    uint32_t targetValue,
    uint16_t scoreValue,
    bool hidden
)
{
    if(!achievementManagerReady)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_INITIALIZED;


        return false;
    }


    if(achievementID ==
       ACHIEVEMENT_INVALID_ID)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_INVALID_ID;


        return false;
    }


    if(achievementExists(
        achievementID
    ))
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_ALREADY_EXISTS;


        return false;
    }


    if(achievementCount >=
       ACHIEVEMENT_MAX_COUNT)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_FULL;


        return false;
    }


    if(name == nullptr ||
       name[0] == '\0')
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_INVALID_NAME;


        return false;
    }


    AchievementRecord& record =
        achievementRecords[
            achievementCount
        ];


    clearAchievementRecordData(
        record
    );


    record.definition.achievementID =
        achievementID;


    record.definition.gameID =
        gameID;


    if(!copyAchievementText(
        record.definition.name,
        sizeof(record.definition.name),
        name
    ))
    {
        clearAchievementRecordData(
            record
        );


        achievementManagerStatus =
            ACHIEVEMENT_STATUS_INVALID_NAME;


        return false;
    }


    if(description != nullptr &&
       description[0] != '\0')
    {
        strncpy(
            record.definition.description,
            description,
            ACHIEVEMENT_DESCRIPTION_LENGTH - 1
        );


        record.definition.description[
            ACHIEVEMENT_DESCRIPTION_LENGTH - 1
        ] = '\0';
    }


    record.definition.category =
        category;


    record.definition.rarity =
        rarity;


    record.definition.targetValue =
        targetValue == 0 ?
        1 :
        targetValue;


    record.definition.scoreValue =
        scoreValue;


    record.definition.hidden =
        hidden;


    record.definition.enabled =
        true;


    record.definition.valid =
        true;


    record.progress.achievementID =
        achievementID;


    record.progress.currentValue =
        0;


    record.progress.progressPercent =
        0;


    record.progress.unlockedUnix =
        0;


    record.progress.unlocked =
        false;


    record.progress.notificationPending =
        false;


    record.progress.modified =
        true;


    record.progress.valid =
        true;


    achievementCount++;


    achievementManagerStatus =
        ACHIEVEMENT_STATUS_READY;


    return true;
}



bool unregisterAchievement(
    uint16_t achievementID
)
{
    int16_t index =
        findAchievementIndex(
            achievementID
        );


    if(index < 0)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    for(uint16_t i = index;
        i + 1 < achievementCount;
        i++)
    {
        achievementRecords[i] =
            achievementRecords[i + 1];
    }


    if(achievementCount > 0)
    {
        achievementCount--;


        clearAchievementRecordData(
            achievementRecords[
                achievementCount
            ]
        );
    }


    for(uint8_t i = 0;
        i < achievementTrackerCount;)
    {
        if(achievementTrackers[i].
               achievementID ==
           achievementID)
        {
            removeAchievementTracker(
                achievementTrackers[i].
                    trackerID
            );
        }
        else
        {
            i++;
        }
    }


    if(achievementNotification.active &&
       achievementNotification.achievementID ==
       achievementID)
    {
        stopAchievementNotification();
    }


    achievementManagerStatus =
        ACHIEVEMENT_STATUS_READY;


    return true;
}



void clearAchievements()
{
    for(uint16_t i = 0;
        i < ACHIEVEMENT_MAX_COUNT;
        i++)
    {
        clearAchievementRecordData(
