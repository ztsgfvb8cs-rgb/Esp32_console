RuntimeResult WavDecoder::skipCurrentPayload(
    uint32_t nowMs,
    size_t byteBudget)
{
    if (byteBudget == 0U)
    {
        return setError(
            WavDecoderError::Busy,
            RuntimeResult::Busy);
    }

    const size_t totalRemaining =
        static_cast<size_t>(
            currentChunkBytesRemaining_) +
        currentChunkPaddingBytes_;

    if (totalRemaining == 0U)
    {
        if (!idEquals(
                currentChunkId_,
                FMT_ID) &&

            !idEquals(
                currentChunkId_,
                DATA_ID))
        {
            status_.skippedChunkCount =
                saturatingIncrement32(
                    status_.
                        skippedChunkCount);
        }

        if (formatChunkFound_ &&
            dataChunkFound_)
        {
            headerPhase_ =
                HeaderPhase::Complete;

            return finalizeHeader();
        }

        headerPhase_ =
            HeaderPhase::ChunkHeader;

        return RuntimeResult::Ok;
    }

    const size_t boundedBudget =
        minimumSize(
            byteBudget,
            config_.
                sourceBufferCapacityBytes);

    const size_t step =
        minimumSize(
            totalRemaining,
            boundedBudget);

    const RuntimeResult result =
        skipSourceExact(
            nowMs,
            step);

    if (result != RuntimeResult::Ok)
    {
        return result;
    }

    status_.headerBytesScanned +=
        static_cast<uint32_t>(
            step);

    size_t consumed = step;

    const size_t payloadConsumed =
        minimumSize(
            consumed,
            currentChunkBytesRemaining_);

    currentChunkBytesRemaining_ -=
        static_cast<uint32_t>(
            payloadConsumed);

    consumed -= payloadConsumed;

    if (consumed > 0U)
    {
        currentChunkPaddingBytes_ =
            consumed >=
                    currentChunkPaddingBytes_
                ? 0U
                : static_cast<uint8_t>(
                    currentChunkPaddingBytes_ -
                    consumed);
    }

    if (currentChunkBytesRemaining_ == 0U &&
        currentChunkPaddingBytes_ == 0U)
    {
        if (!idEquals(
                currentChunkId_,
                FMT_ID) &&

            !idEquals(
                currentChunkId_,
                DATA_ID))
        {
            status_.skippedChunkCount =
                saturatingIncrement32(
                    status_.
                        skippedChunkCount);
        }

        if (formatChunkFound_ &&
            dataChunkFound_)
        {
            headerPhase_ =
                HeaderPhase::Complete;

            return finalizeHeader();
        }

        headerPhase_ =
            HeaderPhase::ChunkHeader;
    }

