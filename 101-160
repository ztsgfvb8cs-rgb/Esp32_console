//====================================================
// LIFECYCLE
//====================================================

bool BatteryManager::begin(bool sampleImmediately)
{
    if (currentStatus.initialized)
    {
        return ready();
    }

    clearStatus();

    if (!validateConfiguration())
    {
        currentStatus.error =
            BatteryError::INVALID_CONFIGURATION;

        return false;
    }

    if (!HardwareManager::ready() &&
        !HardwareManager::begin())
    {
        currentStatus.error =
            BatteryError::HARDWARE_INITIALIZATION_FAILED;

        return false;
    }

#if defined(ARDUINO_ARCH_ESP32)

    // A 1:2 divider presents at most about 2.1 V to the ADC.
    // Explicit 11 dB attenuation keeps that range measurable.
    analogSetPinAttenuation(
        BoardPins::BATTERY_ADC_PIN,
        ADC_11db);

#endif

    currentStatus.initialized = true;
    currentStatus.error = BatteryError::NONE;

    if (sampleImmediately && !forceSample())
    {
        currentStatus.initialized = false;
        return false;
    }

    return true;
}

void BatteryManager::update()
{
    if (!currentStatus.initialized)
    {
        return;
    }

    currentStatus.changed = false;

    if (currentStatus.sampling)
    {
        (void)collectOneSample();
        return;
    }

    const uint32_t now = millis();

    if (currentStatus.valid &&
        now - currentStatus.lastUpdateTime <
            BoardConfig::BATTERY_UPDATE_INTERVAL_MS)
    {
        return;
    }

    if (startSampling())
    {
        (void)collectOneSample();
    }
}

void BatteryManager::end()
{
    clearStatus();
}

bool BatteryManager::ready()
{
    return
        currentStatus.initialized &&
        currentStatus.error == BatteryError::NONE;
}

BatteryStatus BatteryManager::status()
{
    return currentStatus;
}

//====================================================
// SAMPLING
//====================================================

bool BatteryManager::forceSample()
{
    if (!currentStatus.initialized)
    {
        return false;
    }

    resetSampler();
    currentStatus.sampling = true;

    for (uint8_t index = 0;
         index < BoardConfig::BATTERY_SAMPLE_COUNT;
         ++index)
    {
        const int rawValue =
            HardwareManager::rawBatteryAdc();

        if (rawValue < 0 ||
            rawValue >
                static_cast<int>(
                    BoardConfig::BATTERY_ADC_MAX_VALUE))
        {
            resetSampler();
            currentStatus.error =
                BatteryError::ADC_READ_FAILED;

            return false;
        }

        sampleAccumulator +=
            static_cast<uint16_t>(rawValue);

        ++collectedSampleCount;
    }

    return finishSampling();
}

