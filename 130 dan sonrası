    {
        return setError(
            PsramPoolError::AlreadyInitialized,
            RuntimeResult::Busy);
    }

    PsramPoolError validationError =
        PsramPoolError::None;

    if (!validateConfig(config, &validationError))
    {
        return setError(
            validationError,
            RuntimeResult::InvalidArgument);
    }

    if (!MemoryManager::begin())
    {
        return setError(
            PsramPoolError::BackingAllocationFailed,
            RuntimeResult::NotReady);
    }

    if ((config.requirePsram ||
         config.preference == MemoryPreference::PsramOnly) &&
        !MemoryManager::psramAvailable())
    {
        return setError(
            PsramPoolError::PsramUnavailable,
            RuntimeResult::NotReady);
    }

    const uint32_t generation =
        nextGeneration(status_.generation);

    resetMetadata(true);

    status_.generation = generation;
    status_.preference = config.preference;
    status_.classCount = config.classCount;
    config_ = config;

    uint16_t nextSlot = 0;

    for (uint8_t classIndex = 0;
         classIndex < config_.classCount;
         ++classIndex)
