RuntimeRecoveryAction
RuntimeHealthCoordinator::defaultRecoveryAction(
    RuntimeHealthSubsystem subsystem,
    RuntimeHealthError error)
{
    if (error ==
            RuntimeHealthError::
                LowInternalMemory ||
        error == RuntimeHealthError::LowPsram)
    {
        return policy_.
                requestShutdownOnCriticalMemory
            ? RuntimeRecoveryAction::
                RequestSafeShutdown
            : RuntimeRecoveryAction::
                ForceForegroundClose;
    }

    switch (subsystem)
    {
        case RuntimeHealthSubsystem::
                ModuleManager:

        case RuntimeHealthSubsystem::
                SessionBridge:
            return RuntimeRecoveryAction::
                ForceForegroundClose;

        case RuntimeHealthSubsystem::
                InputRouter:
            return RuntimeRecoveryAction::
                ClearTransientInput;

        case RuntimeHealthSubsystem::
                ScreenRouter:
            return RuntimeRecoveryAction::
                ResetScreenRoute;

        case RuntimeHealthSubsystem::
                AudioCoordinator:
            return RuntimeRecoveryAction::
                SuspendAudio;

        case RuntimeHealthSubsystem::
                PowerCoordinator:
            return RuntimeRecoveryAction::
                RequestSafeShutdown;

        case RuntimeHealthSubsystem::
                InternalMemory:

        case RuntimeHealthSubsystem::Psram:
            return RuntimeRecoveryAction::
                RequestForegroundClose;

        case RuntimeHealthSubsystem::System:
            return RuntimeRecoveryAction::
                EnterFatalState;

        case RuntimeHealthSubsystem::None:
        default:
            return RuntimeRecoveryAction::None;
    }
}

RuntimeResult
RuntimeHealthCoordinator::executeRecoveryAction(
    RuntimeRecoveryAction action,
    uint32_t nowMs)
{
    switch (action)
    {
        case RuntimeRecoveryAction::
                ClearTransientInput:
            RuntimeInputRouter::
                clearTransientStates();

            RuntimeInputRouter::
                resetAllActions();

            if (RuntimeInputRouter::lastError() !=
                RuntimeInputError::None)
            {
                RuntimeInputRouter::end();

                if (!RuntimeInputRouter::begin())
                {
                    return RuntimeResult::NotReady;
                }
            }

            return RuntimeResult::Ok;

        case RuntimeRecoveryAction::
                RequestForegroundClose:
            if (!RuntimeSessionBridge::
                    sessionActive() &&
                !RuntimeModuleManager::
                    foregroundActive())
            {
                return RuntimeResult::Ok;
            }

            return RuntimeSessionBridge::
                requestClose(
                    RuntimeSessionExitReason::
                        Recovery);

        case RuntimeRecoveryAction::
                ForceForegroundClose:
        {
            RuntimeResult result =
                RuntimeResult::Ok;

            if (RuntimeSessionBridge::
                    sessionActive())
            {
                result =
                    RuntimeSessionBridge::
                        closeImmediately(
                            RuntimeSessionExitReason::
                                Recovery,
                            policy_.
                                returnToMainMenuAfterRecovery);
            }
            else if (
                RuntimeModuleManager::
                    foregroundActive() ||
                RuntimeModuleManager::state() ==
                    RuntimeModuleState::Failed)
            {
                result =
                    RuntimeModuleManager::
                        closeForeground();
            }

            RuntimeInputRouter::
                resetAllActions();

            return result;
        }

        case RuntimeRecoveryAction::
                ResetScreenRoute:
            RuntimeScreenRouter::
                requestImmediateRender(
                    RuntimeScreenRefreshReason::
                        Recovery);

            if (RuntimeSessionBridge::
                    sessionActive())
            {
                return RuntimeResult::Ok;
            }

            ScreenManager::invalidate();

            return RuntimeResult::Ok;

        case RuntimeRecoveryAction::SuspendAudio:
            RuntimeAudioCoordinator::
                setSuspended(true);

            RuntimeAudioCoordinator::end();

            if (!RuntimeAudioCoordinator::begin())
            {
                return RuntimeResult::NotReady;
            }

            RuntimeAudioCoordinator::
                setSuspended(false);

            return RuntimeResult::Ok;

        case RuntimeRecoveryAction::RestoreAudio:
            if (!RuntimeAudioCoordinator::ready())
            {
                if (!RuntimeAudioCoordinator::begin())
                {
                    return RuntimeResult::NotReady;
                }
            }

            RuntimeAudioCoordinator::
                setSuspended(false);

            return RuntimeResult::Ok;

        case RuntimeRecoveryAction::
                ReturnToMainMenu:
        {
            if (RuntimeSessionBridge::
                    sessionActive())
            {
                const RuntimeResult closeResult =
                    RuntimeSessionBridge::
                        closeImmediately(
                            RuntimeSessionExitReason::
                                Recovery,
                            false);

                if (closeResult !=
                    RuntimeResult::Ok)
                {
                    return closeResult;
                }
            }

            RuntimeInputRouter::
                resetAllActions();

            RuntimeContext::setScreen(
                AppScreen::MainMenu);

            RuntimeContext::setEngine(
                EngineKind::None);

            ScreenManager::navigate(
                AppScreen::MainMenu);

            ScreenManager::invalidate();

            RuntimeScreenRouter::
                requestImmediateRender(
                    RuntimeScreenRefreshReason::
                        Recovery);

            return RuntimeResult::Ok;
        }

        case RuntimeRecoveryAction::
                RequestSafeShutdown:
            return RuntimePowerCoordinator::
                requestShutdown(
                    ShutdownReason::
                        InternalError,
                    nowMs);

        case RuntimeRecoveryAction::
                EnterFatalState:
            RuntimeContext::setFatalError(true);

            if (RuntimeSessionBridge::
                    sessionActive())
            {
                RuntimeSessionBridge::
                    closeImmediately(
                        RuntimeSessionExitReason::
                            Recovery,
                        false);
            }
            else if (
                RuntimeModuleManager::
                    foregroundActive())
            {
                RuntimeModuleManager::
                    closeForeground();
            }

            RuntimeInputRouter::
                resetAllActions();

            RuntimeAudioCoordinator::
                setSuspended(true);

            RuntimeContext::setScreen(
                AppScreen::Error);

            ScreenManager::navigate(
                AppScreen::Error);

            ScreenManager::invalidate();

            RuntimeScreenRouter::
                requestImmediateRender(
                    RuntimeScreenRefreshReason::
                        Recovery);

            currentStatus_.fatalState = true;

            currentStatus_.level =
                RuntimeHealthLevel::Fatal;

            currentStatus_.error =
                RuntimeHealthError::
                    FatalRuntimeState;

            return RuntimeResult::Ok;

        case RuntimeRecoveryAction::None:
        default:
            return RuntimeResult::Unsupported;
    }
}

void RuntimeHealthCoordinator::markHealthy()
{
    if (currentStatus_.recoveryPending ||
        currentStatus_.recoveryInProgress ||
        currentStatus_.fatalState)
    {
        return;
    }

    if (currentStatus_.
            consecutiveHealthySamples <
        UINT8_MAX)
    {
        ++currentStatus_.
            consecutiveHealthySamples;
    }

    if (currentStatus_.
            consecutiveHealthySamples <
        HEALTHY_SAMPLES_TO_CLEAR)
    {
        if (currentStatus_.level ==
            RuntimeHealthLevel::Recovering)
        {
            return;
        }

        if (currentStatus_.error ==
            RuntimeHealthError::None)
        {
            currentStatus_.level =
                RuntimeHealthLevel::Healthy;
        }

        return;
    }

    currentStatus_.level =
        RuntimeHealthLevel::Healthy;

    currentStatus_.subsystem =
        RuntimeHealthSubsystem::None;

    currentStatus_.pendingAction =
        RuntimeRecoveryAction::None;

    currentStatus_.error =
        RuntimeHealthError::None;

    currentStatus_.lastResult =
        RuntimeResult::Ok;

    currentStatus_.recoveryAttempts = 0;
}

RuntimeResult RuntimeHealthCoordinator::fail(
    RuntimeHealthSubsystem subsystem,
    RuntimeHealthError error,
    RuntimeResult result,
    RuntimeRecoveryAction action)
{
    currentStatus_.subsystem = subsystem;
    currentStatus_.error = error;
    currentStatus_.lastResult = result;

    currentStatus_.
        consecutiveHealthySamples = 0;

    if (action == RuntimeRecoveryAction::None)
    {
        action =
            defaultRecoveryAction(
                subsystem,
                error);
    }

    if (action != RuntimeRecoveryAction::None &&
        policy_.recoverForegroundAutomatically)
    {
        currentStatus_.pendingAction = action;
        currentStatus_.recoveryPending = true;
    }

    if (action ==
            RuntimeRecoveryAction::
                EnterFatalState ||
        error ==
            RuntimeHealthError::
                FatalRuntimeState ||
        error ==
            RuntimeHealthError::
                RecoveryLimitReached)
    {
        currentStatus_.level =
            RuntimeHealthLevel::Fatal;
    }
    else if (
        isCriticalMemoryError(error) ||
        subsystem ==
            RuntimeHealthSubsystem::
                PowerCoordinator)
    {
        currentStatus_.level =
            RuntimeHealthLevel::Critical;
    }
    else
    {
        currentStatus_.level =
            RuntimeHealthLevel::Degraded;
    }

    if (Logger::ready())
    {
        if (currentStatus_.level ==
                RuntimeHealthLevel::Fatal ||
            currentStatus_.level ==
                RuntimeHealthLevel::Critical)
        {
            Logger::error(
                LogSource::System,
                "HEALTH_RT",
                errorText(error));
        }
        else
        {
            Logger::warning(
                LogSource::System,
                "HEALTH_RT",
                errorText(error));
        }
    }

    notifyStateChanged();

    return result;
}

void RuntimeHealthCoordinator::
    notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(currentStatus_);
    }
}
