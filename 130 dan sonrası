RuntimeResult I2sAudioBackend::applyRoute(
    AudioRoute routeValue,
    bool forceMute)
{
    if (!validRoute(routeValue))
    {
        return setError(
            I2sAudioBackendError::InvalidRoute,
            RuntimeResult::InvalidArgument);
    }

    const bool effectiveMute =
        forceMute ||
        routeValue == AudioRoute::Muted;

    const bool speakerEnabled =
        !effectiveMute &&
        routeValue == AudioRoute::Speaker;

    const bool headphoneEnabled =
        !effectiveMute &&
        routeValue == AudioRoute::Headphones;

    const bool routeChanged =
        currentStatus_.route != routeValue ||
        currentStatus_.muted != effectiveMute;

    setEnablePin(
        config_.speakerEnablePin,
        config_.speakerEnableActiveHigh,
        speakerEnabled);

    setEnablePin(
        config_.headphoneEnablePin,
        config_.headphoneEnableActiveHigh,
        headphoneEnabled);

    if (routeChanged &&
        config_.routeSettleTimeMs > 0U)
    {
        platformDelay(config_.routeSettleTimeMs);
    }

    currentStatus_.route = routeValue;
    currentStatus_.muted = effectiveMute;
    currentStatus_.error =
        I2sAudioBackendError::None;

    if (routeChanged)
    {
        currentStatus_.routeChangeCount =
            saturatingIncrement32(
                currentStatus_.routeChangeCount);
    }

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult I2sAudioBackend::setError(
    I2sAudioBackendError error,
    RuntimeResult result)
{
    currentStatus_.error = error;
    notifyStateChanged();

    return result;
}

void I2sAudioBackend::refreshStatus()
{
    currentStatus_.format = config_.format;
    currentStatus_.dmaBufferCount =
        currentStatus_.initialized ||
                currentStatus_.driverInstalled
            ? config_.dmaBufferCount
            : 0U;
    currentStatus_.dmaFramesPerBuffer =
        currentStatus_.initialized ||
                currentStatus_.driverInstalled
            ? config_.dmaFramesPerBuffer
            : 0U;
    currentStatus_.dmaCapacityFrames =
        static_cast<size_t>(
            currentStatus_.dmaBufferCount) *
        currentStatus_.dmaFramesPerBuffer;
    currentStatus_.budgetReserved =
        static_cast<bool>(budgetHandle_);

    if (!currentStatus_.budgetReserved)
    {
        currentStatus_.reservedInternalBytes = 0;
    }
}

void I2sAudioBackend::notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(currentStatus_);
    }
}
