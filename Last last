bool savePlayerProfile(
    const PlayerProfile& profile
)
{
    if(!validateStoredProfile(
        profile
    ))
    {
        profileStorageStatus =
            PROFILE_STORAGE_INVALID_FILE;


        return false;
    }


    if(!createProfileStorageFolder())
    {
        profileStorageStatus =
            PROFILE_STORAGE_FOLDER_ERROR;


        return false;
    }


    char profilePath[
        PROFILE_FILE_PATH_LENGTH
    ];


    char backupPath[
        PROFILE_FILE_PATH_LENGTH
    ];


    if(!buildProfileFilePath(
        profile.profileID,
        profilePath,
        sizeof(profilePath)
    ))
    {
        profileStorageStatus =
            PROFILE_STORAGE_FILE_ERROR;


        return false;
    }


    if(!buildProfileBackupPath(
        profile.profileID,
        backupPath,
        sizeof(backupPath)
    ))
    {
        profileStorageStatus =
            PROFILE_STORAGE_FILE_ERROR;


        return false;
    }


    if(SD.exists(
        PROFILE_STORAGE_TEMP_FILE
    ))
    {
        SD.remove(
            PROFILE_STORAGE_TEMP_FILE
        );
    }


    if(!writeProfileFile(
        PROFILE_STORAGE_TEMP_FILE,
        profile
    ))
    {
        profileStorageStatus =
            PROFILE_STORAGE_WRITE_ERROR;


        return false;
    }


    if(SD.exists(
        profilePath
    ))
    {
        if(SD.exists(
            backupPath
        ))
        {
            SD.remove(
                backupPath
            );
        }


        if(!copyProfileFile(
            profilePath,
            backupPath
        ))
        {
            SD.remove(
                PROFILE_STORAGE_TEMP_FILE
            );


            profileStorageStatus =
                PROFILE_STORAGE_BACKUP_ERROR;


            return false;
        }


        if(!SD.remove(
            profilePath
        ))
        {
            SD.remove(
                PROFILE_STORAGE_TEMP_FILE
            );


            profileStorageStatus =
                PROFILE_STORAGE_DELETE_ERROR;


            return false;
        }
    }


    if(!SD.rename(
        PROFILE_STORAGE_TEMP_FILE,
        profilePath
    ))
    {
        if(SD.exists(
            backupPath
        ))
        {
            copyProfileFile(
                backupPath,
                profilePath
            );
        }


        SD.remove(
            PROFILE_STORAGE_TEMP_FILE
        );


        profileStorageStatus =
            PROFILE_STORAGE_WRITE_ERROR;


        return false;
    }


    uint32_t currentUnix =
        getProfileStorageUnixTime();


    if(!updateProfileIndexEntry(
        profile,
        currentUnix
    ))
    {
        return false;
    }


    if(!saveProfileIndex())
    {
        profileStorageStatus =
            PROFILE_STORAGE_WRITE_ERROR;


        return false;
    }


    if(isPlayerProfileInitialized() &&
       getPlayerProfileID() == profile.profileID)
    {
        clearProfileModified();
    }


    profileStorageReady =
        true;


    profileStorageStatus =
        PROFILE_STORAGE_READY;


    return true;
}



