//---------------- Achievement Unlock ----------------

bool unlockAchievement(
    uint16_t achievementID
)
{
    AchievementRecord* record =
        findMutableAchievement(
            achievementID
        );


    if(record == nullptr)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    if(!record->definition.enabled)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_LOCKED;


        return false;
    }


    if(record->progress.unlocked)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_ALREADY_UNLOCKED;


        return true;
    }


    record->progress.currentValue =
        record->definition.targetValue;


    record->progress.progressPercent =
        ACHIEVEMENT_PROGRESS_COMPLETE;


    record->progress.unlockedUnix =
        getAchievementUnixTime();


    record->progress.unlocked =
        true;


    record->progress.notificationPending =
        true;


    record->progress.modified =
        true;


    if(isPlayerProfileInitialized())
    {
        incrementProfileAchievementCount();
    }


    if(!achievementNotification.active)
    {
        startAchievementNotification(
            achievementID
        );
    }


    for(uint8_t i = 0;
        i < achievementTrackerCount;
        i++)
    {
        if(achievementTrackers[i].valid &&
           achievementTrackers[i].
               achievementID ==
               achievementID)
        {
            synchronizeTrackerWithAchievement(
                achievementTrackers[i]
            );


            achievementTrackers[i].active =
                false;
        }
    }


    achievementManagerStatus =
        ACHIEVEMENT_STATUS_READY;


    return true;
}



bool lockAchievement(
    uint16_t achievementID
)
{
    AchievementRecord* record =
        findMutableAchievement(
            achievementID
        );


    if(record == nullptr)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    bool wasUnlocked =
        record->progress.unlocked;


    record->progress.currentValue =
        0;


    record->progress.progressPercent =
        0;


    record->progress.unlockedUnix =
        0;


    record->progress.unlocked =
        false;


    record->progress.notificationPending =
        false;


    record->progress.modified =
        true;


    if(wasUnlocked &&
       isPlayerProfileInitialized())
    {
        uint16_t achievementTotal =
            getProfileAchievementCount();


        if(achievementTotal > 0)
        {
            setProfileAchievementCount(
                achievementTotal - 1
            );
        }
    }


    if(achievementNotification.active &&
       achievementNotification.achievementID ==
       achievementID)
    {
        stopAchievementNotification();
    }


    for(uint8_t i = 0;
        i < achievementTrackerCount;
        i++)
    {
        if(achievementTrackers[i].valid &&
           achievementTrackers[i].
               achievementID ==
               achievementID)
        {
            synchronizeTrackerWithAchievement(
                achievementTrackers[i]
            );
        }
    }


    achievementManagerStatus =
        ACHIEVEMENT_STATUS_READY;


    return true;
}



bool checkAchievementUnlock(
    uint16_t achievementID
)
{
    AchievementRecord* record =
        findMutableAchievement(
            achievementID
        );


    if(record == nullptr)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    if(record->progress.unlocked)
    {
        return true;
    }


    if(record->progress.currentValue >=
       record->definition.targetValue)
    {
        return unlockAchievement(
            achievementID
        );
    }


    return false;
}



