bool StatisticsManager::submitValue(
    const String& id,
    int64_t submittedValue
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    StatisticInfo& statistic =
        statistics[index];

    if (statistic.type != STATISTIC_HIGH_SCORE &&
        statistic.type != STATISTIC_LOW_SCORE)
    {
        return false;
    }

    bool changed =
        statistic.value != submittedValue;

    bool bestWasInitialized =
        statistic.bestInitialized;

    int64_t previousBest =
        statistic.bestValue;

    statistic.value = submittedValue;

    evaluateBest(
        statistic,
        submittedValue
    );

    if (!changed &&
        bestWasInitialized ==
            statistic.bestInitialized &&
        previousBest ==
            statistic.bestValue)
    {
        return true;
    }

    statistic.updatedAt = getTimestamp();

    if (statistic.persistent)
        markDirty();

    return true;
}

bool StatisticsManager::reset(
    const String& id
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    StatisticInfo& statistic =
        statistics[index];

    int64_t previousValue =
        statistic.value;

    int64_t previousBest =
        statistic.bestValue;

    bool previousBestInitialized =
        statistic.bestInitialized;

    statistic.value =
        statistic.defaultValue;

    resetBestState(statistic);

    bool changed =
        previousValue != statistic.value ||
        previousBest != statistic.bestValue ||
        previousBestInitialized !=
            statistic.bestInitialized;

    if (!changed)
        return true;

    statistic.updatedAt = getTimestamp();

    if (statistic.persistent)
        markDirty();

    return true;
}

void StatisticsManager::resetBySource(
    const String& source
)
{
    if (!initialized ||
        !validSource(source))
    {
        return;
    }

    bool persistentChanged = false;

    for (uint16_t i = 0;
         i < statisticCount;
         i++)
    {
        StatisticInfo& statistic =
            statistics[i];

        if (!statistic.valid ||
            statistic.source != source)
        {
            continue;
        }

        int64_t previousValue =
            statistic.value;

        int64_t previousBest =
            statistic.bestValue;

        bool previousBestInitialized =
            statistic.bestInitialized;

        statistic.value =
            statistic.defaultValue;

        resetBestState(statistic);

        bool changed =
            previousValue != statistic.value ||
            previousBest != statistic.bestValue ||
            previousBestInitialized !=
                statistic.bestInitialized;

        if (!changed)
            continue;

        statistic.updatedAt = getTimestamp();

        if (statistic.persistent)
            persistentChanged = true;
    }

    if (persistentChanged)
        markDirty();
}

void StatisticsManager::resetAll()
{
    if (!initialized)
        return;

    bool persistentChanged = false;

    for (uint16_t i = 0;
         i < statisticCount;
         i++)
    {
        StatisticInfo& statistic =
            statistics[i];

        if (!statistic.valid)
            continue;

        int64_t previousValue =
            statistic.value;

        int64_t previousBest =
            statistic.bestValue;

        bool previousBestInitialized =
            statistic.bestInitialized;

        statistic.value =
            statistic.defaultValue;

        resetBestState(statistic);

        bool changed =
            previousValue != statistic.value ||
            previousBest != statistic.bestValue ||
            previousBestInitialized !=
                statistic.bestInitialized;

        if (!changed)
            continue;

        statistic.updatedAt = getTimestamp();

        if (statistic.persistent)
            persistentChanged = true;
    }

    if (persistentChanged)
        markDirty();
}

