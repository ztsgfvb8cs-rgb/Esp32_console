    StreamRingBufferOverflowPolicy
        overflowPolicy() const;

    void setObserver(
        StreamRingBufferObserver observer);

    StreamRingBufferError lastError() const;

    void clearError();

    static const char* errorText(
        StreamRingBufferError value);

private:
    MemoryBlock backing_ = {};
    StreamRingBufferConfig config_ = {};
    StreamRingBufferStatus status_ = {};

    size_t readOffset_ = 0;
    size_t writeOffset_ = 0;
    size_t usedBytes_ = 0;

