        status_.riffDeclaredSizeBytes >
            status_.fileSizeBytes)
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                TruncatedDataChunk,
            RuntimeResult::CorruptData);
