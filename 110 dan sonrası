void RuntimeHealthCoordinator::
    synchronizeCoordinatorState(
        uint32_t nowMs)
{
    const RuntimeModuleStatus moduleStatus =
        RuntimeModuleManager::status();

    const RuntimeSessionStatus sessionStatus =
        RuntimeSessionBridge::status();

    const RuntimeInputStatus inputStatus =
        RuntimeInputRouter::status();

    const RuntimeScreenStatus screenStatus =
        RuntimeScreenRouter::status();

    const RuntimeAudioCoordinatorStatus audioStatus =
        RuntimeAudioCoordinator::status();

    const RuntimePowerCoordinatorStatus powerStatus =
        RuntimePowerCoordinator::status();

    currentStatus_.foregroundActive =
        moduleStatus.foregroundActive ||
        sessionStatus.active;

    currentStatus_.moduleKind =
        moduleStatus.kind;

    currentStatus_.moduleState =
        moduleStatus.state;

    currentStatus_.moduleError =
        moduleStatus.error;

    currentStatus_.sessionError =
        sessionStatus.error;

    currentStatus_.inputError =
        inputStatus.error;

    currentStatus_.screenError =
        screenStatus.error;

    currentStatus_.audioError =
        audioStatus.error;

    currentStatus_.powerError =
        powerStatus.error;

    if (moduleStatus.transitionSequence !=
        currentStatus_.
            observedTransitionSequence)
    {
        currentStatus_.
            observedTransitionSequence =
                moduleStatus.transitionSequence;

        currentStatus_.stateEnteredAtMs =
            nowMs;
    }
}

void RuntimeHealthCoordinator::refreshMemoryState()
{
    SystemMonitor::update(millis());

    const SystemSnapshot snapshot =
        SystemMonitor::snapshot();

    currentStatus_.freeInternalBytes =
        static_cast<size_t>(
            snapshot.freeHeap);

    currentStatus_.freePsramBytes =
        static_cast<size_t>(
            snapshot.freePsram);
}

RuntimeResult
RuntimeHealthCoordinator::evaluateHealth(
    uint32_t nowMs)
{
    RuntimeResult result =
        evaluateMemory();

    if (result != RuntimeResult::Ok)
    {
        return result;
    }

    result = evaluateForeground(nowMs);

    if (result != RuntimeResult::Ok)
    {
        return result;
    }

    result = evaluateCoordinators();

    if (result != RuntimeResult::Ok)
    {
        return result;
    }

    markHealthy();

    return RuntimeResult::Ok;
}

RuntimeResult
RuntimeHealthCoordinator::evaluateMemory()
{
    const bool internalSampleValid =
        currentStatus_.freeInternalBytes > 0;

    const bool internalCritical =
        internalSampleValid &&
        currentStatus_.freeInternalBytes <
            policy_.criticalInternalFreeBytes;

    const bool internalLow =
        internalSampleValid &&
        currentStatus_.freeInternalBytes <
            policy_.minimumInternalFreeBytes;

    const bool psramChecksEnabled =
        MemoryManager::psramAvailable();

    const bool psramSampleValid =
        currentStatus_.freePsramBytes > 0;

    const bool psramCritical =
        psramChecksEnabled &&
        psramSampleValid &&
        currentStatus_.freePsramBytes <
            policy_.criticalPsramFreeBytes;

    const bool psramLow =
        psramChecksEnabled &&
        psramSampleValid &&
        currentStatus_.freePsramBytes <
            policy_.minimumPsramFreeBytes;

    if (internalCritical)
    {
        const RuntimeRecoveryAction action =
            policy_.
                requestShutdownOnCriticalMemory
                ? RuntimeRecoveryAction::
                    RequestSafeShutdown
                : RuntimeRecoveryAction::
                    ForceForegroundClose;

        return fail(
            RuntimeHealthSubsystem::
                InternalMemory,
            RuntimeHealthError::
                LowInternalMemory,
            RuntimeResult::OutOfMemory,
            action);
    }

    if (psramCritical)
    {
        const RuntimeRecoveryAction action =
            policy_.
                requestShutdownOnCriticalMemory
                ? RuntimeRecoveryAction::
                    RequestSafeShutdown
                : RuntimeRecoveryAction::
                    ForceForegroundClose;

        return fail(
            RuntimeHealthSubsystem::Psram,
            RuntimeHealthError::LowPsram,
            RuntimeResult::OutOfMemory,
            action);
    }

    if (internalLow)
    {
        if (currentStatus_.foregroundActive)
        {
            return fail(
                RuntimeHealthSubsystem::
                    InternalMemory,
                RuntimeHealthError::
                    LowInternalMemory,
                RuntimeResult::OutOfMemory,
                RuntimeRecoveryAction::
                    RequestForegroundClose);
        }

        currentStatus_.level =
            RuntimeHealthLevel::Degraded;

        currentStatus_.subsystem =
            RuntimeHealthSubsystem::
                InternalMemory;

        currentStatus_.error =
            RuntimeHealthError::
                LowInternalMemory;

        currentStatus_.lastResult =
            RuntimeResult::OutOfMemory;

        currentStatus_.
            consecutiveHealthySamples = 0;

        return RuntimeResult::Ok;
    }

    if (psramLow)
    {
        if (currentStatus_.foregroundActive)
        {
            return fail(
                RuntimeHealthSubsystem::Psram,
                RuntimeHealthError::LowPsram,
                RuntimeResult::OutOfMemory,
                RuntimeRecoveryAction::
                    RequestForegroundClose);
        }

        currentStatus_.level =
            RuntimeHealthLevel::Degraded;

        currentStatus_.subsystem =
            RuntimeHealthSubsystem::Psram;

        currentStatus_.error =
            RuntimeHealthError::LowPsram;

        currentStatus_.lastResult =
            RuntimeResult::OutOfMemory;

        currentStatus_.
            consecutiveHealthySamples = 0;
    }

    return RuntimeResult::Ok;
}

RuntimeResult
RuntimeHealthCoordinator::evaluateForeground(
    uint32_t nowMs)
{
    const RuntimeModuleStatus moduleStatus =
        RuntimeModuleManager::status();

    const RuntimeSessionStatus sessionStatus =
        RuntimeSessionBridge::status();

    if (moduleStatus.foregroundActive !=
        sessionStatus.active)
    {
        return fail(
            RuntimeHealthSubsystem::
                SessionBridge,
            RuntimeHealthError::
                ForegroundStateMismatch,
            RuntimeResult::InternalError,
            RuntimeRecoveryAction::
                ForceForegroundClose);
    }

    if (moduleStatus.foregroundActive &&
        (moduleStatus.kind !=
             sessionStatus.moduleKind ||
         moduleStatus.engine !=
             sessionStatus.engine))
    {
        return fail(
            RuntimeHealthSubsystem::
                SessionBridge,
            RuntimeHealthError::
                ForegroundStateMismatch,
            RuntimeResult::InternalError,
            RuntimeRecoveryAction::
                ForceForegroundClose);
    }

    if (transitionTimedOut(
            moduleStatus.state,
            nowMs,
            currentStatus_.stateEnteredAtMs,
            policy_))
    {
        return fail(
            RuntimeHealthSubsystem::
                ModuleManager,
            RuntimeHealthError::
                SessionStalled,
            RuntimeResult::Busy,
            moduleStatus.state ==
                    RuntimeModuleState::Stopping
                ? RuntimeRecoveryAction::
                    ForceForegroundClose
                : RuntimeRecoveryAction::
                    RequestForegroundClose);
    }

    if (moduleStatus.state ==
            RuntimeModuleState::Failed ||
        moduleStatus.error !=
            RuntimeModuleError::None ||
        sessionStatus.error ==
            RuntimeSessionError::BackendFailed)
    {
        return fail(
            RuntimeHealthSubsystem::
                ModuleManager,
            RuntimeHealthError::
                SessionStalled,
            RuntimeResult::InternalError,
            RuntimeRecoveryAction::
                ForceForegroundClose);
    }

    return RuntimeResult::Ok;
}

RuntimeResult
RuntimeHealthCoordinator::evaluateCoordinators()
{
    if (!RuntimeModuleManager::ready() ||
        !RuntimeSessionBridge::ready() ||
        !RuntimeInputRouter::ready() ||
        !RuntimeScreenRouter::ready() ||
        !RuntimeAudioCoordinator::ready() ||
        !RuntimePowerCoordinator::ready())
    {
        return fail(
            RuntimeHealthSubsystem::System,
            RuntimeHealthError::
                RequiredCoordinatorNotReady,
            RuntimeResult::NotReady,
            RuntimeRecoveryAction::
                EnterFatalState);
    }

    const RuntimeInputStatus inputStatus =
        RuntimeInputRouter::status();

    if (inputStatus.error !=
        RuntimeInputError::None)
    {
        return fail(
            RuntimeHealthSubsystem::
                InputRouter,
            RuntimeHealthError::
                InputRoutingFailure,
            RuntimeResult::InternalError,
            RuntimeRecoveryAction::
                ClearTransientInput);
    }

    const RuntimeScreenStatus screenStatus =
        RuntimeScreenRouter::status();

    if (screenStatus.error !=
            RuntimeScreenError::None ||
        screenStatus.consecutiveFailures >=
            policy_.
                maximumConsecutiveRenderFailures)
    {
        return fail(
            RuntimeHealthSubsystem::
                ScreenRouter,
            RuntimeHealthError::
                RepeatedRenderFailure,
            RuntimeResult::InternalError,
            RuntimeRecoveryAction::
                ResetScreenRoute);
    }

    const RuntimeAudioCoordinatorStatus
        audioStatus =
            RuntimeAudioCoordinator::status();

    if (audioStatus.error !=
        RuntimeAudioError::None)
    {
        return fail(
            RuntimeHealthSubsystem::
                AudioCoordinator,
            RuntimeHealthError::
                AudioPolicyFailure,
            RuntimeResult::InternalError,
            RuntimeRecoveryAction::
                SuspendAudio);
    }

    const RuntimePowerCoordinatorStatus
        powerStatus =
            RuntimePowerCoordinator::status();

    if (powerStatus.error !=
        RuntimePowerError::None)
    {
        return fail(
            RuntimeHealthSubsystem::
                PowerCoordinator,
            RuntimeHealthError::
                PowerPolicyFailure,
            RuntimeResult::InternalError,
            RuntimeRecoveryAction::
                RequestSafeShutdown);
    }

    return RuntimeResult::Ok;
}
