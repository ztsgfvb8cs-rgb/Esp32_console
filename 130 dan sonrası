uint32_t nextGeneration(uint32_t current)
{
    return current == UINT32_MAX
        ? 1U
        : current + 1U;
}

uint32_t saturatingIncrement32(uint32_t value)
{
    return value == UINT32_MAX
        ? UINT32_MAX
        : value + 1U;
}

uint64_t saturatingAdd64(
    uint64_t first,
    uint64_t second)
{
    return second > UINT64_MAX - first
        ? UINT64_MAX
        : first + second;
}

size_t minimumSize(
    size_t first,
    size_t second)
{
    return first < second
        ? first
        : second;
}

bool idEquals(
    const uint8_t* value,
    const uint8_t* expected)
{
    return
        value != nullptr &&
        expected != nullptr &&
        memcmp(value, expected, 4U) == 0;
}

size_t boundedStringLength(
    const char* text,
    size_t capacity)
{
    if (text == nullptr)
    {
        return 0U;
    }

    size_t length = 0U;

    while (length < capacity &&
           text[length] != '\0')
    {
        ++length;
    }

    return length;
}

bool validMemoryPreference(
    MemoryPreference preference)
{
    switch (preference)
    {
        case MemoryPreference::InternalOnly:
        case MemoryPreference::PsramPreferred:
        case MemoryPreference::PsramOnly:
            return true;

        default:
            return false;
    }
}

bool extensibleGuidSuffixValid(
    const uint8_t* bytes)
{
    static constexpr uint8_t suffix[12] = {
        0x00U, 0x00U,
        0x10U, 0x00U,
        0x80U, 0x00U, 0x00U, 0xAAU,
        0x00U, 0x38U, 0x9BU, 0x71U
    };

    return
        bytes != nullptr &&
        bytes[2] == 0U &&
        bytes[3] == 0U &&
        memcmp(
            bytes + 4U,
            suffix,
            sizeof(suffix)) == 0;
}
}

