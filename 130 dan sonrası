    {
        return setError(
            PsramPoolError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!block ||
        block.slotIndex == PSRAM_POOL_INVALID_SLOT ||
        block.classIndex == PSRAM_POOL_INVALID_CLASS ||
        block.leaseId == 0 ||
        !validClearMode(clearMode))
    {
        return setError(
            PsramPoolError::InvalidBlock,
            RuntimeResult::InvalidArgument);
