RuntimeResult Mp3Decoder::parseHeader(
    uint32_t nowMs,
    size_t byteBudget)
{
    if (!open())
    {
        return setError(
            Mp3DecoderError::NotOpen,
            RuntimeResult::NotReady);
    }

    if (status_.state == Mp3DecoderState::Failed)
    {
        return RuntimeResult::CorruptData;
    }

    if (status_.headerReady)
    {
        status_.error = Mp3DecoderError::None;
        return RuntimeResult::Ok;
    }

    const size_t effectiveBudget =
        byteBudget > 0U
            ? byteBudget
            : config_.sourceReadChunkBytes;

    if (effectiveBudget == 0U)
    {
        return setError(
            Mp3DecoderError::InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    const uint32_t startOffset =
        SdStreamService::position(stream_);

    while (!status_.headerReady)
    {
        const uint32_t currentOffset =
            SdStreamService::position(stream_);

        const size_t consumedThisCall =
            currentOffset >= startOffset
                ? static_cast<size_t>(
                    currentOffset - startOffset)
                : 0U;

        if (consumedThisCall >= effectiveBudget)
        {
            return setError(
                Mp3DecoderError::Busy,
                RuntimeResult::Busy);
        }

        RuntimeResult result =
            RuntimeResult::InternalError;

        switch (parsePhase_)
        {
            case ParsePhase::Id3v2Header:
                result = parseId3v2Header(nowMs);
                break;

            case ParsePhase::SkipId3v2:
                result = skipId3v2(
                    nowMs,
                    effectiveBudget - consumedThisCall);
                break;

            case ParsePhase::SearchFirstFrame:
                result = searchFirstFrame(
                    nowMs,
                    effectiveBudget - consumedThisCall);
                break;

            case ParsePhase::ParseFirstFrame:
                result = parseFirstFrame(nowMs);
                break;

            case ParsePhase::Complete:
                result = finalizeHeader();
                break;

            default:
                status_.state = Mp3DecoderState::Failed;

                return setError(
                    Mp3DecoderError::InternalError,
                    RuntimeResult::InternalError);
        }

        if (result != RuntimeResult::Ok)
        {
            return result;
        }
    }

    status_.error = Mp3DecoderError::None;
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult Mp3Decoder::decode(
    PcmRingBuffer& destination,
    uint32_t nowMs,
    size_t maximumPcmFrames,
    size_t& decodedPcmFrames)
{
    decodedPcmFrames = 0U;

    if (!open())
    {
        return setError(
            Mp3DecoderError::NotOpen,
            RuntimeResult::NotReady);
    }

    if (status_.state == Mp3DecoderState::Failed)
    {
        return RuntimeResult::CorruptData;
    }

    if (!status_.headerReady)
    {
        const RuntimeResult parseResult =
            parseHeader(
                nowMs,
                config_.sourceReadChunkBytes);

        if (parseResult != RuntimeResult::Ok)
        {
            return parseResult;
        }
    }

    if (status_.eof)
    {
        return setError(
            Mp3DecoderError::EndOfStream,
            RuntimeResult::NotReady);
    }

    const RuntimeResult destinationResult =
        validateDestination(destination);

    if (destinationResult != RuntimeResult::Ok)
    {
        return destinationResult;
    }

    size_t frameBudget = maximumPcmFrames;

    if (frameBudget == 0U)
    {
        frameBudget =
            config_.defaultPcmFramesPerDecodeCall;
    }

    frameBudget = minimumSize(
        frameBudget,
        MP3_DECODER_MAX_FRAMES_PER_CALL);

    if (frameBudget == 0U)
    {
        return setError(
            Mp3DecoderError::InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    status_.state = Mp3DecoderState::Decoding;
    status_.sourceWouldBlock = false;
    status_.destinationBackpressure = false;
    status_.decodeCount =
        saturatingIncrement32(status_.decodeCount);

    RuntimeResult terminalResult = RuntimeResult::Ok;

    while (decodedPcmFrames < frameBudget)
    {
        size_t producedFrames = 0U;

        const RuntimeResult frameResult =
            decodeOneMpegFrame(
                destination,
                nowMs,
                frameBudget - decodedPcmFrames,
                producedFrames);

        decodedPcmFrames += producedFrames;

        if (frameResult != RuntimeResult::Ok)
        {
            terminalResult = frameResult;
            break;
        }

        if (producedFrames == 0U)
        {
            terminalResult = RuntimeResult::Busy;
            break;
        }
    }

    refreshDerivedStatus();

    if (status_.eof)
    {
        status_.state = Mp3DecoderState::EndOfStream;
    }
    else if (terminalResult == RuntimeResult::Ok ||
             decodedPcmFrames > 0U)
    {
        status_.state = Mp3DecoderState::Ready;
        status_.error = Mp3DecoderError::None;
    }

    notifyStateChanged();

    if (decodedPcmFrames > 0U &&
        isTemporaryResult(terminalResult))
    {
        return RuntimeResult::Ok;
    }

    return terminalResult;
}

RuntimeResult Mp3Decoder::decode(
    PcmRingBuffer& destination,
    uint32_t nowMs,
    size_t& decodedPcmFrames)
{
    return decode(
        destination,
        nowMs,
        config_.defaultPcmFramesPerDecodeCall,
        decodedPcmFrames);
}

RuntimeResult Mp3Decoder::seekMilliseconds(
    uint32_t milliseconds,
    bool accurate)
{
    if (!ready())
    {
        return setError(
            status_.open
                ? Mp3DecoderError::InvalidSeek
                : Mp3DecoderError::NotOpen,
            RuntimeResult::NotReady);
    }

    if (status_.durationMilliseconds > 0U &&
        milliseconds > status_.durationMilliseconds)
    {
        return setError(
            Mp3DecoderError::InvalidSeek,
            RuntimeResult::InvalidArgument);
    }

    Mp3SeekPoint point;
    Mp3SeekSource source = Mp3SeekSource::None;

    const RuntimeResult chooseResult =
        chooseSeekPoint(
            milliseconds,
            point,
            source);

    if (chooseResult != RuntimeResult::Ok)
    {
        return chooseResult;
    }

    if (accurate &&
        source != Mp3SeekSource::SparseIndex &&
        point.sourceOffsetBytes >
            status_.streamInfo.audioDataOffsetBytes)
    {
        const uint16_t bitrate =
            status_.streamInfo.averageBitrateKbps > 0U
                ? status_.streamInfo.averageBitrateKbps
                : status_.streamInfo.firstFrame.bitrateKbps;

        const uint32_t maximumBacktrack =
            static_cast<uint32_t>(minimumSize(
                backend_->compressedWindowBytes,
                static_cast<size_t>(
                    point.sourceOffsetBytes -
                    status_.streamInfo.audioDataOffsetBytes)));

        const uint32_t oneSecondBytes =
            bitrate > 0U
                ? static_cast<uint32_t>(bitrate) * 125U
                : maximumBacktrack;

        const uint32_t backtrackBytes =
            oneSecondBytes < maximumBacktrack
                ? oneSecondBytes
                : maximumBacktrack;

        point.sourceOffsetBytes -= backtrackBytes;

        const uint32_t backtrackMs =
            bitrate > 0U
                ? static_cast<uint32_t>(
                    (static_cast<uint64_t>(backtrackBytes) *
                     8ULL) /
                    bitrate)
                : 0U;

        const uint64_t backtrackFrames =
            millisecondsToFrames(
                backtrackMs,
                status_.streamInfo.outputFormat.sampleRateHz);

        point.pcmFrame =
            backtrackFrames >= point.pcmFrame
                ? 0U
                : point.pcmFrame - backtrackFrames;
    }

    const RuntimeResult seekResult =
        seekToSourceOffset(
            point.sourceOffsetBytes,
            point.pcmFrame,
            source);

    if (seekResult != RuntimeResult::Ok)
    {
        return seekResult;
    }

    if (accurate)
    {
        const uint64_t targetFrame =
            millisecondsToFrames(
                milliseconds,
                status_.streamInfo.
                    outputFormat.sampleRateHz);

        const RuntimeResult accurateResult =
            accurateSeekForward(
                targetFrame,
                config_.accurateSeekDecodeLimitMs);

        if (accurateResult != RuntimeResult::Ok)
        {
            return accurateResult;
        }
    }

    status_.seekCount =
        saturatingIncrement32(status_.seekCount);

    refreshDerivedStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult Mp3Decoder::seekPcmFrame(
    uint64_t pcmFrame,
    bool accurate)
{
    if (!ready() ||
        status_.streamInfo.outputFormat.sampleRateHz == 0U)
    {
        return setError(
            status_.open
                ? Mp3DecoderError::InvalidSeek
                : Mp3DecoderError::NotOpen,
            RuntimeResult::NotReady);
    }

    if (status_.estimatedTotalPcmFrames > 0U &&
        pcmFrame > status_.estimatedTotalPcmFrames)
    {
        return setError(
            Mp3DecoderError::InvalidSeek,
            RuntimeResult::InvalidArgument);
    }

    const uint64_t milliseconds64 =
        (pcmFrame * 1000ULL) /
        status_.streamInfo.outputFormat.sampleRateHz;

    if (milliseconds64 > UINT32_MAX)
    {
        return setError(
            Mp3DecoderError::InvalidSeek,
            RuntimeResult::InvalidArgument);
    }

    return seekMilliseconds(
        static_cast<uint32_t>(milliseconds64),
        accurate);
}

