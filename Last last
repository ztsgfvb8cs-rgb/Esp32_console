    currentSession.gameMode =
        PLAYTIME_MODE_UNKNOWN;


    currentSession.difficulty =
        PLAYTIME_DIFFICULTY_UNKNOWN;


    currentSession.state =
        PLAYTIME_SESSION_STOPPED;


    currentSession.startTime =
        0;


    currentSession.lastUpdateTime =
        0;


    currentSession.pauseStartTime =
        0;


    currentSession.sessionMilliseconds =
        0;


    currentSession.pausedMilliseconds =
        0;


    currentSession.frameCount =
        0;


    currentSession.valid =
        false;
}



static void clearStatisticsData()
{
    currentStatistics.gameID =
        PLAYTIME_INVALID_GAME_ID;


    currentStatistics.launchCount =
        0;


    currentStatistics.completedSessionCount =
        0;


    currentStatistics.interruptedSessionCount =
        0;


    currentStatistics.totalMilliseconds =
        0;


    currentStatistics.singlePlayerMilliseconds =
        0;


    currentStatistics.multiplayerMilliseconds =
        0;


    currentStatistics.easyMilliseconds =
        0;


    currentStatistics.normalMilliseconds =
        0;


    currentStatistics.hardMilliseconds =
        0;


    currentStatistics.extremeMilliseconds =
        0;


    currentStatistics.longestSessionMilliseconds =
        0;


    currentStatistics.shortestSessionMilliseconds =
        0;


    currentStatistics.lastSessionMilliseconds =
        0;


    currentStatistics.totalFrames =
        0;


    currentStatistics.initialized =
        false;
}



static bool isValidGameMode(
    uint8_t gameMode
)
{
    return
        gameMode == PLAYTIME_MODE_UNKNOWN ||
        gameMode == PLAYTIME_MODE_SINGLEPLAYER ||
        gameMode == PLAYTIME_MODE_MULTIPLAYER;
}



static bool isValidDifficulty(
    uint8_t difficulty
)
{
    return
        difficulty == PLAYTIME_DIFFICULTY_UNKNOWN ||
        difficulty == PLAYTIME_DIFFICULTY_EASY ||
        difficulty == PLAYTIME_DIFFICULTY_NORMAL ||
        difficulty == PLAYTIME_DIFFICULTY_HARD ||
        difficulty == PLAYTIME_DIFFICULTY_EXTREME;
}



static void addModePlaytime(
    uint8_t gameMode,
    uint32_t milliseconds
)
{
    switch(gameMode)
    {
        case PLAYTIME_MODE_SINGLEPLAYER:

            currentStatistics.singlePlayerMilliseconds +=
                milliseconds;

            break;


        case PLAYTIME_MODE_MULTIPLAYER:

            currentStatistics.multiplayerMilliseconds +=
                milliseconds;

            break;


        default:

            break;
    }
}



static void addDifficultyPlaytime(
    uint8_t difficulty,
    uint32_t milliseconds
)
{
    switch(difficulty)
    {
        case PLAYTIME_DIFFICULTY_EASY:

            currentStatistics.easyMilliseconds +=
                milliseconds;

            break;


        case PLAYTIME_DIFFICULTY_NORMAL:

            currentStatistics.normalMilliseconds +=
                milliseconds;

            break;


        case PLAYTIME_DIFFICULTY_HARD:

            currentStatistics.hardMilliseconds +=
                milliseconds;

            break;


        case PLAYTIME_DIFFICULTY_EXTREME:

            currentStatistics.extremeMilliseconds +=
                milliseconds;

            break;


        default:

            break;
    }
}



static void updateSessionStatistics(
    bool completed
)
{
    uint32_t sessionTime =
        currentSession.sessionMilliseconds;


    currentStatistics.totalMilliseconds +=
        sessionTime;


    currentStatistics.totalFrames +=
        currentSession.frameCount;


    currentStatistics.lastSessionMilliseconds =
        sessionTime;


    if(sessionTime >
       currentStatistics.longestSessionMilliseconds)
    {
        currentStatistics.longestSessionMilliseconds =
            sessionTime;
    }



    if(sessionTime > 0)
    {
        if(currentStatistics.shortestSessionMilliseconds == 0 ||
           sessionTime <
           currentStatistics.shortestSessionMilliseconds)
        {
            currentStatistics.shortestSessionMilliseconds =
                sessionTime;
        }
    }



    if(completed)
    {
        currentStatistics.completedSessionCount++;
    }
    else
    {
        currentStatistics.interruptedSessionCount++;
    }



    addModePlaytime(
        currentSession.gameMode,
        sessionTime
    );


    addDifficultyPlaytime(
        currentSession.difficulty,
        sessionTime
    );
}



