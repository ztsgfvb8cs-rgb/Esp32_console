void HardwareManager::clearState()
{
    currentStatus.initialized = false;
    currentStatus.spiReady = false;
    currentStatus.i2cReady = false;
    currentStatus.psramAvailable = false;
    currentStatus.boostEnabled = false;
    currentStatus.backlightEnabled = false;
    currentStatus.hapticEnabled = false;

    currentStatus.psramBytes = 0;

    currentStatus.stage =
        HardwareInitStage::NONE;

    currentStatus.error =
        HardwareError::NONE;
}

bool HardwareManager::fail(
    HardwareError error)
{
    makeOutputsSafe();

    if (currentStatus.i2cReady)
    {
        Wire.end();

        currentStatus.i2cReady = false;
    }

    if (currentStatus.spiReady)
    {
        SPI.end();

        currentStatus.spiReady = false;
    }

    currentStatus.initialized = false;

    currentStatus.stage =
        HardwareInitStage::FAILED;

    currentStatus.error = error;

    return false;
}

bool HardwareManager::configureOutputPins()
{
    makeOutputsSafe();

    if (!configureOutput(
            BoardPins::TFT_DC_PIN,
            LOW))
    {
        return false;
    }

    if (pinConnected(
            BoardPins::TFT_RESET_PIN) &&
        !configureOutput(
            BoardPins::TFT_RESET_PIN,
            HIGH))
    {
        return false;
    }

    return true;
}

bool HardwareManager::configureInputPins()
{
    const uint8_t buttonMode =
        BoardConfig::USE_INTERNAL_BUTTON_PULLUPS
            ? INPUT_PULLUP
            : INPUT;

    for (size_t i = 0;
         i < BoardPins::DIRECT_BUTTON_COUNT;
         ++i)
    {
        if (!configureInput(
                BoardPins::DIRECT_BUTTON_PINS[i],
                buttonMode))
        {
            return false;
        }
    }

    if (!configureInput(
            BoardPins::BATTERY_ADC_PIN,
            INPUT))
    {
        return false;
    }

    if (pinConnected(
            BoardPins::HEADPHONE_DETECT_PIN) &&
        !configureInput(
            BoardPins::HEADPHONE_DETECT_PIN,
            INPUT_PULLUP))
    {
        return false;
    }

    if (pinConnected(
            BoardPins::TOUCH_IRQ_PIN) &&
        !configureInput(
            BoardPins::TOUCH_IRQ_PIN,
            INPUT_PULLUP))
    {
        return false;
    }

    analogReadResolution(
        BoardConfig::BATTERY_ADC_BITS);

    return true;
}

bool HardwareManager::configureSharedSpi()
{
    if (!pinConnected(
            BoardPins::SPI_SCLK_PIN) ||
        !pinConnected(
            BoardPins::SPI_MISO_PIN) ||
        !pinConnected(
            BoardPins::SPI_MOSI_PIN))
    {
        return false;
    }

    SPI.begin(
        BoardPins::SPI_SCLK_PIN,
        BoardPins::SPI_MISO_PIN,
        BoardPins::SPI_MOSI_PIN,
        BoardPins::NOT_CONNECTED);

    currentStatus.spiReady = true;

    return true;
}

bool HardwareManager::configureRtcI2c()
{
    if (!BoardConfig::ENABLE_RTC)
    {
        currentStatus.i2cReady = false;

        return true;
    }

    const bool started =
        Wire.begin(
            BoardPins::I2C_SDA_PIN,
            BoardPins::I2C_SCL_PIN,
            BoardConfig::I2C_FREQUENCY_HZ);

    currentStatus.i2cReady = started;

    return started;
}

bool HardwareManager::detectRequiredMemory()
{
#if defined(ARDUINO_ARCH_ESP32)

    currentStatus.psramAvailable =
        psramFound();

    if (currentStatus.psramAvailable)
    {
        currentStatus.psramBytes =
            static_cast<uint32_t>(
                ESP.getPsramSize());
    }

#else

    currentStatus.psramAvailable =
        !BoardConfig::REQUIRE_PSRAM;

    currentStatus.psramBytes = 0;

#endif

    if (!BoardConfig::REQUIRE_PSRAM)
    {
        return true;
    }

    if (!currentStatus.psramAvailable)
    {
        return fail(
            HardwareError::PSRAM_NOT_FOUND);
    }

    if (currentStatus.psramBytes <
        BoardConfig::EXPECTED_PSRAM_BYTES)
    {
        return fail(
            HardwareError::PSRAM_TOO_SMALL);
    }

    return true;
}

