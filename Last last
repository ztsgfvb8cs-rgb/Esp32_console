//---------------- Profile Activation ----------------

bool activateSelectedProfile()
{
    if(!hasSelectedProfile())
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_INVALID_PROFILE;


        return false;
    }


    uint16_t profileID =
        getSelectedProfileID();


    if(!loadPlayerProfile(
        profileID
    ))
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_LOAD_ERROR;


        return false;
    }


    if(!isPlayerProfileActive())
    {
        if(!activatePlayerProfile())
        {
            profileSelectorStatus =
                PROFILE_SELECTOR_LOAD_ERROR;


            return false;
        }
    }


    if(!saveActiveProfile())
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_STORAGE_ERROR;


        return false;
    }


    if(!refreshProfileSelector())
    {
        return false;
    }


    selectProfileByID(
        profileID
    );


    profileSelectorStatus =
        PROFILE_SELECTOR_READY;


    return true;
}



