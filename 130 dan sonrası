bool I2sAudioBackend::validConfig(
    const I2sAudioBackendConfig& config)
{
    if (!validFormat(config.format) ||
        !validRoute(config.initialRoute) ||
        config.dmaBufferCount <
            I2S_AUDIO_MIN_DMA_BUFFER_COUNT ||
        config.dmaBufferCount >
            I2S_AUDIO_MAX_DMA_BUFFER_COUNT ||
        config.dmaFramesPerBuffer <
            I2S_AUDIO_MIN_DMA_FRAMES_PER_BUFFER ||
        config.dmaFramesPerBuffer >
            I2S_AUDIO_MAX_DMA_FRAMES_PER_BUFFER ||
        !validRequiredPin(config.bitClockPin) ||
        !validRequiredPin(config.wordSelectPin) ||
        !validRequiredPin(config.dataOutPin) ||
        !validOptionalPin(config.masterClockPin) ||
        !validOptionalPin(config.speakerEnablePin) ||
        !validOptionalPin(config.headphoneEnablePin))
    {
        return false;
    }

    const BoardPins::Pin pins[] = {
        config.bitClockPin,
        config.wordSelectPin,
        config.dataOutPin,
        config.masterClockPin,
        config.speakerEnablePin,
        config.headphoneEnablePin
    };

    for (size_t first = 0;
         first < sizeof(pins) / sizeof(pins[0]);
         ++first)
    {
        for (size_t second = first + 1U;
             second < sizeof(pins) / sizeof(pins[0]);
             ++second)
        {
            if (pinsConflict(pins[first], pins[second]))
            {
                return false;
            }
        }
    }

    if (config.reserveInternalBudget)
    {
        const size_t labelLength =
            boundedStringLength(
                config.budgetLabel,
                I2S_AUDIO_BUDGET_LABEL_CAPACITY);

        if (labelLength == 0U ||
            labelLength >=
                I2S_AUDIO_BUDGET_LABEL_CAPACITY)
        {
            return false;
        }
    }

    return requiredInternalBytes(config) > 0U;
}

