        totalMilliseconds(id) /
        1000ULL;
}


uint64_t
PlaytimeManager::totalMillisecondsBySource(
    const String& source
)
{
    if (!validSource(source))
        return 0;

    uint64_t total = 0;

    for (uint16_t i = 0;
         i < entryCount;
         i++)
    {
        if (!entries[i].valid ||
            entries[i].source != source)
        {
            continue;
        }

        uint64_t value =
            entries[i].totalMilliseconds;

        if (active &&
            !paused &&
            activeIndex ==
                static_cast<int16_t>(i))
        {
            uint64_t pending =
                pendingActiveMilliseconds();

            if (value >
                PLAYTIME_UINT64_MAX -
                pending)
            {
                value =
                    PLAYTIME_UINT64_MAX;
            }
            else
            {
                value += pending;
            }
        }

        if (total >
            PLAYTIME_UINT64_MAX - value)
        {
            return PLAYTIME_UINT64_MAX;
        }

        total += value;
    }

    return total;
}


uint64_t
PlaytimeManager::totalSecondsBySource(
    const String& source
)
{
    return
        totalMillisecondsBySource(source) /
        1000ULL;
}


