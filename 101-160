{
    return currentCalibrationOffsetV;
}

bool BatteryManager::setSmoothingFactor(float factor)
{
    if (!validFiniteValue(factor) ||
        factor <= 0.0f ||
        factor > 1.0f)
    {
        currentStatus.error =
            BatteryError::INVALID_SMOOTHING_FACTOR;

        return false;
    }

    currentSmoothingFactor = factor;

    if (currentStatus.error ==
        BatteryError::INVALID_SMOOTHING_FACTOR)
    {
        currentStatus.error = BatteryError::NONE;
    }

    return true;
}

float BatteryManager::smoothingFactor()
{
    return currentSmoothingFactor;
