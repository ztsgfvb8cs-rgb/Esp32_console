//---------------- Profile Index ----------------

bool loadProfileIndex()
{
    clearProfileIndexMemory();


    File file =
        SD.open(
            PROFILE_STORAGE_INDEX_FILE,
            FILE_READ
        );


    if(!file)
    {
        profileStorageStatus =
            PROFILE_STORAGE_FILE_NOT_FOUND;


        return false;
    }


    if(file.size() <
       sizeof(ProfileIndexHeader))
    {
        file.close();


        profileStorageStatus =
            PROFILE_STORAGE_INVALID_FILE;


        return false;
    }


    ProfileIndexHeader header;


    size_t headerRead =
        file.read(
            reinterpret_cast<uint8_t*>(
                &header
            ),
            sizeof(ProfileIndexHeader)
        );


    if(headerRead !=
       sizeof(ProfileIndexHeader))
    {
        file.close();


        profileStorageStatus =
            PROFILE_STORAGE_READ_ERROR;


        return false;
    }


    if(header.magic !=
       PROFILE_STORAGE_INDEX_MAGIC)
    {
        file.close();


        profileStorageStatus =
            PROFILE_STORAGE_INVALID_FILE;


        return false;
    }


    if(header.version !=
       PROFILE_STORAGE_VERSION)
    {
        file.close();


        profileStorageStatus =
            PROFILE_STORAGE_VERSION_ERROR;


        return false;
    }


    if(header.profileCount >
       PROFILE_STORAGE_MAX_PROFILES)
    {
        file.close();


        profileStorageStatus =
            PROFILE_STORAGE_INVALID_FILE;


        return false;
    }


    for(uint8_t i = 0;
        i < header.profileCount;
        i++)
    {
        ProfileIndexEntry entry;


        size_t entryRead =
            file.read(
                reinterpret_cast<uint8_t*>(
                    &entry
                ),
                sizeof(ProfileIndexEntry)
            );


        if(entryRead !=
           sizeof(ProfileIndexEntry))
        {
            file.close();


            clearProfileIndexMemory();


            profileStorageStatus =
                PROFILE_STORAGE_READ_ERROR;


            return false;
        }


        if(!entry.valid ||
           entry.profileID == PROFILE_INVALID_ID)
        {
            file.close();


            clearProfileIndexMemory();


            profileStorageStatus =
                PROFILE_STORAGE_INVALID_FILE;


            return false;
        }


        profileIndex[
            profileIndexCount
        ] = entry;


        profileIndexCount++;
    }


    file.close();


    uint32_t checksum =
        calculateProfileIndexChecksum();


    if(checksum !=
       header.entriesChecksum)
    {
        clearProfileIndexMemory();


        profileStorageStatus =
            PROFILE_STORAGE_INVALID_FILE;


        return false;
    }


    profileStorageStatus =
        PROFILE_STORAGE_READY;


    return true;
}



bool saveProfileIndex()
{
    if(!createProfileStorageFolder())
    {
        profileStorageStatus =
            PROFILE_STORAGE_FOLDER_ERROR;


        return false;
    }


    if(SD.exists(
        PROFILE_STORAGE_INDEX_TEMP
    ))
    {
        SD.remove(
            PROFILE_STORAGE_INDEX_TEMP
        );
    }


    if(!writeProfileIndexFile(
        PROFILE_STORAGE_INDEX_TEMP
    ))
    {
        profileStorageStatus =
            PROFILE_STORAGE_WRITE_ERROR;


        return false;
    }


    if(SD.exists(
        PROFILE_STORAGE_INDEX_FILE
    ))
    {
        if(!SD.remove(
            PROFILE_STORAGE_INDEX_FILE
        ))
        {
            SD.remove(
                PROFILE_STORAGE_INDEX_TEMP
            );


            profileStorageStatus =
                PROFILE_STORAGE_DELETE_ERROR;


            return false;
        }
    }


    if(!SD.rename(
        PROFILE_STORAGE_INDEX_TEMP,
        PROFILE_STORAGE_INDEX_FILE
    ))
    {
        SD.remove(
            PROFILE_STORAGE_INDEX_TEMP
        );


        profileStorageStatus =
            PROFILE_STORAGE_WRITE_ERROR;


        return false;
    }


    profileStorageStatus =
        PROFILE_STORAGE_READY;


    return true;
}



bool rebuildProfileIndex()
{
    clearProfileIndexMemory();


    if(!createProfileStorageFolder())
    {
        profileStorageStatus =
            PROFILE_STORAGE_FOLDER_ERROR;


        return false;
    }


    File folder =
        SD.open(
            PROFILE_STORAGE_FOLDER
        );


    if(!folder ||
       !folder.isDirectory())
    {
        if(folder)
        {
            folder.close();
        }


        profileStorageStatus =
            PROFILE_STORAGE_FOLDER_ERROR;


        return false;
    }


    File file =
        folder.openNextFile();


    while(file)
    {
        if(!file.isDirectory())
        {
            const char* fileName =
                file.name();


            if(fileName != nullptr)
            {
                size_t nameLength =
                    strlen(
                        fileName
                    );


                if(nameLength > 8 &&
                   strstr(
                       fileName,
                       "profile_"
                   ) != nullptr &&
                   strstr(
                       fileName,
                       ".dat"
                   ) != nullptr)
                {
                    PlayerProfile profile;


                    ProfileStorageHeader header;


                    char fullPath[
                        PROFILE_FILE_PATH_LENGTH
                    ];


                    snprintf(
                        fullPath,
                        sizeof(fullPath),
                        "%s/%s",
                        PROFILE_STORAGE_FOLDER,
                        fileName
                    );


                    if(readProfileFile(
                        fullPath,
                        profile,
                        &header
                    ))
                    {
                        if(profileIndexCount <
                           PROFILE_STORAGE_MAX_PROFILES)
                        {
                            fillProfileIndexEntry(
                                profileIndex[
                                    profileIndexCount
                                ],
                                profile,
                                header.savedUnix
                            );


                            profileIndexCount++;
                        }
                    }
                }
            }
        }


        file.close();


        file =
            folder.openNextFile();
    }


    folder.close();


    if(!saveProfileIndex())
    {
        return false;
    }


    profileStorageStatus =
        PROFILE_STORAGE_READY;


    return true;
}



