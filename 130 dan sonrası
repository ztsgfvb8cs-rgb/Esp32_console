        return setError(
            I2sAudioBackendError::UnsupportedFormat,
            RuntimeResult::Unsupported);
    }
#elif defined(EGS_I2S_USE_LEGACY_DRIVER)
    if (!legacyDriverInstalled)
    {
        return setError(
