//---------------- Achievement Trackers ----------------

bool createAchievementTracker(
    uint16_t trackerID,
    uint16_t achievementID
)
{
    if(trackerID ==
       ACHIEVEMENT_INVALID_ID)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_INVALID_ID;


        return false;
    }


    if(findAchievementTracker(
        trackerID
    ) != nullptr)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_ALREADY_EXISTS;


        return false;
    }


    const AchievementRecord* record =
        findAchievement(
            achievementID
        );


    if(record == nullptr)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    if(achievementTrackerCount >=
       ACHIEVEMENT_MAX_TRACKERS)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_TRACKER_FULL;


        return false;
    }


    AchievementTracker& tracker =
        achievementTrackers[
            achievementTrackerCount
        ];


    clearAchievementTrackerData(
        tracker
    );


    tracker.trackerID =
        trackerID;


    tracker.achievementID =
        achievementID;


    tracker.currentValue =
        record->progress.currentValue;


    tracker.targetValue =
        record->definition.targetValue;


    tracker.active =
        !record->progress.unlocked;


    tracker.valid =
        true;


    achievementTrackerCount++;


    achievementManagerStatus =
        ACHIEVEMENT_STATUS_READY;


    return true;
}



bool removeAchievementTracker(
    uint16_t trackerID
)
{
    int8_t index =
        findAchievementTrackerIndex(
            trackerID
        );


    if(index < 0)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    for(uint8_t i = index;
        i + 1 < achievementTrackerCount;
        i++)
    {
        achievementTrackers[i] =
            achievementTrackers[i + 1];
    }


    if(achievementTrackerCount > 0)
    {
        achievementTrackerCount--;


        clearAchievementTrackerData(
            achievementTrackers[
                achievementTrackerCount
            ]
        );
    }


    achievementManagerStatus =
        ACHIEVEMENT_STATUS_READY;


    return true;
}



bool updateAchievementTracker(
    uint16_t trackerID,
    uint32_t currentValue
)
{
    int8_t index =
        findAchievementTrackerIndex(
            trackerID
        );


    if(index < 0)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    AchievementTracker& tracker =
        achievementTrackers[index];


    if(!tracker.active)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_LOCKED;


        return false;
    }


    bool result =
        setAchievementProgress(
            tracker.achievementID,
            currentValue
        );


    if(result)
    {
        synchronizeTrackerWithAchievement(
            tracker
        );
    }


    return result;
}



bool incrementAchievementTracker(
    uint16_t trackerID,
    uint32_t value
)
{
    int8_t index =
        findAchievementTrackerIndex(
            trackerID
        );


    if(index < 0)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    AchievementTracker& tracker =
        achievementTrackers[index];


    if(!tracker.active)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_LOCKED;


        return false;
    }


    uint64_t newValue =
        (uint64_t)tracker.currentValue +
        value;


    if(newValue >
       tracker.targetValue)
    {
        newValue =
            tracker.targetValue;
    }


    return updateAchievementTracker(
        trackerID,
        (uint32_t)newValue
    );
}



