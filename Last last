//==================================================
// ESP32 GAME STATION
// RTC MANAGER IMPLEMENTATION
//==================================================


//---------------- RTC Device ----------------

#if RTC_USE_DS3231

static RTC_DS3231 rtcDevice;

#elif RTC_USE_DS1307

static RTC_DS1307 rtcDevice;

#endif


//---------------- Internal State ----------------

static RTCManagerStatus rtcStatus =
    RTC_STATUS_NOT_INITIALIZED;


static RTCDateTime currentRTCDateTime;


static bool rtcInitialized =
    false;


static bool rtcAvailable =
    false;


//---------------- Internal Constants ----------------

static const uint32_t RTC_UPDATE_INTERVAL =
    250UL;


//---------------- Internal Timing ----------------

static uint32_t lastRTCUpdateTime =
    0;


//---------------- Internal Functions ----------------

static void clearRTCDateTime()
{
    currentRTCDateTime.year =
        0;


    currentRTCDateTime.month =
        0;


    currentRTCDateTime.day =
        0;


    currentRTCDateTime.hour =
        0;


    currentRTCDateTime.minute =
        0;


    currentRTCDateTime.second =
        0;


    currentRTCDateTime.dayOfWeek =
        0;


    currentRTCDateTime.unixTime =
        0;


    currentRTCDateTime.valid =
        false;
}



static void copyDateTimeToRTCData(
    const DateTime& dateTime
)
{
    currentRTCDateTime.year =
        dateTime.year();


    currentRTCDateTime.month =
        dateTime.month();


    currentRTCDateTime.day =
        dateTime.day();


    currentRTCDateTime.hour =
        dateTime.hour();


    currentRTCDateTime.minute =
        dateTime.minute();


    currentRTCDateTime.second =
        dateTime.second();


    currentRTCDateTime.dayOfWeek =
        dateTime.dayOfTheWeek();


    currentRTCDateTime.unixTime =
        dateTime.unixtime();


    currentRTCDateTime.valid =
        isRTCDateValid(
            currentRTCDateTime.year,
            currentRTCDateTime.month,
            currentRTCDateTime.day
        )
        &&
        isRTCTimeValid(
            currentRTCDateTime.hour,
            currentRTCDateTime.minute,
            currentRTCDateTime.second
        );
}



static bool readRTCDevice()
{
    if(!rtcInitialized ||
       !rtcAvailable)
    {
        clearRTCDateTime();

        return false;
    }


    DateTime now =
        rtcDevice.now();


    copyDateTimeToRTCData(
        now
    );


    if(!currentRTCDateTime.valid)
    {
        rtcStatus =
            RTC_STATUS_INVALID_TIME;


        return false;
    }


    rtcStatus =
        RTC_STATUS_READY;


    return true;
}



//---------------- Initialization ----------------

bool initRTCManager()
{
    clearRTCDateTime();


    rtcInitialized =
        false;


    rtcAvailable =
        false;


    rtcStatus =
        RTC_STATUS_NOT_INITIALIZED;


    Wire.begin();


    bool beginResult =
        rtcDevice.begin();


    if(!beginResult)
    {
        rtcStatus =
            RTC_STATUS_NOT_FOUND;


        return false;
    }


    rtcInitialized =
        true;


    rtcAvailable =
        true;


#if RTC_USE_DS3231

    if(rtcDevice.lostPower())
    {
        rtcStatus =
            RTC_STATUS_INVALID_TIME;


        setRTCFromBuildTime();
    }

#elif RTC_USE_DS1307

    if(!rtcDevice.isrunning())
    {
        rtcStatus =
            RTC_STATUS_INVALID_TIME;


        setRTCFromBuildTime();
    }

#endif


    if(!readRTCDevice())
    {
        if(rtcStatus != RTC_STATUS_INVALID_TIME)
        {
            rtcStatus =
                RTC_STATUS_ERROR;
        }


        return false;
    }


    lastRTCUpdateTime =
        millis();


    rtcStatus =
        RTC_STATUS_READY;


    return true;
}



//---------------- Update ----------------

void updateRTCManager()
{
    if(!rtcInitialized ||
       !rtcAvailable)
    {
        return;
    }


    uint32_t currentTime =
        millis();


    if(currentTime - lastRTCUpdateTime <
       RTC_UPDATE_INTERVAL)
    {
        return;
    }


    lastRTCUpdateTime =
        currentTime;


    readRTCDevice();
}



//---------------- RTC State ----------------

bool isRTCAvailable()
{
    return rtcAvailable;
}



bool isRTCInitialized()
{
    return rtcInitialized;
}



bool isRTCDateTimeValid()
{
    return currentRTCDateTime.valid;
}



