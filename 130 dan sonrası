bool ResourceBudgetCoordinator::begin(
    const ResourceBudgetPolicy& policy)
{
    if (currentStatus_.initialized)
    {
        currentStatus_.error =
            ResourceBudgetError::AlreadyInitialized;

        notifyStateChanged();
        return false;
    }

    if (!validatePolicy(policy))
    {
        currentStatus_.error =
            ResourceBudgetError::InvalidPolicy;

        notifyStateChanged();
        return false;
    }

    if (!MemoryManager::begin())
    {
        currentStatus_.error =
            ResourceBudgetError::InternalMemoryUnavailable;

        notifyStateChanged();
        return false;
    }

    const uint32_t serviceGeneration =
        nextGeneration(currentStatus_.generation);

    for (uint8_t index = 0;
         index < RESOURCE_BUDGET_MAX_RESERVATIONS;
         ++index)
    {
        ReservationSlot& slot = reservations_[index];

        const uint32_t slotGeneration =
            nextGeneration(slot.status.generation);

        slot = {};
        slot.status.generation = slotGeneration;
    }

    policy_ = policy;
    currentStatus_ = {};
    currentStatus_.initialized = true;
    currentStatus_.generation = serviceGeneration;
    currentStatus_.error = ResourceBudgetError::None;
    nextLeaseId_ = 1U;

    refreshStatus();
    notifyStateChanged();

    return true;
}

void ResourceBudgetCoordinator::update(
    uint32_t nowMs)
{
    (void)nowMs;

    if (!currentStatus_.initialized)
    {
        setError(
            ResourceBudgetError::NotInitialized,
            RuntimeResult::NotReady);

        return;
    }

    const uint32_t pressureSequence =
        currentStatus_.pressureSequence;

    refreshStatus();

    if (currentStatus_.pressureSequence !=
        pressureSequence)
    {
        notifyStateChanged();
    }
}

void ResourceBudgetCoordinator::end()
{
    const uint32_t serviceGeneration =
        nextGeneration(currentStatus_.generation);

    for (uint8_t index = 0;
         index < RESOURCE_BUDGET_MAX_RESERVATIONS;
         ++index)
    {
        ReservationSlot& slot = reservations_[index];

        const uint32_t slotGeneration =
            nextGeneration(slot.status.generation);

        slot = {};
        slot.status.generation = slotGeneration;
    }

    policy_ = {};
    currentStatus_ = {};
    currentStatus_.generation = serviceGeneration;
    observer_ = nullptr;
    nextLeaseId_ = 1U;
}

