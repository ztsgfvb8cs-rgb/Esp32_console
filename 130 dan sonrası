bool WavDecoder::supportedSourceFormat(
    const WavSourceFormat& formatValue,
    const WavDecoderConfig& config,
    WavDecoderError* rejectionReason)
{
    if (rejectionReason != nullptr)
    {
        *rejectionReason =
            WavDecoderError::None;
    }

    if (formatValue.channelCount <
            WAV_DECODER_MIN_CHANNEL_COUNT ||

        formatValue.channelCount >
            WAV_DECODER_MAX_CHANNEL_COUNT)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                WavDecoderError::
                    UnsupportedChannelCount;
        }

        return false;
    }

    if (formatValue.sampleRateHz <
            I2S_AUDIO_MIN_SAMPLE_RATE_HZ ||

        formatValue.sampleRateHz >
            I2S_AUDIO_MAX_SAMPLE_RATE_HZ)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                WavDecoderError::
                    UnsupportedSampleRate;
        }

        return false;
    }

    if (formatValue.bitsPerSample <
            WAV_DECODER_MIN_BITS_PER_SAMPLE ||

        formatValue.bitsPerSample >
            WAV_DECODER_MAX_BITS_PER_SAMPLE ||

        (formatValue.bitsPerSample % 8U) != 0U)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                WavDecoderError::
                    UnsupportedBitsPerSample;
        }

        return false;
    }

    if (formatValue.validBitsPerSample == 0U ||

        formatValue.validBitsPerSample >
            formatValue.bitsPerSample)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                WavDecoderError::
                    InvalidValidBits;
        }

        return false;
    }

    bool encodingAllowed = false;

    if (formatValue.encoding ==
        WavSampleEncoding::PcmInteger)
    {
        switch (formatValue.bitsPerSample)
        {
            case 8U:
                encodingAllowed =
                    config.allowPcm8;
                break;

            case 16U:
                encodingAllowed =
                    config.allowPcm16;
                break;

            case 24U:
                encodingAllowed =
                    config.allowPcm24;
                break;

            case 32U:
                encodingAllowed =
                    config.allowPcm32;
                break;

            default:
                encodingAllowed = false;
                break;
        }

        if (formatValue.bitsPerSample == 8U &&
            formatValue.validBitsPerSample != 8U)
        {
            encodingAllowed = false;
        }
    }
    else if (formatValue.encoding ==
             WavSampleEncoding::IeeeFloat)
    {
        encodingAllowed =
            config.allowFloat32 &&

            formatValue.bitsPerSample == 32U &&

            formatValue.validBitsPerSample == 32U;
    }

    if (!encodingAllowed)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                formatValue.encoding ==
                        WavSampleEncoding::Unknown
                    ? WavDecoderError::
                        UnsupportedEncoding
                    : WavDecoderError::
                        UnsupportedBitsPerSample;
        }

        return false;
    }

    const uint32_t expectedBlockAlign =
        static_cast<uint32_t>(
            formatValue.channelCount) *
        (formatValue.bitsPerSample / 8U);

    if (expectedBlockAlign == 0U ||

        expectedBlockAlign > UINT16_MAX ||

        formatValue.blockAlignBytes !=
            expectedBlockAlign ||

        formatValue.blockAlignBytes >
            WAV_DECODER_MAX_SOURCE_FRAME_BYTES)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                WavDecoderError::
                    InvalidBlockAlignment;
        }

        return false;
    }

    const uint64_t expectedByteRate =
        static_cast<uint64_t>(
            formatValue.sampleRateHz) *
        formatValue.blockAlignBytes;

    if (expectedByteRate > UINT32_MAX ||

        formatValue.byteRate !=
            expectedByteRate)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                WavDecoderError::
                    InvalidByteRate;
        }

        return false;
    }

    return true;
}

