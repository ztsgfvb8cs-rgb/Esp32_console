//====================================================
// ESP32 GAME STATION
// FOREGROUND SESSION AND UI STATE BRIDGE
// 113_runtime_session_bridge.h
//====================================================
//
// Responsibilities:
// - Bridges RuntimeModuleManager with the application screen flow.
// - Starts games, emulators and PDF sessions through one API.
// - Remembers the browser/screen that must be restored on exit.
// - Synchronizes selected content and active engine state.
// - Converts backend completion/failure into a safe UI transition.
// - Supports deferred close requests for input and recovery paths.
//
// Dependency rule:
// - This header depends only on core value types and the lower-level
//   RuntimeModuleManager contract.
// - StateStore, ScreenManager, FileBrowserController and logging are
//   included only by the implementation file.
// - Input routing remains in files 115-116.
//====================================================

namespace egs
{
inline constexpr uint16_t RUNTIME_INVALID_CONTENT_INDEX =
    static_cast<uint16_t>(0xFFFFU);

enum class RuntimeSessionOrigin : uint8_t
{
    None = 0,
    MainMenu,
    GameBrowser,
    PdfBrowser,
    SearchResults,
    Resume,
    System
};

enum class RuntimeSessionExitReason : uint8_t
{
    None = 0,
    UserRequest,
    BackendFinished,
    LaunchRejected,
    RuntimeFailure,
    Recovery,
    Shutdown
};

enum class RuntimeSessionError : uint8_t
{
    None = 0,
    NotInitialized,
    InvalidContent,
    InvalidReturnScreen,
    AlreadyActive,
    RuntimeManagerNotReady,
    LaunchFailed,
    CloseFailed,
    NavigationFailed,
    BackendFailed
};

struct RuntimeSessionLaunchOptions
{
    RuntimeSessionOrigin origin =
        RuntimeSessionOrigin::None;

    AppScreen returnScreen =
        AppScreen::MainMenu;

    // Catalog index is optional. When supplied, the bridge
    // keeps the global content selection synchronized with
    // the launched item.
    uint16_t selectedContentIndex =
        RUNTIME_INVALID_CONTENT_INDEX;

    // A successful launch normally navigates to Playing
    // or PdfReader.
    bool navigateToForeground = true;

    // A completed or closed session normally returns to
    // returnScreen.
    bool navigateOnClose = true;
};

struct RuntimeSessionStatus
{
    bool initialized = false;
    bool active = false;
    bool closeRequested = false;
    bool navigationPending = false;

    RuntimeSessionOrigin origin =
        RuntimeSessionOrigin::None;

    RuntimeSessionExitReason exitReason =
        RuntimeSessionExitReason::None;

    RuntimeSessionError error =
        RuntimeSessionError::None;

    RuntimeResult lastResult =
        RuntimeResult::Ok;

    RuntimeModuleKind moduleKind =
        RuntimeModuleKind::None;

    RuntimeModuleState moduleState =
        RuntimeModuleState::Stopped;

    RuntimeModuleError moduleError =
        RuntimeModuleError::None;

    EngineKind engine =
        EngineKind::None;

    AppScreen foregroundScreen =
        AppScreen::MainMenu;

    AppScreen returnScreen =
        AppScreen::MainMenu;

    uint16_t selectedContentIndex =
        RUNTIME_INVALID_CONTENT_INDEX;

    uint32_t launchedAtMs = 0;
    uint32_t closedAtMs = 0;
    uint32_t sessionSequence = 0;
};

using RuntimeSessionStateCallback = void (*)(
    const RuntimeSessionStatus& status);

class RuntimeSessionBridge final
{
public:
    //================================================
    // LIFECYCLE
    //================================================

    static bool begin();
    static void update(uint32_t nowMs);
    static void end();

    static bool ready();
    static RuntimeSessionStatus status();

    //================================================
    // SESSION LAUNCH
    //================================================

    static RuntimeResult launch(
        const ContentItem& item,
        const RuntimeSessionLaunchOptions& options);

    // Convenience entry point for the game/PDF file
    // browser. The correct origin, foreground screen
    // and return screen are inferred from content kind.
    static RuntimeResult launchFromBrowser(
        const ContentItem& item,
        uint16_t catalogIndex =
            RUNTIME_INVALID_CONTENT_INDEX);

    // Convenience entry point for search results.
    // The caller supplies the screen that should be
    // restored after the foreground session closes.
    static RuntimeResult launchFromSearch(
        const ContentItem& item,
        AppScreen returnScreen,
        uint16_t catalogIndex =
            RUNTIME_INVALID_CONTENT_INDEX);

    //================================================
    // SESSION CLOSE AND RECOVERY
    //================================================

    // Deferred close is safe to call from an input
    // callback. The actual backend shutdown occurs
    // during update().
    static RuntimeResult requestClose(
        RuntimeSessionExitReason reason =
            RuntimeSessionExitReason::UserRequest);

    // Immediate close is intended for shutdown and
    // recovery paths.
    static RuntimeResult closeImmediately(
        RuntimeSessionExitReason reason,
        bool navigateAfterClose = true);

    static bool sessionActive();
    static bool closePending();

    //================================================
    // ACTIVE SESSION INFORMATION
    //================================================

    static RuntimeModuleKind activeKind();
    static EngineKind activeEngine();

    static AppScreen foregroundScreen();
    static AppScreen returnScreen();

    static const ContentItem* activeContent();

    static bool ownsScreen(AppScreen screen);

    //================================================
    // CALLBACKS AND DIAGNOSTICS
    //================================================

    static void setStateCallback(
        RuntimeSessionStateCallback callback);

    static RuntimeSessionExitReason lastExitReason();
    static RuntimeSessionError lastError();
    static RuntimeResult lastResult();

    static const char* originText(
        RuntimeSessionOrigin value);

    static const char* exitReasonText(
        RuntimeSessionExitReason value);

    static const char* errorText(
        RuntimeSessionError value);

private:
    static RuntimeSessionStatus currentStatus_;

    static RuntimeSessionLaunchOptions
        activeOptions_;

    static RuntimeSessionStateCallback
        stateCallback_;

    static ContentItem activeContent_;

    static RuntimeSessionExitReason
        pendingExitReason_;

    static AppScreen resolveForegroundScreen(
        RuntimeModuleKind kind);

    static AppScreen resolveBrowserReturnScreen(
        const ContentItem& item);

    static RuntimeSessionOrigin resolveBrowserOrigin(
        const ContentItem& item);

    static bool validLaunchContent(
        const ContentItem& item);

    static bool validReturnScreen(
        AppScreen screen);

    static void synchronizeRuntimeStatus();

    static RuntimeResult finishClose(
        RuntimeSessionExitReason reason,
        bool navigateAfterClose);

    static void navigateTo(
        AppScreen screen);

    static void clearSessionData();

    static void notifyStateChanged();

    static RuntimeResult fail(
        RuntimeSessionError error,
        RuntimeResult result,
        RuntimeSessionExitReason exitReason =
            RuntimeSessionExitReason::None);
};

static_assert(
    RUNTIME_INVALID_CONTENT_INDEX ==
        static_cast<uint16_t>(0xFFFFU),
    "Runtime invalid content index must remain "
    "16-bit maximum");
}


