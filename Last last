static bool isLeapYearValue(uint16_t year)
{
    if ((year % 400) == 0)
        return true;

    if ((year % 100) == 0)
        return false;

    return (year % 4) == 0;
}

static uint8_t daysInMonthValue(
    uint8_t month,
    uint16_t year
)
{
    static const uint8_t MONTH_DAYS[12] =
    {
        31,
        28,
        31,
        30,
        31,
        30,
        31,
        31,
        30,
        31,
        30,
        31
    };

    if (month < 1 || month > 12)
        return 0;

    if (month == 2 &&
        isLeapYearValue(year))
    {
        return 29;
    }

    return MONTH_DAYS[month - 1];
}

uint32_t AchievementManager::getTimestamp()
{
    if (!RTCManager::available())
        return millis() / 1000UL;

    uint16_t currentYear =
        RTCManager::year();

    uint8_t currentMonth =
        RTCManager::month();

    uint8_t currentDay =
        RTCManager::day();

    uint8_t currentHour =
        RTCManager::hour();

    uint8_t currentMinute =
        RTCManager::minute();

    uint8_t currentSecond =
        RTCManager::second();

    if (currentYear < 2000 ||
        currentYear > 2135 ||
        currentMonth < 1 ||
        currentMonth > 12)
    {
        return millis() / 1000UL;
    }

    uint8_t maximumDay =
        daysInMonthValue(
            currentMonth,
            currentYear
        );

    if (currentDay < 1 ||
        currentDay > maximumDay ||
        currentHour > 23 ||
        currentMinute > 59 ||
        currentSecond > 59)
    {
        return millis() / 1000UL;
    }

    uint32_t totalDays = 0;

    for (uint16_t year = 2000;
         year < currentYear;
         year++)
    {
        totalDays +=
            isLeapYearValue(year)
                ? 366UL
                : 365UL;
    }

    for (uint8_t month = 1;
         month < currentMonth;
         month++)
    {
        totalDays +=
            daysInMonthValue(
                month,
                currentYear
            );
    }

    totalDays +=
        static_cast<uint32_t>(
            currentDay - 1
        );

    uint64_t timestamp =
        static_cast<uint64_t>(
            totalDays
        ) * 86400ULL;

    timestamp +=
        static_cast<uint64_t>(
            currentHour
        ) * 3600ULL;

    timestamp +=
        static_cast<uint64_t>(
            currentMinute
        ) * 60ULL;

    timestamp += currentSecond;

    if (timestamp > 0xFFFFFFFFULL)
        return millis() / 1000UL;

    return static_cast<uint32_t>(
        timestamp
    );
}

