            writtenFrames);

    currentStatus_.writeCount =
        saturatingIncrement32(
            currentStatus_.writeCount);

    currentStatus_.lastWriteAtMs =
        platformMillis();

    const bool partial =
        writtenFrames < frameCount;

    if (partial)
    {
        currentStatus_.partialWriteCount =
            saturatingIncrement32(
                currentStatus_.partialWriteCount);

        currentStatus_.totalDroppedFrames =
            saturatingAdd64(
                currentStatus_.totalDroppedFrames,
                frameCount - writtenFrames);
    }

    if (timeoutOccurred)
    {
        currentStatus_.timeoutCount =
            saturatingIncrement32(
                currentStatus_.timeoutCount);

        refreshStatus();

        return setError(
            I2sAudioBackendError::WriteTimeout,
            RuntimeResult::Busy);
    }

    if (nativeResult != 0)
    {
        currentStatus_.driverErrorCount =
            saturatingIncrement32(
                currentStatus_.driverErrorCount);

        refreshStatus();

        return setError(
            I2sAudioBackendError::WriteFailed,
            RuntimeResult::IoError);
    }

    if (partial)
    {
        refreshStatus();

        return setError(
            I2sAudioBackendError::PartialWrite,
            resultForNativeWrite(
                nativeResult,
                timeoutOccurred,
                true));
    }

    currentStatus_.error =
        I2sAudioBackendError::None;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult I2sAudioBackend::writeSilence(
    size_t frameCount,
    size_t& writtenFrames,
    uint32_t timeoutMs)
{
    writtenFrames = 0;

    if (!ready())
    {
        return setError(
            I2sAudioBackendError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (frameCount == 0)
    {
        return RuntimeResult::Ok;
    }

    memset(sampleScratch, 0, sizeof(sampleScratch));

    const size_t maximumFramesPerChunk =
        I2S_AUDIO_MAX_DMA_FRAMES_PER_BUFFER;

    while (writtenFrames < frameCount)
    {
        const size_t chunkFrames = minimumSize(
            frameCount - writtenFrames,
            maximumFramesPerChunk);

        size_t chunkWritten = 0;

        const RuntimeResult result = write(
            sampleScratch,
            chunkFrames,
            chunkWritten,
            timeoutMs);

        writtenFrames += chunkWritten;

        currentStatus_.totalSilenceFrames =
            saturatingAdd64(
                currentStatus_.totalSilenceFrames,
                chunkWritten);

        if (result != RuntimeResult::Ok)
        {
            return result;
        }
    }

    return RuntimeResult::Ok;
}

RuntimeResult I2sAudioBackend::setFormat(
    const I2sAudioFormat& format,
    bool drainBeforeChange)
{
    if (!ready())
    {
        return setError(
            I2sAudioBackendError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!validFormat(format))
    {
        return setError(
            I2sAudioBackendError::InvalidFormat,
            RuntimeResult::InvalidArgument);
    }

    if (format.sampleRateHz ==
            config_.format.sampleRateHz &&
        format.bitsPerSample ==
            config_.format.bitsPerSample &&
        format.channelCount ==
            config_.format.channelCount)
    {
        currentStatus_.error =
            I2sAudioBackendError::None;

        return RuntimeResult::Ok;
    }

    if (drainBeforeChange)
    {
        const RuntimeResult drainResult = drain();

        if (drainResult != RuntimeResult::Ok)
        {
            return drainResult;
        }
    }

    const bool wasTransmitting =
        currentStatus_.transmitting;

    if (wasTransmitting)
    {
        const RuntimeResult stopResult = stop();

        if (stopResult != RuntimeResult::Ok)
        {
            return stopResult;
        }
    }

    currentStatus_.state =
        I2sAudioBackendState::Reconfiguring;

    const I2sAudioFormat previousFormat =
        config_.format;

    config_.format = format;

    const RuntimeResult formatResult =
        applyFormat(format);

    if (formatResult != RuntimeResult::Ok)
    {
        config_.format = previousFormat;
        applyFormat(previousFormat);

        currentStatus_.state =
            I2sAudioBackendState::Failed;

        return formatResult;
    }

    currentStatus_.format = format;
    currentStatus_.reconfigureCount =
        saturatingIncrement32(
            currentStatus_.reconfigureCount);
    currentStatus_.state =
        I2sAudioBackendState::Ready;
    currentStatus_.error =
        I2sAudioBackendError::None;

    if (config_.clearDmaOnStart)
    {
        const RuntimeResult flushResult = flush(true);

        if (flushResult != RuntimeResult::Ok)
        {
            return flushResult;
        }
    }

    if (wasTransmitting)
    {
        return start();
    }

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

