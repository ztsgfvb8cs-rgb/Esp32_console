RuntimeOrchestratorStatus
    RuntimeOrchestrator::currentStatus_ = {};

RuntimeOrchestratorPolicy
    RuntimeOrchestrator::policy_ = {};

SystemSettings RuntimeOrchestrator::settings_ = {};

RuntimeOrchestratorObserver
    RuntimeOrchestrator::observer_ = nullptr;

bool RuntimeOrchestrator::begin()
{
    if (currentStatus_.initialized)
    {
        return currentStatus_.state ==
                RuntimeOrchestratorState::Running ||
            currentStatus_.state ==
                RuntimeOrchestratorState::Suspended ||
            currentStatus_.state ==
                RuntimeOrchestratorState::ShutdownPending;
    }

    currentStatus_ = {};
    policy_ = {};
    observer_ = nullptr;
    settings_ = SettingsManager::settings();

    currentStatus_.initialized = true;
    currentStatus_.lastResult = RuntimeResult::Ok;

    transitionTo(
        RuntimeOrchestratorState::Starting,
        RuntimeOrchestratorStage::None);

    if (!beginCoordinators())
    {
        stopCoordinators();
        currentStatus_.initialized = false;

        transitionTo(
            RuntimeOrchestratorState::Failed,
            currentStatus_.stage);

        return false;
    }

    RuntimeAudioCoordinator::setSettings(settings_);
    RuntimePowerCoordinator::setSettings(settings_);

    FramePacer::setAutomaticFrameskip(
        settings_.automaticFrameskip);

    const RuntimeInputStatus inputStatus =
        RuntimeInputRouter::status();

    currentStatus_.observedInputEventSequence =
        inputStatus.eventSequence;

    currentStatus_.startedAtMs = millis();
    currentStatus_.error =
        RuntimeOrchestratorError::None;

    currentStatus_.lastResult =
        RuntimeResult::Ok;

    synchronizeStatus();

    transitionTo(
        RuntimeOrchestratorState::Running,
        RuntimeOrchestratorStage::None);

    Logger::info(
        LogSource::System,
        "RUNTIME_ORCH",
        "Runtime orchestrator ready");

    notifyStateChanged();

    return true;
}

RuntimeResult RuntimeOrchestrator::update(
    uint32_t nowMs,
    uint32_t nowUs)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeOrchestratorStage::RuntimeUpdate,
            RuntimeOrchestratorError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (currentStatus_.updateInProgress)
    {
        return fail(
            RuntimeOrchestratorStage::RuntimeUpdate,
            RuntimeOrchestratorError::AlreadyUpdating,
            RuntimeResult::Busy);
    }

    if (currentStatus_.state ==
            RuntimeOrchestratorState::Stopped ||
        currentStatus_.state ==
            RuntimeOrchestratorState::Stopping ||
        currentStatus_.state ==
            RuntimeOrchestratorState::Failed)
    {
        return RuntimeResult::NotReady;
    }

    if (nowMs == 0)
    {
        nowMs = millis();
    }

    if (nowUs == 0)
    {
        nowUs = micros();
    }

    currentStatus_.updateInProgress = true;

    currentStatus_.stage =
        RuntimeOrchestratorStage::RuntimeUpdate;

    const uint32_t startedUs = micros();

    RuntimeResult result =
        updateCoordinators(nowMs, nowUs);

    synchronizeStatus();

    if (result == RuntimeResult::Ok &&
        currentStatus_.fatalHealth)
    {
        result = processFatalHealth(nowMs);
    }

    const uint32_t finishedUs = micros();

    currentStatus_.lastUpdateDurationUs =
        finishedUs - startedUs;

    currentStatus_.lastUpdateAtMs = nowMs;

    ++currentStatus_.updateSequence;

    if (currentStatus_.lastUpdateDurationUs >
        policy_.maximumUpdateDurationUs)
    {
        ++currentStatus_.overrunCount;

        if (currentStatus_.consecutiveOverruns <
            UINT8_MAX)
        {
            ++currentStatus_.consecutiveOverruns;
        }

        if (currentStatus_.consecutiveOverruns >=
            policy_.maximumConsecutiveOverruns)
        {
            currentStatus_.error =
                RuntimeOrchestratorError::
                    UpdateOverrun;

            if (Logger::ready())
            {
                Logger::warning(
                    LogSource::System,
                    "RUNTIME_ORCH",
                    "Runtime update duration exceeded limit");
            }
        }
    }
    else
    {
        currentStatus_.consecutiveOverruns = 0;

        if (currentStatus_.error ==
            RuntimeOrchestratorError::UpdateOverrun)
        {
            currentStatus_.error =
                RuntimeOrchestratorError::None;
        }
    }

    currentStatus_.lastResult = result;
    currentStatus_.updateInProgress = false;

    if (currentStatus_.shutdownPending)
    {
        transitionTo(
            RuntimeOrchestratorState::
                ShutdownPending,
            RuntimeOrchestratorStage::Shutdown);
    }
    else if (currentStatus_.suspended)
    {
        transitionTo(
            RuntimeOrchestratorState::Suspended,
            RuntimeOrchestratorStage::None);
    }
    else if (
        result == RuntimeResult::Ok &&
        currentStatus_.state !=
            RuntimeOrchestratorState::Failed)
    {
        transitionTo(
            RuntimeOrchestratorState::Running,
            RuntimeOrchestratorStage::None);
    }

    notifyStateChanged();

    return result;
}

void RuntimeOrchestrator::end()
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    transitionTo(
        RuntimeOrchestratorState::Stopping,
        RuntimeOrchestratorStage::Shutdown);

    if (RuntimeSessionBridge::ready() &&
        RuntimeSessionBridge::sessionActive())
    {
        RuntimeSessionBridge::closeImmediately(
            RuntimeSessionExitReason::Shutdown,
            false);
    }
    else if (
        RuntimeModuleManager::ready() &&
        (RuntimeModuleManager::foregroundActive() ||
         RuntimeModuleManager::state() ==
             RuntimeModuleState::Failed))
    {
        RuntimeModuleManager::closeForeground();
    }

    stopCoordinators();

    currentStatus_.initialized = false;
    currentStatus_.updateInProgress = false;
    currentStatus_.suspended = false;
    currentStatus_.foregroundActive = false;
    currentStatus_.shutdownPending = false;
    currentStatus_.fatalHealth = false;

    currentStatus_.moduleKind =
        RuntimeModuleKind::None;

    currentStatus_.moduleState =
        RuntimeModuleState::Stopped;

    currentStatus_.engine =
