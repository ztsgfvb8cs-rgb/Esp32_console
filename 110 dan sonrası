    switch (item.kind)
    {
        case ContentKind::BuiltinGame:
            return RuntimeModuleKind::BuiltinGame;

        case ContentKind::Rom:
            return RuntimeModuleKind::Emulator;

        case ContentKind::Pdf:
            return RuntimeModuleKind::PdfReader;

        case ContentKind::Music:
            return RuntimeModuleKind::MediaViewer;

        case ContentKind::SaveData:
        case ContentKind::Firmware:
            return RuntimeModuleKind::SystemTool;

        case ContentKind::Unknown:
        default:
            return RuntimeModuleKind::None;
    }
}

bool RuntimeModuleManager::validateContent(
    const ContentItem& item,
    RuntimeModuleKind expectedKind)
{
    if (!item.available)
    {
        return false;
    }

    switch (expectedKind)
    {
        case RuntimeModuleKind::BuiltinGame:
            return
                item.kind == ContentKind::BuiltinGame &&
                item.engine == EngineKind::Builtin &&
                item.id[0] != '\0';

        case RuntimeModuleKind::Emulator:
            return
                item.kind == ContentKind::Rom &&
                isEmulatorEngine(item.engine) &&
                item.path[0] != '\0';

        case RuntimeModuleKind::PdfReader:
            return
                item.kind == ContentKind::Pdf &&
                item.path[0] != '\0';

        case RuntimeModuleKind::MediaViewer:
            return
                item.kind == ContentKind::Music &&
                item.path[0] != '\0';

        case RuntimeModuleKind::SystemTool:
            return
                item.kind == ContentKind::SaveData ||
                item.kind == ContentKind::Firmware;

        case RuntimeModuleKind::None:
        default:
            return false;
    }
}

RuntimeResult RuntimeModuleManager::startGameSession(
    const ContentItem& item,
    RuntimeModuleKind kind)
{
    if (kind != RuntimeModuleKind::BuiltinGame &&
        kind != RuntimeModuleKind::Emulator)
    {
        return RuntimeResult::Unsupported;
    }

    return GameSession::start(item);
}

RuntimeResult RuntimeModuleManager::startPdfSession(
