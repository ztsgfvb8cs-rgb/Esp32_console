//---------------- Internal Storage ----------------

static StoredPlaytimeRecord playtimeRecords[
    MAX_PLAYTIME_RECORDS
];


static uint16_t playtimeRecordCount =
    0;


static bool playtimeStorageReady =
    false;


static PlaytimeStorageStatus playtimeStorageStatus =
    PLAYTIME_STORAGE_NOT_INITIALIZED;


//---------------- Internal Functions ----------------

static void clearStoredRecord(
    StoredPlaytimeRecord& record
)
{
    memset(
        &record,
        0,
        sizeof(StoredPlaytimeRecord)
    );


    record.gameID =
        PLAYTIME_INVALID_GAME_ID;


    record.statistics.gameID =
        PLAYTIME_INVALID_GAME_ID;


    record.valid =
        false;
}



static void clearMemoryRecords()
{
    playtimeRecordCount =
        0;


    for(uint16_t i = 0;
        i < MAX_PLAYTIME_RECORDS;
        i++)
    {
        clearStoredRecord(
            playtimeRecords[i]
        );
    }
}



static int16_t findRecordIndex(
    uint16_t gameID
)
{
    if(gameID ==
       PLAYTIME_INVALID_GAME_ID)
    {
        return -1;
    }


    for(uint16_t i = 0;
        i < playtimeRecordCount;
        i++)
    {
        if(playtimeRecords[i].valid &&
           playtimeRecords[i].gameID == gameID)
        {
            return (int16_t)i;
        }
    }


    return -1;
}



static bool ensureStorageFolder()
{
    if(SD.exists(
        PLAYTIME_STORAGE_FOLDER
    ))
    {
        return true;
    }


    return SD.mkdir(
        PLAYTIME_STORAGE_FOLDER
    );
}



static uint32_t getCurrentStorageUnixTime()
{
    if(!isRTCInitialized() ||
       !isRTCAvailable() ||
       !isRTCDateTimeValid())
    {
        return 0;
    }


    return getRTCUnixTime();
}



static uint32_t calculateBufferChecksum(
    const uint8_t* data,
    size_t length
)
{
    if(data == nullptr ||
       length == 0)
    {
        return 0;
    }


    uint32_t checksum =
        2166136261UL;


    for(size_t i = 0;
        i < length;
        i++)
    {
        checksum ^=
            data[i];


        checksum *=
            16777619UL;
    }


    return checksum;
}



static bool copyFile(
    const char* sourcePath,
    const char* destinationPath
)
{
    if(sourcePath == nullptr ||
       destinationPath == nullptr)
    {
        return false;
    }


    File sourceFile =
        SD.open(
            sourcePath,
            FILE_READ
        );


    if(!sourceFile)
    {
        return false;
    }


    if(SD.exists(
        destinationPath
    ))
    {
        SD.remove(
            destinationPath
        );
    }


    File destinationFile =
        SD.open(
            destinationPath,
            FILE_WRITE
        );


    if(!destinationFile)
    {
        sourceFile.close();

        return false;
    }


    uint8_t buffer[512];


    bool result =
        true;


    while(sourceFile.available())
    {
        size_t bytesRead =
            sourceFile.read(
                buffer,
                sizeof(buffer)
            );


        if(bytesRead == 0)
        {
            break;
        }


        size_t bytesWritten =
            destinationFile.write(
                buffer,
                bytesRead
            );


        if(bytesWritten != bytesRead)
        {
            result =
                false;

            break;
        }
    }


    destinationFile.flush();

    destinationFile.close();

    sourceFile.close();


    if(!result)
    {
        SD.remove(
            destinationPath
        );
    }


    return result;
}



static void fillStorageHeader(
    PlaytimeStorageHeader& header
)
{
    header.magic =
        PLAYTIME_STORAGE_MAGIC;


    header.version =
        PLAYTIME_STORAGE_VERSION;


    header.recordCount =
        playtimeRecordCount;


    header.maximumRecords =
        MAX_PLAYTIME_RECORDS;


    header.reserved =
        0;


    header.dataChecksum =
        calculatePlaytimeStorageChecksum();
}



static bool writeStorageToFile(
    const char* path
)
{
    if(path == nullptr)
    {
        return false;
    }


    File file =
        SD.open(
            path,
            FILE_WRITE
        );


    if(!file)
    {
        return false;
    }


    PlaytimeStorageHeader header;


    fillStorageHeader(
        header
    );


    size_t headerWritten =
        file.write(
            reinterpret_cast<const uint8_t*>(
                &header
            ),
            sizeof(PlaytimeStorageHeader)
        );


    if(headerWritten !=
       sizeof(PlaytimeStorageHeader))
    {
        file.close();

        return false;
    }


    for(uint16_t i = 0;
        i < playtimeRecordCount;
        i++)
    {
        size_t recordWritten =
            file.write(
                reinterpret_cast<const uint8_t*>(
                    &playtimeRecords[i]
                ),
                sizeof(StoredPlaytimeRecord)
            );


        if(recordWritten !=
           sizeof(StoredPlaytimeRecord))
        {
            file.close();

            return false;
        }
    }


    file.flush();

    file.close();


    return true;
}



static bool readStorageFromFile(
    const char* path
)
{
    if(path == nullptr)
    {
        return false;
    }


    File file =
        SD.open(
            path,
            FILE_READ
        );


    if(!file)
    {
        return false;
    }


    if(file.size() <
       sizeof(PlaytimeStorageHeader))
    {
        file.close();

        return false;
    }


    PlaytimeStorageHeader header;


    size_t headerRead =
        file.read(
            reinterpret_cast<uint8_t*>(
                &header
            ),
            sizeof(PlaytimeStorageHeader)
        );


    if(headerRead !=
       sizeof(PlaytimeStorageHeader))
    {
        file.close();

        return false;
    }


    if(header.magic !=
       PLAYTIME_STORAGE_MAGIC)
    {
        file.close();

        return false;
    }


    if(header.version !=
       PLAYTIME_STORAGE_VERSION)
    {
        file.close();

        return false;
    }


    if(header.recordCount >
       MAX_PLAYTIME_RECORDS)
    {
        file.close();

        return false;
    }


    clearMemoryRecords();


    for(uint16_t i = 0;
        i < header.recordCount;
        i++)
    {
        StoredPlaytimeRecord record;


        size_t recordRead =
            file.read(
                reinterpret_cast<uint8_t*>(
                    &record
                ),
                sizeof(StoredPlaytimeRecord)
            );


        if(recordRead !=
           sizeof(StoredPlaytimeRecord))
        {
            clearMemoryRecords();

            file.close();

            return false;
        }


        if(!validatePlaytimeRecord(
            record
        ))
        {
            clearMemoryRecords();

            file.close();

            return false;
        }


        playtimeRecords[
            playtimeRecordCount
        ] = record;


        playtimeRecordCount++;
    }


    file.close();


    uint32_t calculatedChecksum =
        calculatePlaytimeStorageChecksum();


    if(calculatedChecksum !=
       header.dataChecksum)
    {
        clearMemoryRecords();

        return false;
    }


    return true;
}



//---------------- Initialization ----------------

bool initPlaytimeStorage()
{
    clearMemoryRecords();


    playtimeStorageReady =
        false;


    playtimeStorageStatus =
        PLAYTIME_STORAGE_NOT_INITIALIZED;


    if(!ensureStorageFolder())
    {
        playtimeStorageStatus =
            PLAYTIME_STORAGE_SD_ERROR;


        return false;
    }


    if(!SD.exists(
        PLAYTIME_STORAGE_FILE
    ))
    {
        if(!createPlaytimeStorageFile())
        {
            playtimeStorageStatus =
                PLAYTIME_STORAGE_FILE_ERROR;


            return false;
        }
    }


    if(!loadPlaytimeStorage())
    {
        if(SD.exists(
            PLAYTIME_STORAGE_BACKUP_FILE
        ))
        {
            if(restorePlaytimeStorageBackup())
            {
                playtimeStorageReady =
                    true;


                playtimeStorageStatus =
                    PLAYTIME_STORAGE_READY;


                return true;
            }
        }


        playtimeStorageStatus =
            PLAYTIME_STORAGE_INVALID_FILE;


        return false;
    }


    playtimeStorageReady =
        true;


    playtimeStorageStatus =
        PLAYTIME_STORAGE_READY;


    return true;
}



//---------------- Storage State ----------------

bool isPlaytimeStorageReady()
{
    return playtimeStorageReady;
}



PlaytimeStorageStatus getPlaytimeStorageStatus()
{
    return playtimeStorageStatus;
