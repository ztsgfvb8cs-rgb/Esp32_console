PcmRingBuffer::~PcmRingBuffer()
{
    end();
}

RuntimeResult PcmRingBuffer::begin(
    const PcmRingBufferConfig& config)
{
    ReservationLockGuard guard;

    if (initialized_ || backing_)
    {
        return setError(
            PcmRingBufferError::AlreadyInitialized,
            RuntimeResult::Busy);
    }

    if (!validConfig(config))
    {
        return setError(
            validFormat(config.format)
                ? PcmRingBufferError::InvalidConfiguration
                : PcmRingBufferError::InvalidFormat,
            RuntimeResult::InvalidArgument);
    }

    const size_t bytes = requiredBytes(
        config.format,
        config.capacityFrames);

    if (bytes == 0U)
    {
        return setError(
            PcmRingBufferError::InvalidCapacity,
            RuntimeResult::InvalidArgument);
    }

    if (!MemoryManager::begin())
    {
        return setError(
            PcmRingBufferError::BackingAllocationFailed,
            RuntimeResult::NotReady);
    }

    MemoryBlock block = MemoryManager::allocate(
        bytes,
        config.preference,
        config.clearBackingStore);

    if (!block || block.size < bytes)
    {
        if (block)
        {
            MemoryManager::release(block);
        }

        return setError(
            PcmRingBufferError::BackingAllocationFailed,
            RuntimeResult::OutOfMemory);
    }

    const uint32_t generation = nextGeneration(
        generation_.load(std::memory_order_relaxed));

    backing_ = block;
    config_ = config;

    readFrame_.store(0U, std::memory_order_relaxed);
    writeFrame_.store(0U, std::memory_order_relaxed);
    usedFrames_.store(0U, std::memory_order_relaxed);
    producerReservationFrames_.store(
        0U,
        std::memory_order_relaxed);
    consumerReservationFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalWrittenFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalReadFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalSilenceFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalDiscardedFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalOverwrittenFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalRejectedFrames_.store(
        0U,
        std::memory_order_relaxed);

    writeCount_.store(
        0U,
        std::memory_order_relaxed);

    readCount_.store(
        0U,
        std::memory_order_relaxed);

    overflowCount_.store(
        0U,
        std::memory_order_relaxed);

    underflowCount_.store(
        0U,
        std::memory_order_relaxed);

    resetCount_.store(
        0U,
        std::memory_order_relaxed);

    highWatermarkReachedFrames_.store(
        0U,
        std::memory_order_relaxed);

    generation_.store(
        generation,
        std::memory_order_release);

    lastError_.store(
        PcmRingBufferError::None,
        std::memory_order_relaxed);

    initialized_ = true;
    ownsBackingStore_ = true;
    backingIsPsram_ = backing_.psram;

    return RuntimeResult::Ok;
}

RuntimeResult PcmRingBuffer::begin(
    const I2sAudioFormat& formatValue,
    size_t capacityFramesValue,
    MemoryPreference preference)
{
    PcmRingBufferConfig config;

    config.format = formatValue;
    config.capacityFrames = capacityFramesValue;
    config.preference = preference;

    config.lowWatermarkFrames = minimumSize(
        PCM_RING_BUFFER_DEFAULT_LOW_WATER_FRAMES,
        capacityFramesValue / 4U);

    config.highWatermarkFrames = minimumSize(
        PCM_RING_BUFFER_DEFAULT_HIGH_WATER_FRAMES,
        capacityFramesValue -
            capacityFramesValue / 4U);

    if (config.highWatermarkFrames <
        config.lowWatermarkFrames)
    {
        config.highWatermarkFrames =
            config.lowWatermarkFrames;
    }

    return begin(config);
}

RuntimeResult PcmRingBuffer::attach(
    int16_t* externalSamples,
    size_t externalSampleCount,
    const PcmRingBufferConfig& config)
{
    ReservationLockGuard guard;

    if (initialized_ || backing_)
    {
        return setError(
            PcmRingBufferError::AlreadyInitialized,
            RuntimeResult::Busy);
    }

    if (externalSamples == nullptr)
    {
        return setError(
            PcmRingBufferError::InvalidPointer,
            RuntimeResult::InvalidArgument);
    }

    if ((reinterpret_cast<uintptr_t>(
             externalSamples) %
         alignof(int16_t)) != 0U)
    {
        return setError(
            PcmRingBufferError::InvalidAlignment,
            RuntimeResult::InvalidArgument);
    }

    if (!validConfig(config))
    {
        return setError(
            validFormat(config.format)
                ? PcmRingBufferError::InvalidConfiguration
                : PcmRingBufferError::InvalidFormat,
            RuntimeResult::InvalidArgument);
    }

    const size_t requiredSamples =
        config.capacityFrames *
        static_cast<size_t>(
            config.format.channelCount);

    if (externalSampleCount < requiredSamples)
    {
        return setError(
            PcmRingBufferError::InvalidCapacity,
            RuntimeResult::InvalidArgument);
    }

    const size_t bytes = requiredBytes(
        config.format,
        config.capacityFrames);

    if (bytes == 0U)
    {
        return setError(
            PcmRingBufferError::InvalidCapacity,
            RuntimeResult::InvalidArgument);
    }

    if (config.clearBackingStore)
    {
        memset(
            externalSamples,
            0,
            bytes);
    }

    const uint32_t generation = nextGeneration(
        generation_.load(
            std::memory_order_relaxed));

    backing_ = {};
    backing_.data = externalSamples;
    backing_.size = bytes;
    backing_.psram = false;

    config_ = config;

    readFrame_.store(
        0U,
        std::memory_order_relaxed);

    writeFrame_.store(
        0U,
        std::memory_order_relaxed);

    usedFrames_.store(
        0U,
        std::memory_order_relaxed);

    producerReservationFrames_.store(
        0U,
        std::memory_order_relaxed);

    consumerReservationFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalWrittenFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalReadFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalSilenceFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalDiscardedFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalOverwrittenFrames_.store(
        0U,
        std::memory_order_relaxed);

    totalRejectedFrames_.store(
        0U,
        std::memory_order_relaxed);

    writeCount_.store(
        0U,
        std::memory_order_relaxed);

    readCount_.store(
        0U,
        std::memory_order_relaxed);

    overflowCount_.store(
        0U,
        std::memory_order_relaxed);

    underflowCount_.store(
        0U,
        std::memory_order_relaxed);

    resetCount_.store(
        0U,
        std::memory_order_relaxed);

    highWatermarkReachedFrames_.store(
        0U,
        std::memory_order_relaxed);

    generation_.store(
        generation,
        std::memory_order_release);

    lastError_.store(
        PcmRingBufferError::None,
        std::memory_order_relaxed);

    initialized_ = true;
    ownsBackingStore_ = false;
    backingIsPsram_ = false;

    return RuntimeResult::Ok;
}

void PcmRingBuffer::end()
{
    ReservationLockGuard guard;

    const uint32_t generation = nextGeneration(
        generation_.load(
            std::memory_order_relaxed));

    if (ownsBackingStore_ && backing_)
    {
        MemoryManager::release(backing_);
    }

    backing_ = {};
    config_ = {};

    readFrame_.store(
        0U,
        std::memory_order_relaxed);

    writeFrame_.store(
        0U,
        std::memory_order_relaxed);

    usedFrames_.store(
        0U,
        std::memory_order_relaxed);

