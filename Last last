const int64_t STAT_INT64_MAX = 9223372036854775807LL;
const int64_t STAT_INT64_MIN = (-9223372036854775807LL - 1LL);

void removeCarriageReturn(String& value)
{
    while (value.endsWith("\r"))
        value.remove(value.length() - 1);
}

uint16_t countFields(const String& line)
{
    if (line.length() == 0)
        return 0;

    uint16_t count = 1;

    for (uint32_t i = 0; i < line.length(); i++)
    {
        if (line.charAt(i) == '|')
            count++;
    }

    return count;
}

bool readField(
    const String& line,
    uint8_t requestedField,
    String& result
)
{
    uint32_t fieldStart = 0;
    uint8_t currentField = 0;

    for (uint32_t i = 0; i <= line.length(); i++)
    {
        bool fieldEnd =
            (i == line.length()) ||
            (line.charAt(i) == '|');

        if (!fieldEnd)
            continue;

        if (currentField == requestedField)
        {
            result = line.substring(fieldStart, i);
            return true;
        }

        currentField++;
        fieldStart = i + 1;
    }

    result = "";
    return false;
}

bool isHexCharacter(char value)
{
    return
        (value >= '0' && value <= '9') ||
        (value >= 'A' && value <= 'F') ||
        (value >= 'a' && value <= 'f');
}

uint8_t hexCharacterValue(char value)
{
    if (value >= '0' && value <= '9')
        return static_cast<uint8_t>(value - '0');

    if (value >= 'A' && value <= 'F')
        return static_cast<uint8_t>(value - 'A' + 10);

    return static_cast<uint8_t>(value - 'a' + 10);
}

String encodeTextValue(const String& value)
{
    static const char HEX[] = "0123456789ABCDEF";

    String result;
    result.reserve(value.length() + 8);

    for (uint32_t i = 0; i < value.length(); i++)
    {
        uint8_t current =
            static_cast<uint8_t>(value.charAt(i));

        bool mustEncode =
            current == '%' ||
            current == '|' ||
            current == '\r' ||
            current == '\n' ||
            current < 32 ||
            current == 127;

        if (!mustEncode)
        {
            result += static_cast<char>(current);
            continue;
        }

        result += '%';
        result += HEX[(current >> 4) & 0x0F];
        result += HEX[current & 0x0F];
    }

    return result;
}

bool decodeTextValue(
    const String& value,
    String& result
)
{
    result = "";
    result.reserve(value.length());

    for (uint32_t i = 0; i < value.length(); i++)
    {
        char current = value.charAt(i);

        if (current != '%')
        {
            result += current;
            continue;
        }

        if (i + 2 >= value.length())
            return false;

        char high = value.charAt(i + 1);
        char low = value.charAt(i + 2);

        if (!isHexCharacter(high) ||
            !isHexCharacter(low))
        {
            return false;
        }

        uint8_t decoded =
            static_cast<uint8_t>(
                hexCharacterValue(high) << 4
            );

        decoded |= hexCharacterValue(low);

        result += static_cast<char>(decoded);
        i += 2;
    }

    return true;
}

bool parseUnsigned32(
    const String& value,
    uint32_t& result
)
{
    if (value.length() == 0)
        return false;

    uint64_t parsed = 0;

    for (uint32_t i = 0; i < value.length(); i++)
    {
        char current = value.charAt(i);

        if (current < '0' || current > '9')
            return false;

        parsed =
            (parsed * 10ULL) +
            static_cast<uint8_t>(current - '0');

        if (parsed > 0xFFFFFFFFULL)
            return false;
    }

    result = static_cast<uint32_t>(parsed);
    return true;
}

bool parseSigned64(
    const String& value,
    int64_t& result
)
{
    if (value.length() == 0)
        return false;

    uint32_t index = 0;
    bool negative = false;

    char first = value.charAt(0);

    if (first == '-' || first == '+')
    {
        negative = first == '-';
        index = 1;

        if (index >= value.length())
            return false;
    }

    const uint64_t positiveLimit =
        9223372036854775807ULL;

    const uint64_t negativeLimit =
        9223372036854775808ULL;

    uint64_t limit =
        negative
            ? negativeLimit
            : positiveLimit;

    uint64_t parsed = 0;

    for (; index < value.length(); index++)
    {
        char current = value.charAt(index);

        if (current < '0' || current > '9')
            return false;

        uint8_t digit =
            static_cast<uint8_t>(current - '0');

        if (parsed > (limit - digit) / 10ULL)
            return false;

        parsed = (parsed * 10ULL) + digit;
    }

    if (!negative)
    {
        result = static_cast<int64_t>(parsed);
        return true;
    }

    if (parsed == negativeLimit)
    {
        result = STAT_INT64_MIN;
        return true;
    }

    result = -static_cast<int64_t>(parsed);
    return true;
}

String signed64ToString(int64_t value)
{
    char buffer[24];
    uint8_t position = sizeof(buffer) - 1;

    buffer[position] = '\0';

    bool negative = value < 0;

    uint64_t magnitude = 0;

    if (negative)
    {
        magnitude =
            static_cast<uint64_t>(
                -(value + 1)
            ) + 1ULL;
    }
    else
    {
        magnitude =
            static_cast<uint64_t>(value);
    }

    do
    {
        uint8_t digit =
            static_cast<uint8_t>(
                magnitude % 10ULL
            );

        magnitude /= 10ULL;

        buffer[--position] =
            static_cast<char>('0' + digit);
    }
    while (magnitude > 0);

    if (negative)
        buffer[--position] = '-';

    return String(&buffer[position]);
}

