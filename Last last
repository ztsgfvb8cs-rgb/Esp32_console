}



static bool writeProfileFile(
    const char* path,
    const PlayerProfile& profile
)
{
    if(path == nullptr)
    {
        return false;
    }


    File file =
        SD.open(
            path,
            FILE_WRITE
        );


    if(!file)
    {
        return false;
    }


    ProfileStorageHeader header;


    fillProfileStorageHeader(
        header,
        profile
    );


    size_t headerWritten =
        file.write(
            reinterpret_cast<const uint8_t*>(
                &header
            ),
            sizeof(ProfileStorageHeader)
        );


    if(headerWritten !=
       sizeof(ProfileStorageHeader))
    {
        file.close();

        return false;
    }


    size_t profileWritten =
        file.write(
            reinterpret_cast<const uint8_t*>(
                &profile
            ),
            sizeof(PlayerProfile)
        );


    if(profileWritten !=
       sizeof(PlayerProfile))
    {
        file.close();

        return false;
    }


    file.flush();

    file.close();


    return true;
}



static bool readProfileFile(
    const char* path,
    PlayerProfile& profile,
    ProfileStorageHeader* outputHeader
)
{
    if(path == nullptr)
    {
        return false;
    }


    File file =
        SD.open(
            path,
            FILE_READ
        );


    if(!file)
    {
        return false;
    }


    size_t expectedSize =
        sizeof(ProfileStorageHeader) +
        sizeof(PlayerProfile);


    if(file.size() <
       expectedSize)
    {
        file.close();

        return false;
    }


    ProfileStorageHeader header;


    size_t headerRead =
        file.read(
            reinterpret_cast<uint8_t*>(
                &header
            ),
            sizeof(ProfileStorageHeader)
        );


    if(headerRead !=
       sizeof(ProfileStorageHeader))
    {
        file.close();

        return false;
    }


    if(header.magic !=
       PROFILE_STORAGE_MAGIC)
    {
        file.close();

        return false;
    }


    if(header.version !=
       PROFILE_STORAGE_VERSION)
    {
        file.close();

        return false;
    }


    if(header.profileDataSize !=
       sizeof(PlayerProfile))
    {
        file.close();

        return false;
    }


    size_t profileRead =
        file.read(
            reinterpret_cast<uint8_t*>(
                &profile
            ),
            sizeof(PlayerProfile)
        );


    file.close();


    if(profileRead !=
       sizeof(PlayerProfile))
    {
        return false;
    }


    if(profile.profileID !=
       header.profileID)
    {
        return false;
    }


    uint32_t calculatedChecksum =
        calculateProfileChecksum(
            profile
        );


    if(calculatedChecksum !=
       header.profileChecksum)
    {
        return false;
    }


    if(!validateStoredProfile(
        profile
    ))
    {
        return false;
    }


    if(outputHeader != nullptr)
    {
        *outputHeader =
            header;
    }


    return true;
}



static bool writeProfileIndexFile(
    const char* path
)
{
    if(path == nullptr)
    {
        return false;
    }


    File file =
        SD.open(
            path,
            FILE_WRITE
        );


    if(!file)
    {
        return false;
    }


    ProfileIndexHeader header;


    fillProfileIndexHeader(
        header
    );


    size_t headerWritten =
        file.write(
            reinterpret_cast<const uint8_t*>(
                &header
            ),
            sizeof(ProfileIndexHeader)
        );


    if(headerWritten !=
       sizeof(ProfileIndexHeader))
    {
        file.close();

        return false;
    }


    for(uint8_t i = 0;
        i < profileIndexCount;
        i++)
    {
        size_t entryWritten =
            file.write(
                reinterpret_cast<const uint8_t*>(
                    &profileIndex[i]
                ),
                sizeof(ProfileIndexEntry)
            );


        if(entryWritten !=
           sizeof(ProfileIndexEntry))
        {
            file.close();

            return false;
        }
    }


    file.flush();

    file.close();


    return true;
}



