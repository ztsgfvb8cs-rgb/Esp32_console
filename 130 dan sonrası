RuntimeResult Mp3Decoder::open(
    const char* pathValue,
    const Mp3DecoderConfig& config)
{
    if (status_.open || stream_)
    {
        return setError(
            Mp3DecoderError::AlreadyOpen,
            RuntimeResult::Busy);
    }

    if (!validConfig(config))
    {
        return setError(
            Mp3DecoderError::InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    const size_t pathLength =
        boundedStringLength(
            pathValue,
            MP3_DECODER_PATH_CAPACITY);

    if (pathValue == nullptr ||
        pathLength == 0U ||
        pathLength >= MP3_DECODER_PATH_CAPACITY)
    {
        return setError(
            Mp3DecoderError::InvalidPath,
            RuntimeResult::InvalidArgument);
    }

    if (!SdStreamService::ready())
    {
        return setError(
            Mp3DecoderError::StreamServiceNotReady,
            RuntimeResult::NotReady);
    }

    config_ = config;

    const RuntimeResult backendResult =
        allocateBackend();

    if (backendResult != RuntimeResult::Ok)
    {
        config_ = {};
        return backendResult;
    }

    SdStreamOpenOptions options;

    options.purpose = SdStreamPurpose::Audio;
    options.bufferCapacityBytes =
        config.sourceBufferCapacityBytes;
    options.bufferPreference =
        config.sourceBufferPreference;
    options.readChunkBytes =
        config.sourceReadChunkBytes;
    options.refillThresholdBytes =
        config.sourceRefillThresholdBytes;
    options.initialPrefetchBytes =
        config.sourceInitialPrefetchBytes;
    options.startOffsetBytes = 0U;
    options.retryLimit = config.sourceRetryLimit;
    options.retryDelayMs = config.sourceRetryDelayMs;
    options.allowPartialReads = true;
    options.clearBufferOnClose =
        config.clearSourceBufferOnClose;
    options.automaticallyPrefetch = true;
    options.pauseAtEndOfFile = false;

    SdStreamHandle openedStream;

    const RuntimeResult openResult =
        SdStreamService::open(
            pathValue,
            openedStream,
            options);

    if (openResult != RuntimeResult::Ok)
    {
        releaseBackend();
        config_ = {};

        return setError(
            Mp3DecoderError::OpenFailed,
            openResult);
    }

    const uint32_t generation =
        nextGeneration(status_.generation);

    status_ = {};
    stream_ = openedStream;
    parsePhase_ = ParsePhase::Id3v2Header;
    pendingId3v2Bytes_ = 0U;
    firstFrameOffsetBytes_ = 0U;
    nextSeekIndexAtMs_ = 0U;

    memset(
        id3HeaderScratch_,
        0,
        sizeof(id3HeaderScratch_));

    memset(
        frameHeaderScratch_,
        0,
        sizeof(frameHeaderScratch_));

    status_.open = true;
    status_.backendReady = backend_ != nullptr;
    status_.state =
        Mp3DecoderState::ParsingMetadata;
    status_.error = Mp3DecoderError::None;
    status_.fileSizeBytes =
        SdStreamService::fileSize(stream_);
    status_.generation = generation;
    status_.seekIndexCapacity =
        config_.buildSparseSeekIndex
            ? config_.maximumSeekIndexEntries
            : 0U;

    memcpy(
        status_.path,
        pathValue,
        pathLength);

    status_.path[pathLength] = '\0';

    notifyStateChanged();

    return RuntimeResult::Ok;
}

void Mp3Decoder::close()
{
    const uint32_t generation =
        nextGeneration(status_.generation);

    if (stream_)
    {
        SdStreamService::close(stream_);
    }

    releaseBackend();

    config_ = {};
    status_ = {};
    status_.generation = generation;
    status_.state = Mp3DecoderState::Closed;

    stream_ = {};
    parsePhase_ = ParsePhase::Id3v2Header;
    pendingId3v2Bytes_ = 0U;
    firstFrameOffsetBytes_ = 0U;
    nextSeekIndexAtMs_ = 0U;

    memset(
        id3HeaderScratch_,
        0,
        sizeof(id3HeaderScratch_));

    memset(
        frameHeaderScratch_,
        0,
        sizeof(frameHeaderScratch_));
}

