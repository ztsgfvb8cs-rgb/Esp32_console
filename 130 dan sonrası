size_t I2sAudioBackend::requiredInternalBytes(
    const I2sAudioBackendConfig& config)
{
    if (!validFormat(config.format) ||
        config.dmaBufferCount == 0U ||
        config.dmaFramesPerBuffer == 0U)
    {
        return 0;
    }

    const size_t frameBytes =
        hardwareFrameBytes(config);

    size_t bytes = saturatingMultiplySize(
        config.dmaBufferCount,
        config.dmaFramesPerBuffer);

    bytes = saturatingMultiplySize(
        bytes,
        frameBytes);

    if (bytes == SIZE_MAX)
    {
        return 0;
    }

    bytes = saturatingAddSize(
        bytes,
        I2S_AUDIO_DRIVER_OVERHEAD_BUDGET_BYTES);

    if (config.format.channelCount == 1U &&
        config.duplicateMonoToStereo)
    {
        const size_t scratchBytes =
            saturatingMultiplySize(
                config.dmaFramesPerBuffer,
                2U * SAMPLE_BYTES);

        bytes = saturatingAddSize(
            bytes,
            scratchBytes);
    }

    return bytes == SIZE_MAX
        ? 0U
        : bytes;
}

