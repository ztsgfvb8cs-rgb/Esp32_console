//---------------- Start Session ----------------


bool startPlaytimeSession(
    uint16_t gameID
)
{
    return startPlaytimeSession(
        gameID,
        PLAYTIME_MODE_UNKNOWN,
        PLAYTIME_DIFFICULTY_UNKNOWN
    );
}



bool startPlaytimeSession(
    uint16_t gameID,
    uint8_t gameMode,
    uint8_t difficulty
)
{
    if(gameID == PLAYTIME_INVALID_GAME_ID)
    {
        return false;
    }



    if(!isValidGameMode(gameMode))
    {
        return false;
    }



    if(!isValidDifficulty(difficulty))
    {
        return false;
    }



    if(currentSession.valid)
    {
        stopPlaytimeSession(
            false
        );
    }



    if(!currentStatistics.initialized ||
       currentStatistics.gameID != gameID)
    {
        clearStatisticsData();


        currentStatistics.gameID =
            gameID;


        currentStatistics.initialized =
            true;
    }



    uint32_t currentTime =
        millis();



    currentSession.gameID =
        gameID;


    currentSession.gameMode =
        gameMode;


    currentSession.difficulty =
        difficulty;


    currentSession.state =
        PLAYTIME_SESSION_RUNNING;


    currentSession.startTime =
        currentTime;


    currentSession.lastUpdateTime =
        currentTime;


    currentSession.pauseStartTime =
        0;


    currentSession.sessionMilliseconds =
        0;


    currentSession.pausedMilliseconds =
        0;


    currentSession.frameCount =
        0;


    currentSession.valid =
        true;



    currentStatistics.launchCount++;



    return true;
}



//---------------- Pause Session ----------------


bool pausePlaytimeSession()
{
    if(!currentSession.valid)
    {
        return false;
    }



    if(currentSession.state !=
       PLAYTIME_SESSION_RUNNING)
    {
        return false;
    }



    updatePlaytimeManager();



    currentSession.state =
        PLAYTIME_SESSION_PAUSED;


    currentSession.pauseStartTime =
        millis();



    return true;
}



//---------------- Resume Session ----------------


bool resumePlaytimeSession()
{
    if(!currentSession.valid)
    {
        return false;
    }



    if(currentSession.state !=
       PLAYTIME_SESSION_PAUSED)
    {
        return false;
    }



    uint32_t currentTime =
        millis();



    uint32_t pauseDuration =
        currentTime -
        currentSession.pauseStartTime;



    currentSession.pausedMilliseconds +=
        pauseDuration;


    currentSession.pauseStartTime =
        0;


    currentSession.lastUpdateTime =
        currentTime;


    currentSession.state =
        PLAYTIME_SESSION_RUNNING;



    return true;
}



//---------------- Stop Session ----------------


bool stopPlaytimeSession()
{
    return stopPlaytimeSession(
        true
    );
}



bool stopPlaytimeSession(
    bool completed
)
{
    if(!currentSession.valid)
    {
        return false;
    }



    if(currentSession.state ==
       PLAYTIME_SESSION_RUNNING)
    {
        updatePlaytimeManager();
    }



    if(currentSession.state ==
       PLAYTIME_SESSION_PAUSED)
    {
        uint32_t currentTime =
            millis();


        uint32_t pauseDuration =
            currentTime -
            currentSession.pauseStartTime;


        currentSession.pausedMilliseconds +=
            pauseDuration;


        currentSession.pauseStartTime =
            0;
    }



    updateSessionStatistics(
        completed
    );



    currentSession.state =
        PLAYTIME_SESSION_STOPPED;


    currentSession.valid =
        false;



    return true;
}



//---------------- Update ----------------


void updatePlaytimeManager()
{
    if(!currentSession.valid)
    {
        return;
    }



    if(currentSession.state !=
       PLAYTIME_SESSION_RUNNING)
    {
        return;
    }



    uint32_t currentTime =
        millis();



    uint32_t elapsedTime =
        currentTime -
        currentSession.lastUpdateTime;



    currentSession.sessionMilliseconds +=
        elapsedTime;


    currentSession.lastUpdateTime =
        currentTime;


    currentSession.frameCount++;
}



