RuntimeScreenMode RuntimeScreenRouter::resolveMode()
{
    const bool sessionActive =
        RuntimeSessionBridge::ready() &&
        RuntimeSessionBridge::sessionActive();

    const bool moduleActive =
        RuntimeModuleManager::ready() &&
        RuntimeModuleManager::foregroundActive();

    if (sessionActive || moduleActive)
    {
        const RuntimeModuleKind kind =
            sessionActive
                ? RuntimeSessionBridge::activeKind()
                : RuntimeModuleManager::activeKind();

        switch (kind)
        {
            case RuntimeModuleKind::BuiltinGame:
            case RuntimeModuleKind::Emulator:
                return RuntimeScreenMode::ForegroundGame;

            case RuntimeModuleKind::PdfReader:
                return RuntimeScreenMode::ForegroundPdf;

            case RuntimeModuleKind::MediaViewer:
            case RuntimeModuleKind::SystemTool:
            case RuntimeModuleKind::None:
            default:
                return RuntimeScreenMode::ErrorScreen;
        }
    }

    const AppScreen screen =
        ScreenManager::current();

    if (screen == AppScreen::Playing ||
        screen == AppScreen::PdfReader ||
        screen == AppScreen::Error)
    {
        return RuntimeScreenMode::ErrorScreen;
    }

    return RuntimeScreenMode::UserInterface;
}

bool RuntimeScreenRouter::foregroundStateValid(
    RuntimeScreenMode mode)
{
    if (!RuntimeSessionBridge::ready() ||
        !RuntimeModuleManager::ready() ||
        !RuntimeSessionBridge::sessionActive() ||
        !RuntimeModuleManager::foregroundActive())
    {
        return false;
    }

    const RuntimeModuleStatus moduleStatus =
        RuntimeModuleManager::status();

    if (moduleStatus.state !=
            RuntimeModuleState::Running ||
        moduleStatus.error !=
            RuntimeModuleError::None)
    {
        return false;
    }

    if (mode == RuntimeScreenMode::ForegroundGame)
    {
        const RuntimeModuleKind kind =
            RuntimeSessionBridge::activeKind();

        return
            ScreenManager::current() ==
                AppScreen::Playing &&
            (kind == RuntimeModuleKind::BuiltinGame ||
             kind == RuntimeModuleKind::Emulator) &&
            moduleStatus.kind == kind;
    }

    if (mode == RuntimeScreenMode::ForegroundPdf)
    {
        return
            ScreenManager::current() ==
                AppScreen::PdfReader &&
            RuntimeSessionBridge::activeKind() ==
                RuntimeModuleKind::PdfReader &&
            moduleStatus.kind ==
                RuntimeModuleKind::PdfReader;
    }

    return false;
}

bool RuntimeScreenRouter::periodicRefreshDue(
    uint32_t nowMs)
{
    if (currentStatus_.foregroundOwned)
    {
        return false;
    }

    switch (currentStatus_.screen)
    {
        case AppScreen::MainMenu:
            return
                policy_.refreshMainMenuPeriodically &&
                policy_.mainMenuRefreshIntervalMs > 0 &&
                nowMs -
                    currentStatus_.
                        lastPeriodicRefreshAtMs >=
                    policy_.
                        mainMenuRefreshIntervalMs;

        case AppScreen::SystemMonitor:
            return
                policy_.
                    refreshSystemMonitorPeriodically &&
                policy_.
                    systemMonitorRefreshIntervalMs > 0 &&
                nowMs -
                    currentStatus_.
                        lastPeriodicRefreshAtMs >=
                    policy_.
                        systemMonitorRefreshIntervalMs;

        default:
            return false;
    }
}

bool RuntimeScreenRouter::shouldRender(
    RuntimeScreenMode mode,
    uint32_t nowMs,
    uint32_t nowUs)
{
    (void)nowMs;

    if (currentStatus_.forceRequested)
    {
        return true;
    }

    switch (mode)
    {
        case RuntimeScreenMode::UserInterface:
        case RuntimeScreenMode::ErrorScreen:
            // ScreenManager retains its existing UI pacing
            // and dirty checks until the final integration
            // files replace that internal path.
            return true;

        case RuntimeScreenMode::ForegroundGame:
            if (!policy_.renderForegroundContinuously)
            {
                return currentStatus_.dirty;
            }

            if (FramePacer::shouldRender(nowUs))
            {
                currentStatus_.refreshReason =
                    RuntimeScreenRefreshReason::
                        ForegroundFrame;

                return true;
            }

            return false;

        case RuntimeScreenMode::ForegroundPdf:
            if (policy_.renderPdfOnlyWhenDirty)
            {
                return currentStatus_.dirty;
            }

            if (FramePacer::shouldRender(nowUs))
            {
                currentStatus_.refreshReason =
                    RuntimeScreenRefreshReason::
                        ForegroundFrame;

                return true;
            }

            return false;

        case RuntimeScreenMode::None:
        default:
            return false;
    }
}

RuntimeResult RuntimeScreenRouter::renderUserInterface(
    uint32_t nowMs)
{
    if (currentStatus_.foregroundOwned &&
        policy_.suppressUiDuringForeground)
    {
        return RuntimeResult::Busy;
    }

    if (currentStatus_.dirty ||
        currentStatus_.forceRequested)
    {
        ScreenManager::invalidate();
    }

    ScreenManager::update(nowMs);

    return RuntimeResult::Ok;
}

RuntimeResult RuntimeScreenRouter::renderForeground(
    uint32_t nowUs)
{
    if (!foregroundStateValid(currentStatus_.mode))
    {
        return RuntimeResult::InternalError;
    }

    RuntimeModuleManager::render();

    const RuntimeModuleStatus moduleStatus =
        RuntimeModuleManager::status();

    if (moduleStatus.state ==
            RuntimeModuleState::Failed ||
        moduleStatus.error !=
            RuntimeModuleError::None)
    {
        return RuntimeResult::InternalError;
    }

    if (currentStatus_.refreshReason ==
        RuntimeScreenRefreshReason::ForegroundFrame)
    {
        const uint32_t completedUs = micros();

        FramePacer::frameCompleted(
            completedUs == 0
                ? nowUs
                : completedUs);
    }

    return RuntimeResult::Ok;
}
