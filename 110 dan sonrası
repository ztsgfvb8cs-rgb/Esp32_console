bool AiDifficultyManager::validateProfile(
    const AiDifficultyProfile& value)
{
    if (!validLevel(value.level, false))
    {
        return false;
    }

    if (value.reactionDelayMs == 0 ||
        value.decisionIntervalMs == 0 ||
        value.mistakeCooldownMs == 0)
    {
        return false;
    }

    return
        value.aimErrorPermille <=
            AI_PERMILLE_MAX &&
        value.movementErrorPermille <=
            AI_PERMILLE_MAX &&
        value.randomnessPermille <=
            AI_PERMILLE_MAX &&
        value.predictionStrengthPermille <=
            AI_PERMILLE_MAX &&
        value.aggressionPermille <=
            AI_PERMILLE_MAX &&
        value.defensePermille <=
            AI_PERMILLE_MAX &&
        value.riskTakingPermille <=
            AI_PERMILLE_MAX &&
        value.recoveryPermille <=
            AI_PERMILLE_MAX;
}
