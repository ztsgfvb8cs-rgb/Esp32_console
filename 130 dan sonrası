RuntimeResult I2sAudioBackend::write(
    const int16_t* interleavedSamples,
    size_t frameCount,
    size_t& writtenFrames,
    uint32_t timeoutMs)
{
    writtenFrames = 0;

    if (!ready())
    {
        return setError(
            I2sAudioBackendError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (frameCount == 0)
    {
        currentStatus_.error =
            I2sAudioBackendError::None;

        return RuntimeResult::Ok;
    }

    if (interleavedSamples == nullptr)
    {
        return setError(
            I2sAudioBackendError::InvalidFormat,
            RuntimeResult::InvalidArgument);
    }

    if (!currentStatus_.transmitting ||
        currentStatus_.state !=
            I2sAudioBackendState::Running)
    {
        return setError(
            I2sAudioBackendError::Busy,
            RuntimeResult::Busy);
    }

    currentStatus_.totalSubmittedFrames =
        saturatingAdd64(
            currentStatus_.totalSubmittedFrames,
            frameCount);

    if (currentStatus_.muted ||
        currentStatus_.route == AudioRoute::Muted)
    {
        currentStatus_.totalDroppedFrames =
            saturatingAdd64(
                currentStatus_.totalDroppedFrames,
                frameCount);

        writtenFrames = frameCount;
        currentStatus_.writeCount =
            saturatingIncrement32(
                currentStatus_.writeCount);
        currentStatus_.lastWriteAtMs =
            platformMillis();
        currentStatus_.error =
            I2sAudioBackendError::None;

        refreshStatus();
        notifyStateChanged();

        return RuntimeResult::Ok;
    }

    const uint32_t effectiveTimeout =
        timeoutMs > 0U
            ? timeoutMs
            : config_.defaultWriteTimeoutMs;

    size_t sourceFrameOffset = 0;
    int nativeResult = 0;
    bool timeoutOccurred = false;

    while (sourceFrameOffset < frameCount)
    {
        const size_t remainingFrames =
            frameCount - sourceFrameOffset;

        size_t chunkFrames = remainingFrames;
        const void* writeData = nullptr;
        size_t writeBytes = 0;
        size_t nativeFrameBytes = 0;

        if (config_.format.channelCount == 1U &&
            config_.duplicateMonoToStereo)
        {
            chunkFrames = minimumSize(
                chunkFrames,
                static_cast<size_t>(
                    I2S_AUDIO_MAX_DMA_FRAMES_PER_BUFFER));

            for (size_t frameIndex = 0;
                 frameIndex < chunkFrames;
                 ++frameIndex)
            {
                const int16_t sample =
                    interleavedSamples[
                        sourceFrameOffset + frameIndex];

                sampleScratch[frameIndex * 2U] = sample;
                sampleScratch[frameIndex * 2U + 1U] = sample;
            }

            writeData = sampleScratch;
            nativeFrameBytes = 2U * SAMPLE_BYTES;
            writeBytes = chunkFrames * nativeFrameBytes;
