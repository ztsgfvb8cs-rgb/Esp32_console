bool validIdentifier(
    const String& value,
    uint32_t maximumLength
)
{
    if (value.length() == 0 ||
        value.length() > maximumLength)
    {
        return false;
    }

    for (uint32_t i = 0; i < value.length(); i++)
    {
        uint8_t current =
            static_cast<uint8_t>(value.charAt(i));

        if (current < 32 || current == 127)
            return false;
    }

    return true;
}

bool hasDuplicateID(
