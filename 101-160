//====================================================
// ESP32 GAME STATION
// LOW-LEVEL BOARD HARDWARE MANAGER
// 105_hardware_manager.h
//====================================================
//
// Responsibilities:
// - Places all outputs in a safe state before startup.
// - Configures direct buttons and detection inputs.
// - Starts the shared SPI bus and DS3231 I2C bus.
// - Verifies required PSRAM on ESP32-S3 N16R8.
// - Owns only low-level board control.
//
// Deliberately not handled here:
// - TFT_eSPI display initialization.
// - XPT2046 touch protocol.
// - SD filesystem mounting.
// - I2S audio driver installation.
// - PWM effects for backlight or vibration.
// - Phone keypad scanning.
//====================================================

enum class HardwareInitStage : uint8_t
{
    NONE = 0,
    VALIDATION,
    SAFE_OUTPUTS,
    INPUTS,
    SPI_BUS,
    I2C_BUS,
    MEMORY_CHECK,
    POWER_ENABLE,
    READY,
    FAILED
};

enum class HardwareError : uint8_t
{
    NONE = 0,
    INVALID_CONFIGURATION,
    OUTPUT_CONFIGURATION_FAILED,
    INPUT_CONFIGURATION_FAILED,
    I2C_INITIALIZATION_FAILED,
    PSRAM_NOT_FOUND,
    PSRAM_TOO_SMALL,
    BOOST_ENABLE_FAILED
};

enum class DirectButton : uint8_t
{
    UP = 0,
    DOWN,
    LEFT,
    RIGHT,
    A,
    B,
    MENU,
    BACK,
    COUNT
};

struct HardwareStatus
{
    bool initialized;
    bool spiReady;
    bool i2cReady;
    bool psramAvailable;
    bool boostEnabled;
    bool backlightEnabled;
    bool hapticEnabled;

    uint32_t psramBytes;

    HardwareInitStage stage;
    HardwareError error;
};

class HardwareManager
{
public:
    //================================================
    // LIFECYCLE
    //================================================

    static bool begin();
    static void end();

    static bool ready();
    static HardwareStatus status();

    static HardwareInitStage stage();
    static HardwareError lastError();

    //================================================
    // SHARED BUSES
    //================================================

    static SPIClass& sharedSpi();
    static TwoWire& rtcWire();

    //================================================
    // LOW-LEVEL OUTPUT CONTROL
    //================================================

    static bool setBoostEnabled(bool enabled);
    static bool boostEnabled();

    // Digital fallback control only. A later display driver
    // may attach PWM to the same backlight pin.
    static bool setBacklightEnabled(bool enabled);
    static bool backlightEnabled();

    // Digital fallback control only. A later haptic driver
    // may attach PWM to the same MOSFET control pin.
    static bool setHapticEnabled(bool enabled);
    static bool hapticEnabled();

    static void makeOutputsSafe();

    //================================================
    // INPUT ACCESS
    //================================================

    static bool buttonPressed(DirectButton button);
    static bool headphoneConnected();
    static int rawBatteryAdc();

    //================================================
    // VALIDATION AND TEXT HELPERS
    //================================================

    static bool validateRuntimeConfiguration();

    static const char* stageText(HardwareInitStage value);
    static const char* errorText(HardwareError value);

private:
    static HardwareStatus currentStatus;

    static void clearState();
    static bool fail(HardwareError error);

    static bool configureOutputPins();
    static bool configureInputPins();
    static bool configureSharedSpi();
    static bool configureRtcI2c();
    static bool detectRequiredMemory();

    static bool pinConnected(BoardPins::Pin pin);

    static bool configureOutput(
        BoardPins::Pin pin,
        uint8_t initialLevel);

    static bool configureInput(
        BoardPins::Pin pin,
        uint8_t mode);

    static void writeActiveLevel(
        BoardPins::Pin pin,
        bool active,
        bool activeHigh);

    static bool validButton(DirectButton button);
    static BoardPins::Pin buttonPin(DirectButton button);
};

