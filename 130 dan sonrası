            case SdStreamError::ReadFailed:
                return "READ_FAILED";

            case SdStreamError::SeekFailed:
                return "SEEK_FAILED";

            case SdStreamError::InvalidSeek:
                return "INVALID_SEEK";

            case SdStreamError::
                    BufferOperationFailed:
                return
                    "BUFFER_OPERATION_FAILED";

            case SdStreamError::EndOfFile:
                return "END_OF_FILE";

            case SdStreamError::RetryPending:
                return "RETRY_PENDING";

            case SdStreamError::
                    RetryLimitReached:
                return "RETRY_LIMIT_REACHED";

            case SdStreamError::Busy:
                return "BUSY";

            default:
                return "UNKNOWN";
        }
    }

    SdStreamService::StreamSlot*
    SdStreamService::slotFor(
        const SdStreamHandle& handle,
        SdStreamError* error) {
        if (error != nullptr) {
            *error = SdStreamError::None;
        }

        if (!currentStatus_.initialized) {
            if (error != nullptr) {
                *error =
                    SdStreamError::
                        NotInitialized;
            }

            return nullptr;
        }

        if (!handle ||
            handle.slot >=
                SD_STREAM_MAX_STREAMS) {
            if (error != nullptr) {
                *error =
                    SdStreamError::InvalidHandle;
            }

            return nullptr;
        }

        StreamSlot& slot =
            slots_[handle.slot];

        if (handle.generation !=
            slot.generation) {
            if (error != nullptr) {
                *error =
                    SdStreamError::StaleHandle;
            }

            return nullptr;
        }

        if (!slot.occupied) {
            if (error != nullptr) {
                *error =
                    SdStreamError::NotOpen;
            }

            return nullptr;
        }

        return &slot;
    }

    const SdStreamService::StreamSlot*
    SdStreamService::slotForConst(
        const SdStreamHandle& handle,
        SdStreamError* error) {
        return slotFor(handle, error);
    }

    bool SdStreamService::
    validateServiceConfig(
        const SdStreamServiceConfig& config) {
        return
            config.maximumBytesPerUpdate > 0 &&
            config.maximumStreamsPerUpdate > 0 &&
            config.maximumStreamsPerUpdate <=
                SD_STREAM_MAX_STREAMS;
    }

    bool SdStreamService::validateOpenOptions(
        const SdStreamOpenOptions& options) {
        return
            validPurpose(options.purpose) &&
            validMemoryPreference(
                options.bufferPreference) &&
            options.bufferCapacityBytes >=
                SD_STREAM_MINIMUM_BUFFER_BYTES &&
            options.bufferCapacityBytes <=
                SD_STREAM_MAXIMUM_BUFFER_BYTES &&
            options.readChunkBytes > 0 &&
            options.readChunkBytes <=
                options.bufferCapacityBytes &&
            options.refillThresholdBytes <=
                options.bufferCapacityBytes &&
            options.initialPrefetchBytes <=
                options.bufferCapacityBytes;
    }

    bool SdStreamService::validPurpose(
        SdStreamPurpose purpose) {
        switch (purpose) {
            case SdStreamPurpose::Generic:
            case SdStreamPurpose::Audio:
            case SdStreamPurpose::Pdf:
            case SdStreamPurpose::Emulator:
            case SdStreamPurpose::Asset:
                return true;

            default:
                return false;
        }
    }

    bool SdStreamService::validSeekOrigin(
        SdStreamSeekOrigin origin) {
        switch (origin) {
            case SdStreamSeekOrigin::Begin:
            case SdStreamSeekOrigin::Current:
            case SdStreamSeekOrigin::End:
                return true;

            default:
                return false;
        }
    }

    RuntimeResult SdStreamService::prefetchSlot(
        StreamSlot& slot,
        uint32_t nowMs,
        size_t maximumBytes,
        size_t& loadedBytes) {
        loadedBytes = 0;

        if (!slot.occupied ||
            !slot.file ||
            !slot.buffer.ready()) {
            slot.status.error =
                SdStreamError::NotOpen;

            return RuntimeResult::NotReady;
        }

        if (slot.status.state ==
            SdStreamState::Failed) {
            return RuntimeResult::IoError;
        }

        if (slot.status.paused) {
            slot.status.error =
                SdStreamError::Busy;

            refreshStreamStatus(slot);

            return RuntimeResult::Busy;
        }

        if (slot.status.retryPending &&
            !timeReached(
                nowMs,
                slot.status.nextRetryAtMs)) {
            slot.status.error =
                SdStreamError::RetryPending;

            refreshStreamStatus(slot);

            return RuntimeResult::Busy;
        }

        if (slot.status.sourceOffsetBytes >=
            slot.status.fileSizeBytes) {
            slot.status.eof = true;
            slot.prefetchRequested = false;
            slot.status.error =
                SdStreamError::None;

            refreshStreamStatus(slot);
            notifyStreamChanged(slot);

            return RuntimeResult::Ok;
        }

        if (maximumBytes == 0) {
            slot.status.error =
                SdStreamError::None;

            refreshStreamStatus(slot);

            return RuntimeResult::Ok;
        }

        const size_t writableBytes =
            slot.buffer.availableWrite();

        const uint32_t sourceRemaining =
            slot.status.fileSizeBytes -
            slot.status.sourceOffsetBytes;

        size_t requestedBytes =
            minimumSize(
                maximumBytes,
                slot.options.readChunkBytes);

        requestedBytes =
            minimumSize(
                requestedBytes,
                writableBytes);

        requestedBytes =
            minimumSize(
                requestedBytes,
                static_cast<size_t>(
                    sourceRemaining));

        if (requestedBytes == 0) {
            slot.status.error =
                SdStreamError::None;

            refreshStreamStatus(slot);

            return RuntimeResult::Ok;
        }

        slot.status.state =
            SdStreamState::Prefetching;

        StreamRingBufferWritableSpans spans;

        const RuntimeResult reserveResult =
            slot.buffer.writableSpans(
                requestedBytes,
                spans,
                false);

        if (reserveResult !=
                RuntimeResult::Ok ||
            spans.totalSize() !=
                requestedBytes) {
            slot.status.state =
                SdStreamState::Failed;

            slot.status.error =
                SdStreamError::
                    BufferOperationFailed;

            refreshStreamStatus(slot);
            notifyStreamChanged(slot);

            return reserveResult !=
                    RuntimeResult::Ok
                ? reserveResult
                : RuntimeResult::InternalError;
        }

        size_t firstRead = 0;
        size_t secondRead = 0;

        if (spans.first.size > 0) {
            firstRead =
                slot.file.read(
                    spans.first.data,
                    spans.first.size);
        }

        if (firstRead ==
                spans.first.size &&
            spans.second.size > 0) {
            secondRead =
                slot.file.read(
                    spans.second.data,
                    spans.second.size);
        }

        const size_t actualRead =
            firstRead + secondRead;

        if (actualRead == 0) {
            slot.buffer.cancelWrite();

            slot.consecutiveReadFailures =
                slot.consecutiveReadFailures ==
                        UINT8_MAX
                    ? UINT8_MAX
                    : static_cast<uint8_t>(
                        slot.
                            consecutiveReadFailures +
                        1U);

            slot.status.retryCount =
                saturatingIncrement32(
                    slot.status.retryCount);

            if (slot.consecutiveReadFailures >
                slot.options.retryLimit) {
                slot.status.retryPending =
                    false;

                slot.status.nextRetryAtMs = 0;

                slot.status.state =
                    SdStreamState::Failed;

                slot.status.error =
                    SdStreamError::
                        RetryLimitReached;

                refreshStreamStatus(slot);
                notifyStreamChanged(slot);

                return RuntimeResult::IoError;
            }

            slot.status.retryPending = true;

            slot.status.nextRetryAtMs =
                nowMs +
                slot.options.retryDelayMs;

            slot.status.error =
                SdStreamError::RetryPending;

            slot.status.state =
                SdStreamState::Ready;

            refreshStreamStatus(slot);
            notifyStreamChanged(slot);

            return RuntimeResult::Busy;
        }

        const RuntimeResult commitResult =
            slot.buffer.commitWrite(
                actualRead);

        if (commitResult != RuntimeResult::Ok) {
            slot.status.state =
                SdStreamState::Failed;

            slot.status.error =
                SdStreamError::
                    BufferOperationFailed;

            refreshStreamStatus(slot);
            notifyStreamChanged(slot);

            return commitResult;
        }

        loadedBytes = actualRead;

        slot.status.sourceOffsetBytes +=
            static_cast<uint32_t>(
                actualRead);

        slot.status.totalSourceBytesRead =
            saturatingAdd64(
                slot.status.
                    totalSourceBytesRead,
                actualRead);

        slot.status.prefetchCount =
            saturatingIncrement32(
                slot.status.prefetchCount);

        slot.status.lastReadAtMs = nowMs;

        currentStatus_.totalSourceBytesRead =
            saturatingAdd64(
                currentStatus_.
                    totalSourceBytesRead,
                actualRead);

        const bool shortRead =
            actualRead < requestedBytes;

        if (shortRead &&
            slot.status.sourceOffsetBytes <
                slot.status.fileSizeBytes) {
            slot.consecutiveReadFailures =
                slot.consecutiveReadFailures ==
                        UINT8_MAX
                    ? UINT8_MAX
                    : static_cast<uint8_t>(
                        slot.
                            consecutiveReadFailures +
                        1U);

            slot.status.retryCount =
                saturatingIncrement32(
                    slot.status.retryCount);

            if (slot.consecutiveReadFailures >
                slot.options.retryLimit) {
                slot.status.retryPending =
                    false;

                slot.status.nextRetryAtMs = 0;

                slot.status.state =
                    SdStreamState::Failed;

                slot.status.error =
                    SdStreamError::
                        RetryLimitReached;

                refreshStreamStatus(slot);
                notifyStreamChanged(slot);

                return RuntimeResult::IoError;
            }

            slot.status.retryPending = true;

            slot.status.nextRetryAtMs =
                nowMs +
                slot.options.retryDelayMs;

            slot.status.error =
                SdStreamError::RetryPending;
        } else {
            slot.consecutiveReadFailures = 0;
            slot.status.retryPending = false;
            slot.status.nextRetryAtMs = 0;
            slot.status.error =
                SdStreamError::None;
        }

        slot.status.eof =
            slot.status.sourceOffsetBytes >=
            slot.status.fileSizeBytes;

        slot.prefetchRequested =
            !slot.status.eof &&
            slot.buffer.availableRead() <=
                slot.options.
                    refillThresholdBytes;

        refreshStreamStatus(slot);
        notifyStreamChanged(slot);

        return RuntimeResult::Ok;
    }

    RuntimeResult
    SdStreamService::resolveSeekTarget(
        const StreamSlot& slot,
        int64_t offsetBytes,
        SdStreamSeekOrigin origin,
        uint32_t& targetOffset) {
        targetOffset = 0;

        if (!validSeekOrigin(origin)) {
            return
                RuntimeResult::InvalidArgument;
        }

        int64_t baseOffset = 0;

        switch (origin) {
            case SdStreamSeekOrigin::Begin:
                baseOffset = 0;
                break;

            case SdStreamSeekOrigin::Current:
                baseOffset =
                    static_cast<int64_t>(
                        slot.status.
                            consumerOffsetBytes);
                break;

            case SdStreamSeekOrigin::End:
                baseOffset =
                    static_cast<int64_t>(
                        slot.status.
                            fileSizeBytes);
                break;

            default:
                return
                    RuntimeResult::InvalidArgument;
        }

        if ((offsetBytes > 0 &&
             baseOffset >
                 INT64_MAX - offsetBytes) ||
            (offsetBytes < 0 &&
             baseOffset <
                 INT64_MIN - offsetBytes)) {
            return
                RuntimeResult::InvalidArgument;
        }

        const int64_t resolved =
            baseOffset + offsetBytes;

        if (resolved < 0 ||
            resolved >
                static_cast<int64_t>(
                    slot.status.fileSizeBytes)) {
            return
                RuntimeResult::InvalidArgument;
        }

        targetOffset =
            static_cast<uint32_t>(resolved);

        return RuntimeResult::Ok;
    }

    void SdStreamService::refreshStreamStatus(
        StreamSlot& slot) {
        slot.status.generation =
            slot.generation;

        slot.status.open =
            slot.occupied &&
            slot.file &&
            slot.buffer.ready();

        if (!slot.occupied) {
            slot.status.open = false;
            slot.status.paused = false;
            slot.status.eof = false;
            slot.status.retryPending = false;
            slot.status.
                readReservationActive = false;
            slot.status.state =
                SdStreamState::Closed;
            slot.status.bufferCapacityBytes = 0;
            slot.status.bufferedBytes = 0;
            slot.status.writableBytes = 0;
            slot.status.highWatermarkBytes = 0;

            return;
        }

        const StreamRingBufferStatus
            bufferStatus =
                slot.buffer.status();

        slot.status.bufferCapacityBytes =
            bufferStatus.capacityBytes;

        slot.status.bufferedBytes =
            bufferStatus.readableBytes;

        slot.status.writableBytes =
            bufferStatus.writableBytes;

        slot.status.highWatermarkBytes =
            bufferStatus.highWatermarkBytes;

        slot.status.readReservationActive =
            bufferStatus.
                readReservationActive;

        slot.status.eof =
            slot.status.sourceOffsetBytes >=
            slot.status.fileSizeBytes;

        if (slot.status.state ==
            SdStreamState::Failed) {
            return;
        }

        if (slot.status.paused) {
            slot.status.state =
                SdStreamState::Paused;

            return;
        }

        if (slot.status.eof &&
            slot.status.bufferedBytes == 0) {
            if (slot.options.
                    pauseAtEndOfFile) {
                slot.status.paused = true;
                slot.status.state =
                    SdStreamState::Paused;
            } else {
                slot.status.state =
                    SdStreamState::EndOfFile;
            }

            return;
        }

        if (slot.status.state !=
                SdStreamState::Opening &&
            slot.status.state !=
                SdStreamState::Seeking &&
            slot.status.state !=
                SdStreamState::Prefetching) {
            slot.status.state =
                SdStreamState::Ready;
        } else if (
            slot.status.state ==
            SdStreamState::Opening) {
            slot.status.state =
                SdStreamState::Ready;
        } else if (
            slot.status.state ==
            SdStreamState::Seeking) {
            slot.status.state =
                SdStreamState::Ready;
        } else if (
            slot.status.state ==
            SdStreamState::Prefetching) {
            slot.status.state =
                SdStreamState::Ready;
        }
    }

    void SdStreamService::
    refreshServiceStatus() {
        currentStatus_.storageReady =
            StorageManager::ready();

        currentStatus_.maximumBytesPerUpdate =
            config_.maximumBytesPerUpdate;

        uint8_t openCount = 0;
        uint8_t activeCount = 0;
        uint8_t failedCount = 0;

        for (uint8_t index = 0;
             index < SD_STREAM_MAX_STREAMS;
             ++index) {
            StreamSlot& slot =
                slots_[index];

            if (!slot.occupied) {
                continue;
            }

            refreshStreamStatus(slot);

            ++openCount;

            if (slot.status.state ==
                SdStreamState::Failed) {
                ++failedCount;
                continue;
            }

            if (!slot.status.paused &&
                (!slot.status.eof ||
                 slot.status.bufferedBytes > 0)) {
                ++activeCount;
            }
        }

        currentStatus_.openStreamCount =
            openCount;

        currentStatus_.activeStreamCount =
            activeCount;

        currentStatus_.failedStreamCount =
            failedCount;

        if (currentStatus_.nextServiceSlot >=
            SD_STREAM_MAX_STREAMS) {
            currentStatus_.nextServiceSlot = 0;
        }
    }

    void SdStreamService::invalidateHandle(
        SdStreamHandle& handle) {
        handle.slot =
            SD_STREAM_INVALID_SLOT;

        handle.generation = 0;
    }

    RuntimeResult SdStreamService::setError(
        SdStreamError error,
        RuntimeResult result) {
        currentStatus_.error = error;

        return result;
    }

    void SdStreamService::
    notifyStreamChanged(
        const StreamSlot& slot) {
        if (observer_ == nullptr) {
            return;
        }

        const ptrdiff_t index =
            &slot - &slots_[0];

        if (index < 0 ||
            index >= SD_STREAM_MAX_STREAMS) {
            return;
        }

        SdStreamHandle handle;

        handle.slot =
            static_cast<uint8_t>(index);

        handle.generation =
            slot.generation;

        observer_(handle, slot.status);
    }
}

