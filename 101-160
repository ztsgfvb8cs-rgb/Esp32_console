bool BatteryManager::setCalibration(
    float scale,
    float offsetVoltage)
{
    if (!validFiniteValue(scale) ||
        !validFiniteValue(offsetVoltage) ||
        scale < MIN_CALIBRATION_SCALE ||
        scale > MAX_CALIBRATION_SCALE ||
        offsetVoltage < MIN_CALIBRATION_OFFSET_V ||
        offsetVoltage > MAX_CALIBRATION_OFFSET_V)
    {
        currentStatus.error =
            BatteryError::INVALID_CALIBRATION;

        return false;
    }

    currentCalibrationScale = scale;
    currentCalibrationOffsetV = offsetVoltage;

    if (currentStatus.error ==
        BatteryError::INVALID_CALIBRATION)
    {
        currentStatus.error = BatteryError::NONE;
    }

    if (currentStatus.initialized)
    {
        return forceSample();
    }

    return true;
}

void BatteryManager::resetCalibration()
{
    currentCalibrationScale =
        DEFAULT_CALIBRATION_SCALE;

    currentCalibrationOffsetV =
        DEFAULT_CALIBRATION_OFFSET_V;

    if (currentStatus.error ==
        BatteryError::INVALID_CALIBRATION)
    {
        currentStatus.error = BatteryError::NONE;
    }

    if (currentStatus.initialized)
    {
        (void)forceSample();
    }
}

