//---------------- Validation ----------------

bool validateProfileSelectorEntry(
    const ProfileSelectorEntry& entry
)
{
    if(!entry.valid)
    {
        return false;
    }


    if(entry.profileID ==
       PROFILE_INVALID_ID)
    {
        return false;
    }


    if(entry.playerName[0] ==
       '\0')
    {
        return false;
    }


    size_t nameLength =
        strnlen(
            entry.playerName,
            PROFILE_SELECTOR_NAME_LENGTH
        );


    if(nameLength == 0 ||
       nameLength >= PROFILE_SELECTOR_NAME_LENGTH)
    {
        return false;
    }


    return true;
}



bool validateProfileSelector()
{
    if(selectorEntryCount >
       PROFILE_STORAGE_MAX_PROFILES)
    {
        return false;
    }


    uint8_t selectedCount =
        0;


    for(uint8_t i = 0;
        i < selectorEntryCount;
        i++)
    {
        if(!validateProfileSelectorEntry(
            selectorEntries[i]
        ))
        {
            return false;
        }


        if(selectorEntries[i].selected)
        {
            selectedCount++;
        }


        for(uint8_t j = i + 1;
            j < selectorEntryCount;
            j++)
        {
            if(selectorEntries[i].profileID ==
               selectorEntries[j].profileID)
            {
                return false;
            }


            if(strcmp(
                selectorEntries[i].playerName,
                selectorEntries[j].playerName
            ) == 0)
            {
                return false;
            }
        }
    }


    if(selectedProfileIndex ==
       PROFILE_SELECTOR_INVALID_INDEX)
    {
        return selectedCount == 0;
    }


    if(!isValidSelectorIndex(
        selectedProfileIndex
    ))
    {
        return false;
    }


    if(selectedCount != 1)
    {
        return false;
    }


    return
        selectorEntries[
            selectedProfileIndex
        ].selected;
}



