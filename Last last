)
{
    if(achievementID ==
       ACHIEVEMENT_INVALID_ID)
    {
        return -1;
    }


    for(uint16_t i = 0;
        i < achievementCount;
        i++)
    {
        if(achievementRecords[i].
               definition.valid &&
           achievementRecords[i].
               definition.achievementID ==
               achievementID)
        {
            return (int16_t)i;
        }
    }


    return -1;
}



