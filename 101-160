{
    return
        pin != BoardPins::NOT_CONNECTED &&
        BoardPins::isPhysicalEsp32S3Gpio(pin);
}

bool HardwareManager::configureOutput(
    BoardPins::Pin pin,
    uint8_t initialLevel)
{
    if (!pinConnected(pin))
    {
        return false;
    }

    pinMode(
        pin,
        OUTPUT);

    digitalWrite(
        pin,
        initialLevel);

    return true;
}

bool HardwareManager::configureInput(
    BoardPins::Pin pin,
    uint8_t mode)
{
    if (!pinConnected(pin))
    {
        return false;
    }

    pinMode(
        pin,
        mode);

    return true;
}

void HardwareManager::writeActiveLevel(
    BoardPins::Pin pin,
    bool active,
    bool activeHigh)
{
    const bool highLevel =
        active == activeHigh;

    digitalWrite(
        pin,
        highLevel ? HIGH : LOW);
}

bool HardwareManager::validButton(
    DirectButton button)
{
    return
        static_cast<uint8_t>(button) <
        static_cast<uint8_t>(
            DirectButton::COUNT);
}

BoardPins::Pin HardwareManager::buttonPin(
    DirectButton button)
{
    if (!validButton(button))
    {
        return BoardPins::NOT_CONNECTED;
    }

    return
        BoardPins::DIRECT_BUTTON_PINS[
            static_cast<uint8_t>(button)];
}
#ifndef EGS_POWER_MANAGER_H
#define EGS_POWER_MANAGER_H

#include <Arduino.h>
#include <stdint.h>

