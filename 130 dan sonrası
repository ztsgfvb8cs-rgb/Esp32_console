//====================================================
// ESP32 GAME STATION
// FIXED-CLASS PSRAM BLOCK POOL CONTRACT
// 133_psram_pool.h
//====================================================
//
// Responsibilities:
// - Reserves a bounded set of contiguous backing regions.
// - Reuses fixed-size blocks without repeated heap allocation.
// - Selects the smallest available class that satisfies a request.
// - Tracks generation and lease identifiers to reject stale handles.
// - Reports reserved, requested, used and internally wasted bytes.
// - Allows all blocks to be released in constant bounded time.
//
// Memory rule:
// - Pool metadata stays in internal static storage inside the object.
// - Backing regions normally use MemoryPreference::PsramOnly.
// - DMA descriptors and DMA transfer buffers must not use this pool.
// - Frequently accessed tiny state should remain in internal RAM.
//
// Fragmentation rule:
// - MemoryManager is called only once for each enabled size class.
// - Individual acquire/release operations never call malloc or free.
// - A class stride is aligned once and reused for every block.
//
// Integration rule:
// - File 134 implements this contract using MemoryManager.
// - Audio, PDF, emulator and game caches may share one configured pool.
// - ResourceBudgetCoordinator will validate the total reservation before
//   the pool is initialized.
//====================================================

namespace egs
{
inline constexpr uint8_t PSRAM_POOL_MAX_SIZE_CLASSES = 6U;
inline constexpr uint16_t PSRAM_POOL_MAX_BLOCKS = 96U;
inline constexpr size_t PSRAM_POOL_MAX_ALIGNMENT_BYTES = 64U;

inline constexpr uint16_t PSRAM_POOL_INVALID_SLOT =
    0xFFFFU;

inline constexpr uint8_t PSRAM_POOL_INVALID_CLASS =
    0xFFU;

enum class PsramPoolClearMode : uint8_t
{
    Default = 0,
    Preserve,
    Clear
};

enum class PsramPoolError : uint8_t
{
    None = 0,
    AlreadyInitialized,
    NotInitialized,
    InvalidConfiguration,
    InvalidClass,
    InvalidAlignment,
    CapacityOverflow,
    PsramUnavailable,
    BackingAllocationFailed,
    RequestTooLarge,
    PoolExhausted,
    InvalidBlock,
    ForeignBlock,
    StaleBlock,
    DoubleRelease
};

struct PsramPoolSizeClassConfig
{
    size_t blockSizeBytes = 0;
    uint16_t blockCount = 0;

    size_t alignment =
        alignof(max_align_t);

    // Clearing on acquire is safe for object/state blocks.
    // Streaming and decode buffers that are fully overwritten
    // should normally disable it.
    bool clearOnAcquire = false;
};

struct PsramPoolConfig
{
    MemoryPreference preference =
        MemoryPreference::PsramOnly;

    PsramPoolSizeClassConfig classes[
        PSRAM_POOL_MAX_SIZE_CLASSES] = {};

    uint8_t classCount = 0;

    // When a matching class is exhausted, a larger free class
    // may satisfy the request. Disable this for tightly budgeted
    // subsystems.
    bool allowLargerClassFallback = true;

    // Clears each complete class backing region during begin().
    bool clearBackingStore = false;

    // Rejects initialization if any backing region falls into
    // internal RAM.
    bool requirePsram = true;

    // Optional security/debug behavior. It increases release cost.
    bool clearBlocksOnRelease = false;
};

struct PsramPoolBlock
{
    void* data = nullptr;

    size_t requestedBytes = 0;
    size_t capacityBytes = 0;

    uint16_t slotIndex =
        PSRAM_POOL_INVALID_SLOT;

    uint8_t classIndex =
        PSRAM_POOL_INVALID_CLASS;

    uint32_t generation = 0;
    uint32_t leaseId = 0;

    explicit operator bool() const
    {
        return data != nullptr;
    }
};

struct PsramPoolClassStatus
{
    bool enabled = false;
    bool psram = false;

    size_t blockSizeBytes = 0;
    size_t strideBytes = 0;
    size_t reservedBytes = 0;
    size_t usedCapacityBytes = 0;
    size_t requestedBytes = 0;
    size_t wastedBytes = 0;

    uint16_t totalBlocks = 0;
    uint16_t usedBlocks = 0;
    uint16_t freeBlocks = 0;
    uint16_t peakUsedBlocks = 0;
};

struct PsramPoolStatus
{
    bool initialized = false;
    bool allBackingsInPsram = false;
    bool exhausted = false;

    PsramPoolError error =
        PsramPoolError::None;

    MemoryPreference preference =
        MemoryPreference::PsramOnly;

    uint8_t classCount = 0;

    uint16_t totalBlocks = 0;
    uint16_t usedBlocks = 0;
    uint16_t freeBlocks = 0;
    uint16_t peakUsedBlocks = 0;

    size_t reservedBytes = 0;
    size_t usedCapacityBytes = 0;
    size_t requestedBytes = 0;
    size_t wastedBytes = 0;
    size_t peakUsedCapacityBytes = 0;

    uint32_t allocationCount = 0;
    uint32_t releaseCount = 0;
    uint32_t failedAllocationCount = 0;
    uint32_t releaseAllCount = 0;
    uint32_t generation = 0;
};

using PsramPoolObserver = void (*)(
    const PsramPoolStatus& status);

class PsramPool final
{
public:
    PsramPool() = default;
    ~PsramPool();

    PsramPool(
        const PsramPool&) = delete;

    PsramPool& operator=(
        const PsramPool&) = delete;

    PsramPool(
        PsramPool&&) = delete;

    PsramPool& operator=(
        PsramPool&&) = delete;

    //================================================
    // CONFIGURATION AND LIFECYCLE
    //================================================

    // Returns a balanced general-purpose configuration.
    // Callers may edit the returned class sizes/counts
    // before begin().
    static PsramPoolConfig defaultConfig();

    RuntimeResult begin(
        const PsramPoolConfig& config);

    RuntimeResult beginDefault();

    void end();

    bool ready() const;

    PsramPoolStatus status() const;

    //================================================
    // BLOCK ACQUISITION AND RELEASE
    //================================================

    PsramPoolBlock acquire(
        size_t requestedBytes,
        PsramPoolClearMode clearMode =
            PsramPoolClearMode::Default);

    // Acquires from an exact class. This is useful for cache
    // layers that reserve one specific block geometry and
    // forbid larger fallback.
    PsramPoolBlock acquireFromClass(
        uint8_t classIndex,
        size_t requestedBytes,
        PsramPoolClearMode clearMode =
            PsramPoolClearMode::Default);

    RuntimeResult release(
        PsramPoolBlock& block,
        PsramPoolClearMode clearMode =
            PsramPoolClearMode::Default);

    RuntimeResult releaseAll(
        PsramPoolClearMode clearMode =
            PsramPoolClearMode::Default);

    //================================================
    // OWNERSHIP AND CAPACITY QUERIES
    //================================================

    bool owns(
        const PsramPoolBlock& block) const;

    bool contains(
        const void* pointer) const;

    uint8_t bestClassFor(
        size_t requestedBytes) const;

    PsramPoolClassStatus classStatus(
        uint8_t classIndex) const;

    size_t smallestBlockSize() const;

    size_t largestBlockSize() const;

    uint16_t freeBlockCount(
        uint8_t classIndex) const;

    bool canAcquire(
        size_t requestedBytes) const;

    //================================================
    // DIAGNOSTICS
    //================================================

    void setObserver(
        PsramPoolObserver observer);

    PsramPoolError lastError() const;

    void clearError();

    static bool validAlignment(
        size_t alignment);

    static const char* errorText(
        PsramPoolError value);

private:
    struct SlotMetadata
    {
        bool used = false;

        uint8_t classIndex =
            PSRAM_POOL_INVALID_CLASS;

        uint32_t leaseId = 0;
        size_t requestedBytes = 0;
    };

    PsramPoolConfig config_ = {};
