        0,
        firstBytes);

    const size_t secondBytes =
        sizeBytes - firstBytes;

    if (secondBytes > 0)
    {
        memset(
            base,
            0,
            secondBytes);
    }
}

void StreamRingBuffer::refreshStatus()
{
    status_.capacityBytes =
        backing_ ? backing_.size : 0;

    status_.readableBytes =
        usedBytes_;

    status_.writableBytes =
        backing_ &&
                usedBytes_ <= backing_.size
            ? backing_.size - usedBytes_
            : 0;

    status_.empty =
        usedBytes_ == 0;

    status_.full =
        backing_ &&
        usedBytes_ == backing_.size;

    status_.writeReservationActive =
        writeReservationBytes_ > 0;

    status_.readReservationActive =
        readReservationBytes_ > 0;

    status_.writeReservationBytes =
        writeReservationBytes_;

    status_.readReservationBytes =
        readReservationBytes_;

    status_.overflowPolicy =
        config_.overflowPolicy;

    if (usedBytes_ >
        status_.highWatermarkBytes)
    {
        status_.highWatermarkBytes =
            usedBytes_;
    }
}

RuntimeResult StreamRingBuffer::setError(
    StreamRingBufferError error,
    RuntimeResult result) const
{
    StreamRingBuffer* const self =
        const_cast<StreamRingBuffer*>(this);

    self->status_.error = error;
    self->notifyStateChanged();

    return result;
}

void StreamRingBuffer::moveFrom(
    StreamRingBuffer& other) noexcept
{
    backing_ = other.backing_;
    config_ = other.config_;
    status_ = other.status_;

    readOffset_ =
        other.readOffset_;

    writeOffset_ =
        other.writeOffset_;

    usedBytes_ =
        other.usedBytes_;

    writeReservationBytes_ =
        other.writeReservationBytes_;

    readReservationBytes_ =
        other.readReservationBytes_;

    observer_ =
        other.observer_;

    const uint32_t otherGeneration =
        nextGeneration(
            other.status_.generation);

    other.backing_ = {};
    other.config_ = {};
    other.status_ = {};

    other.status_.generation =
        otherGeneration;

    other.readOffset_ = 0;
    other.writeOffset_ = 0;
    other.usedBytes_ = 0;
    other.writeReservationBytes_ = 0;
    other.readReservationBytes_ = 0;
    other.observer_ = nullptr;
}

void StreamRingBuffer::
    notifyStateChanged() const
{
    if (observer_ != nullptr)
    {
        observer_(status_);
    }
}
