bool finiteFloatValue(float value)
{
    return
        value == value &&
        value >= -FLT_MAX &&
        value <= FLT_MAX;
}


String unsigned64ToString(uint64_t value)
{
    char buffer[24];

    uint8_t position =
        sizeof(buffer) - 1;

    buffer[position] = '\0';

    do
    {
        uint8_t digit =
            static_cast<uint8_t>(
                value % 10ULL
            );

        value /= 10ULL;

        buffer[--position] =
            static_cast<char>(
                '0' + digit
            );
    }
    while (value > 0);

    return String(&buffer[position]);
}


const char* healthLevelText(
    SystemHealthLevel level
)
{
    switch (level)
    {
        case SYSTEM_HEALTH_WARNING:
            return "WARNING";

        case SYSTEM_HEALTH_CRITICAL:
            return "CRITICAL";

        case SYSTEM_HEALTH_NORMAL:
        default:
            return "NORMAL";
    }
}


void appendBoolean(
    String& output,
    bool value
)
{
    output += value
        ? "true"
        : "false";
}

