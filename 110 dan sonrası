RuntimeResult RuntimeSessionBridge::requestClose(
    RuntimeSessionExitReason reason)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeSessionError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!currentStatus_.active &&
        !RuntimeModuleManager::foregroundActive())
    {
        return RuntimeResult::NotReady;
    }

    currentStatus_.closeRequested = true;
    pendingExitReason_ =
        reason == RuntimeSessionExitReason::None
            ? RuntimeSessionExitReason::UserRequest
            : reason;

    notifyStateChanged();
    return RuntimeResult::Ok;
}

RuntimeResult RuntimeSessionBridge::closeImmediately(
    RuntimeSessionExitReason reason,
    bool navigateAfterClose)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeSessionError::NotInitialized,
            RuntimeResult::NotReady);
    }

    return finishClose(
        reason == RuntimeSessionExitReason::None
            ? RuntimeSessionExitReason::UserRequest
            : reason,
        navigateAfterClose);
}

