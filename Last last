//---------------- Internal Functions ----------------

static void clearProfilePreferences()
{
    playerProfile.preferences.theme =
        PROFILE_DEFAULT_THEME;


    playerProfile.preferences.volume =
        PROFILE_DEFAULT_VOLUME;


    playerProfile.preferences.brightness =
        PROFILE_DEFAULT_BRIGHTNESS;


    playerProfile.preferences.soundEnabled =
        true;


    playerProfile.preferences.vibrationEnabled =
        false;


    playerProfile.preferences.showFPS =
        false;


    playerProfile.preferences.showBatteryPercent =
        true;


    playerProfile.preferences.autoSaveEnabled =
        true;
}



static void clearProfileStatistics()
{
    playerProfile.statistics.totalPlaytimeMilliseconds =
        0;


    playerProfile.statistics.totalSessions =
        0;


    playerProfile.statistics.completedSessions =
        0;


    playerProfile.statistics.interruptedSessions =
        0;


    playerProfile.statistics.totalGameLaunches =
        0;


    playerProfile.statistics.longestSessionMilliseconds =
        0;


    playerProfile.statistics.uniqueGamesPlayed =
        0;


    playerProfile.statistics.achievementCount =
        0;
}



static void clearProfileDateInformation()
{
    playerProfile.dateInformation.createdUnix =
        0;


    playerProfile.dateInformation.lastLoginUnix =
        0;


    playerProfile.dateInformation.lastLogoutUnix =
        0;


    playerProfile.dateInformation.rtcTimeValid =
        false;
}



static void clearProfileFavorites()
{
    playerProfile.favoriteGameCount =
        0;


    playerProfile.primaryFavoriteGame =
        PROFILE_INVALID_ID;


    for(uint8_t i = 0;
        i < PROFILE_MAX_FAVORITES;
        i++)
    {
        playerProfile.favoriteGames[i] =
            PROFILE_INVALID_ID;
    }
}



static int8_t findFavoriteGameIndex(
    uint16_t gameID
)
{
    if(gameID ==
       PROFILE_INVALID_ID)
    {
        return -1;
    }


    for(uint8_t i = 0;
        i < playerProfile.favoriteGameCount;
        i++)
    {
        if(playerProfile.favoriteGames[i] ==
           gameID)
        {
            return (int8_t)i;
        }
    }


    return -1;
}



static uint32_t getCurrentProfileUnixTime()
{
    if(!isRTCInitialized())
    {
        return 0;
    }


    if(!isRTCAvailable())
    {
        return 0;
    }


    if(!isRTCDateTimeValid())
    {
        return 0;
    }


    return getRTCUnixTime();
}



//---------------- Initialization ----------------

void initProfileManager()
{
    memset(
        &playerProfile,
        0,
        sizeof(PlayerProfile)
    );


    playerProfile.profileID =
        PROFILE_INVALID_ID;


    playerProfile.playerName[0] =
        '\0';


    clearProfileFavorites();

    clearProfilePreferences();

    clearProfileStatistics();

    clearProfileDateInformation();


    playerProfile.loginCount =
        0;


    playerProfile.active =
        false;


    playerProfile.initialized =
        false;


    playerProfile.modified =
        false;


    profileManagerStatus =
        PROFILE_STATUS_READY;
}



//---------------- Profile Creation ----------------

bool createPlayerProfile(
    uint16_t profileID,
    const char* playerName
)
{
    if(profileID ==
       PROFILE_INVALID_ID)
    {
        profileManagerStatus =
            PROFILE_STATUS_INVALID_PROFILE;


        return false;
    }


    if(!validatePlayerName(
        playerName
    ))
    {
        profileManagerStatus =
            PROFILE_STATUS_INVALID_NAME;


        return false;
    }


    initProfileManager();


    playerProfile.profileID =
        profileID;


    strncpy(
        playerProfile.playerName,
        playerName,
        PROFILE_NAME_LENGTH - 1
    );


    playerProfile.playerName[
        PROFILE_NAME_LENGTH - 1
    ] = '\0';


    playerProfile.initialized =
        true;


    playerProfile.active =
        true;


    playerProfile.modified =
        true;


    playerProfile.loginCount =
        1;


    updateProfileCreatedTime();


    playerProfile.dateInformation.lastLoginUnix =
        playerProfile.dateInformation.createdUnix;


    profileManagerStatus =
        PROFILE_STATUS_READY;


    return true;
}



//---------------- Profile Reset ----------------

void resetPlayerProfile()
{
    initProfileManager();
}



//---------------- Active Profile ----------------

bool activatePlayerProfile()
{
    if(!playerProfile.initialized)
    {
        profileManagerStatus =
            PROFILE_STATUS_INVALID_PROFILE;


        return false;
    }


    if(!validatePlayerProfile())
    {
        profileManagerStatus =
            PROFILE_STATUS_INVALID_PROFILE;


        return false;
    }


    playerProfile.active =
        true;


    playerProfile.loginCount++;


    updateProfileLoginTime();


    playerProfile.modified =
        true;


    profileManagerStatus =
        PROFILE_STATUS_READY;


    return true;
}



bool deactivatePlayerProfile()
{
    if(!playerProfile.initialized)
    {
        profileManagerStatus =
            PROFILE_STATUS_INVALID_PROFILE;


        return false;
    }


    if(!playerProfile.active)
    {
        profileManagerStatus =
            PROFILE_STATUS_NO_ACTIVE_PROFILE;


        return false;
    }


    updateProfileLogoutTime();


    playerProfile.active =
        false;


    playerProfile.modified =
        true;


    profileManagerStatus =
        PROFILE_STATUS_READY;


    return true;
}



bool isPlayerProfileActive()
{
    return
        playerProfile.initialized &&
        playerProfile.active;
}



