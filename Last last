                static_cast<int16_t>(i))
        {
            uint64_t pending =
                pendingActiveMilliseconds();

            if (value >
                PLAYTIME_UINT64_MAX -
                pending)
            {
                value =
                    PLAYTIME_UINT64_MAX;
            }
            else
            {
                value += pending;
            }
        }

        if (total >
            PLAYTIME_UINT64_MAX - value)
        {
            return PLAYTIME_UINT64_MAX;
        }

        total += value;
    }

    return total;
}


