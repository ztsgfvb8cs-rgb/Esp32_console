                    PsramPoolError::CapacityOverflow;
            }

            return false;
        }

        const size_t classDataBytes =
            stride * classConfig.blockCount;

        const size_t alignmentPadding =
            classConfig.alignment - 1U;

        if (addWouldOverflow(
                classDataBytes,
                alignmentPadding))
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::CapacityOverflow;
            }

            return false;
        }

        const size_t classReservedBytes =
            classDataBytes + alignmentPadding;

        if (addWouldOverflow(
                totalReservedBytes,
                classReservedBytes))
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::CapacityOverflow;
            }

            return false;
        }

        totalReservedBytes += classReservedBytes;
        totalBlocks = static_cast<uint16_t>(
            totalBlocks + classConfig.blockCount);
        previousBlockSize = classConfig.blockSizeBytes;
