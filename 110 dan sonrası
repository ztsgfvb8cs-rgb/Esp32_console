bool AiPerceptionSystem::endFrame()
{
    if (!currentStatus_.initialized)
    {
        setError(AiPerceptionError::NotInitialized);
        return false;
    }

    if (!currentStatus_.frameOpen)
    {
        setError(AiPerceptionError::FrameNotOpen);
        return false;
    }

    const uint32_t nowMs = currentStatus_.frameStartedAtMs;

    for (size_t i = 0;
         i < currentStatus_.stimulusCount;
         ++i)
    {
        processStimulus(frameStimuli_[i], nowMs);
    }

    currentStatus_.frameOpen = false;
    currentStatus_.frameCompletedAtMs = nowMs;
    ++currentStatus_.frameSequence;
    currentStatus_.error = AiPerceptionError::None;

    refreshCounts();
    notifyStateChanged();

    return true;
}

void AiPerceptionSystem::update(uint32_t nowMs)
{
    if (!currentStatus_.initialized ||
        currentStatus_.frameOpen)
    {
        return;
    }

    if (nowMs == 0)
    {
        nowMs = millis();
    }

    decayAndPredict(nowMs);
    refreshCounts();
    notifyStateChanged();
}

