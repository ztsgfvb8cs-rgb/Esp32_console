static_assert(
    MP3_DECODER_MIN_CHANNEL_COUNT == 1U &&
        MP3_DECODER_MAX_CHANNEL_COUNT == 2U,
    "MP3 decoder supports mono and stereo only");

static_assert(
    MP3_DECODER_MAX_PCM_FRAMES_PER_MPEG_FRAME == 1152U,
    "MP3 decoder scratch sizing assumes 1152-frame MPEG-1 output");

static_assert(
    MP3_DECODER_MAX_PCM_SAMPLES_PER_MPEG_FRAME == 2304U,
    "MP3 PCM scratch buffer sizing is invalid");

static_assert(
    MP3_DECODER_DEFAULT_FRAMES_PER_CALL > 0U &&
        MP3_DECODER_DEFAULT_FRAMES_PER_CALL <=
            MP3_DECODER_MAX_FRAMES_PER_CALL,
    "MP3 decode frame limits are invalid");

static_assert(
    MP3_DECODER_DEFAULT_SEEK_INDEX_ENTRIES > 0U &&
        MP3_DECODER_DEFAULT_SEEK_INDEX_ENTRIES <=
            MP3_DECODER_MAX_SEEK_INDEX_ENTRIES,
    "MP3 seek-index limits are invalid");
}

