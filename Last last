uint64_t PlaytimeManager::
currentSessionMilliseconds()
{
    uint64_t result =
        sessionMilliseconds;

    if (!active || paused)
        return result;

    uint64_t pending =
        pendingActiveMilliseconds();

    if (result >
        PLAYTIME_UINT64_MAX - pending)
    {
        return PLAYTIME_UINT64_MAX;
    }

    return result + pending;
}


