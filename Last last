bool parseStatisticRecord(
    const String& line,
    StatisticInfo& statistic,
    bool& repaired
)
{
    if (countFields(line) != 11)
        return false;

    String recordType;
    String encodedID;
    String encodedSource;
    String encodedTitle;
    String valueField;
    String defaultField;
    String bestField;
    String updatedField;
    String typeField;
    String bestInitializedField;
    String persistentField;

    if (!readField(line, 0, recordType) ||
        !readField(line, 1, encodedID) ||
        !readField(line, 2, encodedSource) ||
        !readField(line, 3, encodedTitle) ||
        !readField(line, 4, valueField) ||
        !readField(line, 5, defaultField) ||
        !readField(line, 6, bestField) ||
        !readField(line, 7, updatedField) ||
        !readField(line, 8, typeField) ||
        !readField(line, 9, bestInitializedField) ||
        !readField(line, 10, persistentField))
    {
        return false;
    }

    if (recordType != "S")
        return false;

    statistic = makeEmptyStatistic();

    if (!decodeTextValue(encodedID, statistic.id) ||
        !decodeTextValue(encodedSource, statistic.source) ||
        !decodeTextValue(encodedTitle, statistic.title))
    {
        return false;
    }

    int64_t loadedValue = 0;
    int64_t loadedDefault = 0;
    int64_t loadedBest = 0;

    uint32_t loadedUpdatedAt = 0;
    uint32_t loadedType = 0;
    uint32_t loadedBestInitialized = 0;
    uint32_t loadedPersistent = 0;

    if (!parseSigned64(valueField, loadedValue) ||
        !parseSigned64(defaultField, loadedDefault) ||
        !parseSigned64(bestField, loadedBest) ||
        !parseUnsigned32(updatedField, loadedUpdatedAt) ||
        !parseUnsigned32(typeField, loadedType) ||
        !parseUnsigned32(
            bestInitializedField,
            loadedBestInitialized
        ) ||
        !parseUnsigned32(
            persistentField,
            loadedPersistent
        ))
    {
        return false;
    }

    if (!validIdentifierValue(statistic.id, 48) ||
        !validIdentifierValue(statistic.source, 48) ||
        !validTitleValue(statistic.title) ||
        loadedType >
            static_cast<uint32_t>(
                STATISTIC_LOW_SCORE
            ) ||
        loadedBestInitialized > 1 ||
        loadedPersistent > 1)
    {
        return false;
    }

    if (loadedPersistent == 0)
    {
        repaired = true;
        return false;
    }

    statistic.value = loadedValue;
    statistic.defaultValue = loadedDefault;
    statistic.bestValue = loadedBest;

    statistic.updatedAt = loadedUpdatedAt;

    statistic.type =
        static_cast<StatisticType>(loadedType);

    statistic.bestInitialized =
        loadedBestInitialized == 1;

    statistic.persistent = true;
    statistic.valid = true;

    if (statistic.type == STATISTIC_COUNTER &&
        statistic.value < statistic.defaultValue)
    {
        statistic.value = statistic.defaultValue;
        repaired = true;
    }

    if (!statistic.bestInitialized)
    {
        if (statistic.type == STATISTIC_COUNTER ||
            statistic.type == STATISTIC_GAUGE)
        {
            statistic.bestValue = statistic.value;
            statistic.bestInitialized = true;
            repaired = true;
        }
        else if (statistic.bestValue != 0)
        {
            statistic.bestValue = 0;
            repaired = true;
        }
    }
    else
    {
        bool bestNeedsUpdate = false;

        if (statistic.type == STATISTIC_LOW_SCORE)
        {
            bestNeedsUpdate =
                statistic.value <
                statistic.bestValue;
        }
        else
        {
            bestNeedsUpdate =
                statistic.value >
                statistic.bestValue;
        }

        if (bestNeedsUpdate)
        {
            statistic.bestValue = statistic.value;
            repaired = true;
        }
    }

    return true;
}

bool removeIfExists(const String& path)
{
    if (!StorageManager::exists(path))
        return true;

    return StorageManager::deleteFile(path);
}

bool copyFileContents(
    const String& sourcePath,
    const String& destinationPath
)
{
    File source =
        StorageManager::openFile(
            sourcePath,
            FILE_READ
        );

    if (!source)
        return false;

    if (!removeIfExists(destinationPath))
    {
        StorageManager::closeFile(source);
        return false;
    }

    File destination =
        StorageManager::openFile(
            destinationPath,
            FILE_WRITE
        );

    if (!destination)
    {
        StorageManager::closeFile(source);
        return false;
    }

    bool succeeded = true;
    uint8_t buffer[256];

    while (source.available())
    {
        int bytesRead =
            source.read(
                buffer,
                sizeof(buffer)
            );

        if (bytesRead <= 0)
        {
            succeeded = false;
            break;
        }

        size_t bytesWritten =
            destination.write(
                buffer,
                static_cast<size_t>(bytesRead)
            );

        if (bytesWritten !=
            static_cast<size_t>(bytesRead))
        {
            succeeded = false;
            break;
        }
    }

    destination.flush();

    if (destination.getWriteError() != 0)
        succeeded = false;

    StorageManager::closeFile(source);
    StorageManager::closeFile(destination);

    if (!succeeded)
        removeIfExists(destinationPath);

    return succeeded;
}

bool quarantineFile(
    const String& sourcePath,
    const String& quarantinePath
)
{
    if (!StorageManager::exists(sourcePath))
        return true;

    if (!removeIfExists(quarantinePath))
        return false;

    return StorageManager::renameFile(
        sourcePath,
        quarantinePath
    );
}

uint16_t persistentStatisticCount(
    const StatisticInfo* items,
    uint16_t itemCount
)
{
    if (items == nullptr)
        return 0;

    uint16_t result = 0;

    for (uint16_t i = 0; i < itemCount; i++)
    {
        if (items[i].valid &&
            items[i].persistent)
        {
            result++;
        }
    }

    return result;
}

bool writeStatisticsDatabase(
    const String& path,
    const char* header,
    uint16_t version,
    const StatisticInfo* items,
    uint16_t itemCount
)
{
    if (!removeIfExists(path))
        return false;

    File file =
        StorageManager::openFile(
            path,
            FILE_WRITE
        );

    if (!file)
        return false;

    uint16_t persistentCount =
        persistentStatisticCount(
            items,
            itemCount
        );

    file.println(header);
    file.println(version);
    file.println(persistentCount);

    for (uint16_t i = 0; i < itemCount; i++)
    {
        const StatisticInfo& statistic =
            items[i];

        if (!statistic.valid ||
            !statistic.persistent)
        {
            continue;
        }

        file.print("S|");
        file.print(encodeTextValue(statistic.id));
        file.print('|');
        file.print(encodeTextValue(statistic.source));
        file.print('|');
        file.print(encodeTextValue(statistic.title));
        file.print('|');
        file.print(signed64ToString(statistic.value));
        file.print('|');
        file.print(
            signed64ToString(
                statistic.defaultValue
            )
        );
        file.print('|');
        file.print(
            signed64ToString(
                statistic.bestValue
            )
        );
        file.print('|');
        file.print(statistic.updatedAt);
        file.print('|');
        file.print(
            static_cast<uint8_t>(
                statistic.type
            )
        );
        file.print('|');
        file.print(
            statistic.bestInitialized
                ? 1
                : 0
        );
        file.print('|');
        file.println(1);
    }

    file.flush();

    bool succeeded =
        file.getWriteError() == 0;

    StorageManager::closeFile(file);

    if (!succeeded)
        removeIfExists(path);

    return succeeded;
}

bool loadStatisticsDatabase(
    const String& path,
    const char* expectedHeader,
    uint16_t expectedVersion,
    StatisticInfo* output,
    uint16_t maximumCount,
    uint16_t& outputCount,
    bool& repaired
)
{
    outputCount = 0;
    repaired = false;

    if (output != nullptr)
    {
        for (uint16_t i = 0;
             i < maximumCount;
             i++)
        {
            output[i] = makeEmptyStatistic();
        }
    }

    File file =
        StorageManager::openFile(
            path,
            FILE_READ
        );

    if (!file)
        return false;

    String header =
        file.readStringUntil('\n');

    removeCarriageReturn(header);

    if (header != expectedHeader)
    {
        StorageManager::closeFile(file);
        return false;
    }

    String versionLine =
        file.readStringUntil('\n');

    removeCarriageReturn(versionLine);

    uint32_t loadedVersion = 0;

    if (!parseUnsigned32(
            versionLine,
            loadedVersion
        ) ||
        loadedVersion != expectedVersion)
    {
        StorageManager::closeFile(file);
        return false;
    }

    String countLine =
        file.readStringUntil('\n');

    removeCarriageReturn(countLine);

    uint32_t declaredCount = 0;

    if (!parseUnsigned32(
            countLine,
            declaredCount
        ) ||
        declaredCount > maximumCount)
    {
        StorageManager::closeFile(file);
        return false;
    }

    uint32_t physicalRecordCount = 0;

    while (file.available())
    {
        String line =
            file.readStringUntil('\n');

        removeCarriageReturn(line);

        if (line.length() == 0)
        {
            repaired = true;
            continue;
        }

        physicalRecordCount++;

        if (line.length() > 1024)
        {
            repaired = true;
            continue;
        }

        StatisticInfo statistic;
        bool recordRepaired = false;

        if (!parseStatisticRecord(
                line,
                statistic,
                recordRepaired
            ))
        {
            repaired = true;
            continue;
        }

        if (hasDuplicateID(
                output,
                outputCount,
                statistic.id
            ))
        {
            repaired = true;
            continue;
        }

        if (outputCount >= maximumCount)
        {
            repaired = true;
            break;
        }

        if (output != nullptr)
            output[outputCount] = statistic;

        outputCount++;

        if (recordRepaired)
            repaired = true;
    }

    StorageManager::closeFile(file);

    if (physicalRecordCount != declaredCount ||
        outputCount != declaredCount)
    {
        repaired = true;
    }

    return true;
}

bool isLeapYearValue(uint16_t year)
{
    if ((year % 400) == 0)
        return true;

    if ((year % 100) == 0)
        return false;

    return (year % 4) == 0;
}

uint8_t daysInMonthValue(
    uint8_t month,
    uint16_t year
)
{
    static const uint8_t MONTH_DAYS[12] =
    {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    if (month < 1 || month > 12)
        return 0;

    if (month == 2 &&
        isLeapYearValue(year))
    {
        return 29;
    }

    return MONTH_DAYS[month - 1];
}

}

