//====================================================
// ESP32 GAME STATION
// POWER STATE AND SHUTDOWN MANAGER
// 107_power_manager.h
//====================================================
//
// Responsibilities:
// - Tracks input activity and display idle states.
// - Wakes the display when activity is reported.
// - Coordinates a non-blocking safe-shutdown sequence.
// - Disables haptic, backlight and TPS61088 boost output.
//
// Notes:
// - The locking physical power button remains the primary
//   hardware power control.
// - DIMMED is a logical state. The later backlight/display
//   driver can apply reduced PWM brightness through the
//   state callback.
// - Touch and phone-keypad drivers must call
//   notifyActivity() when they detect valid input.
//====================================================

enum class PowerState : uint8_t
{
    OFF = 0,
    STARTING,
    ACTIVE,
    DIMMED,
    DISPLAY_OFF,
    SHUTDOWN_PENDING,
    SHUTTING_DOWN,
    POWER_DISABLED,
    FAILED
};

enum class ShutdownReason : uint8_t
{
    NONE = 0,
    USER_REQUEST,
    LOW_BATTERY,
    CRITICAL_BATTERY,
    SOFTWARE_REQUEST,
    SYSTEM_UPDATE,
    INTERNAL_ERROR
};

enum class PowerError : uint8_t
{
    NONE = 0,
    HARDWARE_INITIALIZATION_FAILED,
    BOOST_CONTROL_FAILED,
    BACKLIGHT_CONTROL_FAILED,
    INVALID_IDLE_TIMEOUTS,
    INVALID_SHUTDOWN_REASON
};

struct PowerStatus
{
    bool initialized;
    bool automaticIdleEnabled;
    bool keepAwake;
    bool shutdownRequested;
    bool shutdownPreparationComplete;
    bool boostEnabled;
    bool backlightEnabled;

    uint32_t lastActivityTime;
    uint32_t idleTimeMs;
    uint32_t dimTimeoutMs;
    uint32_t displayOffTimeoutMs;
    uint32_t shutdownRequestTime;

    PowerState state;
    ShutdownReason shutdownReason;
    PowerError error;
};

using PowerStateCallback = void (*)(
    PowerState previousState,
    PowerState currentState);

// Return true when files/settings/audio are safe for power-off.
// Returning false asks PowerManager to try again until timeout.
using ShutdownPreparationCallback = bool (*)(
    ShutdownReason reason);

class PowerManager
{
public:
    static constexpr uint32_t DEFAULT_DIM_TIMEOUT_MS =
        BoardConfig::MENU_IDLE_TIMEOUT_MS / 2UL;

    static constexpr uint32_t DEFAULT_DISPLAY_OFF_TIMEOUT_MS =
        BoardConfig::MENU_IDLE_TIMEOUT_MS;

    static constexpr uint32_t DIRECT_BUTTON_POLL_INTERVAL_MS =
        20UL;

    static constexpr uint32_t SHUTDOWN_REQUEST_GRACE_MS =
        150UL;

    static constexpr uint32_t SHUTDOWN_PREPARATION_TIMEOUT_MS =
        2500UL;

    //================================================
    // LIFECYCLE
    //================================================

    static bool begin();
    static void update();
    static void end();

    static bool ready();
    static PowerStatus status();

    //================================================
    // ACTIVITY AND IDLE CONTROL
    //================================================

    static void notifyActivity();

    static bool setIdleTimeouts(
        uint32_t dimTimeoutMs,
        uint32_t displayOffTimeoutMs);

    static void setAutomaticIdleEnabled(bool enabled);
    static bool automaticIdleEnabled();

    static void setKeepAwake(bool enabled);
    static bool keepAwake();

    static uint32_t idleTimeMs();

    //================================================
    // SHUTDOWN CONTROL
    //================================================

    static bool requestShutdown(ShutdownReason reason);
    static bool cancelShutdown();
    static bool forceShutdown(ShutdownReason reason);

    static bool shutdownPending();
    static ShutdownReason shutdownReason();

    //================================================
    // STATE ACCESS
    //================================================

    static PowerState state();
    static PowerError lastError();

    static bool displayAwake();
    static bool displayDimmed();

    //================================================
    // CALLBACKS
    //================================================

    static void setStateCallback(
        PowerStateCallback callback);

    static void setShutdownPreparationCallback(
        ShutdownPreparationCallback callback);

    //================================================
    // TEXT HELPERS
    //================================================

    static const char* stateText(PowerState value);
    static const char* reasonText(ShutdownReason value);
    static const char* errorText(PowerError value);

private:
    static PowerStatus currentStatus;

    static PowerStateCallback stateCallback;
    static ShutdownPreparationCallback shutdownCallback;

    static uint32_t lastButtonPollTime;

    static void clearState();
    static bool fail(PowerError error);

    static void processDirectButtonActivity(uint32_t now);
    static void processIdle(uint32_t now);
    static void processShutdown(uint32_t now);

    static void transitionTo(PowerState newState);
    static bool wakeDisplay();
    static bool turnDisplayOff();
    static bool performPowerCut();

    static bool validShutdownReason(ShutdownReason reason);
    static bool anyDirectButtonPressed();
    static void synchronizeHardwareStatus();
};

static_assert(
    PowerManager::DEFAULT_DIM_TIMEOUT_MS > 0,
    "Power dim timeout must be greater than zero");

static_assert(
    PowerManager::DEFAULT_DIM_TIMEOUT_MS <
        PowerManager::DEFAULT_DISPLAY_OFF_TIMEOUT_MS,
    "Power dim timeout must precede display-off timeout");

#endif
#include "107_power_manager.h"

//====================================================
// ESP32 GAME STATION
// POWER STATE AND SHUTDOWN MANAGER
// 108_power_manager.cpp
//====================================================

PowerStatus PowerManager::currentStatus =
{
    false,
    true,
    false,
    false,
    false,
    false,
    false,
    0,
    0,
    PowerManager::DEFAULT_DIM_TIMEOUT_MS,
    PowerManager::DEFAULT_DISPLAY_OFF_TIMEOUT_MS,
    0,
    PowerState::OFF,
    ShutdownReason::NONE,
    PowerError::NONE
};

PowerStateCallback PowerManager::stateCallback = nullptr;

ShutdownPreparationCallback
    PowerManager::shutdownCallback = nullptr;

uint32_t PowerManager::lastButtonPollTime = 0;

//====================================================
// LIFECYCLE
//====================================================

bool PowerManager::begin()
{
    if (currentStatus.initialized)
    {
        return ready();
    }

    clearState();
    transitionTo(PowerState::STARTING);

    if (!HardwareManager::ready() &&
        !HardwareManager::begin())
    {
        return fail(
            PowerError::HARDWARE_INITIALIZATION_FAILED);
    }

    if (!HardwareManager::boostEnabled() &&
        !HardwareManager::setBoostEnabled(true))
    {
        return fail(
            PowerError::BOOST_CONTROL_FAILED);
    }

    if (BoardConfig::ENABLE_DISPLAY &&
        !HardwareManager::setBacklightEnabled(true))
    {
        return fail(
            PowerError::BACKLIGHT_CONTROL_FAILED);
    }

    const uint32_t now = millis();

    currentStatus.initialized = true;
    currentStatus.lastActivityTime = now;
    currentStatus.idleTimeMs = 0;
    currentStatus.shutdownRequestTime = 0;
    currentStatus.shutdownReason = ShutdownReason::NONE;
    currentStatus.error = PowerError::NONE;

    synchronizeHardwareStatus();
    transitionTo(PowerState::ACTIVE);

    return true;
}

void PowerManager::update()
{
    if (!currentStatus.initialized)
    {
        return;
    }

    if (currentStatus.state == PowerState::FAILED ||
        currentStatus.state == PowerState::POWER_DISABLED)
    {
        return;
    }

    const uint32_t now = millis();

    processDirectButtonActivity(now);

    if (currentStatus.shutdownRequested)
    {
        processShutdown(now);
        return;
    }

    processIdle(now);
    synchronizeHardwareStatus();
}

void PowerManager::end()
{
    if (currentStatus.initialized)
    {
        HardwareManager::setHapticEnabled(false);

        if (BoardConfig::ENABLE_DISPLAY)
        {
            HardwareManager::setBacklightEnabled(false);
        }
    }

    clearState();
}

bool PowerManager::ready()
{
    return
        currentStatus.initialized &&
        currentStatus.error == PowerError::NONE &&
        currentStatus.state != PowerState::FAILED &&
        currentStatus.state != PowerState::POWER_DISABLED;
}

PowerStatus PowerManager::status()
{
    if (currentStatus.initialized)
    {
        currentStatus.idleTimeMs =
            millis() - currentStatus.lastActivityTime;

        synchronizeHardwareStatus();
    }

    return currentStatus;
}

//====================================================
// ACTIVITY AND IDLE CONTROL
//====================================================

void PowerManager::notifyActivity()
{
    if (!currentStatus.initialized ||
        currentStatus.shutdownRequested)
    {
        return;
    }

    currentStatus.lastActivityTime = millis();
    currentStatus.idleTimeMs = 0;

    if (currentStatus.state == PowerState::DIMMED ||
        currentStatus.state == PowerState::DISPLAY_OFF)
    {
        wakeDisplay();
    }
}

bool PowerManager::setIdleTimeouts(
    uint32_t dimTimeoutMs,
    uint32_t displayOffTimeoutMs)
{
    if (dimTimeoutMs == 0 ||
        displayOffTimeoutMs == 0 ||
        dimTimeoutMs >= displayOffTimeoutMs)
    {
        currentStatus.error =
            PowerError::INVALID_IDLE_TIMEOUTS;

        return false;
    }

    currentStatus.dimTimeoutMs = dimTimeoutMs;
    currentStatus.displayOffTimeoutMs =
        displayOffTimeoutMs;

    if (currentStatus.error ==
        PowerError::INVALID_IDLE_TIMEOUTS)
    {
        currentStatus.error = PowerError::NONE;
    }

    if (currentStatus.initialized)
    {
        notifyActivity();
    }

    return true;
}

void PowerManager::setAutomaticIdleEnabled(bool enabled)
{
    currentStatus.automaticIdleEnabled = enabled;

    if (!currentStatus.initialized)
    {
        return;
    }

    currentStatus.lastActivityTime = millis();
    currentStatus.idleTimeMs = 0;

    if (!enabled &&
        (currentStatus.state == PowerState::DIMMED ||
         currentStatus.state == PowerState::DISPLAY_OFF))
    {
        wakeDisplay();
    }
}

bool PowerManager::automaticIdleEnabled()
{
    return currentStatus.automaticIdleEnabled;
}

void PowerManager::setKeepAwake(bool enabled)
{
    currentStatus.keepAwake = enabled;

    if (!currentStatus.initialized)
    {
        return;
    }

    currentStatus.lastActivityTime = millis();
    currentStatus.idleTimeMs = 0;

    if (enabled &&
        (currentStatus.state == PowerState::DIMMED ||
         currentStatus.state == PowerState::DISPLAY_OFF))
    {
        wakeDisplay();
    }
}

bool PowerManager::keepAwake()
{
    return currentStatus.keepAwake;
}

uint32_t PowerManager::idleTimeMs()
{
    if (!currentStatus.initialized)
    {
        return 0;
    }

    return millis() - currentStatus.lastActivityTime;
}

//====================================================
// SHUTDOWN CONTROL
//====================================================

bool PowerManager::requestShutdown(
    ShutdownReason reason)
{
    if (!currentStatus.initialized)
    {
        return false;
    }

    if (!validShutdownReason(reason))
    {
        currentStatus.error =
            PowerError::INVALID_SHUTDOWN_REASON;

        return false;
    }

    if (currentStatus.state == PowerState::POWER_DISABLED ||
        currentStatus.state == PowerState::SHUTTING_DOWN)
    {
        return false;
    }

    currentStatus.error = PowerError::NONE;

    if (currentStatus.shutdownRequested)
    {
        currentStatus.shutdownReason = reason;
        return true;
    }

    currentStatus.shutdownRequested = true;
    currentStatus.shutdownPreparationComplete = false;
    currentStatus.shutdownReason = reason;
    currentStatus.shutdownRequestTime = millis();

    transitionTo(PowerState::SHUTDOWN_PENDING);
    return true;
}

bool PowerManager::cancelShutdown()
{
    if (!currentStatus.initialized ||
        currentStatus.state != PowerState::SHUTDOWN_PENDING)
    {
        return false;
    }

    currentStatus.shutdownRequested = false;
    currentStatus.shutdownPreparationComplete = false;
    currentStatus.shutdownReason = ShutdownReason::NONE;
    currentStatus.shutdownRequestTime = 0;
    currentStatus.error = PowerError::NONE;
    currentStatus.lastActivityTime = millis();
    currentStatus.idleTimeMs = 0;

    return wakeDisplay();
}

bool PowerManager::forceShutdown(
    ShutdownReason reason)
{
    if (!currentStatus.initialized)
    {
        return false;
    }

    if (!validShutdownReason(reason))
    {
        currentStatus.error =
            PowerError::INVALID_SHUTDOWN_REASON;

        return false;
    }

    currentStatus.error = PowerError::NONE;
    currentStatus.shutdownRequested = true;
    currentStatus.shutdownReason = reason;
    currentStatus.shutdownRequestTime = millis();

    transitionTo(PowerState::SHUTTING_DOWN);

    HardwareManager::setHapticEnabled(false);

    if (BoardConfig::ENABLE_DISPLAY)
    {
        HardwareManager::setBacklightEnabled(false);
    }

    if (shutdownCallback != nullptr)
    {
        (void)shutdownCallback(reason);
    }

    currentStatus.shutdownPreparationComplete = true;
    return performPowerCut();
}

