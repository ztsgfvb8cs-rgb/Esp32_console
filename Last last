//==================================================


//---------------- Internal Entries ----------------

static ProfileSelectorEntry selectorEntries[
    PROFILE_STORAGE_MAX_PROFILES
];


//---------------- Internal Selection ----------------

static uint8_t selectorEntryCount =
    0;


static uint8_t selectedProfileIndex =
    PROFILE_SELECTOR_INVALID_INDEX;


//---------------- Internal State ----------------

static bool profileSelectorReady =
    false;


static ProfileSelectorStatus profileSelectorStatus =
    PROFILE_SELECTOR_NOT_INITIALIZED;


static uint32_t lastSelectorRefreshTime =
    0;


//---------------- Internal Functions ----------------

static void clearSelectorEntry(
    ProfileSelectorEntry& entry
)
{
    memset(
        &entry,
        0,
        sizeof(ProfileSelectorEntry)
    );


    entry.profileID =
        PROFILE_INVALID_ID;


    entry.playerName[0] =
        '\0';


    entry.selected =
        false;


    entry.valid =
        false;
}



static void clearSelectorEntries()
{
    selectorEntryCount =
        0;


    selectedProfileIndex =
        PROFILE_SELECTOR_INVALID_INDEX;


    for(uint8_t i = 0;
        i < PROFILE_STORAGE_MAX_PROFILES;
        i++)
    {
        clearSelectorEntry(
            selectorEntries[i]
        );
    }
}



static void updateSelectedFlags()
{
    for(uint8_t i = 0;
        i < selectorEntryCount;
        i++)
    {
        selectorEntries[i].selected =
            i == selectedProfileIndex;
    }
}



static void copyIndexEntryToSelector(
    ProfileSelectorEntry& destination,
    const ProfileIndexEntry& source
)
{
    clearSelectorEntry(
        destination
    );


    destination.profileID =
        source.profileID;


    strncpy(
        destination.playerName,
        source.playerName,
        PROFILE_SELECTOR_NAME_LENGTH - 1
    );


    destination.playerName[
        PROFILE_SELECTOR_NAME_LENGTH - 1
    ] = '\0';


    destination.createdUnix =
        source.createdUnix;


    destination.lastLoginUnix =
        source.lastLoginUnix;


    destination.lastSavedUnix =
        source.lastSavedUnix;


    destination.totalPlaytimeMilliseconds =
        source.totalPlaytimeMilliseconds;


    destination.loginCount =
        source.loginCount;


    destination.selected =
        false;


    destination.valid =
        source.valid;
}



static bool isValidSelectorIndex(
    uint8_t index
)
{
    if(index >= selectorEntryCount)
    {
        return false;
    }


    if(!selectorEntries[index].valid)
    {
        return false;
    }


    return true;
}



static void preserveSelectionAfterRefresh(
    uint16_t previousProfileID
)
{
    selectedProfileIndex =
        PROFILE_SELECTOR_INVALID_INDEX;


    if(previousProfileID ==
       PROFILE_INVALID_ID)
    {
        updateSelectedFlags();

        return;
    }


    int8_t index =
        findProfileSelectorIndexByID(
            previousProfileID
        );


    if(index >= 0)
    {
        selectedProfileIndex =
            (uint8_t)index;
    }


    updateSelectedFlags();
}



//---------------- Initialization ----------------

bool initProfileSelector()
{
    clearSelectorEntries();


    profileSelectorReady =
        false;


    profileSelectorStatus =
        PROFILE_SELECTOR_NOT_INITIALIZED;


    lastSelectorRefreshTime =
        millis();


    if(!isProfileStorageReady())
    {
        if(!initProfileStorage())
        {
            profileSelectorStatus =
                PROFILE_SELECTOR_STORAGE_ERROR;


            return false;
        }
    }


    if(!refreshProfileSelector())
    {
        return false;
    }


    profileSelectorReady =
        true;


    if(selectorEntryCount == 0)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_NO_PROFILES;
    }
    else
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_READY;
    }


    return true;
}



//---------------- Selector Update ----------------

void updateProfileSelector()
{
    if(!profileSelectorReady)
    {
        return;
    }


    uint32_t currentTime =
        millis();


    if(currentTime -
       lastSelectorRefreshTime <
       PROFILE_SELECTOR_REFRESH_INTERVAL)
    {
        return;
    }


    lastSelectorRefreshTime =
        currentTime;


    uint8_t storedProfileCount =
        getStoredProfileCount();


    if(storedProfileCount !=
       selectorEntryCount)
    {
        refreshProfileSelector();
    }
}



bool refreshProfileSelector()
{
    uint16_t previousProfileID =
        getSelectedProfileID();


    clearSelectorEntries();


    if(!isProfileStorageReady())
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_STORAGE_ERROR;


        return false;
    }


    uint8_t storedProfileCount =
        getStoredProfileCount();


    if(storedProfileCount >
       PROFILE_STORAGE_MAX_PROFILES)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_STORAGE_ERROR;


        return false;
    }


    for(uint8_t i = 0;
        i < storedProfileCount;
        i++)
    {
        const ProfileIndexEntry* indexEntry =
            getProfileIndexEntry(
                i
            );


        if(indexEntry == nullptr)
        {
            continue;
        }


        if(!indexEntry->valid)
        {
            continue;
        }


        if(selectorEntryCount >=
           PROFILE_STORAGE_MAX_PROFILES)
        {
            break;
        }


        copyIndexEntryToSelector(
            selectorEntries[
                selectorEntryCount
            ],
            *indexEntry
        );


        selectorEntryCount++;
    }


    preserveSelectionAfterRefresh(
        previousProfileID
    );


    if(selectedProfileIndex ==
       PROFILE_SELECTOR_INVALID_INDEX &&
       selectorEntryCount > 0)
    {
        selectedProfileIndex =
            0;


        updateSelectedFlags();
    }


    profileSelectorReady =
        true;


    if(selectorEntryCount == 0)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_NO_PROFILES;
    }
    else
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_READY;
    }


    lastSelectorRefreshTime =
        millis();


    return true;
}



//---------------- Selector State ----------------

bool isProfileSelectorReady()
{
    return profileSelectorReady;
}



ProfileSelectorStatus getProfileSelectorStatus()
{
    return profileSelectorStatus;
}



//---------------- Entry Information ----------------

uint8_t getProfileSelectorCount()
{
    return selectorEntryCount;
}



const ProfileSelectorEntry* getProfileSelectorEntry(
    uint8_t index
)
{
    if(!isValidSelectorIndex(
        index
    ))
    {
        return nullptr;
    }


    return &selectorEntries[index];
}



const ProfileSelectorEntry* getSelectedProfileEntry()
{
    if(!hasSelectedProfile())
    {
        return nullptr;
    }


    return &selectorEntries[
        selectedProfileIndex
    ];
}



//---------------- Selection ----------------

bool selectProfileByIndex(
    uint8_t index
)
{
    if(!profileSelectorReady)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_NOT_INITIALIZED;


        return false;
    }


    if(!isValidSelectorIndex(
        index
    ))
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_INVALID_INDEX;


        return false;
    }


    selectedProfileIndex =
        index;


    updateSelectedFlags();


    profileSelectorStatus =
        PROFILE_SELECTOR_READY;


    return true;
}



bool selectProfileByID(
    uint16_t profileID
)
{
    int8_t index =
        findProfileSelectorIndexByID(
            profileID
        );


    if(index < 0)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_INVALID_PROFILE;


        return false;
    }


    return selectProfileByIndex(
        (uint8_t)index
    );
}



bool selectNextProfile()
{
    if(selectorEntryCount == 0)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_NO_PROFILES;


        return false;
    }


    if(selectedProfileIndex ==
       PROFILE_SELECTOR_INVALID_INDEX)
    {
        return selectProfileByIndex(
            0
        );
    }


    uint8_t nextIndex =
        selectedProfileIndex + 1;


    if(nextIndex >=
       selectorEntryCount)
    {
        nextIndex =
            0;
    }


    return selectProfileByIndex(
        nextIndex
    );
}



bool selectPreviousProfile()
{
    if(selectorEntryCount == 0)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_NO_PROFILES;


        return false;
    }


    if(selectedProfileIndex ==
       PROFILE_SELECTOR_INVALID_INDEX)
    {
        return selectProfileByIndex(
            selectorEntryCount - 1
        );
    }


    uint8_t previousIndex;


    if(selectedProfileIndex == 0)
    {
        previousIndex =
            selectorEntryCount - 1;
    }
    else
    {
        previousIndex =
            selectedProfileIndex - 1;
    }


    return selectProfileByIndex(
        previousIndex
    );
}



bool clearProfileSelection()
{
    selectedProfileIndex =
        PROFILE_SELECTOR_INVALID_INDEX;


    updateSelectedFlags();


    if(selectorEntryCount == 0)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_NO_PROFILES;
    }
    else
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_READY;
    }


