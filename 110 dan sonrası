RuntimeInputDisposition RuntimeInputRouter::routeForeground(
    const InputEvent& event,
    RuntimeInputTarget target)
{
    if (isForegroundExitEvent(event))
        return requestSessionClose(event);

    if (target == RuntimeInputTarget::ForegroundPdf)
        return routePdf(event);

    if (target != RuntimeInputTarget::ForegroundGame)
    {
        return record(
            event,
            target,
            RuntimeInputDisposition::Error,
            RuntimeInputError::ForegroundStateMismatch);
    }

    if (!eventVisibleToForeground(event))
    {
        return record(
            event,
            target,
            RuntimeInputDisposition::Ignored);
    }

    return record(
        event,
        target,
        RuntimeInputDisposition::ForwardedToForeground);
}

RuntimeInputDisposition RuntimeInputRouter::routeScreen(
    const InputEvent& event,
    RuntimeInputTarget target)
{
    switch (target)
    {
        case RuntimeInputTarget::MainMenu:
            MenuController::handleInput(event);
            ScreenManager::invalidate();

            return record(
                event,
                target,
                RuntimeInputDisposition::ForwardedToScreen);

        case RuntimeInputTarget::FileBrowser:
            FileBrowserController::update(event);
            ScreenManager::invalidate();

            return record(
                event,
                target,
                RuntimeInputDisposition::ForwardedToScreen);

        case RuntimeInputTarget::Settings:
            SettingsScreen::update(event);
            ScreenManager::invalidate();

            return record(
                event,
                target,
                RuntimeInputDisposition::ForwardedToScreen);

        case RuntimeInputTarget::Search:
        case RuntimeInputTarget::SystemScreen:
            if ((event.action == InputAction::Back ||
                 event.action == InputAction::Menu) &&
                event.type == InputEventType::Pressed)
            {
                ScreenManager::navigate(AppScreen::MainMenu);
                ScreenManager::invalidate();

                return record(
                    event,
                    target,
                    RuntimeInputDisposition::Consumed);
            }

            return record(
                event,
                target,
                RuntimeInputDisposition::Ignored);

        case RuntimeInputTarget::ForegroundGame:
        case RuntimeInputTarget::ForegroundPdf:
            return record(
                event,
                target,
                RuntimeInputDisposition::Error,
                RuntimeInputError::ForegroundStateMismatch);

        default:
            return record(
                event,
                target,
                RuntimeInputDisposition::Ignored);
    }
}

RuntimeInputDisposition RuntimeInputRouter::routePdf(
    const InputEvent& event)
{
    if (!PdfReader::isOpen())
    {
        return record(
            event,
            RuntimeInputTarget::ForegroundPdf,
            RuntimeInputDisposition::Error,
            RuntimeInputError::ForegroundStateMismatch);
    }

    if (!eventEligibleForPdfNavigation(event))
    {
        return record(
            event,
            RuntimeInputTarget::ForegroundPdf,
            RuntimeInputDisposition::Ignored);
    }

    const bool next =
        (policy_.directionalPdfNavigation &&
         (event.action == InputAction::Right ||
          event.action == InputAction::Down)) ||
        (policy_.faceButtonPdfNavigation &&
         event.action == InputAction::A);

    const bool previous =
        (policy_.directionalPdfNavigation &&
         (event.action == InputAction::Left ||
          event.action == InputAction::Up)) ||
        (policy_.faceButtonPdfNavigation &&
         event.action == InputAction::B);

    RuntimeResult result = RuntimeResult::InvalidArgument;

    if (next)
        result = PdfReader::nextPage();
    else if (previous)
        result = PdfReader::previousPage();

    if (result != RuntimeResult::Ok)
    {
        return record(
            event,
            RuntimeInputTarget::ForegroundPdf,
            RuntimeInputDisposition::Error,
            RuntimeInputError::PdfOperationFailed);
    }

    ScreenManager::invalidate();

    return record(
        event,
        RuntimeInputTarget::ForegroundPdf,
        RuntimeInputDisposition::PdfPageChanged);
}
