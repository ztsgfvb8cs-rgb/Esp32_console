bool PlaytimeManager::registerGame(
    const String& gameName
)
{
    if(!managerInitialized)
    {
        return false;
    }


    if(!validGameName(
        gameName
    ))
    {
        return false;
    }


    if(exists(
        gameName
    ))
    {
        return true;
    }


    if(recordCount >=
       PLAYTIME_MAX_GAMES)
    {
        return false;
    }


    GamePlaytimeRecord& record =
        records[
            recordCount
        ];


    clearRecord(
        record
    );


    if(!copyGameName(
        record.gameName,
        gameName
    ))
    {
        clearRecord(
            record
        );


        return false;
    }


    record.valid =
        true;


    record.modified =
        true;


    recordCount++;


    dataModified =
        true;


    return true;
}



bool PlaytimeManager::removeGame(
    const String& gameName
)
{
    if(!managerInitialized)
    {
        return false;
    }


    int16_t gameIndex =
        find(
            gameName
        );


    if(gameIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        return false;
    }


    if(
        session.active &&
        session.gameIndex ==
            gameIndex
    )
    {
        if(!cancel())
        {
            return false;
        }
    }


    for(uint16_t i =
            (uint16_t)gameIndex;
        i + 1 < recordCount;
        i++)
    {
        records[i] =
            records[i + 1];
    }


    if(recordCount > 0)
    {
        recordCount--;


        clearRecord(
            records[
                recordCount
            ]
        );
    }


    if(
        session.active &&
        session.gameIndex >
            gameIndex
    )
    {
        session.gameIndex--;
    }


    dataModified =
        true;


    return true;
}



bool PlaytimeManager::exists(
    const String& gameName
)
{
    return
        find(
            gameName
        ) !=
        PLAYTIME_INVALID_GAME_INDEX;
}


