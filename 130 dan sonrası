uint32_t nextGeneration(uint32_t current)
{
    return current == UINT32_MAX
        ? 1U
        : current + 1U;
}

bool validClearMode(StreamRingBufferClearMode mode)
{
    switch (mode)
    {
        case StreamRingBufferClearMode::Preserve:
        case StreamRingBufferClearMode::Clear:
            return true;

        default:
            return false;
    }
}
}

StreamRingBuffer::~StreamRingBuffer()
{
    end();
}

StreamRingBuffer::StreamRingBuffer(
    StreamRingBuffer&& other) noexcept
{
    moveFrom(other);
}

StreamRingBuffer& StreamRingBuffer::operator=(
    StreamRingBuffer&& other) noexcept
{
    if (this != &other)
    {
        end();
        moveFrom(other);
    }

    return *this;
}

RuntimeResult StreamRingBuffer::begin(
    const StreamRingBufferConfig& config)
{
    if (status_.initialized || backing_)
    {
        return setError(
            StreamRingBufferError::AlreadyInitialized,
            RuntimeResult::Busy);
    }

    if (!validConfig(config, config.capacityBytes))
    {
        return setError(
            config.capacityBytes <
                    STREAM_RING_BUFFER_MINIMUM_CAPACITY_BYTES
                ? StreamRingBufferError::InvalidCapacity
                : StreamRingBufferError::InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    if (!MemoryManager::begin())
    {
        return setError(
            StreamRingBufferError::BackingAllocationFailed,
            RuntimeResult::NotReady);
    }

    MemoryBlock block = MemoryManager::allocate(
        config.capacityBytes,
        config.preference,
        config.clearBackingStore);

    if (!block || block.size < config.capacityBytes)
    {
        if (block)
        {
            MemoryManager::release(block);
        }

        return setError(
            StreamRingBufferError::BackingAllocationFailed,
            RuntimeResult::OutOfMemory);
    }

    const uint32_t generation =
        nextGeneration(status_.generation);

    backing_ = block;
    config_ = config;
    readOffset_ = 0;
    writeOffset_ = 0;
    usedBytes_ = 0;
    writeReservationBytes_ = 0;
    readReservationBytes_ = 0;

    status_ = {};
    status_.initialized = true;
    status_.ownsBackingStore = true;
    status_.psram = backing_.psram;
    status_.overflowPolicy = config_.overflowPolicy;
    status_.capacityBytes = backing_.size;
    status_.generation = generation;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult StreamRingBuffer::begin(
    size_t capacityBytes,
    MemoryPreference preference,
    StreamRingBufferOverflowPolicy overflowPolicy)
{
    StreamRingBufferConfig config;
    config.capacityBytes = capacityBytes;
    config.preference = preference;
    config.overflowPolicy = overflowPolicy;

    return begin(config);
}

RuntimeResult StreamRingBuffer::attach(
    void* externalBuffer,
    size_t capacityBytes,
    const StreamRingBufferConfig& config)
{
    if (status_.initialized || backing_)
    {
        return setError(
            StreamRingBufferError::AlreadyInitialized,
            RuntimeResult::Busy);
    }

    if (externalBuffer == nullptr)
    {
        return setError(
            StreamRingBufferError::InvalidPointer,
            RuntimeResult::InvalidArgument);
    }

    if (!validConfig(config, capacityBytes))
    {
        return setError(
            capacityBytes <
                    STREAM_RING_BUFFER_MINIMUM_CAPACITY_BYTES
                ? StreamRingBufferError::InvalidCapacity
                : StreamRingBufferError::InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    const uint32_t generation =
        nextGeneration(status_.generation);

    backing_ = {};
    backing_.data = externalBuffer;
    backing_.size = capacityBytes;
    backing_.psram = false;

    config_ = config;
    config_.capacityBytes = capacityBytes;

    if (config_.clearBackingStore)
    {
        memset(backing_.data, 0, backing_.size);
    }

    readOffset_ = 0;
    writeOffset_ = 0;
    usedBytes_ = 0;
    writeReservationBytes_ = 0;
    readReservationBytes_ = 0;

    status_ = {};
    status_.initialized = true;
    status_.ownsBackingStore = false;
    status_.psram = false;
    status_.overflowPolicy = config_.overflowPolicy;
    status_.capacityBytes = backing_.size;
    status_.generation = generation;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult StreamRingBuffer::attach(
    void* externalBuffer,
    size_t capacityBytes,
    StreamRingBufferOverflowPolicy overflowPolicy,
    bool clearBackingStore)
{
    StreamRingBufferConfig config;
    config.capacityBytes = capacityBytes;
    config.overflowPolicy = overflowPolicy;
    config.clearBackingStore = clearBackingStore;

    return attach(
        externalBuffer,
        capacityBytes,
        config);
}

void StreamRingBuffer::end()
{
    const uint32_t generation =
        nextGeneration(status_.generation);

    if (status_.ownsBackingStore && backing_)
    {
        MemoryManager::release(backing_);
    }

    backing_ = {};
    config_ = {};
    status_ = {};
    status_.generation = generation;

    readOffset_ = 0;
    writeOffset_ = 0;
    usedBytes_ = 0;
    writeReservationBytes_ = 0;
    readReservationBytes_ = 0;
    observer_ = nullptr;
}

bool StreamRingBuffer::ready() const
{
    return
        status_.initialized &&
        backing_.data != nullptr &&
        backing_.size >=
            STREAM_RING_BUFFER_MINIMUM_CAPACITY_BYTES &&
        backing_.size == status_.capacityBytes &&
        usedBytes_ <= backing_.size;
}

StreamRingBufferStatus StreamRingBuffer::status() const
{
    return status_;
}

RuntimeResult StreamRingBuffer::write(
    const void* source,
    size_t sizeBytes,
    size_t* writtenBytes)
{
    if (writtenBytes != nullptr)
    {
        *writtenBytes = 0;
    }

    if (!ready())
    {
        return setError(
            StreamRingBufferError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (writeReservationBytes_ > 0)
    {
        return setError(
            StreamRingBufferError::WriteReservationActive,
            RuntimeResult::Busy);
    }

    if (readReservationBytes_ > 0)
    {
        return setError(
            StreamRingBufferError::ReadReservationActive,
            RuntimeResult::Busy);
    }

    if (sizeBytes == 0)
    {
        status_.error = StreamRingBufferError::None;
        return RuntimeResult::Ok;
    }

    if (source == nullptr)
    {
        return setError(
            StreamRingBufferError::InvalidPointer,
            RuntimeResult::InvalidArgument);
    }

    if (rangesOverlap(
            source,
            sizeBytes,
            backing_.data,
            backing_.size))
    {
        return setError(
            StreamRingBufferError::SourceOverlapsBuffer,
            RuntimeResult::InvalidArgument);
    }

    const uint8_t* sourceBytes =
        static_cast<const uint8_t*>(source);

    size_t acceptedBytes = 0;
    size_t sourceOffset = 0;

    if (config_.overflowPolicy ==
        StreamRingBufferOverflowPolicy::OverwriteOldest)
    {
        if (sizeBytes > backing_.size)
        {
            sourceOffset = sizeBytes - backing_.size;
            acceptedBytes = backing_.size;

            status_.totalRejectedBytes = saturatingAdd64(
                status_.totalRejectedBytes,
                sourceOffset);

            status_.overflowCount =
                saturatingIncrement32(status_.overflowCount);
        }
        else
        {
            acceptedBytes = sizeBytes;
        }

        const size_t writable = backing_.size - usedBytes_;

        if (acceptedBytes > writable)
        {
            const size_t overwriteBytes =
                acceptedBytes - writable;

            if (config_.clearConsumedBytes)
            {
                clearRange(readOffset_, overwriteBytes);
            }

            advanceReadOffset(overwriteBytes);
            usedBytes_ -= overwriteBytes;

            status_.totalDiscardedBytes = saturatingAdd64(
                status_.totalDiscardedBytes,
                overwriteBytes);

            status_.totalOverwrittenBytes = saturatingAdd64(
                status_.totalOverwrittenBytes,
                overwriteBytes);

            status_.overflowCount =
                saturatingIncrement32(status_.overflowCount);
        }
    }
    else
    {
        const RuntimeResult spaceResult =
            makeWritableSpace(sizeBytes, &acceptedBytes);

        if (spaceResult != RuntimeResult::Ok)
        {
            return spaceResult;
        }
    }

    if (acceptedBytes == 0)
    {
        return setError(
            StreamRingBufferError::InsufficientWritableSpace,
            RuntimeResult::OutOfMemory);
    }

    const size_t firstBytes =
        acceptedBytes < backing_.size - writeOffset_
            ? acceptedBytes
            : backing_.size - writeOffset_;

    uint8_t* const destination =
        static_cast<uint8_t*>(backing_.data);

    memcpy(
        destination + writeOffset_,
        sourceBytes + sourceOffset,
        firstBytes);

    const size_t secondBytes =
        acceptedBytes - firstBytes;

    if (secondBytes > 0)
    {
        memcpy(
            destination,
            sourceBytes + sourceOffset + firstBytes,
            secondBytes);
    }

    advanceWriteOffset(acceptedBytes);
    usedBytes_ += acceptedBytes;

    status_.totalWrittenBytes = saturatingAdd64(
        status_.totalWrittenBytes,
        acceptedBytes);

    status_.writeCount =
        saturatingIncrement32(status_.writeCount);

    status_.error = StreamRingBufferError::None;

    if (writtenBytes != nullptr)
    {
        *writtenBytes = acceptedBytes;
    }

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult StreamRingBuffer::read(
    void* destination,
    size_t sizeBytes,
    size_t* readBytes)
{
    if (readBytes != nullptr)
    {
        *readBytes = 0;
    }

    if (!ready())
    {
        return setError(
            StreamRingBufferError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (writeReservationBytes_ > 0)
    {
        return setError(
            StreamRingBufferError::WriteReservationActive,
            RuntimeResult::Busy);
    }

    if (readReservationBytes_ > 0)
    {
        return setError(
            StreamRingBufferError::ReadReservationActive,
            RuntimeResult::Busy);
    }

    if (sizeBytes == 0)
    {
        status_.error = StreamRingBufferError::None;
