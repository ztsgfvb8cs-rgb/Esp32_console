bool AiDifficultyManager::setRequestedLevel(
    AiDifficultyLevel level)
{
    if (!currentStatus_.initialized)
    {
        setError(
            AiDifficultyError::
                NotInitialized);

        return false;
    }

    if (!validLevel(level, true))
    {
        setError(
            AiDifficultyError::InvalidLevel);

        return false;
    }

    const uint32_t nowMs = millis();

    currentStatus_.requestedLevel = level;

    currentStatus_.adaptiveActive =
        level == AiDifficultyLevel::Adaptive &&
        adaptivePolicy_.enabled;

    const AiDifficultyLevel effective =
        currentStatus_.adaptiveActive
            ? clampedAdaptiveLevel(
                adaptivePolicy_.initialLevel)
            : level;

    clearAdaptiveWindow(nowMs);

    applyEffectiveLevel(
        effective,
        AiDifficultyAdjustmentReason::
            ManualSelection,
        nowMs);

    currentStatus_.error =
        AiDifficultyError::None;

    notifyStateChanged();

    return true;
}

