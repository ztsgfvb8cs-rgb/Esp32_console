    standardConfig.gpio_cfg.invert_flags.bclk_inv = false;
    standardConfig.gpio_cfg.invert_flags.ws_inv = false;

    const esp_err_t initResult =
        i2s_channel_init_std_mode(
            transmitChannel,
            &standardConfig);

    if (initResult != ESP_OK)
    {
        i2s_del_channel(transmitChannel);
        transmitChannel = nullptr;

        currentStatus_.driverErrorCount =
            saturatingIncrement32(
                currentStatus_.driverErrorCount);

        return setError(
            config_.requestApll
                ? I2sAudioBackendError::ClockConfigurationFailed
                : I2sAudioBackendError::PinConfigurationFailed,
            RuntimeResult::IoError);
    }

    currentStatus_.usingApll =
        config_.requestApll;

#elif defined(EGS_I2S_USE_LEGACY_DRIVER)
    i2s_config_t driverConfig = {};
    driverConfig.mode = static_cast<i2s_mode_t>(
        I2S_MODE_MASTER | I2S_MODE_TX);
    driverConfig.sample_rate =
        config_.format.sampleRateHz;
    driverConfig.bits_per_sample =
        I2S_BITS_PER_SAMPLE_16BIT;
    driverConfig.channel_format =
        hardwareChannelCount(config_) == 1U
            ? I2S_CHANNEL_FMT_ONLY_LEFT
            : I2S_CHANNEL_FMT_RIGHT_LEFT;
    driverConfig.communication_format =
        I2S_COMM_FORMAT_STAND_I2S;
    driverConfig.intr_alloc_flags = 0;
    driverConfig.dma_buf_count =
        config_.dmaBufferCount;
    driverConfig.dma_buf_len =
