//====================================================
// ESP32 GAME STATION
// GENERAL-PURPOSE BYTE STREAM RING BUFFER CONTRACT
// 135_stream_ring_buffer.h
//====================================================
//
// Responsibilities:
// - Stores a bounded byte stream in one contiguous backing block.
// - Supports owned MemoryManager storage or caller-owned storage.
// - Exposes copy-based and zero-copy read/write operations.
// - Handles wrap-around without moving unread data.
// - Tracks high-water mark, overflow, underflow and dropped bytes.
// - Allows strict rejection or oldest-data overwrite on overflow.
//
// Concurrency rule:
// - This class does not acquire an internal mutex.
// - All calls must come from one execution context, or callers must
//   provide external synchronization around every operation.
// - The later PCM ring buffer may add a dedicated SPSC task contract.
//
// Lifetime rule:
// - Spans returned by writableSpans() and readableSpans() remain valid
//   only until the next mutating call on the same ring buffer.
// - commitWrite() must follow writableSpans().
// - consumeRead() must follow readableSpans().
// - External backing memory must outlive the ring buffer attachment.
//
// Integration rule:
// - File 136 implements this contract.
// - SdStreamService, PDF streaming and decoder staging may use it.
// - DMA buffers must use internal DMA-capable storage rather than a
//   PSRAM-backed instance of this generic ring buffer.
//====================================================

namespace egs
{
inline constexpr size_t
    STREAM_RING_BUFFER_MINIMUM_CAPACITY_BYTES = 256U;

inline constexpr size_t
    STREAM_RING_BUFFER_DEFAULT_ALIGNMENT =
        alignof(max_align_t);

enum class StreamRingBufferOverflowPolicy : uint8_t
{
    RejectNewData = 0,
    OverwriteOldest
};

enum class StreamRingBufferClearMode : uint8_t
{
    Preserve = 0,
    Clear
};

enum class StreamRingBufferError : uint8_t
{
    None = 0,
    AlreadyInitialized,
    NotInitialized,
    InvalidConfiguration,
    InvalidCapacity,
    InvalidPointer,
    BackingAllocationFailed,
    SourceOverlapsBuffer,
    DestinationOverlapsBuffer,
    WriteReservationActive,
    ReadReservationActive,
    NoWriteReservation,
    NoReadReservation,
    CommitExceedsReservation,
    ConsumeExceedsReservation,
    InsufficientReadableData,
    InsufficientWritableSpace,
    InvalidOffset
};

struct StreamRingBufferConfig
{
    size_t capacityBytes = 0;

    MemoryPreference preference =
        MemoryPreference::PsramPreferred;

    StreamRingBufferOverflowPolicy overflowPolicy =
        StreamRingBufferOverflowPolicy::RejectNewData;

    // Allows copy-based operations to transfer the amount
    // that currently fits instead of rejecting the entire
    // request.
    bool allowPartialWrites = true;
    bool allowPartialReads = true;

    bool clearBackingStore = true;
    bool clearConsumedBytes = false;
    bool clearOnReset = false;
};

struct StreamRingBufferMutableSpan
{
    uint8_t* data = nullptr;
    size_t size = 0;
};

struct StreamRingBufferConstSpan
{
    const uint8_t* data = nullptr;
    size_t size = 0;
};

struct StreamRingBufferWritableSpans
{
    StreamRingBufferMutableSpan first = {};
    StreamRingBufferMutableSpan second = {};

    size_t totalSize() const
    {
        return first.size + second.size;
    }
};

struct StreamRingBufferReadableSpans
{
    StreamRingBufferConstSpan first = {};
    StreamRingBufferConstSpan second = {};

    size_t totalSize() const
    {
        return first.size + second.size;
    }
};

struct StreamRingBufferStatus
{
    bool initialized = false;
    bool ownsBackingStore = false;
    bool psram = false;
    bool empty = true;
    bool full = false;
    bool writeReservationActive = false;
    bool readReservationActive = false;

    StreamRingBufferOverflowPolicy overflowPolicy =
        StreamRingBufferOverflowPolicy::RejectNewData;

    StreamRingBufferError error =
        StreamRingBufferError::None;

    size_t capacityBytes = 0;
    size_t readableBytes = 0;
    size_t writableBytes = 0;
    size_t highWatermarkBytes = 0;

    size_t writeReservationBytes = 0;
    size_t readReservationBytes = 0;

    uint64_t totalWrittenBytes = 0;
    uint64_t totalReadBytes = 0;
    uint64_t totalDiscardedBytes = 0;
    uint64_t totalOverwrittenBytes = 0;
    uint64_t totalRejectedBytes = 0;

    uint32_t writeCount = 0;
    uint32_t readCount = 0;
    uint32_t overflowCount = 0;
    uint32_t underflowCount = 0;
    uint32_t resetCount = 0;
    uint32_t generation = 0;
};

using StreamRingBufferObserver = void (*)(
    const StreamRingBufferStatus& status);

class StreamRingBuffer final
{
public:
    StreamRingBuffer() = default;
    ~StreamRingBuffer();

    StreamRingBuffer(
        const StreamRingBuffer&) = delete;

    StreamRingBuffer& operator=(
        const StreamRingBuffer&) = delete;

    StreamRingBuffer(
        StreamRingBuffer&& other) noexcept;

    StreamRingBuffer& operator=(
        StreamRingBuffer&& other) noexcept;

    //================================================
    // LIFECYCLE AND BACKING STORAGE
    //================================================

    RuntimeResult begin(
