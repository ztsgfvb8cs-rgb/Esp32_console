bool PlaytimeManager::reset(
    const String& id
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    if (activeIndex == index)
    {
        if (!stopSession(false))
            return false;
    }

    PlaytimeInfo& entry =
        entries[index];

    if (entry.totalMilliseconds == 0 &&
        entry.sessionCount == 0 &&
        entry.lastPlayedAt == 0)
    {
        return true;
    }

    entry.totalMilliseconds = 0;
    entry.sessionCount = 0;
    entry.lastPlayedAt = 0;

    if (entry.persistent)
        markDirty();

    return true;
}


void PlaytimeManager::resetBySource(
    const String& source
)
{
    if (!initialized ||
        !validSource(source))
    {
        return;
    }

    if (activeIndex >= 0 &&
        validIndex(
            static_cast<uint16_t>(
                activeIndex
            )
        ) &&
        entries[activeIndex].source ==
            source)
    {
        if (!stopSession(false))
            return;
    }

    bool persistentChanged = false;

    for (uint16_t i = 0;
         i < entryCount;
         i++)
    {
        PlaytimeInfo& entry =
            entries[i];

        if (!entry.valid ||
            entry.source != source)
        {
            continue;
        }

        bool changed =
            entry.totalMilliseconds != 0 ||
            entry.sessionCount != 0 ||
            entry.lastPlayedAt != 0;

        if (!changed)
            continue;

        entry.totalMilliseconds = 0;
        entry.sessionCount = 0;
        entry.lastPlayedAt = 0;

        if (entry.persistent)
            persistentChanged = true;
    }

    if (persistentChanged)
        markDirty();
}


void PlaytimeManager::resetAll()
{
    if (!initialized)
        return;

    if (active &&
        !stopSession(false))
    {
        return;
    }

    bool persistentChanged = false;

    for (uint16_t i = 0;
         i < entryCount;
         i++)
    {
        PlaytimeInfo& entry =
            entries[i];

        if (!entry.valid)
            continue;

        bool changed =
            entry.totalMilliseconds != 0 ||
            entry.sessionCount != 0 ||
            entry.lastPlayedAt != 0;

        if (!changed)
            continue;

        entry.totalMilliseconds = 0;
        entry.sessionCount = 0;
        entry.lastPlayedAt = 0;

        if (entry.persistent)
            persistentChanged = true;
    }

    if (persistentChanged)
        markDirty();
}


bool PlaytimeManager::exists(
    const String& id
)
{
    return find(id) >= 0;
}


uint16_t PlaytimeManager::count()
{
    return entryCount;
}


uint16_t PlaytimeManager::countBySource(
    const String& source
)
{
    if (!validSource(source))
        return 0;

    uint16_t result = 0;

    for (uint16_t i = 0;
         i < entryCount;
         i++)
    {
        if (entries[i].valid &&
            entries[i].source == source)
        {
            result++;
        }
    }

    return result;
}


PlaytimeInfo PlaytimeManager::get(
    uint16_t index
)
{
    if (!validIndex(index))
        return emptyInfo();

    PlaytimeInfo result =
        entries[index];

    if (active &&
        !paused &&
        activeIndex ==
            static_cast<int16_t>(index))
    {
        uint64_t pending =
            pendingActiveMilliseconds();

        if (result.totalMilliseconds >
            PLAYTIME_UINT64_MAX - pending)
        {
            result.totalMilliseconds =
                PLAYTIME_UINT64_MAX;
        }
        else
        {
            result.totalMilliseconds +=
                pending;
        }
    }

    return result;
}


PlaytimeInfo PlaytimeManager::get(
    const String& id
)
{
    int16_t index = find(id);

    return
        index >= 0
            ? get(
                static_cast<uint16_t>(
                    index
                )
              )
            : emptyInfo();
}


PlaytimeInfo PlaytimeManager::getBySource(
    const String& source,
    uint16_t index
)
{
    if (!validSource(source))
        return emptyInfo();

    uint16_t currentIndex = 0;

    for (uint16_t i = 0;
         i < entryCount;
         i++)
    {
        if (!entries[i].valid ||
            entries[i].source != source)
        {
            continue;
        }

        if (currentIndex == index)
            return get(i);

        currentIndex++;
    }

    return emptyInfo();
}


int16_t PlaytimeManager::find(
    const String& id
)
{
    if (!validID(id))
        return -1;

    for (uint16_t i = 0;
         i < entryCount;
         i++)
    {
        if (entries[i].valid &&
            entries[i].id == id)
        {
            return
                static_cast<int16_t>(i);
        }
    }

    return -1;
}

const char* PlaytimeManager::FILE_NAME =
    "playtime.db";


const char* PlaytimeManager::FILE_HEADER =
    "ESP32GS_PLAYTIME";


const uint16_t PlaytimeManager::FILE_VERSION = 1;
bool PlaytimeManager::load()
{
    if (!StorageManager::ready() ||
        active)
    {
        return false;
    }

    clearMemory();

    String mainPath =
        storagePath();

    String backupPath =
        mainPath + ".bak";

    String temporaryPath =
        mainPath + ".tmp";

    String oldPath =
        mainPath + ".old";

    String backupNewPath =
        backupPath + ".new";

    String backupOldPath =
        backupPath + ".old";

    String corruptMainPath =
        mainPath + ".corrupt";

    String corruptBackupPath =
        backupPath + ".corrupt";

    String corruptTemporaryPath =
        temporaryPath + ".corrupt";

    String corruptOldPath =
        oldPath + ".corrupt";

    bool mainExists =
        StorageManager::exists(mainPath);

    bool backupExists =
        StorageManager::exists(backupPath);

    bool temporaryExists =
        StorageManager::exists(
            temporaryPath
        );

    bool oldExists =
        StorageManager::exists(oldPath);

    uint16_t loadedCount = 0;

    bool repaired = false;

    if (mainExists &&
        loadPlaytimeDatabase(
            mainPath,
            FILE_HEADER,
            FILE_VERSION,
            entries,
            MAX_PLAYTIME_ENTRIES,
            loadedCount,
            repaired
        ))
    {
        entryCount = loadedCount;

        dirty = repaired;

        lastChangeTime =
            repaired
                ? millis()
                : 0;

        removeIfExists(temporaryPath);
        removeIfExists(oldPath);
        removeIfExists(backupNewPath);
        removeIfExists(backupOldPath);

        return true;
    }

    bool loadedRecovery = false;

    bool recoveryRepaired = false;

    String recoveryPath = "";

    if (mainExists)
    {
        if (backupExists &&
            loadPlaytimeDatabase(
                backupPath,
                FILE_HEADER,
                FILE_VERSION,
                entries,
                MAX_PLAYTIME_ENTRIES,
                loadedCount,
                recoveryRepaired
            ))
        {
            loadedRecovery = true;
            recoveryPath = backupPath;
        }
        else if (temporaryExists &&
                 loadPlaytimeDatabase(
                     temporaryPath,
                     FILE_HEADER,
                     FILE_VERSION,
                     entries,
                     MAX_PLAYTIME_ENTRIES,
                     loadedCount,
                     recoveryRepaired
                 ))
        {
            loadedRecovery = true;
            recoveryPath = temporaryPath;
        }
        else if (oldExists &&
                 loadPlaytimeDatabase(
                     oldPath,
                     FILE_HEADER,
                     FILE_VERSION,
                     entries,
                     MAX_PLAYTIME_ENTRIES,
                     loadedCount,
                     recoveryRepaired
                 ))
        {
            loadedRecovery = true;
            recoveryPath = oldPath;
        }
    }
    else
    {
        if (temporaryExists &&
            loadPlaytimeDatabase(
                temporaryPath,
                FILE_HEADER,
                FILE_VERSION,
                entries,
                MAX_PLAYTIME_ENTRIES,
                loadedCount,
                recoveryRepaired
            ))
        {
            loadedRecovery = true;
            recoveryPath = temporaryPath;
        }
        else if (oldExists &&
                 loadPlaytimeDatabase(
                     oldPath,
                     FILE_HEADER,
                     FILE_VERSION,
                     entries,
                     MAX_PLAYTIME_ENTRIES,
                     loadedCount,
                     recoveryRepaired
                 ))
        {
            loadedRecovery = true;
            recoveryPath = oldPath;
        }
        else if (backupExists &&
                 loadPlaytimeDatabase(
                     backupPath,
                     FILE_HEADER,
                     FILE_VERSION,
                     entries,
                     MAX_PLAYTIME_ENTRIES,
                     loadedCount,
                     recoveryRepaired
                 ))
        {
            loadedRecovery = true;
            recoveryPath = backupPath;
        }
    }

    if (loadedRecovery)
    {
        entryCount = loadedCount;

        if (mainExists)
        {
            quarantineFile(
                mainPath,
                corruptMainPath
            );
        }

        bool restored =
            copyFileContents(
                recoveryPath,
                mainPath
            );

        if (restored)
        {
            if (recoveryPath ==
                temporaryPath)
            {
                removeIfExists(
                    temporaryPath
                );
            }

            if (recoveryPath == oldPath)
                removeIfExists(oldPath);
        }

        dirty =
            recoveryRepaired ||
            !restored;

        lastChangeTime =
            dirty
                ? millis()
                : 0;

        removeIfExists(backupNewPath);
        removeIfExists(backupOldPath);

        return true;
    }

    if (mainExists)
    {
        quarantineFile(
            mainPath,
            corruptMainPath
        );
    }

    if (backupExists)
    {
        quarantineFile(
            backupPath,
            corruptBackupPath
        );
    }

    if (temporaryExists)
    {
        quarantineFile(
            temporaryPath,
            corruptTemporaryPath
        );
    }

    if (oldExists)
    {
        quarantineFile(
            oldPath,
            corruptOldPath
        );
    }

    removeIfExists(backupNewPath);
    removeIfExists(backupOldPath);

    clearMemory();

    dirty = true;

    lastChangeTime = millis();

    return true;
}


bool PlaytimeManager::save()
{
    if (!initialized ||
        !StorageManager::ready())
    {
        return false;
    }

    if (active &&
        !paused &&
        !flushActiveTime())
    {
        return false;
    }

    if (!StorageManager::createDirectory(
            StorageManager::configPath()
        ))
    {
        return false;
    }

    String mainPath =
        storagePath();

    String temporaryPath =
        mainPath + ".tmp";

    String oldPath =
        mainPath + ".old";

    String backupPath =
        mainPath + ".bak";

    String backupNewPath =
        backupPath + ".new";

    String backupOldPath =
        backupPath + ".old";

    if (!removeIfExists(temporaryPath) ||
        !removeIfExists(oldPath) ||
        !removeIfExists(backupNewPath) ||
        !removeIfExists(backupOldPath))
    {
        return false;
    }

    if (!writePlaytimeDatabase(
            temporaryPath,
            FILE_HEADER,
            FILE_VERSION,
            entries,
            entryCount
        ))
    {
        return false;
    }

    uint16_t expectedCount =
        persistentEntryCount(
            entries,
            entryCount
        );

    uint16_t verifiedCount = 0;

    bool verificationRepair = false;

    if (!loadPlaytimeDatabase(
            temporaryPath,
            FILE_HEADER,
            FILE_VERSION,
            nullptr,
            MAX_PLAYTIME_ENTRIES,
            verifiedCount,
            verificationRepair
        ) ||
        verificationRepair ||
        verifiedCount != expectedCount)
    {
        removeIfExists(temporaryPath);
        return false;
    }

    bool hadMain =
        StorageManager::exists(mainPath);

    if (hadMain &&
        !StorageManager::renameFile(
            mainPath,
            oldPath
        ))
    {
        removeIfExists(temporaryPath);
        return false;
    }

    if (!StorageManager::renameFile(
            temporaryPath,
            mainPath
        ))
    {
        if (hadMain &&
            StorageManager::exists(oldPath))
        {
            StorageManager::renameFile(
                oldPath,
                mainPath
            );
        }

        removeIfExists(temporaryPath);

        return false;
    }

    uint16_t mainVerifiedCount = 0;

    bool mainVerificationRepair = false;

    bool mainValid =
        loadPlaytimeDatabase(
            mainPath,
            FILE_HEADER,
            FILE_VERSION,
            nullptr,
            MAX_PLAYTIME_ENTRIES,
            mainVerifiedCount,
            mainVerificationRepair
        ) &&
        !mainVerificationRepair &&
        mainVerifiedCount ==
            expectedCount;

    if (!mainValid)
    {
        removeIfExists(mainPath);

        if (hadMain &&
            StorageManager::exists(oldPath))
        {
            StorageManager::renameFile(
                oldPath,
                mainPath
            );
        }

        return false;
    }

    String backupSource =
        hadMain &&
        StorageManager::exists(oldPath)
            ? oldPath
            : mainPath;

    bool backupUpdated = false;

    if (copyFileContents(
            backupSource,
            backupNewPath
        ))
    {
        uint16_t backupVerifiedCount = 0;

        bool backupVerificationRepair =
            false;

        bool backupNewValid =
            loadPlaytimeDatabase(
                backupNewPath,
                FILE_HEADER,
                FILE_VERSION,
                nullptr,
                MAX_PLAYTIME_ENTRIES,
                backupVerifiedCount,
                backupVerificationRepair
            ) &&
            !backupVerificationRepair;

        if (backupNewValid)
        {
            bool hadBackup =
                StorageManager::exists(
                    backupPath
                );

            bool movedOldBackup = true;

            if (hadBackup)
            {
                movedOldBackup =
                    StorageManager::renameFile(
                        backupPath,
                        backupOldPath
                    );
            }

            if (movedOldBackup &&
                StorageManager::renameFile(
                    backupNewPath,
                    backupPath
                ))
            {
                backupUpdated = true;

                removeIfExists(
                    backupOldPath
                );
            }
            else
            {
                removeIfExists(
                    backupNewPath
                );

                if (StorageManager::exists(
                        backupOldPath
                    ) &&
                    !StorageManager::exists(
                        backupPath
                    ))
                {
                    StorageManager::renameFile(
                        backupOldPath,
                        backupPath
                    );
                }
            }
        }
        else
        {
            removeIfExists(backupNewPath);
        }
    }

    if (!backupUpdated &&
        !StorageManager::exists(backupPath))
    {
        if (copyFileContents(
                mainPath,
                backupPath
            ))
        {
            uint16_t fallbackBackupCount =
                0;

            bool fallbackBackupRepair =
                false;

            bool fallbackBackupValid =
                loadPlaytimeDatabase(
                    backupPath,
                    FILE_HEADER,
                    FILE_VERSION,
                    nullptr,
                    MAX_PLAYTIME_ENTRIES,
                    fallbackBackupCount,
                    fallbackBackupRepair
                ) &&
                !fallbackBackupRepair &&
                fallbackBackupCount ==
                    expectedCount;

            if (!fallbackBackupValid)
                removeIfExists(backupPath);
        }
    }

    removeIfExists(oldPath);
    removeIfExists(backupNewPath);
    removeIfExists(backupOldPath);

    dirty = false;

    lastChangeTime = 0;

    return true;
}


