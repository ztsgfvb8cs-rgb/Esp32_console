AiPerceptionStatus AiPerceptionSystem::currentStatus_ = {};
AiPerceptionPolicy AiPerceptionSystem::policy_ = {};
AiDifficultyProfile AiPerceptionSystem::difficultyProfile_ = {};
AiPerceptionObserverState AiPerceptionSystem::observerState_ = {};

AiPerceptionStimulus AiPerceptionSystem::frameStimuli_[
    AI_PERCEPTION_MAX_FRAME_STIMULI] = {};

AiPerceptionObservation AiPerceptionSystem::observations_[
    AI_PERCEPTION_MAX_TRACKED_ENTITIES] = {};

AiLineOfSightCallback AiPerceptionSystem::lineOfSightCallback_ = nullptr;
void* AiPerceptionSystem::lineOfSightContext_ = nullptr;
AiPerceptionObserver AiPerceptionSystem::observer_ = nullptr;

bool AiPerceptionSystem::begin()
{
    if (currentStatus_.initialized)
    {
        return true;
    }

    currentStatus_ = {};
    policy_ = {};
    difficultyProfile_ = AiDifficultyProfile{};
    observerState_ = {};

    for (size_t i = 0;
         i < AI_PERCEPTION_MAX_FRAME_STIMULI;
         ++i)
    {
        frameStimuli_[i] = {};
    }

    for (size_t i = 0;
         i < AI_PERCEPTION_MAX_TRACKED_ENTITIES;
         ++i)
    {
        observations_[i] = {};
    }

    if (!validatePolicy(policy_) ||
        !AiDifficultyManager::validateProfile(
            difficultyProfile_))
    {
        currentStatus_.error =
            AiPerceptionError::InvalidPolicy;

        return false;
    }

    currentStatus_.initialized = true;
    currentStatus_.difficultyLevel =
        difficultyProfile_.level;
    currentStatus_.error = AiPerceptionError::None;

    notifyStateChanged();
    return true;
}

void AiPerceptionSystem::reset()
{
    const bool initialized = currentStatus_.initialized;

    currentStatus_ = {};
    currentStatus_.initialized = initialized;
    currentStatus_.difficultyLevel =
        difficultyProfile_.level;

    observerState_ = {};

    for (size_t i = 0;
         i < AI_PERCEPTION_MAX_FRAME_STIMULI;
         ++i)
    {
        frameStimuli_[i] = {};
    }

    for (size_t i = 0;
         i < AI_PERCEPTION_MAX_TRACKED_ENTITIES;
         ++i)
    {
        observations_[i] = {};
    }

    notifyStateChanged();
}

void AiPerceptionSystem::end()
{
    currentStatus_ = {};
    policy_ = {};
    difficultyProfile_ = {};
    observerState_ = {};

    for (size_t i = 0;
         i < AI_PERCEPTION_MAX_FRAME_STIMULI;
         ++i)
    {
        frameStimuli_[i] = {};
    }

    for (size_t i = 0;
         i < AI_PERCEPTION_MAX_TRACKED_ENTITIES;
         ++i)
    {
        observations_[i] = {};
    }

    lineOfSightCallback_ = nullptr;
    lineOfSightContext_ = nullptr;
    observer_ = nullptr;
}

bool AiPerceptionSystem::ready()
{
    return currentStatus_.initialized &&
        currentStatus_.error == AiPerceptionError::None;
}

AiPerceptionStatus AiPerceptionSystem::status()
{
    refreshCounts();
    return currentStatus_;
}

bool AiPerceptionSystem::beginFrame(
    const AiPerceptionObserverState& observer,
    uint32_t nowMs)
{
    if (!currentStatus_.initialized)
    {
        setError(AiPerceptionError::NotInitialized);
        return false;
    }

    if (currentStatus_.frameOpen)
    {
        setError(AiPerceptionError::FrameAlreadyOpen);
        return false;
    }

    if (!validateObserver(observer))
    {
        setError(AiPerceptionError::InvalidObserver);
        return false;
    }

    if (nowMs == 0)
    {
        nowMs = millis();
    }

    decayAndPredict(nowMs);

    for (size_t i = 0;
         i < currentStatus_.observationCount;
         ++i)
    {
        observations_[i].currentlyPerceived = false;

        if (observations_[i].visibility !=
                AiVisibilityState::Unknown &&
            observations_[i].visibility !=
                AiVisibilityState::Predicted)
        {
            observations_[i].visibility =
                AiVisibilityState::Remembered;
        }
    }

    observerState_ = observer;

    for (size_t i = 0;
         i < AI_PERCEPTION_MAX_FRAME_STIMULI;
         ++i)
    {
        frameStimuli_[i] = {};
    }

    currentStatus_.frameOpen = true;
    currentStatus_.observerValid = true;
    currentStatus_.stimulusOverflowed = false;
    currentStatus_.observationOverflowed = false;
    currentStatus_.stimulusCount = 0;
    currentStatus_.frameStartedAtMs = nowMs;
    currentStatus_.error = AiPerceptionError::None;

    notifyStateChanged();
    return true;
}

bool AiPerceptionSystem::submitStimulus(
    const AiPerceptionStimulus& stimulus)
{
    if (!currentStatus_.initialized)
    {
        setError(AiPerceptionError::NotInitialized);
        return false;
    }

    if (!currentStatus_.frameOpen)
    {
        setError(AiPerceptionError::FrameNotOpen);
        return false;
    }

    if (!validateStimulus(stimulus))
    {
        setError(AiPerceptionError::InvalidStimulus);
        return false;
    }

    if (currentStatus_.stimulusCount >=
        AI_PERCEPTION_MAX_FRAME_STIMULI)
    {
        currentStatus_.stimulusOverflowed = true;
        setError(AiPerceptionError::StimulusCapacityExceeded);
        return false;
    }

    frameStimuli_[currentStatus_.stimulusCount] = stimulus;
    ++currentStatus_.stimulusCount;
    currentStatus_.error = AiPerceptionError::None;

    return true;
}
