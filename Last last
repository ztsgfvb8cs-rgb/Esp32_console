static uint32_t calculateMemoryChecksum(
    const uint8_t* data,
    size_t length
)
{
    if(data == nullptr ||
       length == 0)
    {
        return 0;
    }


    uint32_t checksum =
        2166136261UL;


    for(size_t i = 0;
        i < length;
        i++)
    {
        checksum ^=
            data[i];


        checksum *=
            16777619UL;
    }


    return checksum;
}



static bool copyProfileFile(
    const char* sourcePath,
    const char* destinationPath
)
{
    if(sourcePath == nullptr ||
       destinationPath == nullptr)
    {
        return false;
    }


    File sourceFile =
        SD.open(
            sourcePath,
            FILE_READ
        );


    if(!sourceFile)
    {
        return false;
    }


    if(SD.exists(
        destinationPath
    ))
    {
        SD.remove(
            destinationPath
        );
    }


    File destinationFile =
        SD.open(
            destinationPath,
            FILE_WRITE
        );


    if(!destinationFile)
    {
        sourceFile.close();

        return false;
    }


    uint8_t buffer[512];


    bool result =
        true;


    while(sourceFile.available())
    {
        size_t bytesRead =
            sourceFile.read(
                buffer,
                sizeof(buffer)
            );


        if(bytesRead == 0)
        {
            break;
        }


        size_t bytesWritten =
            destinationFile.write(
                buffer,
                bytesRead
            );


        if(bytesWritten != bytesRead)
        {
            result =
                false;

            break;
        }
    }


    destinationFile.flush();

    destinationFile.close();

    sourceFile.close();


    if(!result)
    {
        SD.remove(
            destinationPath
        );
    }


    return result;
}



