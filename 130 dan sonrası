bool StreamRingBuffer::rangesOverlap(
    const void* first,
    size_t firstSize,
    const void* second,
    size_t secondSize)
{
    if (first == nullptr ||
        second == nullptr ||
        firstSize == 0 ||
        secondSize == 0)
    {
        return false;
    }

    const uintptr_t firstAddress =
        reinterpret_cast<uintptr_t>(first);

    const uintptr_t secondAddress =
        reinterpret_cast<uintptr_t>(second);

    if (firstAddress <= secondAddress)
    {
        return
            secondAddress - firstAddress <
            firstSize;
    }

    return
        firstAddress - secondAddress <
        secondSize;
}

uint64_t StreamRingBuffer::saturatingAdd64(
    uint64_t first,
    uint64_t second)
{
    return second > UINT64_MAX - first
        ? UINT64_MAX
        : first + second;
}

