String PlaytimeManager::mostPlayedGame()
{
    if(!managerInitialized ||
       recordCount == 0)
    {
        return String();
    }


    int16_t selectedIndex =
        PLAYTIME_INVALID_GAME_INDEX;


    uint64_t highestPlaytime =
        0;


    for(uint16_t i = 0;
        i < recordCount;
        i++)
    {
        if(!records[i].valid)
        {
            continue;
        }


        uint64_t playtime =
            records[i].
                totalPlaytimeMilliseconds;


        if(
            session.active &&
            session.gameIndex ==
                (int16_t)i
        )
        {
            playtime +=
                calculateSessionDuration();
        }


        if(
            selectedIndex ==
                PLAYTIME_INVALID_GAME_INDEX ||
            playtime >
                highestPlaytime
        )
        {
            selectedIndex =
                (int16_t)i;


            highestPlaytime =
                playtime;
        }
    }


    if(selectedIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        return String();
    }


    return String(
        records[selectedIndex].
            gameName
    );
}



