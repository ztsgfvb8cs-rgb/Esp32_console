// TEXT HELPERS
//====================================================

const char* Logger::levelText(LogLevel level)
{
    switch (level)
    {
        case LOG_LEVEL_DEBUG:
            return "DEBUG";

        case LOG_LEVEL_INFO:
            return "INFO";

        case LOG_LEVEL_WARNING:
            return "WARNING";

        case LOG_LEVEL_ERROR:
            return "ERROR";

        case LOG_LEVEL_CRITICAL:
            return "CRITICAL";

        default:
            return "INVALID";
    }
}

const char* Logger::sourceText(LogSource source)
{
    switch (source)
    {
        case LOG_SOURCE_SYSTEM:
            return "SYSTEM";

        case LOG_SOURCE_HARDWARE:
            return "HARDWARE";

        case LOG_SOURCE_STORAGE:
            return "STORAGE";

        case LOG_SOURCE_DISPLAY:
            return "DISPLAY";

        case LOG_SOURCE_INPUT:
            return "INPUT";

        case LOG_SOURCE_AUDIO:
            return "AUDIO";

        case LOG_SOURCE_NETWORK:
            return "NETWORK";

        case LOG_SOURCE_GAME:
            return "GAME";

        case LOG_SOURCE_EMULATOR:
            return "EMULATOR";

        case LOG_SOURCE_APPLICATION:
            return "APPLICATION";

        case LOG_SOURCE_UNKNOWN:
            return "UNKNOWN";

        default:
            return "INVALID";
    }
}

String Logger::format(const LogEntry& entry)
{
    if (!entry.valid ||
        !validLevel(entry.level) ||
        !validSource(entry.source))
    {
        return String();
    }

    String text;

    text.reserve(
        entry.tag.length() +
        entry.message.length() +
        64);

    text += "[";
    text += String(
        static_cast<unsigned long>(
            entry.timestamp));

    text += "][";
    text += levelText(entry.level);

    text += "][";
    text += sourceText(entry.source);

    text += "][";
    text += entry.tag;

    text += "] ";
    text += entry.message;

    return text;
}

//====================================================
// VALIDATION
//====================================================

bool Logger::validLevel(LogLevel level)
{
    return level >= LOG_LEVEL_DEBUG &&
           level <= LOG_LEVEL_CRITICAL;
}

bool Logger::validSource(LogSource source)
{
    return source >= LOG_SOURCE_SYSTEM &&
           source <= LOG_SOURCE_UNKNOWN;
}

bool Logger::validTag(const String& tag)
{
    return tag.length() > 0 &&
           tag.length() <= MAX_TAG_LENGTH;
}

bool Logger::validMessage(const String& message)
{
    return message.length() > 0 &&
           message.length() <= MAX_MESSAGE_LENGTH;
}

LogEntry Logger::emptyEntry()
{
    LogEntry entry;

    entry.level = LOG_LEVEL_DEBUG;
    entry.source = LOG_SOURCE_UNKNOWN;
    entry.timestamp = 0;

    entry.tag = String();
    entry.message = String();

    entry.valid = false;

    return entry;
}

//====================================================
// MEMORY HELPERS
//====================================================

uint16_t Logger::physicalIndex(
    uint16_t logicalIndex)
{
    return static_cast<uint16_t>(
        (firstIndex + logicalIndex) %
        MAX_MEMORY_ENTRIES);
}

bool Logger::storeInMemory(
    const LogEntry& entry)
{
    if (!entry.valid)
    {
        return false;
    }

    if (entryCount < MAX_MEMORY_ENTRIES)
    {
        entries[physicalIndex(entryCount)] =
            entry;

        ++entryCount;
        return true;
    }

    entries[firstIndex] = entry;

    firstIndex =
        static_cast<uint16_t>(
            (firstIndex + 1) %
            MAX_MEMORY_ENTRIES);

    return true;
}
//====================================================
// OUTPUT HELPERS
//====================================================

bool Logger::writeToSerial(
    const LogEntry& entry)
{
    const String text = format(entry);

    if (text.length() == 0)
    {
        return false;
    }

    return Serial.println(text) > 0;
}

bool Logger::writePendingToFile()
{
    if (pendingFileCount == 0)
    {
        return true;
    }

    if (!StorageManager::ready())
    {
        return false;
    }

    if (!StorageManager::createDirectory(
            StorageManager::configPath()))
    {
        return false;
    }

    if (!rotateFileIfNeeded())
    {
        return false;
    }

    File file =
        StorageManager::openFile(
            FILE_NAME,
            FILE_APPEND);

    if (!file)
    {
        return false;
    }

    uint16_t availablePending =
        pendingFileCount;

    if (availablePending > entryCount)
    {
        availablePending = entryCount;
    }

    const uint16_t firstPendingLogicalIndex =
        entryCount - availablePending;

    uint16_t writtenCount = 0;
    bool writeSucceeded = true;

    for (uint16_t i = 0;
         i < availablePending;
         ++i)
    {
        const LogEntry& entry =
            entries[
                physicalIndex(
                    firstPendingLogicalIndex +
                    i)];

        const String line = format(entry);

        if (line.length() == 0)
        {
            writeSucceeded = false;
            break;
        }

        const size_t textBytes =
            file.print(line);

        const size_t newlineBytes =
            file.write('\n');

        if (textBytes != line.length() ||
            newlineBytes != 1)
        {
            writeSucceeded = false;
            break;
        }

        ++writtenCount;
    }

    file.flush();

    if (file.getWriteError())
    {
        writeSucceeded = false;
    }

    StorageManager::closeFile(file);

    if (writtenCount >= pendingFileCount)
    {
        pendingFileCount = 0;
    }
    else
    {
        pendingFileCount -= writtenCount;
    }

    lastFileChangeTime =
        pendingFileCount == 0
            ? 0
            : millis();

    return writeSucceeded &&
           writtenCount == availablePending;
}

bool Logger::rotateFileIfNeeded()
{
    if (!StorageManager::ready())
    {
        return false;
    }

    if (!StorageManager::exists(FILE_NAME))
    {
        return true;
    }

    File file =
        StorageManager::openFile(
            FILE_NAME,
            FILE_READ);

    if (!file)
    {
        return false;
    }

    const uint32_t fileSize =
        static_cast<uint32_t>(
            file.size());

    StorageManager::closeFile(file);

    if (fileSize < MAX_FILE_SIZE)
    {
        return true;
    }

    if (StorageManager::exists(
            BACKUP_FILE_NAME) &&
        !StorageManager::deleteFile(
            BACKUP_FILE_NAME))
    {
        return false;
    }

    return StorageManager::renameFile(
        FILE_NAME,
        BACKUP_FILE_NAME);
}

//====================================================
// VALUE HELPERS
//====================================================

String Logger::signed64ToString(
    int64_t value)
{
    if (value >= 0)
    {
        return unsigned64ToString(
            static_cast<uint64_t>(value));
    }

    const uint64_t magnitude =
        static_cast<uint64_t>(
            -(value + 1)) +
        1ULL;

    String result = "-";

    result +=
        unsigned64ToString(magnitude);

    return result;
}

String Logger::unsigned64ToString(
    uint64_t value)
{
    char buffer[21];

    uint8_t position =
        sizeof(buffer) - 1;

    buffer[position] = '\0';

    do
    {
        const uint8_t digit =
            static_cast<uint8_t>(
                value % 10ULL);

        --position;

        buffer[position] =
            static_cast<char>(
                '0' + digit);

        value /= 10ULL;
    }
    while (value > 0 &&
           position > 0);

    return String(&buffer[position]);
}

//====================================================
// CHANGE TRACKING
//====================================================

void Logger::markFilePending()
{
    if (pendingFileCount < entryCount)
    {
        ++pendingFileCount;
    }

    if (pendingFileCount >
        MAX_MEMORY_ENTRIES)
    {
        pendingFileCount =
            MAX_MEMORY_ENTRIES;
    }

    lastFileChangeTime = millis();
}

//====================================================
// MEMORY RESET
//====================================================

void Logger::clearState()
{
    for (uint16_t i = 0;
         i < MAX_MEMORY_ENTRIES;
         ++i)
    {
        entries[i] = emptyEntry();
    }

    firstIndex = 0;
    entryCount = 0;

    pendingFileCount = 0;
    lastFileChangeTime = 0;

    enabledOutputs =
        static_cast<uint8_t>(
            LOG_OUTPUT_SERIAL) |
        static_cast<uint8_t>(
            LOG_OUTPUT_MEMORY);

    currentMinimumLevel =
