RuntimeOrchestrator::updateCoordinators(
    uint32_t nowMs,
    uint32_t nowUs)
{
    if (currentStatus_.suspended)
    {
        if (policy_.continuePowerWhileSuspended)
        {
            currentStatus_.stage =
                RuntimeOrchestratorStage::
                    PowerCoordinator;

            RuntimePowerCoordinator::update(nowMs);

            if (!RuntimePowerCoordinator::ready() &&
                !RuntimePowerCoordinator::
                    shutdownPending())
            {
                return fail(
                    RuntimeOrchestratorStage::
                        PowerCoordinator,
                    RuntimeOrchestratorError::
                        PowerCoordinatorFailed,
                    RuntimeResult::InternalError);
            }
        }

        if (policy_.continueHealthWhileSuspended)
        {
            currentStatus_.stage =
                RuntimeOrchestratorStage::
                    HealthCoordinator;

            RuntimeHealthCoordinator::update(nowMs);

            if (RuntimeHealthCoordinator::
                    fatalState())
            {
                currentStatus_.fatalHealth = true;
            }
        }

        currentStatus_.stage =
            RuntimeOrchestratorStage::
                RuntimeUpdate;

        return RuntimeResult::Ok;
    }

    currentStatus_.stage =
        RuntimeOrchestratorStage::InputRouter;

    RuntimeInputRouter::update(nowMs);

    if (!RuntimeInputRouter::ready())
    {
        return fail(
            RuntimeOrchestratorStage::InputRouter,
            RuntimeOrchestratorError::
                InputRouterFailed,
            RuntimeResult::NotReady);
    }

    processInputActivity(nowMs);

    currentStatus_.stage =
        RuntimeOrchestratorStage::SessionBridge;

    RuntimeSessionBridge::update(nowMs);

    if (!RuntimeSessionBridge::ready())
    {
        return fail(
            RuntimeOrchestratorStage::SessionBridge,
            RuntimeOrchestratorError::
                SessionBridgeFailed,
            RuntimeResult::NotReady);
    }

    currentStatus_.stage =
        RuntimeOrchestratorStage::
            AudioCoordinator;

    RuntimeAudioCoordinator::update(nowMs);

    if (!RuntimeAudioCoordinator::ready())
    {
        return fail(
            RuntimeOrchestratorStage::
                AudioCoordinator,
            RuntimeOrchestratorError::
                AudioCoordinatorFailed,
            RuntimeResult::NotReady);
    }

    currentStatus_.stage =
        RuntimeOrchestratorStage::
            PowerCoordinator;

    RuntimePowerCoordinator::update(nowMs);

    if (!RuntimePowerCoordinator::ready() &&
        !RuntimePowerCoordinator::shutdownPending())
    {
        return fail(
            RuntimeOrchestratorStage::
                PowerCoordinator,
            RuntimeOrchestratorError::
                PowerCoordinatorFailed,
            RuntimeResult::InternalError);
    }

    currentStatus_.stage =
        RuntimeOrchestratorStage::ScreenRouter;

    RuntimeScreenRouter::update(nowMs, nowUs);

    if (!RuntimeScreenRouter::ready())
    {
        return fail(
            RuntimeOrchestratorStage::ScreenRouter,
            RuntimeOrchestratorError::
                ScreenRouterFailed,
            RuntimeResult::NotReady);
    }

    currentStatus_.stage =
        RuntimeOrchestratorStage::
            HealthCoordinator;

    RuntimeHealthCoordinator::update(nowMs);

    if (RuntimeHealthCoordinator::fatalState())
