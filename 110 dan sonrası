// 115_runtime_input_router.h
//====================================================
//
// Responsibilities:
// - Owns application-level consumption of InputManager events.
// - Maintains stable per-action held and edge state for games.
// - Routes input to the active foreground session or UI screen.
// - Intercepts Back/Menu for controlled foreground shutdown.
// - Maps PDF navigation without exposing UI classes to backends.
// - Supports injected events for the future 4x4 keypad layer.
// - Records routing diagnostics without dynamic allocation.
//
// Integration rule:
// - After files 159-160 are installed, this router becomes the
//   only component that drains InputManager::next().
// - ScreenManager must then receive routed events instead of
//   reading the input queue directly.
// - Foreground game and emulator code may query actionState()
//   or the convenience held/pressed/released methods.
//
// Dependency rule:
// - The header depends only on core input types and the lower-level
//   RuntimeSessionBridge contract.
// - InputManager, PdfReader, ScreenManager and UI controllers are
//   included only by the implementation file.
//====================================================

namespace egs
{
inline constexpr size_t RUNTIME_INPUT_ACTION_COUNT =
    static_cast<size_t>(InputAction::Count);

inline constexpr uint8_t RUNTIME_INPUT_DEFAULT_EVENT_BUDGET = 24U;
inline constexpr uint8_t RUNTIME_INPUT_MAX_EVENT_BUDGET = 32U;

enum class RuntimeInputTarget : uint8_t
{
    None = 0,
    ForegroundGame,
    ForegroundPdf,
    MainMenu,
    FileBrowser,
    Settings,
    Search,
    SystemScreen
};

enum class RuntimeInputDisposition : uint8_t
{
    Ignored = 0,
    Consumed,
    ForwardedToForeground,
    ForwardedToScreen,
    SessionCloseRequested,
    PdfPageChanged,
    Error
};

enum class RuntimeInputError : uint8_t
{
    None = 0,
    NotInitialized,
    InvalidAction,
    SessionBridgeNotReady,
    ForegroundStateMismatch,
    PdfOperationFailed,
    DispatchFailed
};

struct RuntimeInputPolicy
{
    // Global foreground-exit controls.
    bool backClosesForeground = true;
    bool menuClosesForeground = true;
    bool longMenuClosesForeground = true;

    // Events exposed to active game/emulator code through
    // actionState() and the optional observer callback.
    bool exposeReleaseEventsToForeground = true;
    bool exposeRepeatEventsToForeground = true;
    bool exposeLongPressEventsToForeground = true;
    bool exposeTouchEventsToForeground = true;
    bool exposeTextEventsToForeground = false;

    // PDF reader controls.
    bool directionalPdfNavigation = true;
    bool faceButtonPdfNavigation = true;
    bool repeatedPdfNavigation = true;

    // Prevents one update pass from monopolizing the main loop.
    uint8_t maximumEventsPerUpdate =
        RUNTIME_INPUT_DEFAULT_EVENT_BUDGET;
};

struct RuntimeActionState
{
    bool held = false;
    bool pressed = false;
    bool released = false;
    bool repeated = false;
    bool longPressed = false;

    uint32_t pressedAtMs = 0;
    uint32_t changedAtMs = 0;
    uint32_t eventSequence = 0;
};

struct RuntimeInputStatus
{
    bool initialized = false;
    bool suspended = false;
    bool foregroundCaptured = false;

    RuntimeInputTarget target = RuntimeInputTarget::None;

    RuntimeInputDisposition lastDisposition =
        RuntimeInputDisposition::Ignored;

    RuntimeInputError error =
        RuntimeInputError::None;

    InputEvent lastEvent = {};

    uint32_t updateSequence = 0;
    uint32_t eventSequence = 0;
    uint32_t routedEventCount = 0;
    uint32_t ignoredEventCount = 0;
    uint32_t errorEventCount = 0;
    uint32_t lastEventAtMs = 0;

    uint8_t eventsProcessedThisUpdate = 0;
};

using RuntimeInputObserver = void (*)(
    const InputEvent& event,
    RuntimeInputTarget target,
    RuntimeInputDisposition disposition);

class RuntimeInputRouter final
{
public:
    //================================================
    // LIFECYCLE
    //================================================

    static bool begin();
    static void update(uint32_t nowMs);
    static void end();

    static bool ready();
    static RuntimeInputStatus status();

    // Suspension stops dispatch but preserves held-state cleanup
    // from release events, preventing stuck controls after resume.
    static void setSuspended(bool suspended);
    static bool suspended();

    //================================================
    // EVENT ROUTING
    //================================================

    // Routes an already-created event. This is used by update()
    // and by future keypad/input adapters.
    static RuntimeInputDisposition route(
        const InputEvent& event);

    // Injected events follow the same validation and routing path
    // as physical button, touch and text events.
    static RuntimeInputDisposition inject(
        InputAction action,
        InputEventType type,
        uint32_t timestampMs,
        int16_t x = 0,
        int16_t y = 0,
        char text = '\0');

    static RuntimeInputTarget resolveTarget();

    //================================================
    // GAME/EMULATOR INPUT STATE
    //================================================

    static RuntimeActionState actionState(
        InputAction action);

    static bool held(InputAction action);
    static bool pressed(InputAction action);
    static bool released(InputAction action);
    static bool repeated(InputAction action);
    static bool longPressed(InputAction action);

    // Clears one-update edge flags while preserving held state.
    static void clearTransientStates();

    // Clears all held and edge state. Intended for session close,
    // recovery and shutdown paths.
    static void resetAllActions();

    //================================================
    // POLICY AND OBSERVATION
    //================================================

    static void setPolicy(
        const RuntimeInputPolicy& policy);

    static RuntimeInputPolicy policy();

    static void setObserver(
        RuntimeInputObserver observer);

    static RuntimeInputError lastError();

    static RuntimeInputDisposition lastDisposition();

    static const char* targetText(
        RuntimeInputTarget value);

    static const char* dispositionText(
        RuntimeInputDisposition value);

    static const char* errorText(
        RuntimeInputError value);

private:
    static RuntimeInputStatus currentStatus_;
    static RuntimeInputPolicy policy_;

    static RuntimeActionState actionStates_[
        RUNTIME_INPUT_ACTION_COUNT];

    static RuntimeInputObserver observer_;

    static RuntimeInputDisposition routeForeground(
        const InputEvent& event,
        RuntimeInputTarget target);

    static RuntimeInputDisposition routeScreen(
        const InputEvent& event,
        RuntimeInputTarget target);

    static RuntimeInputDisposition routePdf(
        const InputEvent& event);

    static RuntimeInputDisposition requestSessionClose(
        const InputEvent& event);

    static bool isForegroundExitEvent(
        const InputEvent& event);

    static bool eventVisibleToForeground(
        const InputEvent& event);

    static bool eventEligibleForPdfNavigation(
        const InputEvent& event);

    static bool validAction(
        InputAction action);

    static size_t actionIndex(
        InputAction action);

    static void updateActionState(
        const InputEvent& event);

    static RuntimeInputDisposition record(
        const InputEvent& event,
        RuntimeInputTarget target,
        RuntimeInputDisposition disposition,
        RuntimeInputError error =
            RuntimeInputError::None);
};

static_assert(
    RUNTIME_INPUT_ACTION_COUNT > 0,
    "Runtime input router requires at least one action");

static_assert(
    RUNTIME_INPUT_DEFAULT_EVENT_BUDGET <=
        RUNTIME_INPUT_MAX_EVENT_BUDGET,
    "Default input event budget exceeds maximum");

static_assert(
    RUNTIME_INPUT_MAX_EVENT_BUDGET <= 32U,
    "Runtime input budget must not exceed queue capacity");
}



