//====================================================
// SYSTEM
//====================================================

bool PlaytimeManager::begin()
{
    managerInitialized =
        false;


    dataModified =
        false;


    recordCount =
        0;


    for(uint16_t i = 0;
        i < PLAYTIME_MAX_GAMES;
        i++)
    {
        clearRecord(
            records[i]
        );
    }


    clearSession();


    managerInitialized =
        true;


    return true;
}



void PlaytimeManager::update()
{
    if(!managerInitialized)
    {
        return;
    }


    if(!session.active)
    {
        return;
    }


    calculateSessionDuration();
}



void PlaytimeManager::reset()
{
    if(!managerInitialized)
    {
        begin();

        return;
    }


    clearSession();

    resetAllGames();
}



bool PlaytimeManager::initialized()
{
    return managerInitialized;
}


//====================================================
// SESSION CONTROL
//====================================================

bool PlaytimeManager::start(
    const String& gameName
)
{
    if(!managerInitialized)
    {
        return false;
    }


    if(session.active)
    {
        return false;
    }


    if(!validGameName(
        gameName
    ))
    {
        return false;
    }


    int16_t gameIndex =
        find(
            gameName
        );


    if(gameIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        if(!registerGame(
            gameName
        ))
        {
            return false;
        }


        gameIndex =
            find(
                gameName
            );


        if(gameIndex ==
           PLAYTIME_INVALID_GAME_INDEX)
        {
            return false;
        }
    }


    clearSession();


    session.gameIndex =
        gameIndex;


    session.startMilliseconds =
        millis();


    session.pauseStartMilliseconds =
        0;


    session.totalPausedMilliseconds =
        0;


    session.state =
        PLAYTIME_SESSION_RUNNING;


    session.active =
        true;


    records[gameIndex].launchCount++;


    records[gameIndex].modified =
        true;


    dataModified =
        true;


    return true;
}



bool PlaytimeManager::stop(
    PlaytimeSessionResult result
)
{
    return finishSession(
        result,
        true
    );
}



bool PlaytimeManager::pause()
{
    if(!managerInitialized)
    {
        return false;
    }


    if(!session.active)
    {
        return false;
    }


    if(session.state ==
       PLAYTIME_SESSION_PAUSED)
    {
        return true;
    }


    if(session.state !=
       PLAYTIME_SESSION_RUNNING)
    {
        return false;
    }


    session.pauseStartMilliseconds =
        millis();


    session.state =
        PLAYTIME_SESSION_PAUSED;


    return true;
}



bool PlaytimeManager::resume()
{
    if(!managerInitialized)
    {
        return false;
    }


    if(!session.active)
    {
        return false;
    }


    if(session.state ==
       PLAYTIME_SESSION_RUNNING)
    {
        return true;
    }


    if(session.state !=
       PLAYTIME_SESSION_PAUSED)
    {
        return false;
    }


    uint32_t currentTime =
        millis();


    session.totalPausedMilliseconds +=
        currentTime -
        session.pauseStartMilliseconds;


    session.pauseStartMilliseconds =
        0;


    session.state =
        PLAYTIME_SESSION_RUNNING;


    return true;
}



bool PlaytimeManager::cancel()
{
    return finishSession(
        PLAYTIME_RESULT_NONE,
        false
    );
}


