uint8_t
RuntimePowerCoordinator::resolveBrightness()
{
    if (stateRequiresBacklightOff(
            currentStatus_.powerState))
    {
        return 0;
    }

    uint8_t brightness =
        settings_.brightness;

    if (brightness <
        BoardConfig::MINIMUM_BRIGHTNESS)
    {
        brightness =
            BoardConfig::MINIMUM_BRIGHTNESS;
    }

    if (currentStatus_.powerState ==
        PowerState::Dimmed)
    {
        brightness = applyPercent(
            brightness,
            policy_.idleDimBrightnessPercent);

        if (brightness >
            BoardConfig::DIMMED_BRIGHTNESS)
        {
            brightness =
                BoardConfig::DIMMED_BRIGHTNESS;
        }
    }

    if (!policy_.followBatteryPolicy)
    {
        return brightness;
    }

    uint8_t batteryLimit =
        RUNTIME_POWER_MAX_BRIGHTNESS;

    if (currentStatus_.batteryState ==
        BatteryState::Critical)
    {
        batteryLimit =
            policy_.
                criticalBatteryBrightnessLimit;
    }
    else if (
        currentStatus_.batteryState ==
            BatteryState::Low)
    {
        batteryLimit =
            policy_.
                lowBatteryBrightnessLimit;
    }

    if (currentStatus_.
            batteryPolicy.reduceBrightness &&
        currentStatus_.
                batteryPolicy.maximumBrightness <
            batteryLimit)
    {
        batteryLimit =
            currentStatus_.
                batteryPolicy.maximumBrightness;
    }

    return brightness > batteryLimit
        ? batteryLimit
        : brightness;
}

uint8_t
RuntimePowerCoordinator::resolveAudioLimit()
{
    if (!policy_.followBatteryPolicy)
    {
        return RUNTIME_POWER_MAX_PERCENT;
    }

    uint8_t limit =
        RUNTIME_POWER_MAX_PERCENT;

    if (currentStatus_.batteryState ==
        BatteryState::Critical)
    {
        limit =
            policy_.
                criticalBatteryAudioLimitPercent;
    }
    else if (
        currentStatus_.batteryState ==
            BatteryState::Low)
    {
        limit =
            policy_.
                lowBatteryAudioLimitPercent;
    }

    if (currentStatus_.
            batteryPolicy.reduceAudio &&
        currentStatus_.
                batteryPolicy.
                    maximumAudioVolume <
            limit)
    {
        limit =
            currentStatus_.
                batteryPolicy.
                    maximumAudioVolume;
    }

    return clampPercent(limit);
}

bool
RuntimePowerCoordinator::resolveHapticAllowed()
{
    if (!settings_.hapticEnabled)
    {
        return false;
    }

    if (currentStatus_.powerState ==
            PowerState::ShutdownPending ||
        currentStatus_.powerState ==
            PowerState::ShuttingDown ||
        currentStatus_.powerState ==
            PowerState::SafeHalted ||
        currentStatus_.powerState ==
            PowerState::PowerDisabled ||
        currentStatus_.powerState ==
            PowerState::Failed)
    {
        return false;
    }

    if (!policy_.followBatteryPolicy)
    {
        return true;
    }

    return
        !currentStatus_.
            batteryPolicy.disableHaptic &&
        currentStatus_.batteryState !=
            BatteryState::Critical;
}

uint8_t RuntimePowerCoordinator::clampPercent(
    uint8_t value)
{
    return value > RUNTIME_POWER_MAX_PERCENT
        ? RUNTIME_POWER_MAX_PERCENT
        : value;
}

uint8_t RuntimePowerCoordinator::applyPercent(
    uint8_t value,
    uint8_t percent)
{
    const uint16_t product =
        static_cast<uint16_t>(value) *
        static_cast<uint16_t>(
            clampPercent(percent));

    return static_cast<uint8_t>(
        (product + 50U) / 100U);
}

RuntimeResult RuntimePowerCoordinator::fail(
    RuntimePowerError error,
    RuntimeResult result)
{
    currentStatus_.error = error;

    if (Logger::ready())
    {
        Logger::error(
            LogSource::Hardware,
            "POWER_RT",
            errorText(error));
    }

    notifyStateChanged();

    return result;
}

void RuntimePowerCoordinator::
    notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(currentStatus_);
    }
}
