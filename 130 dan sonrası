uint32_t saturatingIncrement32(uint32_t value)
{
    return value == UINT32_MAX
        ? UINT32_MAX
        : value + 1U;
}

size_t saturatingAddSize(
    size_t first,
    size_t second)
{
    return second > SIZE_MAX - first
        ? SIZE_MAX
        : first + second;
}

size_t subtractFloor(
    size_t first,
    size_t second)
{
    return second >= first
        ? 0U
        : first - second;
}

size_t boundedStringLength(
    const char* text,
    size_t capacity)
{
    if (text == nullptr)
    {
        return 0;
    }

    size_t length = 0;

    while (length < capacity &&
           text[length] != '\0')
    {
        ++length;
    }

    return length;
}

void copyLabel(
    char* destination,
    const char* source)
{
    if (destination == nullptr)
    {
        return;
    }

    destination[0] = '\0';

    if (source == nullptr)
    {
        return;
    }

    const size_t length = boundedStringLength(
        source,
        RESOURCE_BUDGET_LABEL_CAPACITY - 1U);

    if (length > 0)
    {
        memcpy(destination, source, length);
    }

    destination[length] = '\0';
}

bool labelsEqual(
    const char* first,
    const char* second)
{
    if (first == nullptr || second == nullptr)
    {
        return false;
    }

    return strncmp(
        first,
        second,
        RESOURCE_BUDGET_LABEL_CAPACITY) == 0;
}
