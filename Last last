bool StatisticsManager::addWithoutOverflow(
    int64_t currentValue,
    int64_t amount,
    int64_t& result
)
{
    if (amount > 0 &&
        currentValue >
            STAT_INT64_MAX - amount)
    {
        return false;
    }

    if (amount < 0 &&
        currentValue <
            STAT_INT64_MIN - amount)
    {
        return false;
    }

    result = currentValue + amount;
    return true;
}

void StatisticsManager::evaluateBest(
    StatisticInfo& statistic,
    int64_t candidateValue,
    bool forceInitialize
)
{
    if (!statistic.valid)
        return;

    if (forceInitialize ||
        !statistic.bestInitialized)
    {
        statistic.bestValue = candidateValue;
        statistic.bestInitialized = true;
        return;
    }

    if (statistic.type == STATISTIC_LOW_SCORE)
    {
        if (candidateValue <
            statistic.bestValue)
        {
            statistic.bestValue =
                candidateValue;
        }

        return;
    }

    if (candidateValue >
        statistic.bestValue)
    {
        statistic.bestValue =
            candidateValue;
    }
}

