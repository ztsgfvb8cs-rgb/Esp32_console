RuntimeResult PsramPool::begin(
    const PsramPoolConfig& config)
{
    if (status_.initialized)
    {
        return setError(
            PsramPoolError::AlreadyInitialized,
            RuntimeResult::Busy);
    }

    PsramPoolError validationError =
        PsramPoolError::None;

    if (!validateConfig(config, &validationError))
    {
        return setError(
            validationError,
            RuntimeResult::InvalidArgument);
    }

    if (!MemoryManager::begin())
    {
        return setError(
            PsramPoolError::BackingAllocationFailed,
            RuntimeResult::NotReady);
    }

    if ((config.requirePsram ||
         config.preference == MemoryPreference::PsramOnly) &&
        !MemoryManager::psramAvailable())
    {
        return setError(
            PsramPoolError::PsramUnavailable,
            RuntimeResult::NotReady);
    }

    const uint32_t generation =
        nextGeneration(status_.generation);

    resetMetadata(true);

    status_.generation = generation;
    status_.preference = config.preference;
    status_.classCount = config.classCount;
    config_ = config;

    uint16_t nextSlot = 0;

    for (uint8_t classIndex = 0;
         classIndex < config_.classCount;
         ++classIndex)
    {
        const PsramPoolSizeClassConfig& classConfig =
            config_.classes[classIndex];

        size_t stride = 0;

        if (!alignSize(
                classConfig.blockSizeBytes,
                classConfig.alignment,
                &stride) ||
            multiplyWouldOverflow(
                stride,
                classConfig.blockCount))
        {
            for (uint8_t releaseIndex = 0;
                 releaseIndex < classIndex;
                 ++releaseIndex)
            {
                MemoryManager::release(
                    backings_[releaseIndex]);
            }

            resetMetadata(true);
            status_.generation = generation;

            return setError(
                PsramPoolError::CapacityOverflow,
                RuntimeResult::InvalidArgument);
        }

        const size_t classDataBytes =
            stride * classConfig.blockCount;

        const size_t alignmentPadding =
            classConfig.alignment - 1U;

        if (addWouldOverflow(
                classDataBytes,
                alignmentPadding))
        {
            for (uint8_t releaseIndex = 0;
                 releaseIndex < classIndex;
                 ++releaseIndex)
            {
                MemoryManager::release(
                    backings_[releaseIndex]);
            }

            resetMetadata(true);
            status_.generation = generation;

            return setError(
                PsramPoolError::CapacityOverflow,
                RuntimeResult::InvalidArgument);
        }

        const size_t backingBytes =
            classDataBytes + alignmentPadding;

        MemoryBlock backing =
            MemoryManager::allocate(
                backingBytes,
                config_.preference,
                config_.clearBackingStore);

        if (!backing || backing.size < backingBytes)
        {
            if (backing)
            {
                MemoryManager::release(backing);
            }

            for (uint8_t releaseIndex = 0;
                 releaseIndex < classIndex;
                 ++releaseIndex)
            {
                MemoryManager::release(
                    backings_[releaseIndex]);
            }

            resetMetadata(true);
            status_.generation = generation;

            const PsramPoolError allocationError =
                (config_.preference ==
                     MemoryPreference::PsramOnly &&
                 !MemoryManager::psramAvailable())
                    ? PsramPoolError::PsramUnavailable
                    : PsramPoolError::BackingAllocationFailed;

            return setError(
                allocationError,
                RuntimeResult::OutOfMemory);
        }

        if (config_.requirePsram && !backing.psram)
        {
            MemoryManager::release(backing);

            for (uint8_t releaseIndex = 0;
                 releaseIndex < classIndex;
                 ++releaseIndex)
            {
                MemoryManager::release(
                    backings_[releaseIndex]);
            }

            resetMetadata(true);
            status_.generation = generation;

            return setError(
                PsramPoolError::PsramUnavailable,
                RuntimeResult::NotReady);
        }

        backings_[classIndex] = backing;
        classStrides_[classIndex] = stride;
        classSlotStarts_[classIndex] = nextSlot;

        for (uint16_t localSlot = 0;
             localSlot < classConfig.blockCount;
             ++localSlot)
        {
            const uint16_t globalSlot =
                static_cast<uint16_t>(
                    nextSlot + localSlot);

            slots_[globalSlot] = {};
            slots_[globalSlot].classIndex = classIndex;
        }

        nextSlot = static_cast<uint16_t>(
            nextSlot + classConfig.blockCount);
    }

    status_.initialized = true;
    status_.error = PsramPoolError::None;
    nextLeaseId_ = 1U;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult PsramPool::beginDefault()
{
    return begin(defaultConfig());
}

void PsramPool::end()
{
    const uint32_t generation =
        nextGeneration(status_.generation);

    for (uint8_t classIndex = 0;
         classIndex < PSRAM_POOL_MAX_SIZE_CLASSES;
         ++classIndex)
    {
        MemoryManager::release(
            backings_[classIndex]);
    }

    resetMetadata(false);
    status_.generation = generation;
    observer_ = nullptr;
}

bool PsramPool::ready() const
{
    if (!status_.initialized ||
        config_.classCount == 0 ||
        config_.classCount >
            PSRAM_POOL_MAX_SIZE_CLASSES)
    {
        return false;
    }

    for (uint8_t classIndex = 0;
         classIndex < config_.classCount;
         ++classIndex)
    {
        if (!backings_[classIndex] ||
            classStrides_[classIndex] == 0)
        {
            return false;
        }

        if (config_.requirePsram &&
            !backings_[classIndex].psram)
        {
            return false;
        }
    }

    return true;
}

PsramPoolStatus PsramPool::status() const
{
    return status_;
