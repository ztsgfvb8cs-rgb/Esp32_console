bool RuntimePowerCoordinator::begin()
{
    if (currentStatus_.initialized)
    {
        return true;
    }

    currentStatus_ = {};
    policy_ = {};
    settings_ = SettingsManager::settings();
    observer_ = nullptr;

    lastRuntimeTransitionSequence_ = 0;
    lastBatterySampleSequence_ = 0;

    resetApplyCache();

    if (!HardwareManager::ready() &&
        !HardwareManager::begin())
    {
        currentStatus_.error =
            RuntimePowerError::HardwareNotReady;

        return false;
    }

    if (!PowerManager::ready() &&
        !PowerManager::begin())
    {
        currentStatus_.error =
            RuntimePowerError::PowerManagerNotReady;

        return false;
    }

    if (!BatteryManager::ready() &&
        !BatteryManager::begin(true))
    {
        currentStatus_.error =
            RuntimePowerError::BatteryManagerNotReady;

        return false;
    }

    if (!RuntimeModuleManager::ready() &&
        !RuntimeModuleManager::begin())
    {
        currentStatus_.error =
            RuntimePowerError::RuntimeManagerNotReady;

        return false;
    }

    if (!RuntimeAudioCoordinator::ready() &&
        !RuntimeAudioCoordinator::begin())
    {
        currentStatus_.error =
            RuntimePowerError::InvalidPolicy;

        return false;
    }

    savedAudioPolicy =
        RuntimeAudioCoordinator::policy();

    savedAudioPolicyValid = true;

    BatteryManager::setAutomaticCriticalShutdown(
        policy_.automaticCriticalShutdown);

    RuntimeAudioCoordinator::setSettings(settings_);

    currentStatus_.initialized = true;

    currentStatus_.requestedBrightness =
        settings_.brightness;

    currentStatus_.lastUpdateAtMs = millis();

    currentStatus_.lastActivityAtMs =
        PowerManager::status().lastActivityMs;

    currentStatus_.error =
        RuntimePowerError::None;

    if (synchronize(
            currentStatus_.lastUpdateAtMs,
            true) != RuntimeResult::Ok)
    {
        currentStatus_.initialized = false;
        return false;
    }

    Logger::info(
        LogSource::Hardware,
        "POWER_RT",
        "Runtime power coordinator ready");

    notifyStateChanged();

    return true;
}

