// ESP32 GAME STATION
// SINGLE-CELL LI-ION BATTERY MANAGER
// 109_battery_manager.h
//====================================================
//
// Responsibilities:
// - Samples the 26650 cell through the configured divider.
// - Spreads normal ADC sampling across update() calls.
// - Filters ADC noise with a configurable EMA filter.
// - Produces the fixed four-bar battery icon value.
// - Detects low and critical states with hysteresis.
// - Supports scale/offset calibration without changing pins.
//
// The user interface must show only the four-bar icon.
// Percentage remains available for diagnostics and logging.
//====================================================

enum class BatteryState : uint8_t
{
    UNKNOWN = 0,
    CRITICAL,
    LOW,
    NORMAL,
    FULL
};

enum class BatteryError : uint8_t
{
    NONE = 0,
    HARDWARE_INITIALIZATION_FAILED,
    INVALID_CONFIGURATION,
    ADC_READ_FAILED,
    INVALID_CALIBRATION,
    INVALID_SMOOTHING_FACTOR
};

struct BatteryStatus
{
    bool initialized;
    bool valid;
    bool sampling;
    bool changed;
    bool low;
    bool critical;
    bool full;

    uint16_t rawAdc;

    float adcVoltage;
    float batteryVoltage;
    float filteredVoltage;

    uint8_t percentage;
    uint8_t bars;

    uint32_t lastUpdateTime;
    uint32_t sampleSequence;

    BatteryState state;
    BatteryError error;
};

using BatteryStateCallback = void (*)(
    BatteryState previousState,
    BatteryState currentState,
    const BatteryStatus& status);

class BatteryManager
{
public:
    static constexpr float DEFAULT_CALIBRATION_SCALE = 1.0f;
    static constexpr float DEFAULT_CALIBRATION_OFFSET_V = 0.0f;
    static constexpr float DEFAULT_SMOOTHING_FACTOR = 0.25f;

    static constexpr float STATE_HYSTERESIS_V = 0.05f;
    static constexpr float BAR_HYSTERESIS_V = 0.025f;
    static constexpr float CHANGE_EPSILON_V = 0.01f;

    static constexpr float MIN_CALIBRATION_SCALE = 0.50f;
    static constexpr float MAX_CALIBRATION_SCALE = 1.50f;
    static constexpr float MIN_CALIBRATION_OFFSET_V = -0.50f;
    static constexpr float MAX_CALIBRATION_OFFSET_V = 0.50f;

    //================================================
    // LIFECYCLE
    //================================================

    static bool begin(bool sampleImmediately = true);
    static void update();
    static void end();

    static bool ready();
    static BatteryStatus status();

    //================================================
    // SAMPLING
    //================================================

    static bool forceSample();
    static bool sampling();
    static uint32_t lastUpdateTime();
    static uint32_t sampleSequence();

    //================================================
    // BATTERY VALUES
    //================================================

    static uint16_t rawAdc();
    static float adcVoltage();
    static float voltage();
    static uint8_t percentage();
    static uint8_t bars();

    static BatteryState state();
    static bool low();
    static bool critical();
    static bool full();
    static bool changed();

    //================================================
    // CALIBRATION AND FILTERING
    //================================================

    static bool setCalibration(
        float scale,
        float offsetVoltage);

    static void resetCalibration();

    static float calibrationScale();
    static float calibrationOffsetVoltage();

    static bool setSmoothingFactor(float factor);
    static float smoothingFactor();

    //================================================
    // CALLBACKS AND TEXT
    //================================================

    static void setStateCallback(
        BatteryStateCallback callback);

    static BatteryError lastError();

    static const char* stateText(BatteryState value);
    static const char* errorText(BatteryError value);

private:
    static BatteryStatus currentStatus;

    static float currentCalibrationScale;
    static float currentCalibrationOffsetV;
    static float currentSmoothingFactor;

    static BatteryStateCallback stateCallback;

    static uint32_t sampleAccumulator;
    static uint8_t collectedSampleCount;

    static void clearStatus();
    static void resetSampler();

    static bool validateConfiguration();
    static bool startSampling();
    static bool collectOneSample();
    static bool finishSampling();
    static bool processRawAverage(uint16_t averageRaw);

    static float rawToAdcVoltage(uint16_t rawValue);
    static float calibratedBatteryVoltage(float measuredAdcVoltage);

    static BatteryState classifyState(
        float filteredVoltage,
        BatteryState previousState);

    static uint8_t calculateBars(
        float filteredVoltage,
        uint8_t previousBars,
        bool previousValueValid);

    static uint8_t calculatePercentage(float filteredVoltage);

    static bool validFiniteValue(float value);
    static float absoluteFloat(float value);
    static float clampFloat(
        float value,
        float minimum,
        float maximum);
};

