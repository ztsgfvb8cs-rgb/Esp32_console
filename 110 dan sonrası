namespace egs
{
RuntimeSessionStatus RuntimeSessionBridge::currentStatus_ = {};
RuntimeSessionLaunchOptions RuntimeSessionBridge::activeOptions_ = {};
RuntimeSessionStateCallback RuntimeSessionBridge::stateCallback_ = nullptr;
ContentItem RuntimeSessionBridge::activeContent_ = {};
RuntimeSessionExitReason RuntimeSessionBridge::pendingExitReason_ =
    RuntimeSessionExitReason::None;

bool RuntimeSessionBridge::begin()
{
    if (currentStatus_.initialized)
    {
        return true;
    }

    if (!RuntimeModuleManager::ready() &&
        !RuntimeModuleManager::begin())
    {
        currentStatus_ = {};
        currentStatus_.error =
            RuntimeSessionError::RuntimeManagerNotReady;
        currentStatus_.lastResult = RuntimeResult::NotReady;
        return false;
    }

    // A startup bridge must never inherit an unidentified
    // foreground owner from an earlier partial initialization.
    if (RuntimeModuleManager::foregroundActive())
    {
        if (RuntimeModuleManager::closeForeground() !=
            RuntimeResult::Ok)
        {
            currentStatus_ = {};
            currentStatus_.error =
                RuntimeSessionError::CloseFailed;
            currentStatus_.lastResult =
                RuntimeResult::InternalError;
            return false;
        }
    }

    currentStatus_ = {};
    currentStatus_.initialized = true;
    currentStatus_.lastResult = RuntimeResult::Ok;
    currentStatus_.foregroundScreen = AppScreen::MainMenu;
    currentStatus_.returnScreen = AppScreen::MainMenu;
    currentStatus_.selectedContentIndex =
        RUNTIME_INVALID_CONTENT_INDEX;

    activeOptions_ = {};
    activeContent_ = {};
    pendingExitReason_ = RuntimeSessionExitReason::None;

    synchronizeRuntimeStatus();

    Logger::info(
        LogSource::Application,
        "SESSION",
        "Runtime session bridge ready");

    notifyStateChanged();
    return true;
}

void RuntimeSessionBridge::update(uint32_t nowMs)
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    RuntimeModuleManager::update(nowMs);
    synchronizeRuntimeStatus();

    if (currentStatus_.closeRequested)
    {
        const RuntimeSessionExitReason reason =
            pendingExitReason_ == RuntimeSessionExitReason::None
                ? RuntimeSessionExitReason::UserRequest
                : pendingExitReason_;

        finishClose(reason, true);
        return;
    }

    if (!currentStatus_.active)
    {
        return;
    }

    if (currentStatus_.moduleState ==
            RuntimeModuleState::Failed ||
        currentStatus_.moduleError != RuntimeModuleError::None)
    {
        currentStatus_.error =
            RuntimeSessionError::BackendFailed;
        currentStatus_.lastResult =
            RuntimeResult::InternalError;

        finishClose(
            RuntimeSessionExitReason::RuntimeFailure,
            true);
        return;
    }

    if (!RuntimeModuleManager::foregroundActive() ||
        currentStatus_.moduleState ==
            RuntimeModuleState::Stopped)
    {
        finishClose(
            RuntimeSessionExitReason::BackendFinished,
            true);
    }
}

void RuntimeSessionBridge::end()
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    if (currentStatus_.active ||
        RuntimeModuleManager::foregroundActive())
    {
        finishClose(
            RuntimeSessionExitReason::Shutdown,
            false);
    }

    clearSessionData();
    currentStatus_.initialized = false;
    currentStatus_.exitReason =
        RuntimeSessionExitReason::Shutdown;
    currentStatus_.lastResult = RuntimeResult::Ok;

    Logger::info(
        LogSource::Application,
        "SESSION",
        "Runtime session bridge stopped");

    notifyStateChanged();
}

bool RuntimeSessionBridge::ready()
{
    return currentStatus_.initialized;
}

RuntimeSessionStatus RuntimeSessionBridge::status()
{
    synchronizeRuntimeStatus();
    return currentStatus_;
}

RuntimeResult RuntimeSessionBridge::launch(
    const ContentItem& item,
    const RuntimeSessionLaunchOptions& options)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeSessionError::NotInitialized,
            RuntimeResult::NotReady,
            RuntimeSessionExitReason::LaunchRejected);
    }

    if (!RuntimeModuleManager::ready())
    {
        return fail(
            RuntimeSessionError::RuntimeManagerNotReady,
            RuntimeResult::NotReady,
            RuntimeSessionExitReason::LaunchRejected);
    }

    if (currentStatus_.active ||
        RuntimeModuleManager::foregroundActive())
    {
        return fail(
            RuntimeSessionError::AlreadyActive,
            RuntimeResult::Busy,
            RuntimeSessionExitReason::LaunchRejected);
    }

    if (!validLaunchContent(item))
    {
        return fail(
            RuntimeSessionError::InvalidContent,
            RuntimeResult::InvalidArgument,
            RuntimeSessionExitReason::LaunchRejected);
    }

    if (!validReturnScreen(options.returnScreen))
    {
        return fail(
            RuntimeSessionError::InvalidReturnScreen,
            RuntimeResult::InvalidArgument,
            RuntimeSessionExitReason::LaunchRejected);
    }

    if (options.selectedContentIndex !=
            RUNTIME_INVALID_CONTENT_INDEX &&
        ContentCatalog::get(options.selectedContentIndex) == nullptr)
    {
        return fail(
            RuntimeSessionError::InvalidContent,
            RuntimeResult::InvalidArgument,
            RuntimeSessionExitReason::LaunchRejected);
    }

    const RuntimeModuleKind kind =
        item.kind == ContentKind::BuiltinGame
            ? RuntimeModuleKind::BuiltinGame
            : item.kind == ContentKind::Rom
                ? RuntimeModuleKind::Emulator
                : RuntimeModuleKind::PdfReader;

    const AppScreen targetScreen =
        resolveForegroundScreen(kind);

    if (targetScreen != AppScreen::Playing &&
        targetScreen != AppScreen::PdfReader)
    {
        return fail(
            RuntimeSessionError::InvalidContent,
            RuntimeResult::Unsupported,
            RuntimeSessionExitReason::LaunchRejected);
    }

    currentStatus_.error = RuntimeSessionError::None;
    currentStatus_.lastResult = RuntimeResult::Ok;
    currentStatus_.exitReason = RuntimeSessionExitReason::None;
    currentStatus_.closeRequested = false;
    currentStatus_.navigationPending = false;
    currentStatus_.origin = options.origin;
    currentStatus_.moduleKind = kind;
    currentStatus_.moduleState = RuntimeModuleState::Starting;
    currentStatus_.moduleError = RuntimeModuleError::None;
    currentStatus_.engine = item.engine;
    currentStatus_.foregroundScreen = targetScreen;
    currentStatus_.returnScreen = options.returnScreen;
    currentStatus_.selectedContentIndex =
        options.selectedContentIndex;
    currentStatus_.launchedAtMs = 0;
    currentStatus_.closedAtMs = 0;

    activeOptions_ = options;
    activeContent_ = item;
    pendingExitReason_ = RuntimeSessionExitReason::None;

    const RuntimeResult launchResult =
        RuntimeModuleManager::launch(item);

    synchronizeRuntimeStatus();

    if (launchResult != RuntimeResult::Ok)
    {
        clearSessionData();

        RuntimeSessionError launchError =
            RuntimeSessionError::LaunchFailed;

        if (launchResult == RuntimeResult::NotReady)
        {
            launchError =
                RuntimeSessionError::RuntimeManagerNotReady;
        }
        else if (launchResult == RuntimeResult::Busy)
        {
            launchError = RuntimeSessionError::AlreadyActive;
        }
        else if (launchResult == RuntimeResult::InvalidArgument)
        {
            launchError = RuntimeSessionError::InvalidContent;
        }

        return fail(
            launchError,
            launchResult,
            RuntimeSessionExitReason::LaunchRejected);
    }

    currentStatus_.active = true;
    currentStatus_.moduleKind =
        RuntimeModuleManager::activeKind();
    currentStatus_.engine =
        RuntimeModuleManager::activeEngine();
    currentStatus_.foregroundScreen =
        resolveForegroundScreen(currentStatus_.moduleKind);
    currentStatus_.launchedAtMs = millis();
    ++currentStatus_.sessionSequence;

    StateStore::setEngine(currentStatus_.engine);

    if (options.selectedContentIndex !=
        RUNTIME_INVALID_CONTENT_INDEX)
    {
        StateStore::setSelection(
            options.selectedContentIndex);
    }

    if (options.navigateToForeground)
    {
        navigateTo(currentStatus_.foregroundScreen);

        if (ScreenManager::current() !=
            currentStatus_.foregroundScreen)
        {
            RuntimeModuleManager::closeForeground();
            clearSessionData();

            return fail(
                RuntimeSessionError::NavigationFailed,
                RuntimeResult::InternalError,
                RuntimeSessionExitReason::LaunchRejected);
        }
    }

    Logger::info(
        LogSource::Application,
        "SESSION",
        "Foreground session started");

    notifyStateChanged();
    return RuntimeResult::Ok;
}

RuntimeResult RuntimeSessionBridge::launchFromBrowser(
    const ContentItem& item,
    uint16_t catalogIndex)
{
    RuntimeSessionLaunchOptions options;
    options.origin = resolveBrowserOrigin(item);
    options.returnScreen = resolveBrowserReturnScreen(item);
    options.selectedContentIndex = catalogIndex;
