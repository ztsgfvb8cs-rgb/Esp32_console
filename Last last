    int16_t selectedIndex =
        PLAYTIME_INVALID_GAME_INDEX;


    uint32_t highestLaunchCount =
        0;


    for(uint16_t i = 0;
        i < recordCount;
        i++)
    {
        if(!records[i].valid)
        {
            continue;
        }


        if(
            selectedIndex ==
                PLAYTIME_INVALID_GAME_INDEX ||
            records[i].launchCount >
                highestLaunchCount
        )
        {
            selectedIndex =
                (int16_t)i;


            highestLaunchCount =
                records[i].
                    launchCount;
        }
    }


    if(selectedIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        return String();
    }


    return String(
        records[selectedIndex].
            gameName
    );
}


