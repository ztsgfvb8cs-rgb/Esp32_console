    RuntimeResult SdStreamService::close(
        SdStreamHandle& handle) {
        SdStreamError lookupError =
            SdStreamError::None;

        StreamSlot* const slot =
            slotFor(handle, &lookupError);

        if (slot == nullptr) {
            invalidateHandle(handle);

            return setError(
                lookupError,
                RuntimeResult::InvalidArgument);
        }

        if (slot->buffer.status().
                readReservationActive) {
            slot->buffer.cancelRead();
        }

        if (slot->options.clearBufferOnClose &&
            slot->buffer.ready()) {
            slot->buffer.reset(
                StreamRingBufferClearMode::Clear);
        }

        if (slot->file) {
            slot->file.close();
        }

        slot->buffer.end();

        slot->file = File();
        slot->options = {};
        slot->status = {};
        slot->occupied = false;
        slot->prefetchRequested = false;
        slot->consecutiveReadFailures = 0;
        slot->generation =
            nextGeneration(slot->generation);

        slot->status.generation =
            slot->generation;

        slot->status.state =
            SdStreamState::Closed;

        currentStatus_.closeSequence =
            saturatingIncrement32(
                currentStatus_.closeSequence);

        invalidateHandle(handle);
        refreshServiceStatus();
        notifyStreamChanged(*slot);

        currentStatus_.error =
            SdStreamError::None;

        return RuntimeResult::Ok;
    }

    void SdStreamService::closeAll() {
        for (uint8_t index = 0;
             index < SD_STREAM_MAX_STREAMS;
             ++index) {
            StreamSlot& slot =
                slots_[index];

            if (!slot.occupied) {
                continue;
            }

            SdStreamHandle handle;

            handle.slot = index;
            handle.generation =
                slot.generation;

            close(handle);
        }

        refreshServiceStatus();
    }

