//---------------- Favorite Games ----------------

bool addFavoriteGame(
    uint16_t gameID
)
{
    if(gameID ==
       PROFILE_INVALID_ID)
    {
        profileManagerStatus =
            PROFILE_STATUS_INVALID_PROFILE;


        return false;
    }


    if(isFavoriteGame(
        gameID
    ))
    {
        profileManagerStatus =
            PROFILE_STATUS_READY;


        return true;
    }


    if(playerProfile.favoriteGameCount >=
       PROFILE_MAX_FAVORITES)
    {
        profileManagerStatus =
            PROFILE_STATUS_FAVORITES_FULL;


        return false;
    }


    playerProfile.favoriteGames[
        playerProfile.favoriteGameCount
    ] = gameID;


    playerProfile.favoriteGameCount++;


    if(playerProfile.primaryFavoriteGame ==
       PROFILE_INVALID_ID)
    {
        playerProfile.primaryFavoriteGame =
            gameID;
    }


    playerProfile.modified =
        true;


    profileManagerStatus =
        PROFILE_STATUS_READY;


    return true;
}



bool removeFavoriteGame(
    uint16_t gameID
)
{
    int8_t index =
        findFavoriteGameIndex(
            gameID
        );


    if(index < 0)
    {
        profileManagerStatus =
            PROFILE_STATUS_FAVORITE_NOT_FOUND;


        return false;
    }


    for(uint8_t i = index;
        i + 1 < playerProfile.favoriteGameCount;
        i++)
    {
        playerProfile.favoriteGames[i] =
            playerProfile.favoriteGames[i + 1];
    }


    if(playerProfile.favoriteGameCount > 0)
    {
        playerProfile.favoriteGameCount--;


        playerProfile.favoriteGames[
            playerProfile.favoriteGameCount
        ] = PROFILE_INVALID_ID;
    }


    if(playerProfile.primaryFavoriteGame ==
       gameID)
    {
        if(playerProfile.favoriteGameCount > 0)
        {
            playerProfile.primaryFavoriteGame =
                playerProfile.favoriteGames[0];
        }
        else
        {
            playerProfile.primaryFavoriteGame =
                PROFILE_INVALID_ID;
        }
    }


    playerProfile.modified =
        true;


    profileManagerStatus =
        PROFILE_STATUS_READY;


    return true;
}



