bool hasPendingAchievementNotification()
{
    for(uint16_t i = 0;
        i < achievementCount;
        i++)
    {
        if(achievementRecords[i].
               progress.valid &&
           achievementRecords[i].
               progress.notificationPending)
        {
            return true;
        }
    }


    return false;
}



uint16_t getNextPendingAchievementNotification()
{
    for(uint16_t i = 0;
        i < achievementCount;
        i++)
    {
        if(achievementRecords[i].
               progress.valid &&
           achievementRecords[i].
               progress.notificationPending)
        {
