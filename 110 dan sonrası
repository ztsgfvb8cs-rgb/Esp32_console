constexpr uint16_t KNOWN_SOURCE_FLAGS =
    AiPerceptionSourceVision |
    AiPerceptionSourceHearing |
    AiPerceptionSourceContact |
    AiPerceptionSourceGameRule |
    AiPerceptionSourcePrediction;

uint16_t clampPermille(uint16_t value)
{
    return value > AI_PERMILLE_MAX
        ? AI_PERMILLE_MAX
        : value;
}

bool timeReached(uint32_t nowMs, uint32_t deadlineMs)
{
    return static_cast<int32_t>(nowMs - deadlineMs) >= 0;
}

uint64_t saturatedSquare(int64_t value)
{
    const uint64_t magnitude = value < 0
        ? static_cast<uint64_t>(-(value + 1)) + 1ULL
        : static_cast<uint64_t>(value);

    if (magnitude != 0 &&
        magnitude > UINT64_MAX / magnitude)
    {
        return UINT64_MAX;
    }

    return magnitude * magnitude;
}

uint64_t saturatedAdd(uint64_t first, uint64_t second)
{
    return second > UINT64_MAX - first
        ? UINT64_MAX
        : first + second;
}

uint64_t distanceSquared(
    const AiPoint2& first,
    const AiPoint2& second)
{
    const int64_t dx =
        static_cast<int64_t>(second.x) -
        static_cast<int64_t>(first.x);

    const int64_t dy =
        static_cast<int64_t>(second.y) -
        static_cast<int64_t>(first.y);

    return saturatedAdd(
        saturatedSquare(dx),
        saturatedSquare(dy));
}

uint32_t integerSquareRoot(uint64_t value)
{
    uint64_t result = 0;
    uint64_t bit = 1ULL << 62U;

    while (bit > value)
    {
        bit >>= 2U;
    }

    while (bit != 0)
    {
        if (value >= result + bit)
        {
            value -= result + bit;
            result = (result >> 1U) + bit;
        }
        else
        {
            result >>= 1U;
        }

        bit >>= 2U;
    }

    return result > UINT32_MAX
        ? UINT32_MAX
        : static_cast<uint32_t>(result);
}

uint32_t pointDistance(
    const AiPoint2& first,
    const AiPoint2& second)
{
    return integerSquareRoot(
        distanceSquared(first, second));
}

int32_t directionScorePermille(
    const AiPerceptionObserverState& observer,
    const AiPoint2& target)
{
    const int64_t dx =
        static_cast<int64_t>(target.x) -
        static_cast<int64_t>(observer.position.x);

    const int64_t dy =
        static_cast<int64_t>(target.y) -
        static_cast<int64_t>(observer.position.y);

    if (dx == 0 && dy == 0)
    {
        return static_cast<int32_t>(AI_PERMILLE_MAX);
    }

    const int64_t forwardX = observer.forwardPermille.x;
    const int64_t forwardY = observer.forwardPermille.y;

    const uint32_t directionLength = integerSquareRoot(
        saturatedAdd(
            saturatedSquare(dx),
            saturatedSquare(dy)));

    const uint32_t forwardLength = integerSquareRoot(
        saturatedAdd(
            saturatedSquare(forwardX),
            saturatedSquare(forwardY)));

    if (directionLength == 0 || forwardLength == 0)
    {
        return -static_cast<int32_t>(AI_PERMILLE_MAX);
    }

    const int64_t dot =
        dx * forwardX +
        dy * forwardY;

    const uint64_t denominator =
        static_cast<uint64_t>(directionLength) *
        static_cast<uint64_t>(forwardLength);

    if (denominator == 0)
    {
        return -static_cast<int32_t>(AI_PERMILLE_MAX);
    }

    int64_t score =
        (dot * static_cast<int64_t>(AI_PERMILLE_MAX)) /
        static_cast<int64_t>(denominator);

    if (score > AI_PERMILLE_MAX)
    {
        score = AI_PERMILLE_MAX;
    }
    else if (score < -static_cast<int64_t>(AI_PERMILLE_MAX))
    {
        score = -static_cast<int64_t>(AI_PERMILLE_MAX);
    }

    return static_cast<int32_t>(score);
}

bool insideVisionArc(
    const AiPerceptionObserverState& observer,
    const AiPoint2& target,
    uint16_t arcPermille)
{
    if (arcPermille >= AI_PERMILLE_MAX)
    {
        return true;
    }

    const int32_t minimumDirectionScore =
        static_cast<int32_t>(AI_PERMILLE_MAX) -
        static_cast<int32_t>(arcPermille) * 2;

    return directionScorePermille(observer, target) >=
        minimumDirectionScore;
}

uint32_t scaledRange(
    uint32_t baseRange,
    uint16_t strengthPermille)
{
    const uint64_t scaled =
        static_cast<uint64_t>(baseRange) *
        clampPermille(strengthPermille);

    const uint64_t rounded =
        (scaled + AI_PERMILLE_MAX / 2U) /
        AI_PERMILLE_MAX;

    return rounded > UINT32_MAX
        ? UINT32_MAX
        : static_cast<uint32_t>(rounded);
}

uint16_t multipliedPermille(
    uint16_t first,
    uint16_t second)
{
    const uint32_t product =
        static_cast<uint32_t>(clampPermille(first)) *
        static_cast<uint32_t>(clampPermille(second));

    return static_cast<uint16_t>(
        (product + AI_PERMILLE_MAX / 2U) /
        AI_PERMILLE_MAX);
}

uint32_t memoryDurationForSources(
    uint16_t sourceFlags,
    const AiPerceptionPolicy& policy)
{
    uint32_t durationMs = 0;

    if ((sourceFlags & AiPerceptionSourceVision) != 0U ||
        (sourceFlags & AiPerceptionSourceGameRule) != 0U)
    {
        durationMs = policy.visualMemoryMs;
    }

    if ((sourceFlags & AiPerceptionSourceHearing) != 0U &&
        policy.hearingMemoryMs > durationMs)
    {
        durationMs = policy.hearingMemoryMs;
    }

    if ((sourceFlags & AiPerceptionSourceContact) != 0U &&
        policy.contactMemoryMs > durationMs)
    {
        durationMs = policy.contactMemoryMs;
    }

    return durationMs;
}

uint16_t baseConfidenceForObservation(
    const AiPerceptionObservation& observation,
    const AiPerceptionPolicy& policy,
    const AiDifficultyProfile& difficulty)
{
    uint16_t confidence = 0;

    if ((observation.sourceFlags &
         AiPerceptionSourceGameRule) != 0U)
    {
        confidence = AI_PERMILLE_MAX;
    }

    if ((observation.sourceFlags &
         AiPerceptionSourceContact) != 0U &&
        policy.contactConfidencePermille > confidence)
    {
        confidence = policy.contactConfidencePermille;
    }

    if ((observation.sourceFlags &
         AiPerceptionSourceVision) != 0U)
    {
        uint16_t visualConfidence = AI_PERMILLE_MAX;

        const uint16_t visualPenalty =
            static_cast<uint16_t>(
                difficulty.aimErrorPermille / 3U +
                difficulty.movementErrorPermille / 4U);

        visualConfidence = visualPenalty >= visualConfidence
            ? 0U
            : static_cast<uint16_t>(
                visualConfidence - visualPenalty);

        if (observation.visibility ==
            AiVisibilityState::Peripheral)
        {
            visualConfidence = multipliedPermille(
                visualConfidence,
                policy.peripheralConfidencePermille);
        }

        if (visualConfidence > confidence)
        {
            confidence = visualConfidence;
        }
    }

    if ((observation.sourceFlags &
         AiPerceptionSourceHearing) != 0U)
    {
        uint16_t hearingConfidence =
            policy.hearingConfidencePermille;

        const uint16_t randomnessRetention =
            difficulty.randomnessPermille >=
                    AI_PERMILLE_MAX * 2U
                ? 0U
                : static_cast<uint16_t>(
                    AI_PERMILLE_MAX -
                    difficulty.randomnessPermille / 2U);

        hearingConfidence = multipliedPermille(
            hearingConfidence,
            randomnessRetention);

        if (hearingConfidence > confidence)
        {
            confidence = hearingConfidence;
        }
    }

    return clampPermille(confidence);
}

int32_t predictedCoordinate(
    int32_t position,
    int32_t velocity,
    uint32_t horizonMs,
    uint16_t predictionStrengthPermille)
{
    const int64_t displacement =
        static_cast<int64_t>(velocity) *
        static_cast<int64_t>(horizonMs) *
        static_cast<int64_t>(
            clampPermille(predictionStrengthPermille));

    const int64_t scaledDisplacement =
        displacement /
        static_cast<int64_t>(
            AI_PERMILLE_MAX * 1000UL);

    const int64_t predicted =
        static_cast<int64_t>(position) +
        scaledDisplacement;

    if (predicted > INT32_MAX)
    {
        return INT32_MAX;
    }

    if (predicted < INT32_MIN)
    {
        return INT32_MIN;
    }

    return static_cast<int32_t>(predicted);
}
