    uint16_t count,
    const String& id
)
{
    if (items == nullptr)
        return false;

    for (uint16_t i = 0; i < count; i++)
    {
        if (items[i].valid &&
            items[i].id == id)
        {
            return true;
        }
    }

    return false;
}

bool parseRecord(
    const String& line,
    AchievementInfo& achievement,
    uint32_t fallbackTimestamp,
    bool& repaired
)
{
    if (countFields(line) != 11)
        return false;

    String recordType;
    String encodedID;
    String encodedSource;
    String encodedTitle;
    String encodedDescription;
    String categoryField;
    String progressField;
    String targetField;
    String timestampField;
    String hiddenField;
    String unlockedField;

    if (!readField(line, 0, recordType) ||
        !readField(line, 1, encodedID) ||
        !readField(line, 2, encodedSource) ||
        !readField(line, 3, encodedTitle) ||
        !readField(line, 4, encodedDescription) ||
        !readField(line, 5, categoryField) ||
        !readField(line, 6, progressField) ||
        !readField(line, 7, targetField) ||
        !readField(line, 8, timestampField) ||
        !readField(line, 9, hiddenField) ||
        !readField(line, 10, unlockedField))
    {
        return false;
    }

    if (recordType != "A")
        return false;

    achievement = makeEmptyInfo();

    if (!decodeTextValue(
            encodedID,
            achievement.id
        ) ||
        !decodeTextValue(
            encodedSource,
            achievement.source
        ) ||
        !decodeTextValue(
            encodedTitle,
            achievement.title
        ) ||
        !decodeTextValue(
            encodedDescription,
            achievement.description
        ))
    {
        return false;
    }

    uint32_t categoryValue = 0;
    uint32_t progressValue = 0;
    uint32_t targetValue = 0;
    uint32_t timestampValue = 0;
    uint32_t hiddenValue = 0;
    uint32_t unlockedValue = 0;

    if (!parseUnsignedValue(
            categoryField,
            categoryValue
        ) ||
        !parseUnsignedValue(
            progressField,
            progressValue
        ) ||
        !parseUnsignedValue(
            targetField,
            targetValue
        ) ||
        !parseUnsignedValue(
            timestampField,
            timestampValue
        ) ||
        !parseUnsignedValue(
            hiddenField,
            hiddenValue
        ) ||
        !parseUnsignedValue(
            unlockedField,
            unlockedValue
        ))
    {
        return false;
    }

    if (!validIdentifier(achievement.id, 48) ||
        !validIdentifier(achievement.source, 48) ||
        achievement.title.length() == 0 ||
        achievement.title.length() > 96 ||
        achievement.description.length() > 320 ||
        categoryValue > ACHIEVEMENT_SECRET ||
        hiddenValue > 1 ||
        unlockedValue > 1)
    {
        return false;
    }

    if (targetValue == 0)
    {
        targetValue = 1;
        repaired = true;
    }

    achievement.category =
        static_cast<AchievementCategory>(
            categoryValue
        );

    achievement.progress = progressValue;
    achievement.target = targetValue;
    achievement.unlockedAt = timestampValue;

    achievement.hidden =
        hiddenValue == 1;

    achievement.unlocked =
        unlockedValue == 1;

    achievement.valid = true;

    if (achievement.progress >
        achievement.target)
    {
        achievement.progress =
            achievement.target;

        repaired = true;
    }

    uint32_t safeTimestamp =
        fallbackTimestamp == 0
            ? 1
            : fallbackTimestamp;

    if (achievement.unlocked)
    {
        if (achievement.progress !=
            achievement.target)
        {
            achievement.progress =
                achievement.target;

            repaired = true;
        }

        if (achievement.unlockedAt == 0)
        {
            achievement.unlockedAt =
                safeTimestamp;

            repaired = true;
        }
    }
    else if (achievement.progress >=
             achievement.target)
    {
        achievement.progress =
            achievement.target;

        achievement.unlocked = true;

        achievement.unlockedAt =
            safeTimestamp;

        repaired = true;
    }
    else if (achievement.unlockedAt != 0)
    {
        achievement.unlockedAt = 0;

        repaired = true;
    }

    return true;
}

bool loadDatabaseFile(
    const String& path,
    const char* expectedHeader,
    uint16_t expectedVersion,
    AchievementInfo* output,
    uint16_t maximumCount,
    uint16_t& outputCount,
    bool& repaired,
    uint32_t fallbackTimestamp
)
{
    outputCount = 0;
    repaired = false;

    if (output != nullptr)
    {
        for (uint16_t i = 0;
             i < maximumCount;
             i++)
        {
            output[i] = makeEmptyInfo();
        }
    }

    File file =
        StorageManager::openFile(
            path,
            FILE_READ
        );

    if (!file)
        return false;

    String header =
        file.readStringUntil('\n');

    removeCarriageReturn(header);

    if (header != expectedHeader)
    {
        StorageManager::closeFile(file);

        return false;
    }

    String versionLine =
        file.readStringUntil('\n');

    removeCarriageReturn(versionLine);

    uint32_t loadedVersion = 0;

    if (!parseUnsignedValue(
            versionLine,
            loadedVersion
        ) ||
        loadedVersion != expectedVersion)
    {
        StorageManager::closeFile(file);

        return false;
    }

    String countLine =
        file.readStringUntil('\n');

    removeCarriageReturn(countLine);

    uint32_t declaredCount = 0;

    if (!parseUnsignedValue(
            countLine,
            declaredCount
        ) ||
        declaredCount > maximumCount)
    {
        StorageManager::closeFile(file);

        return false;
    }

    uint32_t physicalRecordCount = 0;

    while (file.available())
    {
        String line =
            file.readStringUntil('\n');

        removeCarriageReturn(line);

        if (line.length() == 0)
        {
            repaired = true;

            continue;
        }

        physicalRecordCount++;

        if (line.length() > 1024)
        {
            repaired = true;

            continue;
        }

        AchievementInfo achievement;

        bool recordRepaired = false;

        if (!parseRecord(
                line,
                achievement,
                fallbackTimestamp,
                recordRepaired
            ))
        {
            repaired = true;

            continue;
        }

        if (hasDuplicateID(
                output,
                outputCount,
                achievement.id
            ))
        {
            repaired = true;

            continue;
        }

        if (outputCount >= maximumCount)
        {
            repaired = true;

            break;
        }

        if (output != nullptr)
            output[outputCount] = achievement;

        outputCount++;

        if (recordRepaired)
            repaired = true;
    }

    StorageManager::closeFile(file);

    if (physicalRecordCount != declaredCount ||
        outputCount != declaredCount)
    {
        repaired = true;
    }

    return true;
}

bool removeIfExists(const String& path)
{
    if (!StorageManager::exists(path))
        return true;

    return StorageManager::deleteFile(path);
}

bool copyFileContents(
    const String& sourcePath,
    const String& destinationPath
)
{
    File source =
        StorageManager::openFile(
            sourcePath,
            FILE_READ
        );

    if (!source)
        return false;

    if (!removeIfExists(destinationPath))
    {
        StorageManager::closeFile(source);

        return false;
    }

    File destination =
        StorageManager::openFile(
            destinationPath,
            FILE_WRITE
        );

    if (!destination)
    {
        StorageManager::closeFile(source);

        return false;
    }

    bool succeeded = true;

    uint8_t buffer[256];

    while (source.available())
    {
        int bytesRead =
            source.read(
                buffer,
                sizeof(buffer)
            );

        if (bytesRead <= 0)
        {
            succeeded = false;

            break;
        }

        size_t bytesWritten =
            destination.write(
                buffer,
                static_cast<size_t>(bytesRead)
            );

        if (bytesWritten !=
            static_cast<size_t>(bytesRead))
        {
            succeeded = false;

            break;
        }
    }

    destination.flush();

    if (destination.getWriteError() != 0)
        succeeded = false;

    StorageManager::closeFile(source);

    StorageManager::closeFile(destination);

    if (!succeeded)
        removeIfExists(destinationPath);

    return succeeded;
}

bool quarantineFile(
    const String& sourcePath,
    const String& quarantinePath
)
{
    if (!StorageManager::exists(sourcePath))
        return true;

    if (!removeIfExists(quarantinePath))
        return false;

    return StorageManager::renameFile(
        sourcePath,
        quarantinePath
    );
}

bool writeDatabaseFile(
    const String& path,
    const char* header,
    uint16_t version,
    const AchievementInfo* items,
    uint16_t itemCount
)
{
    if (!removeIfExists(path))
        return false;

    File file =
        StorageManager::openFile(
            path,
            FILE_WRITE
        );

    if (!file)
        return false;

    uint16_t validCount = 0;

    for (uint16_t i = 0;
         i < itemCount;
         i++)
    {
        if (items[i].valid)
            validCount++;
    }

    file.println(header);
    file.println(version);
    file.println(validCount);

    for (uint16_t i = 0;
         i < itemCount;
         i++)
    {
        const AchievementInfo& achievement =
            items[i];

        if (!achievement.valid)
            continue;

        file.print("A|");

        file.print(
            encodeTextValue(achievement.id)
        );

        file.print('|');

        file.print(
            encodeTextValue(achievement.source)
        );

        file.print('|');

        file.print(
            encodeTextValue(achievement.title)
        );

        file.print('|');

        file.print(
            encodeTextValue(
                achievement.description
            )
        );

        file.print('|');

        file.print(
            static_cast<uint8_t>(
                achievement.category
            )
        );

        file.print('|');
        file.print(achievement.progress);
        file.print('|');
        file.print(achievement.target);
        file.print('|');
        file.print(achievement.unlockedAt);
        file.print('|');
        file.print(achievement.hidden ? 1 : 0);
        file.print('|');
        file.println(achievement.unlocked ? 1 : 0);
    }

    file.flush();

    bool succeeded =
        file.getWriteError() == 0;

    StorageManager::closeFile(file);

    if (!succeeded)
        removeIfExists(path);

    return succeeded;
}
}

AchievementInfo AchievementManager::achievements[
    AchievementManager::MAX_ACHIEVEMENTS
];

uint16_t AchievementManager::achievementCount = 0;

bool AchievementManager::initialized = false;

bool AchievementManager::dirty = false;

uint32_t AchievementManager::lastChangeTime = 0;

const char* AchievementManager::FILE_NAME =
    "achievements.db";

const char* AchievementManager::FILE_HEADER =
    "ESP32GS_ACHIEVEMENTS";

const uint16_t AchievementManager::FILE_VERSION = 1;

bool AchievementManager::begin()
{
    if (initialized)
        return true;

    clearMemory();

    if (!StorageManager::ready())
        return false;

    if (!load())
    {
        clearMemory();

        return false;
    }

    initialized = true;

    if (dirty)
        lastChangeTime = millis();

    return true;
}

void AchievementManager::update()
{
    if (!initialized || !dirty)
        return;

    if (millis() - lastChangeTime <
        AUTO_SAVE_DELAY)
    {
        return;
    }

    if (!save())
        lastChangeTime = millis();
}

bool AchievementManager::ready()
{
    return
        initialized &&
        StorageManager::ready();
}

bool AchievementManager::registerAchievement(
    const String& id,
    const String& source,
    const String& title,
    const String& description,
    uint32_t targetValue,
    AchievementCategory category,
    bool hidden
)
{
    if (!initialized ||
        !validID(id) ||
        !validSource(source) ||
        title.length() == 0 ||
        title.length() > 96 ||
        description.length() > 320 ||
        category > ACHIEVEMENT_SECRET)
    {
        return false;
    }

    if (targetValue == 0)
        targetValue = 1;

    int16_t existingIndex = find(id);

    if (existingIndex >= 0)
    {
        AchievementInfo& achievement =
            achievements[existingIndex];

        bool changed = false;

        if (achievement.source != source)
        {
            achievement.source = source;
            changed = true;
        }

        if (achievement.title != title)
        {
            achievement.title = title;
            changed = true;
        }

        if (achievement.description !=
            description)
        {
            achievement.description =
                description;

            changed = true;
        }

        if (achievement.category != category)
        {
            achievement.category = category;
            changed = true;
        }

        if (achievement.target != targetValue)
        {
            achievement.target = targetValue;
            changed = true;
        }

        if (achievement.hidden != hidden)
        {
            achievement.hidden = hidden;
            changed = true;
        }

        if (achievement.unlocked)
        {
            if (achievement.progress !=
                achievement.target)
            {
                achievement.progress =
                    achievement.target;

                changed = true;
            }
        }
        else
        {
            if (achievement.progress >
                achievement.target)
            {
                achievement.progress =
                    achievement.target;

                changed = true;
            }

            bool wasUnlocked =
                achievement.unlocked;

            evaluateUnlock(achievement);

            if (achievement.unlocked !=
                wasUnlocked)
            {
                changed = true;
            }
        }

        if (changed)
            markDirty();

        return true;
    }

    if (achievementCount >= MAX_ACHIEVEMENTS)
        return false;

    AchievementInfo achievement = emptyInfo();

    achievement.id = id;
    achievement.source = source;
    achievement.title = title;
    achievement.description = description;

    achievement.category = category;

    achievement.progress = 0;
    achievement.target = targetValue;
    achievement.unlockedAt = 0;

    achievement.hidden = hidden;
    achievement.unlocked = false;
    achievement.valid = true;

    achievements[achievementCount] =
        achievement;

    achievementCount++;

    markDirty();

    return true;
}
bool AchievementManager::setProgress(
    const String& id,
    uint32_t newProgress
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    AchievementInfo& achievement =
        achievements[index];

    if (achievement.unlocked)
        return true;

    if (newProgress > achievement.target)
        newProgress = achievement.target;

    if (achievement.progress == newProgress)
        return true;

    achievement.progress = newProgress;

    evaluateUnlock(achievement);

    markDirty();

    return true;
}

bool AchievementManager::addProgress(
    const String& id,
    uint32_t amount
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    AchievementInfo& achievement =
        achievements[index];

    if (achievement.unlocked || amount == 0)
        return true;

    uint64_t newProgress =
        static_cast<uint64_t>(
            achievement.progress
        ) + amount;

    if (newProgress > achievement.target)
        newProgress = achievement.target;

    achievement.progress =
        static_cast<uint32_t>(newProgress);

    evaluateUnlock(achievement);

    markDirty();

    return true;
}

bool AchievementManager::unlock(
    const String& id
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    AchievementInfo& achievement =
        achievements[index];

    if (achievement.unlocked)
        return true;

    achievement.progress =
        achievement.target;

    achievement.unlocked = true;

    achievement.unlockedAt =
        getTimestamp();

    if (achievement.unlockedAt == 0)
        achievement.unlockedAt = 1;

    markDirty();

    return true;
}

bool AchievementManager::reset(
    const String& id
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    AchievementInfo& achievement =
        achievements[index];

    if (achievement.progress == 0 &&
        !achievement.unlocked &&
        achievement.unlockedAt == 0)
    {
        return true;
    }

    achievement.progress = 0;
    achievement.unlockedAt = 0;
    achievement.unlocked = false;

    markDirty();

    return true;
}

void AchievementManager::resetAll()
{
    if (!initialized)
        return;

    bool changed = false;

    for (uint16_t i = 0;
         i < achievementCount;
         i++)
    {
        AchievementInfo& achievement =
            achievements[i];

        if (!achievement.valid)
            continue;

        if (achievement.progress != 0 ||
            achievement.unlocked ||
            achievement.unlockedAt != 0)
        {
            achievement.progress = 0;
            achievement.unlockedAt = 0;
            achievement.unlocked = false;

            changed = true;
        }
    }

    if (changed)
        markDirty();
}

bool AchievementManager::exists(
    const String& id
)
{
    return find(id) >= 0;
}

bool AchievementManager::isUnlocked(
    const String& id
)
{
    int16_t index = find(id);

    return
        index >= 0 &&
        achievements[index].unlocked;
}

bool AchievementManager::isHidden(
    const String& id
)
{
    int16_t index = find(id);

    return
        index >= 0 &&
        achievements[index].hidden;
}

uint32_t AchievementManager::progress(
    const String& id
)
{
    int16_t index = find(id);

    return
        index >= 0
            ? achievements[index].progress
            : 0;
}

uint32_t AchievementManager::target(
    const String& id
)
{
    int16_t index = find(id);

    return
        index >= 0
            ? achievements[index].target
            : 0;
}

uint8_t AchievementManager::completionPercent(
    const String& id
)
{
    int16_t index = find(id);

    if (index < 0)
        return 0;

    const AchievementInfo& achievement =
        achievements[index];

    if (achievement.target == 0)
        return 0;

    if (achievement.unlocked)
        return 100;

    uint64_t percent =
        static_cast<uint64_t>(
            achievement.progress
        ) * 100ULL;

    percent /= achievement.target;

    if (percent > 100)
        percent = 100;

    return static_cast<uint8_t>(percent);
}

uint16_t AchievementManager::count()
{
    return achievementCount;
}

uint16_t AchievementManager::unlockedCount()
{
    uint16_t result = 0;

    for (uint16_t i = 0;
         i < achievementCount;
         i++)
    {
        if (achievements[i].valid &&
            achievements[i].unlocked)
        {
            result++;
        }
    }

    return result;
}

uint16_t AchievementManager::countBySource(
    const String& source
)
{
    if (!validSource(source))
        return 0;

    uint16_t result = 0;

    for (uint16_t i = 0;
         i < achievementCount;
         i++)
    {
        if (achievements[i].valid &&
            achievements[i].source == source)
        {
            result++;
        }
    }

    return result;
}

uint16_t AchievementManager::unlockedCountBySource(
    const String& source
)
{
    if (!validSource(source))
        return 0;

    uint16_t result = 0;

    for (uint16_t i = 0;
         i < achievementCount;
         i++)
    {
        if (achievements[i].valid &&
            achievements[i].source == source &&
            achievements[i].unlocked)
        {
            result++;
        }
    }

    return result;
}

AchievementInfo AchievementManager::get(
    uint16_t index
)
{
    return validIndex(index)
        ? achievements[index]
        : emptyInfo();
}

AchievementInfo AchievementManager::get(
    const String& id
)
{
    int16_t index = find(id);

    return index >= 0
        ? achievements[index]
        : emptyInfo();
}

AchievementInfo AchievementManager::getBySource(
    const String& source,
    uint16_t index
)
{
    if (!validSource(source))
        return emptyInfo();

    uint16_t currentIndex = 0;

    for (uint16_t i = 0;
         i < achievementCount;
         i++)
    {
        if (!achievements[i].valid ||
            achievements[i].source != source)
        {
            continue;
        }

        if (currentIndex == index)
            return achievements[i];

        currentIndex++;
    }

    return emptyInfo();
}

int16_t AchievementManager::find(
    const String& id
)
{
    if (!validID(id))
        return -1;

    for (uint16_t i = 0;
         i < achievementCount;
         i++)
    {
        if (achievements[i].valid &&
            achievements[i].id == id)
        {
            return static_cast<int16_t>(i);
        }
    }

    return -1;
}

bool AchievementManager::load()
{
    if (!StorageManager::ready())
        return false;

    clearMemory();

    String mainPath = storagePath();

    String backupPath =
        mainPath + ".bak";

    String temporaryPath =
        mainPath + ".tmp";

    String oldPath =
        mainPath + ".old";

    String backupNewPath =
        backupPath + ".new";

    String backupOldPath =
        backupPath + ".old";

    String corruptMainPath =
        mainPath + ".corrupt";

    String corruptBackupPath =
        backupPath + ".corrupt";

    String corruptTemporaryPath =
        temporaryPath + ".corrupt";

    String corruptOldPath =
        oldPath + ".corrupt";

    bool mainExists =
        StorageManager::exists(mainPath);

    bool backupExists =
        StorageManager::exists(backupPath);

    bool temporaryExists =
        StorageManager::exists(temporaryPath);

    bool oldExists =
        StorageManager::exists(oldPath);

    uint16_t loadedCount = 0;

    bool repaired = false;

    uint32_t fallbackTimestamp =
        getTimestamp();

    if (mainExists &&
        loadDatabaseFile(
            mainPath,
            FILE_HEADER,
            FILE_VERSION,
            achievements,
            MAX_ACHIEVEMENTS,
            loadedCount,
            repaired,
            fallbackTimestamp
        ))
    {
        achievementCount = loadedCount;

        dirty = repaired;

        lastChangeTime =
            repaired
                ? millis()
                : 0;

        removeIfExists(temporaryPath);
        removeIfExists(oldPath);
        removeIfExists(backupNewPath);
        removeIfExists(backupOldPath);

        return true;
    }

    bool loadedRecovery = false;

    String recoveryPath;

    bool recoveryRepaired = false;

    if (mainExists)
    {
        if (backupExists &&
            loadDatabaseFile(
                backupPath,
                FILE_HEADER,
                FILE_VERSION,
                achievements,
                MAX_ACHIEVEMENTS,
                loadedCount,
                recoveryRepaired,
                fallbackTimestamp
            ))
        {
            loadedRecovery = true;
            recoveryPath = backupPath;
        }
        else if (temporaryExists &&
                 loadDatabaseFile(
                     temporaryPath,
                     FILE_HEADER,
                     FILE_VERSION,
                     achievements,
                     MAX_ACHIEVEMENTS,
                     loadedCount,
                     recoveryRepaired,
                     fallbackTimestamp
                 ))
        {
            loadedRecovery = true;
            recoveryPath = temporaryPath;
        }
        else if (oldExists &&
                 loadDatabaseFile(
                     oldPath,
                     FILE_HEADER,
                     FILE_VERSION,
                     achievements,
                     MAX_ACHIEVEMENTS,
                     loadedCount,
                     recoveryRepaired,
                     fallbackTimestamp
                 ))
        {
            loadedRecovery = true;
            recoveryPath = oldPath;
        }
    }
    else
    {
        if (temporaryExists &&
            loadDatabaseFile(
                temporaryPath,
                FILE_HEADER,
                FILE_VERSION,
                achievements,
                MAX_ACHIEVEMENTS,
                loadedCount,
                recoveryRepaired,
                fallbackTimestamp
            ))
        {
            loadedRecovery = true;
            recoveryPath = temporaryPath;
        }
        else if (oldExists &&
                 loadDatabaseFile(
                     oldPath,
                     FILE_HEADER,
                     FILE_VERSION,
                     achievements,
                     MAX_ACHIEVEMENTS,
                     loadedCount,
                     recoveryRepaired,
                     fallbackTimestamp
                 ))
        {
            loadedRecovery = true;
            recoveryPath = oldPath;
        }
        else if (backupExists &&
                 loadDatabaseFile(
                     backupPath,
                     FILE_HEADER,
                     FILE_VERSION,
                     achievements,
                     MAX_ACHIEVEMENTS,
                     loadedCount,
                     recoveryRepaired,
                     fallbackTimestamp
                 ))
        {
            loadedRecovery = true;
            recoveryPath = backupPath;
        }
    }

    if (loadedRecovery)
    {
        achievementCount = loadedCount;

        if (mainExists)
        {
            quarantineFile(
                mainPath,
                corruptMainPath
            );
        }

        bool restored =
            copyFileContents(
                recoveryPath,
                mainPath
            );

        if (restored)
        {
            if (recoveryPath ==
                temporaryPath)
            {
                removeIfExists(temporaryPath);
            }

            if (recoveryPath == oldPath)
                removeIfExists(oldPath);
        }

        dirty =
            recoveryRepaired ||
            !restored;

        lastChangeTime =
            dirty
                ? millis()
                : 0;

        removeIfExists(backupNewPath);
        removeIfExists(backupOldPath);

        return true;
    }

    if (mainExists)
    {
        quarantineFile(
            mainPath,
            corruptMainPath
        );
    }

    if (backupExists)
    {
        quarantineFile(
            backupPath,
            corruptBackupPath
        );
    }

    if (temporaryExists)
    {
        quarantineFile(
            temporaryPath,
            corruptTemporaryPath
        );
    }

    if (oldExists)
    {
        quarantineFile(
            oldPath,
            corruptOldPath
        );
    }

    removeIfExists(backupNewPath);
    removeIfExists(backupOldPath);

    clearMemory();

    dirty = true;

    lastChangeTime = millis();

    return true;
}
bool AchievementManager::save()
{
    if (!initialized ||
        !StorageManager::ready())
    {
        return false;
    }

    if (!StorageManager::createDirectory(
            StorageManager::configPath()
        ))
    {
        return false;
    }

    String mainPath = storagePath();

    String temporaryPath =
        mainPath + ".tmp";

    String oldPath =
        mainPath + ".old";

    String backupPath =
        mainPath + ".bak";

    String backupNewPath =
        backupPath + ".new";

    String backupOldPath =
        backupPath + ".old";

    if (!removeIfExists(temporaryPath) ||
        !removeIfExists(oldPath) ||
        !removeIfExists(backupNewPath) ||
        !removeIfExists(backupOldPath))
    {
        return false;
    }

    if (!writeDatabaseFile(
            temporaryPath,
            FILE_HEADER,
            FILE_VERSION,
            achievements,
            achievementCount
        ))
    {
        return false;
    }

    uint16_t verifiedCount = 0;

    bool verificationRepair = false;

    if (!loadDatabaseFile(
            temporaryPath,
            FILE_HEADER,
            FILE_VERSION,
            nullptr,
            MAX_ACHIEVEMENTS,
            verifiedCount,
            verificationRepair,
            getTimestamp()
        ) ||
        verificationRepair ||
        verifiedCount != achievementCount)
    {
        removeIfExists(temporaryPath);

        return false;
    }

    bool hadMain =
        StorageManager::exists(mainPath);

    if (hadMain &&
        !StorageManager::renameFile(
            mainPath,
            oldPath
        ))
    {
        removeIfExists(temporaryPath);

        return false;
    }

    if (!StorageManager::renameFile(
            temporaryPath,
            mainPath
        ))
    {
        if (hadMain &&
            StorageManager::exists(oldPath))
        {
            StorageManager::renameFile(
                oldPath,
                mainPath
            );
        }

        removeIfExists(temporaryPath);

        return false;
    }

    bool backupUpdated = false;

    if (copyFileContents(
            mainPath,
            backupNewPath
        ))
    {
        uint16_t backupVerifiedCount = 0;

        bool backupVerificationRepair = false;

        bool backupNewValid =
            loadDatabaseFile(
                backupNewPath,
                FILE_HEADER,
                FILE_VERSION,
                nullptr,
                MAX_ACHIEVEMENTS,
                backupVerifiedCount,
                backupVerificationRepair,
                getTimestamp()
            ) &&
            !backupVerificationRepair &&
            backupVerifiedCount ==
                achievementCount;

        if (backupNewValid)
        {
            bool hadBackup =
                StorageManager::exists(
                    backupPath
                );

            bool movedOldBackup = true;

            if (hadBackup)
            {
                movedOldBackup =
                    StorageManager::renameFile(
                        backupPath,
                        backupOldPath
                    );
            }

            if (movedOldBackup &&
                StorageManager::renameFile(
                    backupNewPath,
                    backupPath
                ))
            {
                backupUpdated = true;

                removeIfExists(
                    backupOldPath
                );
            }
            else
            {
                removeIfExists(
                    backupNewPath
                );

                if (StorageManager::exists(
                        backupOldPath
                    ) &&
                    !StorageManager::exists(
                        backupPath
                    ))
                {
                    StorageManager::renameFile(
                        backupOldPath,
                        backupPath
                    );
                }
            }
        }
        else
        {
            removeIfExists(backupNewPath);
        }
    }

    if (!backupUpdated &&
        !StorageManager::exists(backupPath) &&
        hadMain &&
        StorageManager::exists(oldPath))
    {
        StorageManager::renameFile(
            oldPath,
            backupPath
        );
    }
    else
    {
        removeIfExists(oldPath);
    }

    dirty = false;
    lastChangeTime = 0;

    return true;
}

