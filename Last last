bool deleteStoredProfile(
    uint16_t profileID
)
{
    int8_t index =
        findProfileIndexPosition(
            profileID
        );


    if(index < 0)
    {
        profileStorageStatus =
            PROFILE_STORAGE_PROFILE_NOT_FOUND;


        return false;
    }


    char profilePath[
        PROFILE_FILE_PATH_LENGTH
    ];


    char backupPath[
        PROFILE_FILE_PATH_LENGTH
    ];


    buildProfileFilePath(
        profileID,
        profilePath,
        sizeof(profilePath)
    );


    buildProfileBackupPath(
        profileID,
        backupPath,
        sizeof(backupPath)
    );


    if(SD.exists(
        profilePath
    ))
    {
        if(!SD.remove(
            profilePath
        ))
        {
            profileStorageStatus =
                PROFILE_STORAGE_DELETE_ERROR;


            return false;
        }
    }


    if(SD.exists(
        backupPath
    ))
    {
        SD.remove(
            backupPath
        );
    }


    for(uint8_t i = index;
        i + 1 < profileIndexCount;
        i++)
    {
        profileIndex[i] =
            profileIndex[i + 1];
    }


    if(profileIndexCount > 0)
    {
        profileIndexCount--;


        clearProfileIndexEntry(
            profileIndex[
                profileIndexCount
            ]
        );
    }


    if(isPlayerProfileInitialized() &&
       getPlayerProfileID() == profileID)
    {
        resetPlayerProfile();
    }


    if(!saveProfileIndex())
    {
        return false;
    }


    profileStorageStatus =
        PROFILE_STORAGE_READY;


    return true;
}



