//---------------- Date Time Write ----------------

bool setRTCDateTime(
    uint16_t year,
    uint8_t month,
    uint8_t day,
    uint8_t hour,
    uint8_t minute,
    uint8_t second
)
{
    if(!rtcInitialized ||
       !rtcAvailable)
    {
        return false;
    }


    if(!isRTCDateValid(
        year,
        month,
        day
    ))
    {
        return false;
    }


    if(!isRTCTimeValid(
        hour,
        minute,
        second
    ))
    {
