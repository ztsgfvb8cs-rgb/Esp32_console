StatisticInfo StatisticsManager::getBySource(
    const String& source,
    uint16_t index
)
{
    if (!validSource(source))
        return emptyInfo();

    uint16_t currentIndex = 0;

    for (uint16_t i = 0;
         i < statisticCount;
         i++)
    {
        if (!statistics[i].valid ||
            statistics[i].source != source)
        {
            continue;
        }

        if (currentIndex == index)
            return statistics[i];

        currentIndex++;
    }

    return emptyInfo();
}

int16_t StatisticsManager::find(
    const String& id
)
{
    if (!validID(id))
        return -1;

    for (uint16_t i = 0;
         i < statisticCount;
         i++)
    {
        if (statistics[i].valid &&
            statistics[i].id == id)
        {
            return static_cast<int16_t>(i);
        }
    }

    return -1;
}
bool StatisticsManager::load()
{
    if (!StorageManager::ready())
        return false;

    clearMemory();

    String mainPath = storagePath();
    String backupPath = mainPath + ".bak";
    String temporaryPath = mainPath + ".tmp";
    String oldPath = mainPath + ".old";

    String backupNewPath =
        backupPath + ".new";

    String backupOldPath =
        backupPath + ".old";

    String corruptMainPath =
        mainPath + ".corrupt";

    String corruptBackupPath =
        backupPath + ".corrupt";

    String corruptTemporaryPath =
        temporaryPath + ".corrupt";

    String corruptOldPath =
        oldPath + ".corrupt";

    bool mainExists =
        StorageManager::exists(mainPath);

    bool backupExists =
        StorageManager::exists(backupPath);

    bool temporaryExists =
        StorageManager::exists(temporaryPath);

    bool oldExists =
        StorageManager::exists(oldPath);

    uint16_t loadedCount = 0;
    bool repaired = false;

    if (mainExists &&
        loadStatisticsDatabase(
            mainPath,
            FILE_HEADER,
            FILE_VERSION,
            statistics,
            MAX_STATISTICS,
            loadedCount,
            repaired
        ))
    {
        statisticCount = loadedCount;
        dirty = repaired;

        lastChangeTime =
            repaired
                ? millis()
                : 0;

        removeIfExists(temporaryPath);
        removeIfExists(oldPath);
        removeIfExists(backupNewPath);
        removeIfExists(backupOldPath);

        return true;
    }

    bool loadedRecovery = false;
    bool recoveryRepaired = false;
    String recoveryPath = "";

    if (backupExists &&
        loadStatisticsDatabase(
            backupPath,
            FILE_HEADER,
            FILE_VERSION,
            statistics,
            MAX_STATISTICS,
            loadedCount,
            recoveryRepaired
        ))
    {
        loadedRecovery = true;
        recoveryPath = backupPath;
    }
    else if (temporaryExists &&
             loadStatisticsDatabase(
                 temporaryPath,
                 FILE_HEADER,
                 FILE_VERSION,
                 statistics,
                 MAX_STATISTICS,
                 loadedCount,
                 recoveryRepaired
             ))
    {
        loadedRecovery = true;
        recoveryPath = temporaryPath;
    }
    else if (oldExists &&
             loadStatisticsDatabase(
                 oldPath,
                 FILE_HEADER,
                 FILE_VERSION,
                 statistics,
                 MAX_STATISTICS,
                 loadedCount,
                 recoveryRepaired
             ))
    {
        loadedRecovery = true;
        recoveryPath = oldPath;
    }

    if (loadedRecovery)
    {
        statisticCount = loadedCount;

        if (mainExists)
        {
            quarantineFile(
                mainPath,
                corruptMainPath
            );
        }

        bool restored =
            copyFileContents(
                recoveryPath,
                mainPath
            );

        if (restored)
        {
            if (recoveryPath ==
                temporaryPath)
            {
                removeIfExists(temporaryPath);
            }

            if (recoveryPath == oldPath)
                removeIfExists(oldPath);
        }

        dirty =
            recoveryRepaired ||
            !restored;

        lastChangeTime =
            dirty
                ? millis()
                : 0;

        removeIfExists(backupNewPath);
        removeIfExists(backupOldPath);

        return true;
    }

    if (mainExists)
    {
        quarantineFile(
            mainPath,
            corruptMainPath
        );
    }

    if (backupExists)
    {
        quarantineFile(
            backupPath,
            corruptBackupPath
        );
    }

    if (temporaryExists)
    {
        quarantineFile(
            temporaryPath,
            corruptTemporaryPath
        );
    }

    if (oldExists)
    {
        quarantineFile(
            oldPath,
            corruptOldPath
        );
    }

    removeIfExists(backupNewPath);
    removeIfExists(backupOldPath);

    clearMemory();

    dirty = true;
    lastChangeTime = millis();

    return true;
}

bool StatisticsManager::save()
{
    if (!initialized ||
        !StorageManager::ready())
    {
        return false;
    }

    if (!StorageManager::createDirectory(
            StorageManager::configPath()
        ))
    {
        return false;
    }

    String mainPath = storagePath();
    String temporaryPath = mainPath + ".tmp";
    String oldPath = mainPath + ".old";
    String backupPath = mainPath + ".bak";

    String backupNewPath =
        backupPath + ".new";

    String backupOldPath =
        backupPath + ".old";

    if (!removeIfExists(temporaryPath) ||
        !removeIfExists(oldPath) ||
        !removeIfExists(backupNewPath) ||
        !removeIfExists(backupOldPath))
    {
        return false;
    }

    if (!writeStatisticsDatabase(
            temporaryPath,
            FILE_HEADER,
            FILE_VERSION,
            statistics,
            statisticCount
        ))
    {
        return false;
    }

    uint16_t expectedCount =
        persistentStatisticCount(
            statistics,
            statisticCount
        );

    uint16_t verifiedCount = 0;
    bool verificationRepair = false;

    if (!loadStatisticsDatabase(
            temporaryPath,
            FILE_HEADER,
            FILE_VERSION,
            nullptr,
            MAX_STATISTICS,
            verifiedCount,
            verificationRepair
        ) ||
        verificationRepair ||
        verifiedCount != expectedCount)
    {
        removeIfExists(temporaryPath);
        return false;
    }

    bool hadMain =
        StorageManager::exists(mainPath);

    if (hadMain &&
        !StorageManager::renameFile(
            mainPath,
            oldPath
        ))
    {
        removeIfExists(temporaryPath);
        return false;
    }

    if (!StorageManager::renameFile(
            temporaryPath,
            mainPath
        ))
    {
        if (hadMain &&
            StorageManager::exists(oldPath))
        {
            StorageManager::renameFile(
                oldPath,
                mainPath
            );
        }

        removeIfExists(temporaryPath);
        return false;
    }

    uint16_t mainVerifiedCount = 0;
    bool mainVerificationRepair = false;

    bool mainValid =
        loadStatisticsDatabase(
            mainPath,
            FILE_HEADER,
            FILE_VERSION,
            nullptr,
            MAX_STATISTICS,
            mainVerifiedCount,
            mainVerificationRepair
        ) &&
        !mainVerificationRepair &&
        mainVerifiedCount == expectedCount;

    if (!mainValid)
    {
        removeIfExists(mainPath);

        if (hadMain &&
            StorageManager::exists(oldPath))
        {
            StorageManager::renameFile(
                oldPath,
                mainPath
            );
        }

        return false;
    }

    String backupSource =
        hadMain &&
        StorageManager::exists(oldPath)
            ? oldPath
            : mainPath;

    bool backupUpdated = false;

    if (copyFileContents(
            backupSource,
            backupNewPath
        ))
    {
        uint16_t backupVerifiedCount = 0;
        bool backupVerificationRepair = false;

        bool backupNewValid =
            loadStatisticsDatabase(
                backupNewPath,
                FILE_HEADER,
                FILE_VERSION,
                nullptr,
                MAX_STATISTICS,
                backupVerifiedCount,
                backupVerificationRepair
            ) &&
            !backupVerificationRepair;

        if (backupNewValid)
        {
            bool hadBackup =
                StorageManager::exists(
                    backupPath
                );

            bool movedOldBackup = true;

            if (hadBackup)
            {
                movedOldBackup =
                    StorageManager::renameFile(
                        backupPath,
                        backupOldPath
                    );
            }

            if (movedOldBackup &&
                StorageManager::renameFile(
                    backupNewPath,
                    backupPath
                ))
            {
                backupUpdated = true;
                removeIfExists(backupOldPath);
            }
            else
            {
                removeIfExists(backupNewPath);

                if (StorageManager::exists(
                        backupOldPath
                    ) &&
                    !StorageManager::exists(
                        backupPath
                    ))
                {
                    StorageManager::renameFile(
                        backupOldPath,
                        backupPath
                    );
                }
            }
        }
        else
        {
            removeIfExists(backupNewPath);
        }
    }

    if (!backupUpdated &&
        !StorageManager::exists(backupPath))
    {
        if (copyFileContents(
                mainPath,
                backupPath
            ))
        {
            uint16_t fallbackBackupCount = 0;
            bool fallbackBackupRepair = false;

            bool fallbackBackupValid =
                loadStatisticsDatabase(
                    backupPath,
                    FILE_HEADER,
                    FILE_VERSION,
                    nullptr,
                    MAX_STATISTICS,
                    fallbackBackupCount,
                    fallbackBackupRepair
                ) &&
                !fallbackBackupRepair &&
                fallbackBackupCount ==
                    expectedCount;

            if (!fallbackBackupValid)
                removeIfExists(backupPath);
        }
    }

    removeIfExists(oldPath);
    removeIfExists(backupNewPath);
    removeIfExists(backupOldPath);

    dirty = false;
    lastChangeTime = 0;

    return true;
}

