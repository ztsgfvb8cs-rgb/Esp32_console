void SystemMonitorManager::reset()
{
    if (!initialized)
        return;

    uint16_t preservedTargetFPS =
        currentSnapshot.targetFPS;

    currentSnapshot = emptySnapshot();

    currentSnapshot.targetFPS =
        preservedTargetFPS;

    storageStatusOverridden = false;

    resetFrameStatistics();

    uint32_t now = millis();

    lastUpdateTime = now;

    collectRuntimeInformation();
    updateStorageValues();

    currentSnapshot.uptimeMilliseconds =
        extendedUptimeMilliseconds();

    currentSnapshot.sampledAt = now;
    currentSnapshot.valid = true;

    updateWarningValues();
    updateHealthLevel();
}


void SystemMonitorManager::recordFrame(
    uint32_t frameTimeMicroseconds
)
{
    if (!initialized)
        return;

    updateFrameWindow(millis());

    uint32_t measuredFrameTime =
        frameTimeMicroseconds;

    uint32_t currentMicros = micros();

    if (measuredFrameTime == 0)
    {
        if (previousFrameTimeValid)
        {
            measuredFrameTime =
                currentMicros - previousFrameMicros;
        }

        previousFrameMicros = currentMicros;
        previousFrameTimeValid = true;
    }
    else
    {
        previousFrameMicros = currentMicros;
        previousFrameTimeValid = true;
    }

    if (measuredFrameTime == 0)
        return;

    if (frameCount < 0xFFFFFFFFUL)
        frameCount++;

    lastFrameMicroseconds = measuredFrameTime;

    if (frameTimeTotalMicroseconds >
        0xFFFFFFFFFFFFFFFFULL -
        measuredFrameTime)
    {
        frameTimeTotalMicroseconds =
            0xFFFFFFFFFFFFFFFFULL;
    }
    else
    {
        frameTimeTotalMicroseconds +=
            measuredFrameTime;
    }

    if (measuredFrameTime >
        longestFrameMicroseconds)
    {
        longestFrameMicroseconds =
            measuredFrameTime;
    }

    currentSnapshot.lastFrameMilliseconds =
        static_cast<float>(
            measuredFrameTime
        ) / 1000.0f;
}


void SystemMonitorManager::resetFrameStatistics()
{
    frameWindowStart = millis();

    frameCount = 0;
    frameTimeTotalMicroseconds = 0;
    longestFrameMicroseconds = 0;
    lastFrameMicroseconds = 0;

    previousFrameMicros = micros();
    previousFrameTimeValid = false;

    frameMeasurementValid = false;

    currentSnapshot.framesPerSecond = 0.0f;
    currentSnapshot.averageFrameMilliseconds = 0.0f;
    currentSnapshot.lastFrameMilliseconds = 0.0f;
    currentSnapshot.longestFrameMilliseconds = 0.0f;
    currentSnapshot.performanceWarning = false;
}


