void RuntimeSessionBridge::synchronizeRuntimeStatus()
{
    if (!RuntimeModuleManager::ready())
    {
        currentStatus_.moduleKind = RuntimeModuleKind::None;
        currentStatus_.moduleState = RuntimeModuleState::Stopped;
        currentStatus_.moduleError =
            RuntimeModuleError::NotInitialized;
        currentStatus_.engine = EngineKind::None;
        return;
    }

    const RuntimeModuleStatus runtimeStatus =
        RuntimeModuleManager::status();

    currentStatus_.moduleKind = runtimeStatus.kind;
    currentStatus_.moduleState = runtimeStatus.state;
    currentStatus_.moduleError = runtimeStatus.error;

    if (runtimeStatus.foregroundActive)
    {
        currentStatus_.engine = runtimeStatus.engine;
    }
}

RuntimeResult RuntimeSessionBridge::finishClose(
    RuntimeSessionExitReason reason,
    bool navigateAfterClose)
{
    const AppScreen destination =
        activeOptions_.returnScreen;

    const bool shouldNavigate =
        navigateAfterClose &&
        activeOptions_.navigateOnClose &&
        validReturnScreen(destination);

    RuntimeResult closeResult = RuntimeResult::Ok;

    if (RuntimeModuleManager::foregroundActive() ||
        RuntimeModuleManager::state() ==
            RuntimeModuleState::Failed)
    {
        closeResult =
            RuntimeModuleManager::closeForeground();
    }

    synchronizeRuntimeStatus();

    if (closeResult != RuntimeResult::Ok)
    {
        currentStatus_.error =
            RuntimeSessionError::CloseFailed;
        currentStatus_.lastResult = closeResult;
        currentStatus_.exitReason = reason;
        currentStatus_.closeRequested = false;
        pendingExitReason_ = RuntimeSessionExitReason::None;

        Logger::error(
            LogSource::Application,
            "SESSION",
            "Foreground session close failed");

        notifyStateChanged();
        return closeResult;
    }

    StateStore::setEngine(EngineKind::None);

    currentStatus_.active = false;
    currentStatus_.closeRequested = false;
    currentStatus_.navigationPending = false;
    currentStatus_.exitReason = reason;
    currentStatus_.error = RuntimeSessionError::None;
    currentStatus_.lastResult = RuntimeResult::Ok;
    currentStatus_.moduleKind = RuntimeModuleKind::None;
    currentStatus_.moduleState = RuntimeModuleState::Stopped;
    currentStatus_.moduleError = RuntimeModuleError::None;
    currentStatus_.engine = EngineKind::None;
    currentStatus_.closedAtMs = millis();

    activeContent_ = {};
    pendingExitReason_ = RuntimeSessionExitReason::None;
114 — Bölüm 3/3
    if (shouldNavigate)
    {
        navigateTo(destination);

        if (ScreenManager::current() != destination)
        {
            currentStatus_.error =
                RuntimeSessionError::NavigationFailed;
            currentStatus_.lastResult =
                RuntimeResult::InternalError;

            Logger::error(
                LogSource::Application,
                "SESSION",
                "Return-screen navigation failed");

            notifyStateChanged();
            return RuntimeResult::InternalError;
        }
    }

    activeOptions_ = {};

    Logger::info(
        LogSource::Application,
        "SESSION",
        "Foreground session closed");

    notifyStateChanged();
    return RuntimeResult::Ok;
}

