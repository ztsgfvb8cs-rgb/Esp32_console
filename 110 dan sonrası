RuntimeResult RuntimeOrchestrator::requestShutdown(
    ShutdownReason reason,
    uint32_t nowMs)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeOrchestratorStage::Shutdown,
            RuntimeOrchestratorError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (reason == ShutdownReason::None)
    {
        return fail(
            RuntimeOrchestratorStage::Shutdown,
            RuntimeOrchestratorError::
                ShutdownRequestFailed,
            RuntimeResult::InvalidArgument);
    }

    if (currentStatus_.shutdownPending ||
        RuntimePowerCoordinator::shutdownPending())
    {
        synchronizeStatus();

        return RuntimeResult::Busy;
    }

    if (nowMs == 0)
    {
        nowMs = millis();
    }

    if (policy_.closeForegroundBeforeShutdown)
    {
        RuntimeResult closeResult =
            RuntimeResult::Ok;

        if (RuntimeSessionBridge::ready() &&
            RuntimeSessionBridge::sessionActive())
        {
            closeResult =
                RuntimeSessionBridge::
                    closeImmediately(
                        RuntimeSessionExitReason::
                            Shutdown,
                        false);
        }
        else if (
            RuntimeModuleManager::ready() &&
            (RuntimeModuleManager::
                 foregroundActive() ||
             RuntimeModuleManager::state() ==
                 RuntimeModuleState::Failed))
        {
            closeResult =
                RuntimeModuleManager::
                    closeForeground();
        }

        if (closeResult != RuntimeResult::Ok)
        {
            return fail(
                RuntimeOrchestratorStage::Shutdown,
                RuntimeOrchestratorError::
                    ForegroundCloseFailed,
                closeResult);
        }
    }

    RuntimeInputRouter::resetAllActions();

    const RuntimeResult result =
        RuntimePowerCoordinator::requestShutdown(
            reason,
            nowMs);

    if (result != RuntimeResult::Ok)
    {
        return fail(
            RuntimeOrchestratorStage::Shutdown,
            RuntimeOrchestratorError::
                ShutdownRequestFailed,
            result);
    }

    currentStatus_.shutdownPending = true;
    currentStatus_.shutdownReason = reason;

    currentStatus_.lastResult =
        RuntimeResult::Ok;

    transitionTo(
        RuntimeOrchestratorState::ShutdownPending,
        RuntimeOrchestratorStage::Shutdown);

    synchronizeStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

