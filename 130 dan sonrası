inline constexpr size_t MEMORY_ARENA_MINIMUM_CAPACITY_BYTES = 256U;

inline constexpr size_t MEMORY_ARENA_MAXIMUM_ALIGNMENT_BYTES = 64U;

inline constexpr size_t MEMORY_ARENA_DEFAULT_ALIGNMENT =
    alignof(max_align_t);

enum class MemoryArenaClearMode : uint8_t
{
    Preserve = 0,
    Clear
};

enum class MemoryArenaError : uint8_t
{
    None = 0,
    AlreadyInitialized,
    NotInitialized,
    InvalidCapacity,
    InvalidAlignment,
    BackingAllocationFailed,
    OutOfSpace,
    InvalidMarker,
    ForeignPointer
};

struct MemoryArenaConfig
{
    size_t capacityBytes = 0;

    MemoryPreference preference =
        MemoryPreference::PsramPreferred;

    size_t defaultAlignment =
        MEMORY_ARENA_DEFAULT_ALIGNMENT;

    // Clears the full backing block once when begin() succeeds.
    bool clearBackingStore = true;

    // Clears each returned allocation. Disable this for large streaming
    // buffers that are guaranteed to be completely overwritten.
    bool clearAllocations = true;
};

struct MemoryArenaMarker
{
    size_t offset = 0;
    uint32_t generation = 0;
};

struct MemoryArenaStatus
{
    bool initialized = false;
    bool psram = false;

    MemoryPreference preference =
        MemoryPreference::PsramPreferred;

    MemoryArenaError error =
        MemoryArenaError::None;

    size_t capacityBytes = 0;
    size_t usedBytes = 0;
    size_t remainingBytes = 0;
    size_t peakUsedBytes = 0;
    size_t largestAllocationBytes = 0;

    size_t defaultAlignment =
        MEMORY_ARENA_DEFAULT_ALIGNMENT;

    uint32_t allocationCount = 0;
    uint32_t failedAllocationCount = 0;
    uint32_t rewindCount = 0;
    uint32_t resetCount = 0;
    uint32_t generation = 0;
};

class MemoryArena final
{
public:
    MemoryArena() = default;
    ~MemoryArena();

    MemoryArena(const MemoryArena&) = delete;

    MemoryArena& operator=(
        const MemoryArena&) = delete;

    MemoryArena(
        MemoryArena&& other) noexcept;

    MemoryArena& operator=(
        MemoryArena&& other) noexcept;

    //================================================
    // LIFECYCLE
    //================================================

    RuntimeResult begin(
        const MemoryArenaConfig& config);

    RuntimeResult begin(
        size_t capacityBytes,
        MemoryPreference preference =
            MemoryPreference::PsramPreferred,
        bool clearBackingStore = true);

    void end();

    bool ready() const;

    MemoryArenaStatus status() const;

    //================================================
    // LINEAR ALLOCATION
    //================================================

    void* allocate(
        size_t sizeBytes,
        size_t alignment = 0,
        MemoryArenaClearMode clearMode =
            MemoryArenaClearMode::Preserve);

    // Uses the config's clearAllocations preference.
    void* allocateDefault(
        size_t sizeBytes,
        size_t alignment = 0);

    //================================================
    // MARKERS, REWIND AND RESET
    //================================================

    MemoryArenaMarker marker() const;

    RuntimeResult rewind(
        const MemoryArenaMarker& marker,
        MemoryArenaClearMode clearReleasedMemory =
            MemoryArenaClearMode::Preserve);

    RuntimeResult reset(
        MemoryArenaClearMode clearMemory =
            MemoryArenaClearMode::Preserve);

    //================================================
    // OWNERSHIP AND METRICS
    //================================================

    bool contains(
        const void* pointer) const;

    size_t capacity() const;
    size_t used() const;
    size_t remaining() const;
    size_t peakUsed() const;

    bool usingPsram() const;

    MemoryArenaError lastError() const;

    void clearError();

    static bool validAlignment(
        size_t alignment);

    static const char* errorText(
        MemoryArenaError value);

private:
    MemoryBlock backing_ = {};

    MemoryArenaConfig config_ = {};

    MemoryArenaStatus status_ = {};

    size_t offset_ = 0;

    static bool addWouldOverflow(
        size_t first,
        size_t second);

    static bool alignOffset(
        size_t offset,
        size_t alignment,
        size_t* alignedOffset);

    RuntimeResult setError(
        MemoryArenaError error,
        RuntimeResult result);

    void moveFrom(
        MemoryArena& other) noexcept;
};

static_assert(
    MEMORY_ARENA_MINIMUM_CAPACITY_BYTES > 0U,
    "Memory arena minimum capacity must be positive");

static_assert(
    MEMORY_ARENA_DEFAULT_ALIGNMENT > 0U,
    "Memory arena default alignment must be positive");

static_assert(
    (MEMORY_ARENA_DEFAULT_ALIGNMENT &
     (MEMORY_ARENA_DEFAULT_ALIGNMENT - 1U)) == 0U,
    "Memory arena default alignment must be a power of two");

static_assert(
    MEMORY_ARENA_DEFAULT_ALIGNMENT <=
        MEMORY_ARENA_MAXIMUM_ALIGNMENT_BYTES,
    "Memory arena default alignment exceeds supported maximum");
}
