RuntimeResult WavDecoder::open(
    const char* pathValue,
    const WavDecoderConfig& config)
{
    if (status_.open || stream_)
    {
        return setError(
            WavDecoderError::AlreadyOpen,
            RuntimeResult::Busy);
    }

    if (!validConfig(config))
    {
        return setError(
            WavDecoderError::
                InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    const size_t pathLength =
        boundedStringLength(
            pathValue,
            WAV_DECODER_PATH_CAPACITY);

    if (pathValue == nullptr ||
        pathLength == 0U ||
        pathLength >=
            WAV_DECODER_PATH_CAPACITY)
    {
        return setError(
            WavDecoderError::InvalidPath,
            RuntimeResult::InvalidArgument);
    }

    if (!SdStreamService::ready())
    {
        return setError(
            WavDecoderError::
                StreamServiceNotReady,
            RuntimeResult::NotReady);
    }

    SdStreamOpenOptions options;

    options.purpose =
        SdStreamPurpose::Audio;

    options.bufferCapacityBytes =
        config.sourceBufferCapacityBytes;

    options.bufferPreference =
        config.sourceBufferPreference;

    options.readChunkBytes =
        config.sourceReadChunkBytes;

    options.refillThresholdBytes =
        config.sourceRefillThresholdBytes;

    options.initialPrefetchBytes =
        config.sourceInitialPrefetchBytes;

    options.startOffsetBytes = 0U;

    options.retryLimit =
        config.sourceRetryLimit;

    options.retryDelayMs =
        config.sourceRetryDelayMs;

    options.allowPartialReads = true;

    options.clearBufferOnClose =
        config.clearSourceBufferOnClose;

    options.automaticallyPrefetch = true;
    options.pauseAtEndOfFile = false;

    SdStreamHandle openedStream;

    const RuntimeResult openResult =
        SdStreamService::open(
            pathValue,
            openedStream,
            options);

    if (openResult != RuntimeResult::Ok)
    {
        return setError(
            WavDecoderError::OpenFailed,
            openResult);
    }

    const uint32_t generation =
        nextGeneration(
            status_.generation);

    config_ = config;
    status_ = {};
    stream_ = openedStream;

    headerPhase_ =
        HeaderPhase::RiffHeader;

    memset(
        currentChunkId_,
        0,
        sizeof(currentChunkId_));

    currentChunkSize_ = 0U;
    currentChunkPayloadOffset_ = 0U;
    currentChunkBytesRemaining_ = 0U;
    currentChunkPaddingBytes_ = 0U;

    formatChunkFound_ = false;
    dataChunkFound_ = false;

    memset(
        headerScratch_,
        0,
        sizeof(headerScratch_));

    memset(
        sourceFrameScratch_,
        0,
        sizeof(sourceFrameScratch_));

    status_.open = true;

    status_.state =
        WavDecoderState::ParsingHeader;

    status_.error =
        WavDecoderError::None;

    status_.fileSizeBytes =
        SdStreamService::fileSize(
            stream_);

    status_.generation =
        generation;

    memcpy(
        status_.path,
        pathValue,
        pathLength);

    status_.path[pathLength] = '\0';

    notifyStateChanged();

    return RuntimeResult::Ok;
}

void WavDecoder::close()
{
    const uint32_t generation =
        nextGeneration(
            status_.generation);

    if (stream_)
    {
        SdStreamService::close(
            stream_);
    }

    config_ = {};
    status_ = {};

    status_.generation =
        generation;

    status_.state =
        WavDecoderState::Closed;

    stream_ = {};

    headerPhase_ =
        HeaderPhase::RiffHeader;

    memset(
        currentChunkId_,
        0,
        sizeof(currentChunkId_));

    currentChunkSize_ = 0U;
    currentChunkPayloadOffset_ = 0U;
    currentChunkBytesRemaining_ = 0U;
    currentChunkPaddingBytes_ = 0U;

    formatChunkFound_ = false;
    dataChunkFound_ = false;

    memset(
        headerScratch_,
        0,
        sizeof(headerScratch_));

    memset(
        sourceFrameScratch_,
        0,
        sizeof(sourceFrameScratch_));
}

