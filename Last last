bool StatisticsManager::registerStatistic(
    const String& id,
    const String& source,
    const String& title,
    int64_t defaultValue,
    StatisticType statisticType,
    bool persistent
)
{
    if (!initialized ||
        !validID(id) ||
        !validSource(source) ||
        !validTitle(title) ||
        !validType(statisticType))
    {
        return false;
    }

    int16_t existingIndex = find(id);

    if (existingIndex >= 0)
    {
        StatisticInfo& statistic =
            statistics[existingIndex];

        bool wasPersistent =
            statistic.persistent;

        bool changed = false;
        bool typeChanged =
            statistic.type != statisticType;

        if (statistic.source != source)
        {
            statistic.source = source;
            changed = true;
        }

        if (statistic.title != title)
        {
            statistic.title = title;
            changed = true;
        }

        if (statistic.defaultValue !=
            defaultValue)
        {
            statistic.defaultValue =
                defaultValue;

            changed = true;
        }

        if (typeChanged)
        {
            statistic.type = statisticType;
            statistic.value = defaultValue;
            statistic.updatedAt = getTimestamp();

            resetBestState(statistic);
            changed = true;
        }
        else if (
            statistic.type == STATISTIC_COUNTER &&
            statistic.value < defaultValue
        )
        {
            statistic.value = defaultValue;
            statistic.updatedAt = getTimestamp();

            evaluateBest(
                statistic,
                statistic.value
            );

            changed = true;
        }

        if (statistic.persistent != persistent)
        {
            statistic.persistent = persistent;
            changed = true;
        }

        if (changed &&
            (wasPersistent ||
             statistic.persistent))
        {
            markDirty();
        }

        return true;
    }

    if (statisticCount >= MAX_STATISTICS)
        return false;

    StatisticInfo statistic = emptyInfo();

    statistic.id = id;
    statistic.source = source;
    statistic.title = title;

    statistic.value = defaultValue;
    statistic.defaultValue = defaultValue;
    statistic.bestValue = 0;

    statistic.updatedAt = getTimestamp();

    statistic.type = statisticType;

    statistic.bestInitialized = false;
    statistic.persistent = persistent;
    statistic.valid = true;

    resetBestState(statistic);

    statistics[statisticCount] = statistic;
    statisticCount++;

    if (persistent)
        markDirty();

    return true;
}

bool StatisticsManager::setValue(
    const String& id,
    int64_t newValue
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    StatisticInfo& statistic =
        statistics[index];

    if (statistic.type == STATISTIC_COUNTER &&
        newValue < statistic.value)
    {
        return false;
    }

    if (statistic.value == newValue)
    {
        bool bestWasInitialized =
            statistic.bestInitialized;

        int64_t oldBest =
            statistic.bestValue;

        evaluateBest(statistic, newValue);

        if (bestWasInitialized !=
                statistic.bestInitialized ||
            oldBest != statistic.bestValue)
        {
            statistic.updatedAt = getTimestamp();

            if (statistic.persistent)
                markDirty();
        }

        return true;
    }

    statistic.value = newValue;
    statistic.updatedAt = getTimestamp();

    evaluateBest(statistic, newValue);

    if (statistic.persistent)
        markDirty();

    return true;
}

bool StatisticsManager::addValue(
    const String& id,
    int64_t amount
)
{
    if (!initialized)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    StatisticInfo& statistic =
        statistics[index];

    if (statistic.type == STATISTIC_COUNTER &&
        amount < 0)
    {
        return false;
    }

    if (amount == 0)
        return true;

    int64_t newValue = 0;

    if (!addWithoutOverflow(
            statistic.value,
            amount,
            newValue
        ))
    {
        return false;
    }

    statistic.value = newValue;
    statistic.updatedAt = getTimestamp();

    evaluateBest(statistic, newValue);

    if (statistic.persistent)
        markDirty();

    return true;
}

