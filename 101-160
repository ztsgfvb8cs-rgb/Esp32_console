void HardwareManager::makeOutputsSafe()
{
    if (pinConnected(
            BoardPins::TFT_CS_PIN))
    {
        pinMode(
            BoardPins::TFT_CS_PIN,
            OUTPUT);

        digitalWrite(
            BoardPins::TFT_CS_PIN,
            HIGH);
    }

    if (pinConnected(
            BoardPins::TOUCH_CS_PIN))
    {
        pinMode(
            BoardPins::TOUCH_CS_PIN,
            OUTPUT);

        digitalWrite(
            BoardPins::TOUCH_CS_PIN,
            HIGH);
    }

    if (pinConnected(
            BoardPins::SD_CS_PIN))
    {
        pinMode(
            BoardPins::SD_CS_PIN,
            OUTPUT);

        digitalWrite(
            BoardPins::SD_CS_PIN,
            HIGH);
    }

    if (pinConnected(
            BoardPins::TFT_BACKLIGHT_PIN))
    {
        pinMode(
            BoardPins::TFT_BACKLIGHT_PIN,
            OUTPUT);

        digitalWrite(
            BoardPins::TFT_BACKLIGHT_PIN,
            LOW);
    }

    if (pinConnected(
            BoardPins::HAPTIC_PWM_PIN))
    {
        pinMode(
            BoardPins::HAPTIC_PWM_PIN,
            OUTPUT);

        digitalWrite(
            BoardPins::HAPTIC_PWM_PIN,
            LOW);
    }

    if (pinConnected(
            BoardPins::SPEAKER_AMP_ENABLE_PIN))
    {
        pinMode(
            BoardPins::SPEAKER_AMP_ENABLE_PIN,
            OUTPUT);

        digitalWrite(
            BoardPins::SPEAKER_AMP_ENABLE_PIN,
            LOW);
    }

    if (pinConnected(
            BoardPins::HEADPHONE_AMP_ENABLE_PIN))
    {
        pinMode(
            BoardPins::HEADPHONE_AMP_ENABLE_PIN,
            OUTPUT);

        digitalWrite(
            BoardPins::HEADPHONE_AMP_ENABLE_PIN,
            LOW);
    }

    if (pinConnected(
            BoardPins::BOOST_ENABLE_PIN))
    {
        pinMode(
            BoardPins::BOOST_ENABLE_PIN,
            OUTPUT);

        writeActiveLevel(
            BoardPins::BOOST_ENABLE_PIN,
            false,
            BoardConfig::BOOST_ENABLE_ACTIVE_HIGH);
    }

    currentStatus.boostEnabled = false;
    currentStatus.backlightEnabled = false;
    currentStatus.hapticEnabled = false;
}
