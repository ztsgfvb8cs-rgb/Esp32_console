    return get(
        (uint16_t)gameIndex,
        record
    );
}



bool PlaytimeManager::importRecord(
    const GamePlaytimeRecord& record
)
{
    if(!managerInitialized)
    {
        return false;
    }


    if(!record.valid)
    {
        return false;
    }


    char safeGameName[
        PLAYTIME_GAME_NAME_LENGTH
    ];


    memcpy(
        safeGameName,
        record.gameName,
        PLAYTIME_GAME_NAME_LENGTH
    );


    safeGameName[
        PLAYTIME_GAME_NAME_LENGTH - 1
    ] = '\0';


    String gameName =
        String(
            safeGameName
        );


    if(!validGameName(
        gameName
    ))
    {
        return false;
    }


    int16_t gameIndex =
        find(
            gameName
        );


    if(gameIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        if(recordCount >=
           PLAYTIME_MAX_GAMES)
        {
            return false;
        }


        gameIndex =
            (int16_t)recordCount;


        recordCount++;
    }


    records[gameIndex] =
        record;


    memcpy(
        records[gameIndex].gameName,
        safeGameName,
        PLAYTIME_GAME_NAME_LENGTH
    );


    records[gameIndex].gameName[
        PLAYTIME_GAME_NAME_LENGTH - 1
    ] = '\0';


    records[gameIndex].valid =
        true;


    records[gameIndex].modified =
        false;


    return true;
}



bool PlaytimeManager::exportRecord(
    uint16_t index,
    GamePlaytimeRecord& record
