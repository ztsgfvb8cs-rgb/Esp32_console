void RuntimeScreenRouter::setSuspended(bool value)
{
    if (!currentStatus_.initialized ||
        currentStatus_.suspended == value)
    {
        return;
    }

    currentStatus_.suspended = value;

    if (!value)
    {
        requestImmediateRender(
            RuntimeScreenRefreshReason::Recovery);
    }

    notifyStateChanged();
}

