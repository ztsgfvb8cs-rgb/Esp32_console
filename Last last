    ] = '\0';


    entry.createdUnix =
        profile.dateInformation.createdUnix;


    entry.lastLoginUnix =
        profile.dateInformation.lastLoginUnix;


    entry.lastSavedUnix =
        lastSavedUnix;


    entry.totalPlaytimeMilliseconds =
