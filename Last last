String PlaytimeManager::decodeText(
    const String& value
)
{
    String decoded;

    if (!decodeTextValue(
            value,
            decoded
        ))
    {
        return "";
    }

    return decoded;
}


void PlaytimeManager::clearMemory()
{
    entryCount = 0;

    for (uint16_t i = 0;
         i < MAX_PLAYTIME_ENTRIES;
         i++)
    {
        entries[i] = emptyInfo();
    }

    dirty = false;

    lastChangeTime = 0;

    clearSession();
}


void PlaytimeManager::clearSession()
{
    active = false;

    paused = false;

    activeIndex = -1;

    sessionMilliseconds = 0;

    lastTickTime = 0;
}
