    i2s_std_config_t standardConfig = {};
    standardConfig.clk_cfg =
        makeClockConfig(config_);
    standardConfig.slot_cfg =
        makeSlotConfig(config_);
    standardConfig.gpio_cfg.mclk =
        config_.masterClockPin ==
                BoardPins::NOT_CONNECTED
            ? I2S_GPIO_UNUSED
            : config_.masterClockPin;
    standardConfig.gpio_cfg.bclk =
        config_.bitClockPin;
    standardConfig.gpio_cfg.ws =
