bool ResourceBudgetCoordinator::canAdmit(
    const ResourceBudgetRequest& request,
    ResourceBudgetError* rejectionReason)
{
    if (rejectionReason != nullptr)
    {
        *rejectionReason = ResourceBudgetError::None;
    }

    if (!ready())
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                ResourceBudgetError::NotInitialized;
        }

        return false;
    }

    if (!validateRequest(request))
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                validOwner(request.owner)
                    ? ResourceBudgetError::InvalidRequest
                    : ResourceBudgetError::InvalidOwner;
        }

        return false;
    }

    if (!request.allowDuplicateLabel &&
        duplicateLabelExists(request))
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                ResourceBudgetError::DuplicateReservation;
        }

        return false;
    }

    if (findFreeSlot() < 0)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                ResourceBudgetError::NoFreeReservationSlot;
        }

        return false;
    }

    return admissionAllowed(
        request,
        0,
        0,
        rejectionReason);
}

