//---------------- Achievement Progress ----------------

bool setAchievementProgress(
    uint16_t achievementID,
    uint32_t currentValue
)
{
    AchievementRecord* record =
        findMutableAchievement(
            achievementID
        );


    if(record == nullptr)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    if(!record->definition.enabled)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_LOCKED;


        return false;
    }


    if(record->progress.unlocked)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_ALREADY_UNLOCKED;


        return true;
    }


    if(currentValue >
       record->definition.targetValue)
    {
        currentValue =
            record->definition.targetValue;
    }


    record->progress.currentValue =
        currentValue;


    record->progress.progressPercent =
        calculateProgressPercent(
            record->progress.currentValue,
            record->definition.targetValue
        );


    record->progress.modified =
        true;


    for(uint8_t i = 0;
        i < achievementTrackerCount;
        i++)
    {
        if(achievementTrackers[i].valid &&
           achievementTrackers[i].
               achievementID ==
               achievementID)
        {
            synchronizeTrackerWithAchievement(
                achievementTrackers[i]
            );
        }
    }


    checkAchievementUnlock(
        achievementID
    );


    achievementManagerStatus =
        ACHIEVEMENT_STATUS_READY;


    return true;
}



bool addAchievementProgress(
    uint16_t achievementID,
    uint32_t value
)
{
    AchievementRecord* record =
        findMutableAchievement(
            achievementID
        );


    if(record == nullptr)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    uint64_t newValue =
        (uint64_t)record->
            progress.currentValue +
        value;


    if(newValue >
       record->definition.targetValue)
    {
        newValue =
            record->definition.targetValue;
    }


    return setAchievementProgress(
        achievementID,
        (uint32_t)newValue
    );
}



