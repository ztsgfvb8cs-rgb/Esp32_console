bool RuntimeHealthCoordinator::begin()
{
    if (currentStatus_.initialized)
    {
        return true;
    }

    currentStatus_ = {};
    policy_ = {};
    observer_ = nullptr;

    if ((!RuntimeModuleManager::ready() &&
         !RuntimeModuleManager::begin()) ||
        (!RuntimeSessionBridge::ready() &&
         !RuntimeSessionBridge::begin()) ||
        (!RuntimeInputRouter::ready() &&
         !RuntimeInputRouter::begin()) ||
        (!RuntimeScreenRouter::ready() &&
         !RuntimeScreenRouter::begin()) ||
        (!RuntimeAudioCoordinator::ready() &&
         !RuntimeAudioCoordinator::begin()) ||
        (!RuntimePowerCoordinator::ready() &&
         !RuntimePowerCoordinator::begin()))
    {
        currentStatus_.level =
            RuntimeHealthLevel::Fatal;

        currentStatus_.subsystem =
            RuntimeHealthSubsystem::System;

        currentStatus_.error =
            RuntimeHealthError::
                RequiredCoordinatorNotReady;

        currentStatus_.lastResult =
            RuntimeResult::NotReady;

        currentStatus_.fatalState = true;

        RuntimeContext::setFatalError(true);

        return false;
    }

    if (!MemoryManager::psramAvailable())
    {
        Logger::warning(
            LogSource::System,
            "HEALTH_RT",
            "PSRAM unavailable; PSRAM health checks disabled");
    }

    const uint32_t nowMs = millis();

    currentStatus_.initialized = true;
    currentStatus_.level =
        RuntimeHealthLevel::Healthy;

    currentStatus_.lastResult =
        RuntimeResult::Ok;

    currentStatus_.lastSampleAtMs = nowMs;
    currentStatus_.stateEnteredAtMs = nowMs;

    synchronizeCoordinatorState(nowMs);
    refreshMemoryState();

    Logger::info(
        LogSource::System,
        "HEALTH_RT",
        "Runtime health coordinator ready");

    notifyStateChanged();

    return true;
}

void RuntimeHealthCoordinator::update(
    uint32_t nowMs)
{
    if (!currentStatus_.initialized ||
        currentStatus_.suspended ||
        currentStatus_.fatalState)
    {
        return;
    }

    const RuntimeResult sampleResult =
        sample(nowMs, false);

    if (sampleResult != RuntimeResult::Ok &&
        sampleResult != RuntimeResult::Busy)
    {
        return;
    }

    if (currentStatus_.recoveryPending)
    {
        performPendingRecovery(nowMs, false);
    }
}

void RuntimeHealthCoordinator::end()
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    currentStatus_.initialized = false;
    currentStatus_.suspended = false;
    currentStatus_.recoveryPending = false;
    currentStatus_.recoveryInProgress = false;

    currentStatus_.pendingAction =
        RuntimeRecoveryAction::None;

    observer_ = nullptr;
}

bool RuntimeHealthCoordinator::ready()
{
    return currentStatus_.initialized &&
        !currentStatus_.fatalState;
}

RuntimeHealthStatus RuntimeHealthCoordinator::status()
{
    if (currentStatus_.initialized)
    {
        synchronizeCoordinatorState(millis());
        refreshMemoryState();
    }

    return currentStatus_;
}

void RuntimeHealthCoordinator::setSuspended(
    bool value)
{
    if (!currentStatus_.initialized ||
        currentStatus_.suspended == value)
    {
        return;
    }

    currentStatus_.suspended = value;

    if (!value)
    {
        currentStatus_.lastSampleAtMs = 0;
        sample(millis(), true);
    }

    notifyStateChanged();
}

bool RuntimeHealthCoordinator::suspended()
{
    return currentStatus_.suspended;
}

RuntimeResult RuntimeHealthCoordinator::sample(
    uint32_t nowMs,
    bool forceSample)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeHealthSubsystem::System,
            RuntimeHealthError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (currentStatus_.suspended &&
        !forceSample)
    {
        return RuntimeResult::Busy;
    }

    if (!forceSample &&
        policy_.sampleIntervalMs > 0 &&
        nowMs - currentStatus_.lastSampleAtMs <
            policy_.sampleIntervalMs)
    {
        return RuntimeResult::Busy;
    }

    currentStatus_.lastSampleAtMs = nowMs;

    synchronizeCoordinatorState(nowMs);
    refreshMemoryState();

    const RuntimeResult result =
        evaluateHealth(nowMs);

    ++currentStatus_.healthSequence;

    notifyStateChanged();

    return result;
}

RuntimeResult RuntimeHealthCoordinator::requestRecovery(
    RuntimeHealthSubsystem subsystem,
    RuntimeHealthError error,
    RuntimeRecoveryAction action)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeHealthSubsystem::System,
            RuntimeHealthError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (subsystem ==
            RuntimeHealthSubsystem::None ||
        error == RuntimeHealthError::None)
    {
        return RuntimeResult::InvalidArgument;
    }

    if (action == RuntimeRecoveryAction::None)
    {
        action =
            defaultRecoveryAction(
                subsystem,
                error);
    }

    if (action == RuntimeRecoveryAction::None)
    {
        return fail(
            subsystem,
            error,
            RuntimeResult::Unsupported);
    }

    currentStatus_.subsystem = subsystem;
    currentStatus_.error = error;
    currentStatus_.pendingAction = action;
    currentStatus_.recoveryPending = true;
    currentStatus_.recoveryInProgress = false;

    currentStatus_.level =
        isCriticalMemoryError(error)
            ? RuntimeHealthLevel::Critical
            : RuntimeHealthLevel::Degraded;

    currentStatus_.lastResult =
        RuntimeResult::Ok;

    currentStatus_.consecutiveHealthySamples = 0;

    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult
RuntimeHealthCoordinator::performPendingRecovery(
    uint32_t nowMs,
    bool ignoreCooldown)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeHealthSubsystem::System,
            RuntimeHealthError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!currentStatus_.recoveryPending)
    {
        return RuntimeResult::NotReady;
    }

    if (currentStatus_.recoveryInProgress)
    {
        return RuntimeResult::Busy;
    }

    if (!ignoreCooldown &&
        currentStatus_.lastRecoveryAtMs != 0 &&
        nowMs -
                currentStatus_.lastRecoveryAtMs <
            policy_.recoveryCooldownMs)
    {
        currentStatus_.lastResult =
            RuntimeResult::Busy;

        return RuntimeResult::Busy;
    }

    if (currentStatus_.recoveryAttempts >=
        policy_.maximumRecoveryAttempts)
    {
        currentStatus_.error =
            RuntimeHealthError::
                RecoveryLimitReached;

        currentStatus_.level =
            RuntimeHealthLevel::Fatal;

        currentStatus_.fatalState =
            policy_.markFatalAfterRecoveryLimit;

        currentStatus_.pendingAction =
            policy_.markFatalAfterRecoveryLimit
                ? RuntimeRecoveryAction::
                    EnterFatalState
                : RuntimeRecoveryAction::
                    RequestSafeShutdown;

        if (!currentStatus_.fatalState)
        {
            return executeRecoveryAction(
                currentStatus_.pendingAction,
                nowMs);
        }
    }

    currentStatus_.recoveryInProgress = true;

    currentStatus_.level =
        RuntimeHealthLevel::Recovering;

    ++currentStatus_.recoveryAttempts;
    ++currentStatus_.recoverySequence;

    const RuntimeRecoveryAction action =
        currentStatus_.pendingAction;

    const RuntimeResult result =
        executeRecoveryAction(
            action,
            nowMs);

    currentStatus_.lastRecoveryAtMs = nowMs;
    currentStatus_.lastAction = action;
    currentStatus_.lastResult = result;
    currentStatus_.recoveryInProgress = false;

    if (result == RuntimeResult::Ok)
    {
        currentStatus_.recoveryPending = false;

        currentStatus_.pendingAction =
            RuntimeRecoveryAction::None;

        currentStatus_.consecutiveHealthySamples = 0;

        if (!currentStatus_.fatalState)
        {
            currentStatus_.level =
                RuntimeHealthLevel::Recovering;
        }
    }
    else
    {
        currentStatus_.error =
            RuntimeHealthError::
                RecoveryActionFailed;

        currentStatus_.level =
            RuntimeHealthLevel::Critical;

        if (currentStatus_.recoveryAttempts >=
            policy_.maximumRecoveryAttempts)
        {
            currentStatus_.recoveryPending = true;

            currentStatus_.pendingAction =
                policy_.markFatalAfterRecoveryLimit
                    ? RuntimeRecoveryAction::
                        EnterFatalState
                    : RuntimeRecoveryAction::
                        RequestSafeShutdown;
        }
    }

    notifyStateChanged();

    return result;
}

RuntimeResult
RuntimeHealthCoordinator::clearRecoveredState()
{
    if (!currentStatus_.initialized)
    {
        return RuntimeResult::NotReady;
    }

    if (currentStatus_.recoveryPending ||
        currentStatus_.recoveryInProgress ||
        currentStatus_.fatalState)
    {
        return RuntimeResult::Busy;
    }

    currentStatus_.level =
        RuntimeHealthLevel::Healthy;

    currentStatus_.subsystem =
        RuntimeHealthSubsystem::None;

    currentStatus_.pendingAction =
        RuntimeRecoveryAction::None;

    currentStatus_.error =
        RuntimeHealthError::None;

    currentStatus_.lastResult =
        RuntimeResult::Ok;

    currentStatus_.recoveryAttempts = 0;
    currentStatus_.consecutiveHealthySamples = 0;

    notifyStateChanged();

    return RuntimeResult::Ok;
}

