bool AiPerceptionSystem::validateObserver(
    const AiPerceptionObserverState& observer)
{
    if (!observer.active ||
        observer.entityId == AI_INVALID_ENTITY_ID ||
        observer.visionArcPermille > AI_PERMILLE_MAX)
    {
        return false;
    }

    if (observer.visionRange > 0)
    {
        const bool forwardIsZero =
            observer.forwardPermille.x == 0 &&
            observer.forwardPermille.y == 0;

        if (forwardIsZero)
        {
            return false;
        }
    }

    return true;
}

bool AiPerceptionSystem::validateStimulus(
    const AiPerceptionStimulus& stimulus)
{
    const uint8_t category =
        static_cast<uint8_t>(stimulus.category);

    const uint8_t relation =
        static_cast<uint8_t>(stimulus.relation);

    if (stimulus.entityId == AI_INVALID_ENTITY_ID ||
        category >= static_cast<uint8_t>(
            AiEntityCategory::Count) ||
        relation >= static_cast<uint8_t>(
            AiTeamRelation::Count) ||
        stimulus.emittedNoisePermille > AI_PERMILLE_MAX ||
        stimulus.threatPermille > AI_PERMILLE_MAX ||
        stimulus.valuePermille > AI_PERMILLE_MAX ||
        (stimulus.sourceFlags & ~KNOWN_SOURCE_FLAGS) != 0U)
    {
        return false;
    }

    if (stimulus.active &&
        stimulus.sourceFlags == AiPerceptionSourceNone)
    {
        return false;
    }

    return true;
}

bool AiPerceptionSystem::validatePolicy(
    const AiPerceptionPolicy& value)
{
    return
        value.peripheralConfidencePermille <=
            AI_PERMILLE_MAX &&
        value.hearingConfidencePermille <=
            AI_PERMILLE_MAX &&
        value.contactConfidencePermille <=
            AI_PERMILLE_MAX &&
        value.minimumRetainedConfidencePermille <=
            AI_PERMILLE_MAX &&
        value.confidenceDecayPerSecondPermille <=
            AI_PERMILLE_MAX &&
        value.predictionConfidenceCostPermille <=
            AI_PERMILLE_MAX;
}

bool AiPerceptionSystem::queryMatches(
    const AiPerceptionObservation& observation,
    const AiPerceptionQuery& query)
{
    if (observation.entityId == AI_INVALID_ENTITY_ID ||
        observation.visibility == AiVisibilityState::Unknown ||
        observation.confidencePermille <
            query.minimumConfidencePermille)
    {
        return false;
    }

    if (query.categoryMask != 0 &&
        (query.categoryMask & categoryBit(
            observation.category)) == 0)
    {
        return false;
    }

    if (query.relationMask != 0 &&
        (query.relationMask & relationBit(
            observation.relation)) == 0)
    {
        return false;
    }

    if (query.maximumDistance != 0 &&
        observation.distance > query.maximumDistance)
    {
        return false;
    }

    if (query.requireCurrentlyPerceived &&
        !observation.currentlyPerceived)
    {
        return false;
    }

    if (query.requireTargetable &&
        !observation.targetable)
    {
        return false;
    }

    if (!query.includeRemembered &&
        (observation.visibility ==
             AiVisibilityState::Remembered ||
         observation.visibility ==
             AiVisibilityState::Occluded))
    {
        return false;
    }

    if (!query.includePredicted &&
        observation.visibility ==
            AiVisibilityState::Predicted)
    {
        return false;
    }

    return true;
}
