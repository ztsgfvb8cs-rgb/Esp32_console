// CENTRAL RUNTIME SCREEN AND FRAME ROUTER
// 117_runtime_screen_router.h
//====================================================
//
// Responsibilities:
// - Coordinates UI and heavy foreground rendering.
// - Gives foreground games, emulators and PDF sessions exclusive
//   ownership of the display while they are active.
// - Keeps FramePacer usage centralized for foreground modules.
// - Preserves the existing ScreenManager path for normal UI screens.
// - Supports invalidation, forced refresh and periodic live screens.
// - Detects screen/session mismatches and repeated render failures.
//
// Integration rule:
// - Files 159-160 will call this router instead of calling
//   ScreenManager::update() directly.
// - RuntimeInputRouter must drain input before this router updates.
// - Normal UI rendering remains delegated to ScreenManager.
// - Foreground rendering remains delegated to RuntimeModuleManager.
//
// Dependency rule:
// - This header depends only on core value types and the lower-level
//   RuntimeModuleManager contract.
// - DisplayDriver, FramePacer, ScreenManager, RuntimeSessionBridge and
//   logging are included only by the implementation file.
//====================================================

namespace egs
{
enum class RuntimeScreenMode : uint8_t
{
    None = 0,
    UserInterface,
    ForegroundGame,
    ForegroundPdf,
    ErrorScreen
};

enum class RuntimeScreenRefreshReason : uint8_t
{
    None = 0,
    Startup,
    Navigation,
    Input,
    Periodic,
    ForegroundFrame,
    Forced,
    Recovery
};

enum class RuntimeScreenError : uint8_t
{
    None = 0,
    NotInitialized,
    DisplayNotReady,
    SessionBridgeNotReady,
    ModuleManagerNotReady,
    ForegroundScreenMismatch,
    UnsupportedForeground,
    RenderFailed
};

struct RuntimeScreenPolicy
{
    // Main-menu values such as battery status do not need a full
    // frame-rate refresh.
    uint32_t mainMenuRefreshIntervalMs = 1000U;

    // System-monitor values benefit from a faster live refresh.
    uint32_t systemMonitorRefreshIntervalMs = 250U;

    bool refreshMainMenuPeriodically = true;
    bool refreshSystemMonitorPeriodically = true;

    // Games and emulators normally render at FramePacer cadence.
    bool renderForegroundContinuously = true;

    // PDF pages are static until page selection or explicit
    // invalidation changes.
    bool renderPdfOnlyWhenDirty = true;

    // Prevents the UI layer from drawing over a foreground owner.
    bool suppressUiDuringForeground = true;

    // Consecutive failures above this limit are reported as a
    // persistent render failure. Zero is normalized to one.
    uint8_t maximumConsecutiveFailures = 3U;
};

struct RuntimeScreenStatus
{
    bool initialized = false;
    bool suspended = false;
    bool dirty = true;
    bool forceRequested = false;
    bool rendering = false;
    bool foregroundOwned = false;

    RuntimeScreenMode mode = RuntimeScreenMode::None;

    RuntimeScreenRefreshReason refreshReason =
        RuntimeScreenRefreshReason::None;

    RuntimeScreenError error = RuntimeScreenError::None;

    AppScreen screen = AppScreen::Boot;

    RuntimeModuleKind moduleKind =
        RuntimeModuleKind::None;

    RuntimeModuleState moduleState =
        RuntimeModuleState::Stopped;

    uint32_t lastRenderAtMs = 0;
    uint32_t lastRenderDurationUs = 0;
    uint32_t lastPeriodicRefreshAtMs = 0;
    uint32_t renderSequence = 0;
    uint32_t skippedFrameCount = 0;
    uint32_t failedRenderCount = 0;

    uint8_t consecutiveFailures = 0;
};

using RuntimeScreenObserver = void (*)(
    const RuntimeScreenStatus& status);

class RuntimeScreenRouter final
{
public:
    //================================================
    // LIFECYCLE
    //================================================

    static bool begin();

    static void update(
        uint32_t nowMs,
        uint32_t nowUs);

    static void end();

    static bool ready();

    static RuntimeScreenStatus status();

    static void setSuspended(
        bool suspended);

    static bool suspended();

    //================================================
    // INVALIDATION AND RENDER CONTROL
    //================================================

    static void invalidate(
        RuntimeScreenRefreshReason reason =
            RuntimeScreenRefreshReason::Forced);

    // Requests rendering at the next valid frame opportunity.
    static void requestImmediateRender(
        RuntimeScreenRefreshReason reason =
            RuntimeScreenRefreshReason::Forced);

    // Performs one routing/render pass immediately.
    // FramePacer still protects continuously rendered
    // foreground modules unless forceRequested is active.
    static RuntimeResult renderNow(
        uint32_t nowMs,
        uint32_t nowUs);

    static RuntimeScreenMode currentMode();

    static bool foregroundOwnsDisplay();

    static bool renderPending();

    //================================================
    // POLICY AND OBSERVATION
    //================================================

    static void setPolicy(
        const RuntimeScreenPolicy& policy);

    static RuntimeScreenPolicy policy();

    static void setObserver(
        RuntimeScreenObserver observer);

    static RuntimeScreenError lastError();

    static const char* modeText(
        RuntimeScreenMode value);

    static const char* refreshReasonText(
        RuntimeScreenRefreshReason value);

    static const char* errorText(
        RuntimeScreenError value);

private:
    static RuntimeScreenStatus currentStatus_;

    static RuntimeScreenPolicy policy_;

    static RuntimeScreenObserver observer_;

    static RuntimeScreenMode resolveMode();

    static bool foregroundStateValid(
        RuntimeScreenMode mode);

    static bool periodicRefreshDue(
        uint32_t nowMs);

    static bool shouldRender(
        RuntimeScreenMode mode,
        uint32_t nowMs,
        uint32_t nowUs);

    static RuntimeResult renderUserInterface(
        uint32_t nowMs);

    static RuntimeResult renderForeground(
        uint32_t nowUs);

    static void synchronizeStatus();

    static void recordSuccess(
        uint32_t nowMs,
        uint32_t renderDurationUs);

    static RuntimeResult recordFailure(
        RuntimeScreenError error,
        RuntimeResult result);

    static void notifyStateChanged();
