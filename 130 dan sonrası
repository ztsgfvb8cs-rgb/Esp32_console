RuntimeResult I2sAudioBackend::reserveBudget()
{
    if (!config_.reserveInternalBudget)
    {
        currentStatus_.budgetReserved = false;
        currentStatus_.reservedInternalBytes = 0;
        return RuntimeResult::Ok;
    }

    if (!ResourceBudgetCoordinator::ready())
    {
        return setError(
            I2sAudioBackendError::BudgetCoordinatorNotReady,
            RuntimeResult::NotReady);
    }

    const size_t requiredBytes =
        requiredInternalBytes(config_);

    if (requiredBytes == 0U)
    {
        return setError(
            I2sAudioBackendError::InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    ResourceBudgetRequest request;
    request.owner = ResourceBudgetOwner::Audio;
    request.priority = ResourceBudgetPriority::High;
    request.internalBytes = requiredBytes;
    request.psramBytes = 0;
    request.reclaimableInternalBytes = 0;
    request.reclaimablePsramBytes = 0;
    request.persistent = config_.persistentBudget;
    request.allowDuplicateLabel = false;

    const size_t labelLength =
        boundedStringLength(
            config_.budgetLabel,
            sizeof(request.label) - 1U);

    if (labelLength > 0U)
    {
        memcpy(
            request.label,
            config_.budgetLabel,
            labelLength);
    }

    request.label[labelLength] = '\0';

    const RuntimeResult reserveResult =
        ResourceBudgetCoordinator::reserve(
            request,
            budgetHandle_,
            platformMillis());

    if (reserveResult != RuntimeResult::Ok)
    {
        budgetHandle_ = {};

        return setError(
            I2sAudioBackendError::BudgetRejected,
            reserveResult);
    }

    currentStatus_.budgetReserved = true;
    currentStatus_.reservedInternalBytes =
        requiredBytes;

    const RuntimeResult reportResult =
        ResourceBudgetCoordinator::reportUsage(
            budgetHandle_,
            requiredBytes,
            0,
            platformMillis());

    if (reportResult != RuntimeResult::Ok)
    {
        releaseBudget();

        return setError(
            I2sAudioBackendError::BudgetRejected,
            reportResult);
    }

    return RuntimeResult::Ok;
}

void I2sAudioBackend::releaseBudget()
{
    if (!budgetHandle_)
    {
        currentStatus_.budgetReserved = false;
        currentStatus_.reservedInternalBytes = 0;
        return;
    }

    RuntimeResult releaseResult =
        ResourceBudgetCoordinator::release(
            budgetHandle_);

    if (releaseResult != RuntimeResult::Ok &&
        config_.persistentBudget)
    {
        // Persistent reservations are protected from direct release by
        // the current coordinator. I2S end() is the audio-subsystem
        // teardown boundary, so its persistent owner reservations are
        // explicitly released here.
        releaseResult =
            ResourceBudgetCoordinator::releaseOwner(
                ResourceBudgetOwner::Audio,
                true);

        budgetHandle_ = {};
    }

    if (releaseResult == RuntimeResult::Ok)
    {
        budgetHandle_ = {};
    }

    currentStatus_.budgetReserved = false;
    currentStatus_.reservedInternalBytes = 0;
}

