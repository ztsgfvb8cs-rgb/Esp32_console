//====================================================

bool PlaytimeManager::modified()
{
    if(!managerInitialized)
    {
        return false;
    }


    if(dataModified)
    {
        return true;
    }


    for(uint16_t i = 0;
        i < recordCount;
        i++)
    {
        if(
            records[i].valid &&
            records[i].modified
        )
        {
            return true;
        }
    }


    return false;
}



bool PlaytimeManager::gameModified(
    const String& gameName
)
{
    int16_t gameIndex =
        find(
            gameName
        );


    if(gameIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        return false;
    }


    return
        records[gameIndex].
            modified;
}



void PlaytimeManager::clearModified()
{
    if(!managerInitialized)
    {
        return;
    }


    dataModified =
        false;


    for(uint16_t i = 0;
        i < recordCount;
        i++)
    {
        records[i].modified =
            false;
    }
}



void PlaytimeManager::clearGameModified(
    const String& gameName
)
{
    int16_t gameIndex =
        find(
            gameName
        );


    if(gameIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        return;
    }


    records[gameIndex].modified =
        false;


    bool anyModified =
        false;


    for(uint16_t i = 0;
        i < recordCount;
        i++)
    {
        if(
            records[i].valid &&
            records[i].modified
        )
        {
            anyModified =
                true;

            break;
        }
    }


    dataModified =
        anyModified;
}


//====================================================
// RESET
//====================================================

bool PlaytimeManager::resetGame(
    const String& gameName
)
{
    if(!managerInitialized)
    {
        return false;
    }


    int16_t gameIndex =
        find(
            gameName
        );


    if(gameIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        return false;
    }


    if(
        session.active &&
        session.gameIndex ==
            gameIndex
    )
    {
        if(!cancel())
        {
            return false;
        }
    }


    char savedGameName[
        PLAYTIME_GAME_NAME_LENGTH
    ];


    memcpy(
        savedGameName,
        records[gameIndex].gameName,
        PLAYTIME_GAME_NAME_LENGTH
    );


    savedGameName[
        PLAYTIME_GAME_NAME_LENGTH - 1
    ] = '\0';


    clearRecord(
        records[gameIndex]
    );


    memcpy(
        records[gameIndex].gameName,
        savedGameName,
        PLAYTIME_GAME_NAME_LENGTH
    );


    records[gameIndex].gameName[
        PLAYTIME_GAME_NAME_LENGTH - 1
    ] = '\0';


    records[gameIndex].valid =
        true;


    records[gameIndex].modified =
        true;


    dataModified =
        true;


    return true;
}



void PlaytimeManager::resetAllGames()
{
    if(!managerInitialized)
    {
        return;
    }


    clearSession();


    for(uint16_t i = 0;
        i < PLAYTIME_MAX_GAMES;
        i++)
    {
        clearRecord(
            records[i]
        );
    }


    recordCount =
        0;


    dataModified =
        true;
}


//====================================================
// VALIDATION
//====================================================

bool PlaytimeManager::validGameName(
    const String& gameName
)
{
    size_t length =
        gameName.length();


    if(length == 0)
    {
        return false;
    }


    if(length >=
       PLAYTIME_GAME_NAME_LENGTH)
    {
        return false;
    }


    for(size_t i = 0;
        i < length;
        i++)
    {
        char character =
            gameName.charAt(
                i
            );


        if(
            character < 32 ||
            character == '/' ||
            character == '\\'
        )
        {
            return false;
        }
    }


    return true;
}



bool PlaytimeManager::validate()
{
    if(!managerInitialized)
    {
        return false;
    }


    if(recordCount >
       PLAYTIME_MAX_GAMES)
    {
        return false;
    }


    for(uint16_t i = 0;
        i < recordCount;
        i++)
    {
        if(!records[i].valid)
        {
            return false;
        }


        char safeGameName[
            PLAYTIME_GAME_NAME_LENGTH
        ];


        memcpy(
            safeGameName,
            records[i].gameName,
            PLAYTIME_GAME_NAME_LENGTH
        );


        safeGameName[
            PLAYTIME_GAME_NAME_LENGTH - 1
        ] = '\0';


        String gameName =
            String(
                safeGameName
            );


        if(!validGameName(
            gameName
        ))
        {
            return false;
        }


        if(
            records[i].
                completedSessionCount >
            records[i].
                sessionCount
        )
        {
            return false;
        }


        if(
            records[i].
                failedSessionCount >
            records[i].
                sessionCount
        )
        {
            return false;
        }


        if(
            records[i].
                abortedSessionCount >
            records[i].
                sessionCount
        )
        {
            return false;
        }


        uint64_t categorizedSessions =
            (uint64_t)
            records[i].
                completedSessionCount +
            records[i].
                failedSessionCount +
            records[i].
                abortedSessionCount;


        if(categorizedSessions >
           records[i].sessionCount)
        {
            return false;
        }


        for(uint16_t j = i + 1;
            j < recordCount;
            j++)
        {
            if(
                records[j].valid &&
                strcmp(
                    records[i].gameName,
                    records[j].gameName
                ) == 0
            )
            {
                return false;
            }
        }
    }


    for(uint16_t i = recordCount;
        i < PLAYTIME_MAX_GAMES;
        i++)
    {
        if(records[i].valid)
        {
            return false;
        }
    }


    if(session.active)
    {
        if(session.gameIndex < 0)
        {
            return false;
        }


        if(session.gameIndex >=
           (int16_t)recordCount)
        {
            return false;
        }


        if(!records[
            session.gameIndex
        ].valid)
        {
            return false;
        }


        if(
            session.state !=
                PLAYTIME_SESSION_RUNNING &&
            session.state !=
                PLAYTIME_SESSION_PAUSED
        )
        {
            return false;
        }
    }
    else
    {
        if(session.state !=
           PLAYTIME_SESSION_STOPPED)
        {
            return false;
        }
    }


    return true;
}


