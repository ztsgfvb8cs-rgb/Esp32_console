        }
    }


    return -1;
}



static uint32_t getAchievementUnixTime()
{
    if(!isRTCInitialized())
    {
        return 0;
    }


    if(!isRTCAvailable())
    {
        return 0;
    }


    if(!isRTCDateTimeValid())
    {
        return 0;
    }


    return getRTCUnixTime();
}



static uint8_t calculateProgressPercent(
    uint32_t currentValue,
    uint32_t targetValue
)
{
    if(targetValue == 0)
    {
        return ACHIEVEMENT_PROGRESS_COMPLETE;
    }


    if(currentValue >=
       targetValue)
    {
        return ACHIEVEMENT_PROGRESS_COMPLETE;
    }


    uint64_t calculation =
        (uint64_t)currentValue *
        ACHIEVEMENT_PROGRESS_COMPLETE;


    calculation /=
        targetValue;


    if(calculation >
       ACHIEVEMENT_PROGRESS_COMPLETE)
    {
        calculation =
            ACHIEVEMENT_PROGRESS_COMPLETE;
    }


    return (uint8_t)calculation;
}



static bool copyAchievementText(
    char* destination,
    size_t destinationLength,
    const char* source
)
{
    if(destination == nullptr ||
       destinationLength == 0 ||
       source == nullptr)
    {
        return false;
    }


    size_t sourceLength =
        strlen(
            source
        );


    if(sourceLength == 0 ||
       sourceLength >= destinationLength)
    {
        return false;
    }


    strncpy(
        destination,
        source,
        destinationLength - 1
    );


    destination[
        destinationLength - 1
    ] = '\0';


    return true;
}



static void synchronizeTrackerWithAchievement(
    AchievementTracker& tracker
)
{
    AchievementRecord* record =
        findMutableAchievement(
            tracker.achievementID
        );


    if(record == nullptr)
    {
        return;
    }


    tracker.currentValue =
        record->progress.currentValue;


    tracker.targetValue =
        record->definition.targetValue;
}



