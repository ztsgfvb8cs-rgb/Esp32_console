RuntimeResult ResourceBudgetCoordinator::reserve(
    const ResourceBudgetRequest& request,
    ResourceBudgetHandle& handle,
    uint32_t nowMs)
{
    invalidateHandle(handle);

    if (!ready())
    {
        return setError(
            ResourceBudgetError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!validateRequest(request))
    {
        currentStatus_.rejectionCount =
            saturatingIncrement32(
                currentStatus_.rejectionCount);

        return setError(
            validOwner(request.owner)
                ? ResourceBudgetError::InvalidRequest
                : ResourceBudgetError::InvalidOwner,
            RuntimeResult::InvalidArgument);
    }

    if (!request.allowDuplicateLabel &&
        duplicateLabelExists(request))
    {
        currentStatus_.rejectionCount =
            saturatingIncrement32(
                currentStatus_.rejectionCount);

        return setError(
            ResourceBudgetError::DuplicateReservation,
            RuntimeResult::Busy);
    }

    ResourceBudgetError rejectionReason =
        ResourceBudgetError::None;

    if (!admissionAllowed(
            request,
            0,
            0,
            &rejectionReason))
    {
        currentStatus_.rejectionCount =
            saturatingIncrement32(
                currentStatus_.rejectionCount);

        return setError(
            rejectionReason,
            rejectionReason ==
                    ResourceBudgetError::CriticalPressure
                ? RuntimeResult::Busy
                : RuntimeResult::OutOfMemory);
    }

    const int freeSlot = findFreeSlot();

    if (freeSlot < 0)
    {
        currentStatus_.rejectionCount =
            saturatingIncrement32(
                currentStatus_.rejectionCount);

        return setError(
            ResourceBudgetError::NoFreeReservationSlot,
            RuntimeResult::Busy);
    }

    ReservationSlot& slot =
        reservations_[static_cast<uint8_t>(freeSlot)];

    const uint32_t generation =
        nextGeneration(slot.status.generation);

    uint32_t leaseId = nextLeaseId_;

    if (leaseId == 0)
    {
        leaseId = 1U;
    }

    nextLeaseId_ = nextLease(leaseId);

    slot = {};
    slot.active = true;
    slot.status.active = true;
    slot.status.persistent = request.persistent;
    slot.status.owner = request.owner;
    slot.status.priority = request.priority;
    slot.status.error = ResourceBudgetError::None;
    slot.status.reservedInternalBytes =
        request.internalBytes;
    slot.status.reservedPsramBytes =
        request.psramBytes;
    slot.status.reclaimableInternalBytes =
        request.reclaimableInternalBytes;
    slot.status.reclaimablePsramBytes =
        request.reclaimablePsramBytes;
    slot.status.createdAtMs = nowMs;
    slot.status.updatedAtMs = nowMs;
    slot.status.generation = generation;
    slot.status.leaseId = leaseId;

    copyLabel(slot.status.label, request.label);

    handle.slot = static_cast<uint8_t>(freeSlot);
    handle.generation = generation;
    handle.leaseId = leaseId;

    currentStatus_.admissionCount =
        saturatingIncrement32(
            currentStatus_.admissionCount);

    currentStatus_.error = ResourceBudgetError::None;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult ResourceBudgetCoordinator::resize(
    const ResourceBudgetHandle& handle,
    size_t internalBytes,
    size_t psramBytes,
    size_t reclaimableInternalBytes,
    size_t reclaimablePsramBytes,
    uint32_t nowMs)
{
    ResourceBudgetError lookupError =
        ResourceBudgetError::None;

    ReservationSlot* const slot =
        slotFor(handle, &lookupError);

    if (slot == nullptr)
    {
        return setError(
            lookupError,
            RuntimeResult::InvalidArgument);
    }

    if ((internalBytes == 0 && psramBytes == 0) ||
        reclaimableInternalBytes > internalBytes ||
        reclaimablePsramBytes > psramBytes)
    {
        return setError(
            ResourceBudgetError::InvalidRequest,
            RuntimeResult::InvalidArgument);
    }

    if (internalBytes <
            slot->status.reportedInternalBytes ||
        psramBytes <
            slot->status.reportedPsramBytes)
    {
        slot->status.error =
            ResourceBudgetError::ActualUsageExceedsReservation;

        return setError(
            ResourceBudgetError::ActualUsageExceedsReservation,
            RuntimeResult::InvalidArgument);
    }

    ResourceBudgetRequest request;
    request.owner = slot->status.owner;
    request.priority = slot->status.priority;
    request.internalBytes = internalBytes;
    request.psramBytes = psramBytes;
    request.reclaimableInternalBytes =
        reclaimableInternalBytes;
    request.reclaimablePsramBytes =
        reclaimablePsramBytes;
    request.persistent = slot->status.persistent;
    request.allowDuplicateLabel = true;
    copyLabel(request.label, slot->status.label);

    ResourceBudgetError rejectionReason =
        ResourceBudgetError::None;

    if (!admissionAllowed(
            request,
            slot->status.reservedInternalBytes,
            slot->status.reservedPsramBytes,
            &rejectionReason))
    {
        currentStatus_.rejectionCount =
            saturatingIncrement32(
                currentStatus_.rejectionCount);

        slot->status.error = rejectionReason;

        return setError(
            rejectionReason,
            rejectionReason ==
                    ResourceBudgetError::CriticalPressure
                ? RuntimeResult::Busy
                : RuntimeResult::OutOfMemory);
    }

    slot->status.reservedInternalBytes =
        internalBytes;
    slot->status.reservedPsramBytes =
        psramBytes;
    slot->status.reclaimableInternalBytes =
        reclaimableInternalBytes;
    slot->status.reclaimablePsramBytes =
        reclaimablePsramBytes;
    slot->status.updatedAtMs = nowMs;
    slot->status.error = ResourceBudgetError::None;

    currentStatus_.resizeCount =
        saturatingIncrement32(
            currentStatus_.resizeCount);

    currentStatus_.error = ResourceBudgetError::None;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult ResourceBudgetCoordinator::reportUsage(
    const ResourceBudgetHandle& handle,
    size_t actualInternalBytes,
    size_t actualPsramBytes,
    uint32_t nowMs)
{
    ResourceBudgetError lookupError =
        ResourceBudgetError::None;

    ReservationSlot* const slot =
        slotFor(handle, &lookupError);

    if (slot == nullptr)
    {
        return setError(
            lookupError,
            RuntimeResult::InvalidArgument);
    }

    if (actualInternalBytes >
            slot->status.reservedInternalBytes ||
        actualPsramBytes >
            slot->status.reservedPsramBytes)
    {
        slot->status.error =
            ResourceBudgetError::ActualUsageExceedsReservation;

        return setError(
            ResourceBudgetError::ActualUsageExceedsReservation,
            RuntimeResult::OutOfMemory);
    }

    slot->status.reportedInternalBytes =
        actualInternalBytes;
    slot->status.reportedPsramBytes =
        actualPsramBytes;
    slot->status.updatedAtMs = nowMs;
    slot->status.error = ResourceBudgetError::None;

    currentStatus_.reportCount =
        saturatingIncrement32(
            currentStatus_.reportCount);

    currentStatus_.error = ResourceBudgetError::None;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult ResourceBudgetCoordinator::release(
    ResourceBudgetHandle& handle)
{
    ResourceBudgetError lookupError =
        ResourceBudgetError::None;

    ReservationSlot* const slot =
        slotFor(handle, &lookupError);

    if (slot == nullptr)
    {
        invalidateHandle(handle);

        return setError(
            lookupError,
            RuntimeResult::InvalidArgument);
    }

    if (slot->status.persistent)
    {
        return setError(
            ResourceBudgetError::PersistentReservation,
            RuntimeResult::Busy);
    }

    const uint32_t generation =
        nextGeneration(slot->status.generation);

    *slot = {};
    slot->status.generation = generation;

    invalidateHandle(handle);

    currentStatus_.releaseCount =
        saturatingIncrement32(
            currentStatus_.releaseCount);

    currentStatus_.error = ResourceBudgetError::None;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult ResourceBudgetCoordinator::releaseOwner(
    ResourceBudgetOwner owner,
    bool includePersistent)
{
    if (!ready())
    {
        return setError(
            ResourceBudgetError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!validOwner(owner))
    {
        return setError(
            ResourceBudgetError::InvalidOwner,
            RuntimeResult::InvalidArgument);
    }

    uint32_t releasedCount = 0;
    bool persistentSkipped = false;

    for (uint8_t index = 0;
         index < RESOURCE_BUDGET_MAX_RESERVATIONS;
         ++index)
    {
        ReservationSlot& slot = reservations_[index];

        if (!slot.active ||
            slot.status.owner != owner)
        {
            continue;
        }

        if (slot.status.persistent &&
            !includePersistent)
        {
            persistentSkipped = true;
            continue;
        }

        const uint32_t generation =
            nextGeneration(slot.status.generation);

        slot = {};
        slot.status.generation = generation;

        releasedCount =
            saturatingIncrement32(releasedCount);
    }

    if (releasedCount >
        UINT32_MAX - currentStatus_.releaseCount)
    {
        currentStatus_.releaseCount = UINT32_MAX;
    }
    else
    {
        currentStatus_.releaseCount += releasedCount;
    }

    refreshStatus();

    if (persistentSkipped)
    {
        currentStatus_.error =
            ResourceBudgetError::PersistentReservation;

        notifyStateChanged();

        return RuntimeResult::Busy;
    }

    currentStatus_.error = ResourceBudgetError::None;
    notifyStateChanged();

    return RuntimeResult::Ok;
}
