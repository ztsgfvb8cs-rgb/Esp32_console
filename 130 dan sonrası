        else
        {
            nativeFrameBytes =
                inputFrameBytes(config_.format);

            const size_t maximumChunkFrames =
                SIZE_MAX / nativeFrameBytes;

            chunkFrames = minimumSize(
                chunkFrames,
                maximumChunkFrames);

            writeData =
                interleavedSamples +
                sourceFrameOffset *
                    config_.format.channelCount;

            writeBytes =
                chunkFrames * nativeFrameBytes;
