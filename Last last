    uint32_t freePsramBytes;


    // Açılıştan beri görülen en düşük boş PSRAM
    uint32_t minimumFreePsramBytes;


    // Ayrılabilecek en büyük tek PSRAM bloğu
    uint32_t largestFreePsramBlockBytes;


    // PSRAM kullanım yüzdesi
    uint8_t psramUsagePercent;


