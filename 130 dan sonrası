RuntimeResult WavDecoder::parseHeader(
    uint32_t nowMs,
    size_t byteBudget)
{
    if (!open())
    {
        return setError(
            WavDecoderError::NotOpen,
            RuntimeResult::NotReady);
    }

    if (status_.state ==
        WavDecoderState::Failed)
    {
        return RuntimeResult::CorruptData;
    }

    if (status_.headerReady)
    {
        status_.error =
            WavDecoderError::None;

        return RuntimeResult::Ok;
    }

    const size_t effectiveBudget =
        byteBudget > 0U
            ? byteBudget
            : config_.sourceReadChunkBytes;

    if (effectiveBudget == 0U)
    {
        return setError(
            WavDecoderError::
                InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    const uint32_t startScanned =
        status_.headerBytesScanned;

    status_.state =
        WavDecoderState::ParsingHeader;

    status_.sourceWouldBlock = false;

    while (!status_.headerReady)
    {
        if (status_.headerBytesScanned >
            config_.maximumHeaderScanBytes)
        {
            status_.state =
                WavDecoderState::Failed;

            return setError(
                WavDecoderError::
                    HeaderScanLimitReached,
                RuntimeResult::CorruptData);
        }

        const size_t consumedThisCall =
            static_cast<size_t>(
                status_.headerBytesScanned -
                startScanned);

        if (consumedThisCall >=
            effectiveBudget)
        {
            return setError(
                WavDecoderError::Busy,
                RuntimeResult::Busy);
        }

        RuntimeResult result =
            RuntimeResult::InternalError;

        switch (headerPhase_)
        {
            case HeaderPhase::RiffHeader:
                result =
                    parseRiffHeader(nowMs);
                break;

            case HeaderPhase::ChunkHeader:
                result =
                    parseChunkHeader(nowMs);
                break;

            case HeaderPhase::FormatPayload:
                result =
                    parseFormatPayload(nowMs);
                break;

            case HeaderPhase::SkipPayload:
            {
                const size_t remainingBudget =
                    effectiveBudget -
                    consumedThisCall;

                result =
                    skipCurrentPayload(
                        nowMs,
                        remainingBudget);
                break;
            }

            case HeaderPhase::Complete:
                result = finalizeHeader();
                break;

            default:
                status_.state =
                    WavDecoderState::Failed;

                return setError(
                    WavDecoderError::
                        InternalError,
                    RuntimeResult::
                        InternalError);
        }

        if (result != RuntimeResult::Ok)
        {
            return result;
        }
    }

    status_.error =
        WavDecoderError::None;

    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult WavDecoder::decode(
    PcmRingBuffer& destination,
    uint32_t nowMs,
    size_t maximumFrames,
    size_t& decodedFrames)
{
    decodedFrames = 0U;

    if (!open())
    {
        return setError(
            WavDecoderError::NotOpen,
            RuntimeResult::NotReady);
    }

    if (status_.state ==
        WavDecoderState::Failed)
    {
        return RuntimeResult::CorruptData;
    }

    if (!status_.headerReady)
    {
        const RuntimeResult parseResult =
            parseHeader(
                nowMs,
                config_.
                    sourceReadChunkBytes);

        if (parseResult != RuntimeResult::Ok)
        {
            return parseResult;
        }
    }

    if (status_.eof)
    {
        return setError(
            WavDecoderError::EndOfStream,
            RuntimeResult::NotReady);
    }

    const RuntimeResult destinationResult =
        validateDestination(
            destination);

    if (destinationResult !=
        RuntimeResult::Ok)
    {
        return destinationResult;
    }

    size_t frameBudget =
        maximumFrames;

    if (frameBudget == 0U)
    {
        frameBudget =
            config_.
                defaultFramesPerDecodeCall;
    }

    frameBudget = minimumSize(
        frameBudget,
        WAV_DECODER_MAX_FRAMES_PER_CALL);

    if (frameBudget == 0U)
    {
        return setError(
            WavDecoderError::
                InvalidConfiguration,
            RuntimeResult::InvalidArgument);
    }

    status_.state =
        WavDecoderState::Decoding;

    status_.sourceWouldBlock = false;
    status_.destinationBackpressure = false;

    status_.decodeCount =
        saturatingIncrement32(
            status_.decodeCount);

    const RuntimeResult result =
        decodeAvailableFrames(
            destination,
            nowMs,
            frameBudget,
            decodedFrames);

    if (result == RuntimeResult::Ok &&
        !status_.eof)
    {
        status_.state =
            WavDecoderState::Ready;

        status_.error =
            WavDecoderError::None;
    }

    refreshDerivedStatus();
    notifyStateChanged();

    return result;
}

RuntimeResult WavDecoder::decode(
    PcmRingBuffer& destination,
    uint32_t nowMs,
    size_t& decodedFrames)
{
    return decode(
        destination,
        nowMs,
        config_.
            defaultFramesPerDecodeCall,
        decodedFrames);
}

RuntimeResult WavDecoder::seekFrame(
    uint64_t frameIndex)
{
    if (!ready())
    {
        return setError(
            status_.open
                ? WavDecoderError::
                    HeaderNotReady
                : WavDecoderError::NotOpen,
            RuntimeResult::NotReady);
    }

    if (frameIndex >
            status_.totalFrames ||
        multiplyWouldOverflow(
            frameIndex,
            status_.sourceFormat.
                blockAlignBytes))
    {
        return setError(
            WavDecoderError::InvalidSeek,
            RuntimeResult::InvalidArgument);
    }

    const uint64_t byteOffset =
        frameIndex *
        status_.sourceFormat.
            blockAlignBytes;

    if (byteOffset > UINT32_MAX ||
        byteOffset >
            status_.dataSizeBytes)
    {
        return setError(
            WavDecoderError::InvalidSeek,
            RuntimeResult::InvalidArgument);
    }

    const RuntimeResult result =
        seekToDataByteOffset(
            static_cast<uint32_t>(
                byteOffset));

    if (result == RuntimeResult::Ok)
    {
        status_.seekCount =
            saturatingIncrement32(
                status_.seekCount);

        refreshDerivedStatus();
        notifyStateChanged();
    }

    return result;
}

RuntimeResult WavDecoder::seekMilliseconds(
    uint32_t milliseconds)
{
    if (!ready() ||
        status_.sourceFormat.
