void removeCarriageReturn(String& value)
{
    while (value.endsWith("\r"))
        value.remove(value.length() - 1);
}


uint16_t countFields(const String& line)
{
    if (line.length() == 0)
        return 0;

    uint16_t count = 1;

    for (uint32_t i = 0; i < line.length(); i++)
    {
        if (line.charAt(i) == '|')
            count++;
    }

    return count;
}


bool readField(
    const String& line,
    uint8_t requestedField,
    String& result
)
{
    uint32_t fieldStart = 0;
    uint8_t currentField = 0;

    for (uint32_t i = 0; i <= line.length(); i++)
    {
        bool fieldEnd =
            (i == line.length()) ||
            (line.charAt(i) == '|');

        if (!fieldEnd)
            continue;

        if (currentField == requestedField)
        {
            result =
                line.substring(fieldStart, i);

            return true;
        }

        currentField++;
        fieldStart = i + 1;
    }

    result = "";

    return false;
}


bool isHexCharacter(char value)
{
    return
        (value >= '0' && value <= '9') ||
        (value >= 'A' && value <= 'F') ||
        (value >= 'a' && value <= 'f');
}


uint8_t hexCharacterValue(char value)
{
    if (value >= '0' && value <= '9')
    {
        return static_cast<uint8_t>(
            value - '0'
        );
    }

    if (value >= 'A' && value <= 'F')
    {
        return static_cast<uint8_t>(
            value - 'A' + 10
        );
    }

    return static_cast<uint8_t>(
        value - 'a' + 10
    );
}


String encodeTextValue(const String& value)
{
    static const char HEX[] =
        "0123456789ABCDEF";

    String result;

    result.reserve(value.length() + 8);

    for (uint32_t i = 0; i < value.length(); i++)
    {
        uint8_t current =
            static_cast<uint8_t>(
                value.charAt(i)
            );

        bool mustEncode =
            current == '%' ||
            current == '|' ||
            current == '\r' ||
            current == '\n' ||
            current < 32 ||
            current == 127;

        if (!mustEncode)
        {
            result +=
                static_cast<char>(current);

            continue;
        }

        result += '%';

        result +=
            HEX[(current >> 4) & 0x0F];

        result +=
            HEX[current & 0x0F];
    }

    return result;
}


bool decodeTextValue(
    const String& value,
    String& result
)
{
    result = "";

    result.reserve(value.length());

    for (uint32_t i = 0; i < value.length(); i++)
    {
        char current = value.charAt(i);

        if (current != '%')
        {
            result += current;
            continue;
        }

        if (i + 2 >= value.length())
            return false;

        char high = value.charAt(i + 1);
        char low = value.charAt(i + 2);

        if (!isHexCharacter(high) ||
            !isHexCharacter(low))
        {
            return false;
        }

        uint8_t decoded =
            static_cast<uint8_t>(
                hexCharacterValue(high) << 4
            );

        decoded |=
            hexCharacterValue(low);

        result +=
            static_cast<char>(decoded);

        i += 2;
    }

    return true;
}


bool parseUnsigned32(
    const String& value,
    uint32_t& result
)
{
    if (value.length() == 0)
        return false;

    uint64_t parsed = 0;

    for (uint32_t i = 0; i < value.length(); i++)
    {
        char current =
            value.charAt(i);

        if (current < '0' ||
            current > '9')
        {
            return false;
        }

        parsed =
            (parsed * 10ULL) +
            static_cast<uint8_t>(
                current - '0'
            );

        if (parsed > 0xFFFFFFFFULL)
            return false;
    }

    result =
        static_cast<uint32_t>(parsed);

    return true;
}


bool parseUnsigned64(
    const String& value,
    uint64_t& result
)
{
    if (value.length() == 0)
        return false;

    uint64_t parsed = 0;

    for (uint32_t i = 0; i < value.length(); i++)
    {
        char current =
            value.charAt(i);

        if (current < '0' ||
            current > '9')
        {
            return false;
        }

        uint8_t digit =
            static_cast<uint8_t>(
                current - '0'
            );

        if (parsed >
            (PLAYTIME_UINT64_MAX - digit) /
            10ULL)
        {
            return false;
        }

        parsed =
            (parsed * 10ULL) + digit;
    }

    result = parsed;

    return true;
}


String unsigned64ToString(uint64_t value)
{
    char buffer[24];

    uint8_t position =
        sizeof(buffer) - 1;

    buffer[position] = '\0';

    do
    {
        uint8_t digit =
            static_cast<uint8_t>(
                value % 10ULL
            );

        value /= 10ULL;

        buffer[--position] =
            static_cast<char>(
                '0' + digit
            );
    }
    while (value > 0);

    return String(&buffer[position]);
}


bool validIdentifierValue(
    const String& value,
    uint32_t maximumLength
)
{
    if (value.length() == 0 ||
        value.length() > maximumLength)
    {
        return false;
    }

    for (uint32_t i = 0; i < value.length(); i++)
    {
        uint8_t current =
            static_cast<uint8_t>(
                value.charAt(i)
            );

        if (current < 32 ||
            current == 127)
        {
            return false;
        }
    }

    return true;
}


bool validTitleValue(const String& value)
{
    if (value.length() == 0 ||
        value.length() > 96)
    {
        return false;
    }

    for (uint32_t i = 0; i < value.length(); i++)
    {
        uint8_t current =
            static_cast<uint8_t>(
                value.charAt(i)
            );

        if (current < 32 ||
            current == 127)
        {
            return false;
        }
    }

    return true;
}


PlaytimeInfo makeEmptyPlaytimeInfo()
{
    PlaytimeInfo info;

    info.id = "";
    info.source = "";
    info.title = "";

    info.totalMilliseconds = 0;
    info.sessionCount = 0;
    info.lastPlayedAt = 0;

    info.persistent = false;
    info.valid = false;

    return info;
}


bool hasDuplicateID(
    const PlaytimeInfo* items,
    uint16_t count,
    const String& id
)
{
    if (items == nullptr)
        return false;

    for (uint16_t i = 0; i < count; i++)
    {
        if (items[i].valid &&
            items[i].id == id)
        {
            return true;
        }
    }

    return false;
}


bool parsePlaytimeRecord(
    const String& line,
    PlaytimeInfo& entry,
    bool& repaired
)
{
    if (countFields(line) != 8)
        return false;

    String recordType;
    String encodedID;
    String encodedSource;
    String encodedTitle;
    String totalField;
    String sessionCountField;
    String lastPlayedField;
    String persistentField;

    if (!readField(
            line,
            0,
            recordType
        ) ||
        !readField(
            line,
            1,
            encodedID
        ) ||
        !readField(
            line,
            2,
            encodedSource
        ) ||
        !readField(
            line,
            3,
            encodedTitle
        ) ||
        !readField(
            line,
            4,
            totalField
        ) ||
        !readField(
            line,
            5,
            sessionCountField
        ) ||
        !readField(
            line,
            6,
            lastPlayedField
        ) ||
        !readField(
            line,
            7,
            persistentField
        ))
    {
        return false;
    }

    if (recordType != "P")
        return false;

    entry =
        makeEmptyPlaytimeInfo();

    if (!decodeTextValue(
            encodedID,
            entry.id
        ) ||
        !decodeTextValue(
            encodedSource,
            entry.source
        ) ||
        !decodeTextValue(
            encodedTitle,
            entry.title
        ))
    {
        return false;
    }

    uint64_t loadedTotal = 0;

    uint32_t loadedSessionCount = 0;
    uint32_t loadedLastPlayed = 0;
    uint32_t loadedPersistent = 0;

    if (!parseUnsigned64(
            totalField,
            loadedTotal
        ) ||
        !parseUnsigned32(
            sessionCountField,
            loadedSessionCount
        ) ||
        !parseUnsigned32(
            lastPlayedField,
            loadedLastPlayed
        ) ||
        !parseUnsigned32(
            persistentField,
            loadedPersistent
        ))
    {
        return false;
    }

    if (!validIdentifierValue(
            entry.id,
            48
        ) ||
        !validIdentifierValue(
            entry.source,
            48
        ) ||
        !validTitleValue(
            entry.title
        ) ||
        loadedPersistent > 1)
    {
        return false;
    }

    if (loadedPersistent == 0)
    {
        repaired = true;
        return false;
    }

    entry.totalMilliseconds =
        loadedTotal;

    entry.sessionCount =
        loadedSessionCount;

    entry.lastPlayedAt =
        loadedLastPlayed;

    entry.persistent = true;
    entry.valid = true;

    return true;
}


bool removeIfExists(const String& path)
{
    if (!StorageManager::exists(path))
        return true;

    return StorageManager::deleteFile(path);
}


bool copyFileContents(
    const String& sourcePath,
    const String& destinationPath
)
{
    File source =
        StorageManager::openFile(
            sourcePath,
            FILE_READ
        );

    if (!source)
        return false;

    if (!removeIfExists(destinationPath))
    {
        StorageManager::closeFile(source);
        return false;
    }

    File destination =
        StorageManager::openFile(
            destinationPath,
            FILE_WRITE
        );

    if (!destination)
    {
        StorageManager::closeFile(source);
        return false;
    }

    bool succeeded = true;

    uint8_t buffer[256];

    while (source.available())
    {
        int bytesRead =
            source.read(
                buffer,
                sizeof(buffer)
            );

        if (bytesRead <= 0)
        {
            succeeded = false;
            break;
        }

        size_t bytesWritten =
            destination.write(
                buffer,
                static_cast<size_t>(
                    bytesRead
                )
            );

        if (bytesWritten !=
            static_cast<size_t>(
                bytesRead
            ))
        {
            succeeded = false;
            break;
        }
    }

    destination.flush();

    if (destination.getWriteError() != 0)
        succeeded = false;

    StorageManager::closeFile(source);

    StorageManager::closeFile(
        destination
    );

    if (!succeeded)
        removeIfExists(destinationPath);

    return succeeded;
}


bool quarantineFile(
    const String& sourcePath,
    const String& quarantinePath
)
{
    if (!StorageManager::exists(sourcePath))
        return true;

    if (!removeIfExists(quarantinePath))
        return false;

    return StorageManager::renameFile(
        sourcePath,
        quarantinePath
    );
}


uint16_t persistentEntryCount(
    const PlaytimeInfo* items,
    uint16_t itemCount
)
{
    if (items == nullptr)
        return 0;

    uint16_t result = 0;

    for (uint16_t i = 0; i < itemCount; i++)
    {
        if (items[i].valid &&
            items[i].persistent)
        {
            result++;
        }
    }

    return result;
}


bool writePlaytimeDatabase(
    const String& path,
    const char* header,
    uint16_t version,
    const PlaytimeInfo* items,
    uint16_t itemCount
)
{
    if (!removeIfExists(path))
        return false;

    File file =
        StorageManager::openFile(
            path,
            FILE_WRITE
        );

    if (!file)
        return false;

    uint16_t persistentCount =
        persistentEntryCount(
            items,
            itemCount
        );

    file.println(header);
    file.println(version);
    file.println(persistentCount);

    for (uint16_t i = 0; i < itemCount; i++)
    {
        const PlaytimeInfo& entry =
            items[i];

        if (!entry.valid ||
            !entry.persistent)
        {
            continue;
        }

        file.print("P|");

        file.print(
            encodeTextValue(entry.id)
        );

        file.print('|');

        file.print(
            encodeTextValue(entry.source)
        );

        file.print('|');

        file.print(
            encodeTextValue(entry.title)
        );

        file.print('|');

        file.print(
            unsigned64ToString(
                entry.totalMilliseconds
            )
        );

        file.print('|');

        file.print(entry.sessionCount);

        file.print('|');

        file.print(entry.lastPlayedAt);

        file.print('|');

        file.println(
            static_cast<uint8_t>(1)
        );
    }

    file.flush();

    bool succeeded =
        file.getWriteError() == 0;

    StorageManager::closeFile(file);

    if (!succeeded)
        removeIfExists(path);

    return succeeded;
}


bool loadPlaytimeDatabase(
    const String& path,
    const char* expectedHeader,
    uint16_t expectedVersion,
    PlaytimeInfo* output,
    uint16_t maximumCount,
    uint16_t& outputCount,
    bool& repaired
)
{
    outputCount = 0;
    repaired = false;

    if (output != nullptr)
    {
        for (uint16_t i = 0;
             i < maximumCount;
             i++)
        {
            output[i] =
                makeEmptyPlaytimeInfo();
        }
    }

    File file =
        StorageManager::openFile(
            path,
            FILE_READ
        );

    if (!file)
        return false;

    String header =
        file.readStringUntil('\n');

    removeCarriageReturn(header);

    if (header != expectedHeader)
    {
        StorageManager::closeFile(file);
        return false;
    }

    String versionLine =
        file.readStringUntil('\n');

    removeCarriageReturn(versionLine);

    uint32_t loadedVersion = 0;

    if (!parseUnsigned32(
            versionLine,
            loadedVersion
        ) ||
        loadedVersion != expectedVersion)
    {
        StorageManager::closeFile(file);
        return false;
    }

    String countLine =
        file.readStringUntil('\n');

    removeCarriageReturn(countLine);

    uint32_t declaredCount = 0;

    if (!parseUnsigned32(
            countLine,
            declaredCount
        ) ||
        declaredCount > maximumCount)
    {
        StorageManager::closeFile(file);
        return false;
    }

    uint32_t physicalRecordCount = 0;

    while (file.available())
    {
        String line =
            file.readStringUntil('\n');

        removeCarriageReturn(line);

        if (line.length() == 0)
        {
            repaired = true;
            continue;
        }

        physicalRecordCount++;

        if (line.length() > 768)
        {
            repaired = true;
            continue;
        }

        PlaytimeInfo entry;

        bool recordRepaired = false;

        if (!parsePlaytimeRecord(
                line,
                entry,
                recordRepaired
            ))
        {
            repaired = true;
            continue;
        }

        if (hasDuplicateID(
                output,
                outputCount,
                entry.id
            ))
        {
            repaired = true;
            continue;
        }

        if (outputCount >= maximumCount)
        {
            repaired = true;
            break;
        }

        if (output != nullptr)
            output[outputCount] = entry;

        outputCount++;

        if (recordRepaired)
            repaired = true;
    }

    StorageManager::closeFile(file);

    if (physicalRecordCount !=
            declaredCount ||
        outputCount != declaredCount)
    {
        repaired = true;
    }

    return true;
}


bool isLeapYearValue(uint16_t year)
{
    if ((year % 400) == 0)
        return true;

    if ((year % 100) == 0)
        return false;

    return (year % 4) == 0;
}


uint8_t daysInMonthValue(
    uint8_t month,
    uint16_t year
)
{
    static const uint8_t MONTH_DAYS[12] =
    {
        31,
        28,
        31,
        30,
        31,
        30,
        31,
        31,
        30,
        31,
        30,
        31
    };

    if (month < 1 ||
        month > 12)
    {
        return 0;
    }

    if (month == 2 &&
        isLeapYearValue(year))
    {
        return 29;
    }

    return MONTH_DAYS[month - 1];
}

}


PlaytimeInfo PlaytimeManager::entries[
    PlaytimeManager::MAX_PLAYTIME_ENTRIES
];


uint16_t PlaytimeManager::entryCount = 0;


bool PlaytimeManager::initialized = false;


bool PlaytimeManager::dirty = false;


uint32_t PlaytimeManager::lastChangeTime = 0;


bool PlaytimeManager::active = false;


bool PlaytimeManager::paused = false;


int16_t PlaytimeManager::activeIndex = -1;


uint64_t PlaytimeManager::sessionMilliseconds = 0;


uint32_t PlaytimeManager::lastTickTime = 0;
bool PlaytimeManager::begin()
{
    if (initialized)
        return true;

    clearMemory();

    if (!StorageManager::ready())
        return false;

    if (!load())
    {
        clearMemory();
        return false;
    }

    initialized = true;

    if (dirty)
        lastChangeTime = millis();

    return true;
}


void PlaytimeManager::update()
{
    if (!initialized)
        return;

    if (active &&
        !paused &&
        !flushActiveTime())
    {
        return;
    }

    if (!dirty)
        return;

    if (millis() - lastChangeTime <
        AUTO_SAVE_DELAY)
    {
        return;
    }

    if (!save())
        lastChangeTime = millis();
}


bool PlaytimeManager::ready()
{
    return
        initialized &&
        StorageManager::ready();
}


bool PlaytimeManager::registerEntry(
    const String& id,
    const String& source,
    const String& title,
    bool persistent
)
{
    if (!initialized ||
        !validID(id) ||
        !validSource(source) ||
        !validTitle(title))
    {
        return false;
    }

    int16_t existingIndex =
        find(id);

    if (existingIndex >= 0)
    {
        PlaytimeInfo& entry =
            entries[existingIndex];

        bool wasPersistent =
            entry.persistent;

        bool changed = false;

        if (entry.source != source)
        {
            entry.source = source;
            changed = true;
        }

        if (entry.title != title)
        {
            entry.title = title;
            changed = true;
        }

        if (entry.persistent != persistent)
        {
            entry.persistent = persistent;
            changed = true;
        }

        if (changed &&
            (wasPersistent ||
             entry.persistent))
        {
            markDirty();
        }

        return true;
    }

    if (entryCount >=
        MAX_PLAYTIME_ENTRIES)
    {
        return false;
    }

    PlaytimeInfo entry =
        emptyInfo();

    entry.id = id;
    entry.source = source;
    entry.title = title;

    entry.totalMilliseconds = 0;
    entry.sessionCount = 0;
    entry.lastPlayedAt = 0;

    entry.persistent = persistent;
    entry.valid = true;

    entries[entryCount] = entry;

    entryCount++;

    if (persistent)
        markDirty();

    return true;
}


bool PlaytimeManager::startSession(
    const String& id
)
{
    if (!initialized || active)
        return false;

    int16_t index = find(id);

    if (index < 0)
        return false;

    PlaytimeInfo& entry =
        entries[index];

    if (entry.sessionCount ==
        0xFFFFFFFFUL)
    {
        return false;
    }

    entry.sessionCount++;

    entry.lastPlayedAt =
        getTimestamp();

    active = true;
    paused = false;

    activeIndex = index;

    sessionMilliseconds = 0;

    lastTickTime = millis();

    if (entry.persistent)
        markDirty();

    return true;
}


bool PlaytimeManager::stopSession(
    bool saveImmediately
)
{
    if (!initialized || !active)
        return false;

    if (!paused &&
        !flushActiveTime())
    {
        return false;
    }

    int16_t stoppedIndex =
        activeIndex;

    if (stoppedIndex >= 0 &&
        validIndex(
            static_cast<uint16_t>(
                stoppedIndex
            )
        ))
    {
        PlaytimeInfo& entry =
            entries[stoppedIndex];

        entry.lastPlayedAt =
            getTimestamp();

        if (entry.persistent)
            markDirty();
    }

    clearSession();

    if (saveImmediately && dirty)
        return save();

    return true;
}


bool PlaytimeManager::pauseSession()
{
    if (!initialized ||
        !active ||
        paused)
    {
        return false;
    }

    if (!flushActiveTime())
        return false;

    paused = true;

    lastTickTime = 0;

    return true;
}


bool PlaytimeManager::resumeSession()
{
    if (!initialized ||
        !active ||
        !paused)
    {
        return false;
    }

    paused = false;

    lastTickTime = millis();

    return true;
}


