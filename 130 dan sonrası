            PsramPoolError::InvalidBlock,
            RuntimeResult::InvalidArgument);

        return {};
    }

    const uint8_t firstClass =
        bestClassFor(requestedBytes);

    if (firstClass == PSRAM_POOL_INVALID_CLASS)
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
