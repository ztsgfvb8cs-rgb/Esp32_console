    Healthy = 0,
    Degraded,
    Recovering,
    Critical,
    Fatal
};

enum class RuntimeHealthSubsystem : uint8_t
{
    None = 0,
    ModuleManager,
    SessionBridge,
    InputRouter,
    ScreenRouter,
    AudioCoordinator,
    PowerCoordinator,
    InternalMemory,
    Psram,
    System
};

enum class RuntimeRecoveryAction : uint8_t
{
    None = 0,
    ClearTransientInput,
    RequestForegroundClose,
    ForceForegroundClose,
    ResetScreenRoute,
    SuspendAudio,
    RestoreAudio,
    ReturnToMainMenu,
    RequestSafeShutdown,
    EnterFatalState
};

enum class RuntimeHealthError : uint8_t
{
    None = 0,
    NotInitialized,
    RequiredCoordinatorNotReady,
    ForegroundStateMismatch,
    SessionStalled,
    RepeatedRenderFailure,
    InputRoutingFailure,
    AudioPolicyFailure,
    PowerPolicyFailure,
    LowInternalMemory,
    LowPsram,
    RecoveryCooldownActive,
    RecoveryLimitReached,
    RecoveryActionFailed,
    FatalRuntimeState
};

struct RuntimeHealthPolicy
{
    // Free-memory thresholds preserve enough headroom for input,
    // logging, foreground cleanup and shutdown preparation.
    size_t minimumInternalFreeBytes = 40UL * 1024UL;
    size_t criticalInternalFreeBytes = 24UL * 1024UL;
    size_t minimumPsramFreeBytes = 192UL * 1024UL;
    size_t criticalPsramFreeBytes = 96UL * 1024UL;

    // A foreground session may remain in Starting/Stopping only for a
    // bounded interval before recovery is requested.
    uint32_t startupTimeoutMs = 5000UL;
    uint32_t stopTimeoutMs = 3000UL;

    // Health sampling is intentionally slower than frame processing.
    uint16_t sampleIntervalMs = 250U;
    uint16_t recoveryCooldownMs = 1000U;

    uint8_t maximumConsecutiveRenderFailures = 3U;
    uint8_t maximumRecoveryAttempts = 3U;

    bool recoverForegroundAutomatically = true;
    bool returnToMainMenuAfterRecovery = true;
    bool requestShutdownOnCriticalMemory = true;
    bool markFatalAfterRecoveryLimit = true;
};

struct RuntimeHealthStatus
{
    bool initialized = false;
    bool suspended = false;
    bool foregroundActive = false;
    bool recoveryPending = false;
    bool recoveryInProgress = false;
    bool fatalState = false;

    RuntimeHealthLevel level = RuntimeHealthLevel::Healthy;
    RuntimeHealthSubsystem subsystem = RuntimeHealthSubsystem::None;
    RuntimeRecoveryAction pendingAction = RuntimeRecoveryAction::None;
    RuntimeRecoveryAction lastAction = RuntimeRecoveryAction::None;
    RuntimeHealthError error = RuntimeHealthError::None;
    RuntimeResult lastResult = RuntimeResult::Ok;

    RuntimeModuleKind moduleKind = RuntimeModuleKind::None;
    RuntimeModuleState moduleState = RuntimeModuleState::Stopped;
    RuntimeModuleError moduleError = RuntimeModuleError::None;
    RuntimeSessionError sessionError = RuntimeSessionError::None;
    RuntimeInputError inputError = RuntimeInputError::None;
    RuntimeScreenError screenError = RuntimeScreenError::None;
    RuntimeAudioError audioError = RuntimeAudioError::None;
    RuntimePowerError powerError = RuntimePowerError::None;

    size_t freeInternalBytes = 0;
    size_t freePsramBytes = 0;

    uint32_t observedTransitionSequence = 0;
    uint32_t stateEnteredAtMs = 0;
    uint32_t lastSampleAtMs = 0;
    uint32_t lastRecoveryAtMs = 0;
    uint32_t healthSequence = 0;
    uint32_t recoverySequence = 0;

    uint8_t recoveryAttempts = 0;
    uint8_t consecutiveHealthySamples = 0;
};

using RuntimeHealthObserver = void (*)(
    const RuntimeHealthStatus& status);

