    GamePlaytimeRecord& record
)
{
    if(!managerInitialized)
    {
        return false;
    }


    if(index >=
       recordCount)
    {
        return false;
    }


    if(!records[index].valid)
    {
        return false;
    }


    record =
        records[index];


    return true;
}



bool PlaytimeManager::get(
    const String& gameName,
    GamePlaytimeRecord& record
)
{
    int16_t gameIndex =
        find(
            gameName
        );


    if(gameIndex ==
       PLAYTIME_INVALID_GAME_INDEX)
    {
        return false;
