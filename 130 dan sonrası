bool PsramPool::validateConfig(
    const PsramPoolConfig& config,
    PsramPoolError* error) const
{
    if (error != nullptr)
    {
        *error = PsramPoolError::None;
    }

    if (!validPreference(config.preference) ||
        config.classCount == 0 ||
        config.classCount >
            PSRAM_POOL_MAX_SIZE_CLASSES ||
        (config.requirePsram &&
         config.preference ==
             MemoryPreference::InternalOnly))
    {
        if (error != nullptr)
        {
            *error =
                PsramPoolError::InvalidConfiguration;
        }

        return false;
    }

    uint16_t totalBlocks = 0;
    size_t previousBlockSize = 0;
    size_t totalReservedBytes = 0;

    for (uint8_t classIndex = 0;
         classIndex < config.classCount;
         ++classIndex)
    {
        const PsramPoolSizeClassConfig& classConfig =
            config.classes[classIndex];

        if (classConfig.blockSizeBytes == 0 ||
            classConfig.blockCount == 0)
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::InvalidConfiguration;
            }

            return false;
        }

        if (!validAlignment(classConfig.alignment))
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::InvalidAlignment;
            }

            return false;
        }

        if (classIndex > 0 &&
            classConfig.blockSizeBytes <=
                previousBlockSize)
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::InvalidConfiguration;
            }

            return false;
        }

        if (classConfig.blockCount >
            PSRAM_POOL_MAX_BLOCKS - totalBlocks)
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::CapacityOverflow;
            }

            return false;
        }

        size_t stride = 0;

        if (!alignSize(
                classConfig.blockSizeBytes,
                classConfig.alignment,
                &stride) ||
            multiplyWouldOverflow(
                stride,
                classConfig.blockCount))
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::CapacityOverflow;
            }

            return false;
        }

        const size_t classDataBytes =
            stride * classConfig.blockCount;

        const size_t alignmentPadding =
            classConfig.alignment - 1U;

        if (addWouldOverflow(
                classDataBytes,
                alignmentPadding))
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::CapacityOverflow;
            }

            return false;
        }

        const size_t classReservedBytes =
            classDataBytes + alignmentPadding;

        if (addWouldOverflow(
                totalReservedBytes,
                classReservedBytes))
        {
            if (error != nullptr)
            {
                *error =
                    PsramPoolError::CapacityOverflow;
            }

            return false;
        }

        totalReservedBytes += classReservedBytes;
        totalBlocks = static_cast<uint16_t>(
            totalBlocks + classConfig.blockCount);
        previousBlockSize = classConfig.blockSizeBytes;
    }

    return totalBlocks > 0 &&
        totalReservedBytes > 0;
}

int PsramPool::findFreeSlotInClass(
    uint8_t classIndex) const
{
    if (!ready() ||
        classIndex >= config_.classCount)
    {
        return -1;
    }

    const uint16_t classStart =
        classSlotStarts_[classIndex];

    const uint16_t classCount =
        config_.classes[classIndex].blockCount;

    for (uint16_t localSlot = 0;
         localSlot < classCount;
         ++localSlot)
    {
        const uint16_t globalSlot =
            static_cast<uint16_t>(
                classStart + localSlot);

        if (!slots_[globalSlot].used)
        {
            return static_cast<int>(globalSlot);
        }
    }

    return -1;
}

void* PsramPool::pointerForSlot(
    uint8_t classIndex,
    uint16_t slotIndex) const
{
    if (classIndex >= config_.classCount ||
        !backings_[classIndex])
    {
        return nullptr;
    }

    const uint16_t classStart =
        classSlotStarts_[classIndex];

    const uint16_t classCount =
        config_.classes[classIndex].blockCount;

    if (slotIndex < classStart ||
        slotIndex >=
            static_cast<uint16_t>(
                classStart + classCount))
    {
        return nullptr;
    }

    const size_t localSlot =
        static_cast<size_t>(slotIndex - classStart);

    const uintptr_t rawBase =
        reinterpret_cast<uintptr_t>(
            backings_[classIndex].data);

    const size_t alignment =
        config_.classes[classIndex].alignment;

    const uintptr_t alignmentMask =
        static_cast<uintptr_t>(alignment - 1U);

    if (rawBase > UINTPTR_MAX - alignmentMask)
    {
        return nullptr;
    }

    const uintptr_t alignedBase =
        (rawBase + alignmentMask) &
        ~alignmentMask;

    const size_t baseAdjustment =
        static_cast<size_t>(alignedBase - rawBase);

    const size_t offset =
        localSlot * classStrides_[classIndex];

    if (baseAdjustment > backings_[classIndex].size ||
        offset >
            backings_[classIndex].size -
            baseAdjustment ||
        classStrides_[classIndex] >
            backings_[classIndex].size -
            baseAdjustment - offset)
    {
        return nullptr;
    }

    return reinterpret_cast<void*>(
        alignedBase + offset);
}

PsramPoolBlock PsramPool::acquireFromResolvedClass(
    uint8_t classIndex,
    size_t requestedBytes,
    PsramPoolClearMode clearMode)
{
    const int freeSlot =
        findFreeSlotInClass(classIndex);

    if (freeSlot < 0)
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::PoolExhausted,
            RuntimeResult::OutOfMemory);

        return {};
    }

    const uint16_t slotIndex =
        static_cast<uint16_t>(freeSlot);

    void* const pointer =
        pointerForSlot(classIndex, slotIndex);

    if (pointer == nullptr)
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::BackingAllocationFailed,
            RuntimeResult::InternalError);

        return {};
    }

    if (shouldClearOnAcquire(classIndex, clearMode))
    {
        memset(
            pointer,
            0,
            classStrides_[classIndex]);
    }

    uint32_t leaseId = nextLeaseId_;

    if (leaseId == 0)
    {
        leaseId = 1U;
    }

    nextLeaseId_ = nextLease(leaseId);

    SlotMetadata& metadata = slots_[slotIndex];
    metadata.used = true;
    metadata.classIndex = classIndex;
    metadata.leaseId = leaseId;
    metadata.requestedBytes = requestedBytes;

    if (classUsedBlocks_[classIndex] < UINT16_MAX)
    {
        ++classUsedBlocks_[classIndex];
    }

    if (classUsedBlocks_[classIndex] >
        classPeakUsedBlocks_[classIndex])
    {
        classPeakUsedBlocks_[classIndex] =
            classUsedBlocks_[classIndex];
    }

    if (addWouldOverflow(
            classRequestedBytes_[classIndex],
            requestedBytes))
    {
        classRequestedBytes_[classIndex] = SIZE_MAX;
    }
    else
    {
        classRequestedBytes_[classIndex] +=
            requestedBytes;
    }

    if (status_.allocationCount < UINT32_MAX)
    {
        ++status_.allocationCount;
    }

    PsramPoolBlock block;
    block.data = pointer;
    block.requestedBytes = requestedBytes;
    block.capacityBytes =
        config_.classes[classIndex].blockSizeBytes;
    block.slotIndex = slotIndex;
    block.classIndex = classIndex;
    block.generation = status_.generation;
    block.leaseId = leaseId;

    status_.error = PsramPoolError::None;
    refreshStatus();
    notifyStateChanged();

    return block;
}

bool PsramPool::shouldClearOnAcquire(
    uint8_t classIndex,
    PsramPoolClearMode clearMode) const
{
    if (clearMode == PsramPoolClearMode::Clear)
    {
        return true;
    }

    if (clearMode == PsramPoolClearMode::Preserve)
    {
        return false;
    }

    return classIndex < config_.classCount &&
        config_.classes[classIndex].clearOnAcquire;
}

bool PsramPool::shouldClearOnRelease(
    PsramPoolClearMode clearMode) const
{
    if (clearMode == PsramPoolClearMode::Clear)
    {
        return true;
    }

    if (clearMode == PsramPoolClearMode::Preserve)
    {
        return false;
    }

    return config_.clearBlocksOnRelease;
}

void PsramPool::refreshStatus()
{
    if (!status_.initialized)
    {
        status_.allBackingsInPsram = false;
        status_.exhausted = false;
        status_.totalBlocks = 0;
        status_.usedBlocks = 0;
        status_.freeBlocks = 0;
        status_.reservedBytes = 0;
        status_.usedCapacityBytes = 0;
        status_.requestedBytes = 0;
        status_.wastedBytes = 0;
        return;
    }

    uint16_t totalBlocks = 0;
    uint16_t usedBlocks = 0;
    size_t reservedBytes = 0;
    size_t usedCapacityBytes = 0;
    size_t requestedBytes = 0;
    bool allInPsram = true;

    for (uint8_t classIndex = 0;
         classIndex < config_.classCount;
         ++classIndex)
    {
        const PsramPoolSizeClassConfig& classConfig =
            config_.classes[classIndex];

        totalBlocks = static_cast<uint16_t>(
            totalBlocks + classConfig.blockCount);

        usedBlocks = static_cast<uint16_t>(
            usedBlocks + classUsedBlocks_[classIndex]);

        reservedBytes += backings_[classIndex].size;

        usedCapacityBytes +=
            classConfig.blockSizeBytes *
            classUsedBlocks_[classIndex];

        requestedBytes +=
            classRequestedBytes_[classIndex];

        allInPsram =
            allInPsram && backings_[classIndex].psram;
    }

    status_.classCount = config_.classCount;
    status_.preference = config_.preference;
    status_.allBackingsInPsram = allInPsram;
    status_.totalBlocks = totalBlocks;
    status_.usedBlocks = usedBlocks;
    status_.freeBlocks = static_cast<uint16_t>(
        totalBlocks - usedBlocks);
    status_.exhausted =
        totalBlocks > 0 && usedBlocks == totalBlocks;
    status_.reservedBytes = reservedBytes;
    status_.usedCapacityBytes = usedCapacityBytes;
    status_.requestedBytes = requestedBytes;
    status_.wastedBytes =
        usedCapacityBytes >= requestedBytes
            ? usedCapacityBytes - requestedBytes
            : 0;

    if (usedBlocks > status_.peakUsedBlocks)
    {
        status_.peakUsedBlocks = usedBlocks;
    }

    if (usedCapacityBytes >
        status_.peakUsedCapacityBytes)
    {
        status_.peakUsedCapacityBytes =
            usedCapacityBytes;
    }
}

void PsramPool::resetMetadata(
