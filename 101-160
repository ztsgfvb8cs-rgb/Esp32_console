//====================================================
// ESP32 GAME STATION
// ESP32-S3 DEVKITC-1 N16R8 PIN MAP
// 103_board_pins.h
//====================================================
//
// Notes:
// - GPIO26..GPIO37 are deliberately not used. They can be
//   occupied by the module's flash/Octal PSRAM interface.
// - GPIO0, GPIO3, GPIO45 and GPIO46 are strapping pins and
//   are deliberately not used.
// - GPIO19/20 are left free for native USB.
// - GPIO43/44 are left free for UART0 diagnostics.
// - The phone keypad matrix is intentionally not defined
//   here. It will be added after its matrix is finalized.
//
// External hardware expectations:
// - Buttons connect the assigned GPIO to GND when pressed.
// - Haptic output drives a MOSFET/transistor, never the
//   vibration motor directly.
// - TFT reset is tied to the board reset/3.3 V as required.
// - Touch IRQ is not required; touch is polled over SPI.
//====================================================

namespace BoardPins
{
    using Pin = int8_t;

    inline constexpr Pin NOT_CONNECTED = -1;

    //================================================
    // RESERVED INTERFACES
    //================================================

    inline constexpr Pin USB_D_MINUS_PIN = 19;
    inline constexpr Pin USB_D_PLUS_PIN  = 20;

    inline constexpr Pin UART0_TX_PIN = 43;
    inline constexpr Pin UART0_RX_PIN = 44;

    //================================================
    // SHARED SPI BUS
    // ILI9341 + XPT2046 + TFT MICROSD
    //================================================

    inline constexpr Pin SPI_MOSI_PIN = 11;
    inline constexpr Pin SPI_SCLK_PIN = 12;
    inline constexpr Pin SPI_MISO_PIN = 13;

    inline constexpr Pin TFT_CS_PIN        = 10;
    inline constexpr Pin TFT_DC_PIN        = 9;
    inline constexpr Pin TFT_RESET_PIN     = NOT_CONNECTED;
    inline constexpr Pin TFT_BACKLIGHT_PIN = 8;

    inline constexpr Pin TOUCH_CS_PIN  = 7;
    inline constexpr Pin TOUCH_IRQ_PIN = NOT_CONNECTED;

    inline constexpr Pin SD_CS_PIN = 6;

    //================================================
    // I2S AUDIO BUS
    // MAX98357A + PCM5102A
    //================================================

    inline constexpr Pin I2S_BCLK_PIN = 39;
    inline constexpr Pin I2S_WS_PIN   = 40;
    inline constexpr Pin I2S_DATA_OUT_PIN = 41;

    // Speaker muting is expected to be handled by the
    // switched headphone jack or external hardware.
    inline constexpr Pin SPEAKER_AMP_ENABLE_PIN =
        NOT_CONNECTED;

    inline constexpr Pin HEADPHONE_AMP_ENABLE_PIN =
        NOT_CONNECTED;

    inline constexpr Pin HEADPHONE_DETECT_PIN = 48;

    //================================================
    // I2C BUS
    // DS3231 RTC
    //================================================

    inline constexpr Pin I2C_SCL_PIN = 42;
    inline constexpr Pin I2C_SDA_PIN = 47;

    //================================================
    // DIRECT GAME CONTROLS
    // ACTIVE LOW, INTERNAL PULL-UP
    //================================================

    inline constexpr Pin BUTTON_UP_PIN    = 1;
    inline constexpr Pin BUTTON_DOWN_PIN  = 2;
    inline constexpr Pin BUTTON_LEFT_PIN  = 14;
    inline constexpr Pin BUTTON_RIGHT_PIN = 15;

    inline constexpr Pin BUTTON_A_PIN = 16;
    inline constexpr Pin BUTTON_B_PIN = 17;

    inline constexpr Pin BUTTON_MENU_PIN = 18;
    inline constexpr Pin BUTTON_BACK_PIN = 21;

    inline constexpr Pin DIRECT_BUTTON_PINS[] =
    {
        BUTTON_UP_PIN,
        BUTTON_DOWN_PIN,
        BUTTON_LEFT_PIN,
        BUTTON_RIGHT_PIN,
        BUTTON_A_PIN,
        BUTTON_B_PIN,
        BUTTON_MENU_PIN,
        BUTTON_BACK_PIN
    };

    inline constexpr size_t DIRECT_BUTTON_COUNT =
        sizeof(DIRECT_BUTTON_PINS) /
        sizeof(DIRECT_BUTTON_PINS[0]);

    //================================================
    // POWER, BATTERY AND HAPTIC
    //================================================

    inline constexpr Pin BATTERY_ADC_PIN = 4;

    // Drives the gate/base of the haptic driver circuit.
    inline constexpr Pin HAPTIC_PWM_PIN = 5;

    inline constexpr Pin BOOST_ENABLE_PIN = 38;

    //================================================
    // OPTIONAL / CURRENTLY UNUSED
    //================================================

    inline constexpr Pin PIEZO_BUZZER_PIN =
        NOT_CONNECTED;

    inline constexpr Pin CHARGE_STATUS_PIN =
        NOT_CONNECTED;

    // Board revisions may place the onboard RGB LED on
    // GPIO38 or GPIO48. The project does not use it.
    inline constexpr Pin ONBOARD_RGB_LED_PIN =
        NOT_CONNECTED;

    //================================================
    // VALIDATION HELPERS
    //================================================

    constexpr bool isPhysicalEsp32S3Gpio(Pin pin)
    {
        return
            (pin >= 0 && pin <= 21) ||
            (pin >= 26 && pin <= 48);
    }

    constexpr bool isStrappingPin(Pin pin)
    {
        return
            pin == 0 ||
            pin == 3 ||
            pin == 45 ||
            pin == 46;
    }

    constexpr bool isMemoryBusPin(Pin pin)
    {
        return pin >= 26 && pin <= 37;
    }

    constexpr bool isNativeUsbPin(Pin pin)
    {
        return
            pin == USB_D_MINUS_PIN ||
            pin == USB_D_PLUS_PIN;
    }

    constexpr bool isUart0Pin(Pin pin)
    {
        return
            pin == UART0_TX_PIN ||
            pin == UART0_RX_PIN;
    }

    constexpr bool isSafeProjectPin(Pin pin)
    {
        return
            isPhysicalEsp32S3Gpio(pin) &&
            !isStrappingPin(pin) &&
            !isMemoryBusPin(pin) &&
            !isNativeUsbPin(pin) &&
            !isUart0Pin(pin);
    }
    template <size_t N>
    constexpr bool allPinsSafe(const Pin (&pins)[N])
    {
        for (size_t i = 0; i < N; ++i)
        {
            if (!isSafeProjectPin(pins[i]))
            {
                return false;
            }
        }

        return true;
    }

    template <size_t N>
    constexpr bool allPinsUnique(const Pin (&pins)[N])
    {
        for (size_t i = 0; i < N; ++i)
        {
            for (size_t j = i + 1; j < N; ++j)
            {
                if (pins[i] == pins[j])
                {
                    return false;
                }
            }
        }

        return true;
    }

    inline constexpr Pin ASSIGNED_PROJECT_PINS[] =
    {
        SPI_MOSI_PIN,
        SPI_SCLK_PIN,
        SPI_MISO_PIN,
        TFT_CS_PIN,
        TFT_DC_PIN,
        TFT_BACKLIGHT_PIN,
        TOUCH_CS_PIN,
        SD_CS_PIN,
        I2S_BCLK_PIN,
        I2S_WS_PIN,
        I2S_DATA_OUT_PIN,
        HEADPHONE_DETECT_PIN,
        I2C_SCL_PIN,
        I2C_SDA_PIN,
        BUTTON_UP_PIN,
        BUTTON_DOWN_PIN,
        BUTTON_LEFT_PIN,
        BUTTON_RIGHT_PIN,
        BUTTON_A_PIN,
        BUTTON_B_PIN,
        BUTTON_MENU_PIN,
        BUTTON_BACK_PIN,
        BATTERY_ADC_PIN,
        HAPTIC_PWM_PIN,
        BOOST_ENABLE_PIN
    };

    inline constexpr size_t ASSIGNED_PROJECT_PIN_COUNT =
        sizeof(ASSIGNED_PROJECT_PINS) /
        sizeof(ASSIGNED_PROJECT_PINS[0]);

    static_assert(
        allPinsSafe(ASSIGNED_PROJECT_PINS),
        "103_board_pins.h contains an unsafe ESP32-S3 pin");

    static_assert(
        allPinsUnique(ASSIGNED_PROJECT_PINS),
        "103_board_pins.h contains a duplicate pin assignment");

    static_assert(
        BATTERY_ADC_PIN >= 1 &&
        BATTERY_ADC_PIN <= 10,
        "Battery measurement must use an ADC1-capable pin");

    static_assert(
        DIRECT_BUTTON_COUNT == 8,
        "Exactly eight direct control buttons are expected");
}

