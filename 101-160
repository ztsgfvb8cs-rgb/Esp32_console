//====================================================
// FORMATTED VALUES
//====================================================

bool Logger::writeValue(
    LogLevel level,
    LogSource source,
    const String& tag,
    const String& name,
    int32_t value)
{
    String text;

    text.reserve(name.length() + 16);

    text = name;
    text += "=";
    text += String(
        static_cast<long>(value));

    return write(
        level,
        source,
        tag,
        text);
}

bool Logger::writeValue(
    LogLevel level,
    LogSource source,
    const String& tag,
    const String& name,
    uint32_t value)
{
    String text;

    text.reserve(name.length() + 16);

    text = name;
    text += "=";
    text += String(
        static_cast<unsigned long>(value));

    return write(
        level,
        source,
        tag,
        text);
}

bool Logger::writeValue(
    LogLevel level,
    LogSource source,
    const String& tag,
    const String& name,
    int64_t value)
{
    String text;

    text.reserve(name.length() + 24);

    text = name;
    text += "=";
    text += signed64ToString(value);

    return write(
        level,
        source,
        tag,
        text);
}

bool Logger::writeValue(
    LogLevel level,
    LogSource source,
    const String& tag,
    const String& name,
    uint64_t value)
{
    String text;

    text.reserve(name.length() + 24);

    text = name;
    text += "=";
    text += unsigned64ToString(value);

    return write(
        level,
        source,
        tag,
        text);
}

bool Logger::writeValue(
    LogLevel level,
    LogSource source,
    const String& tag,
    const String& name,
    float value,
    uint8_t decimalPlaces)
{
    String text;

    text.reserve(name.length() + 24);

    text = name;
    text += "=";
    text += String(
        value,
        decimalPlaces);

    return write(
        level,
        source,
        tag,
        text);
}

bool Logger::writeValue(
    LogLevel level,
    LogSource source,
    const String& tag,
    const String& name,
    bool value)
{
    String text;

    text.reserve(name.length() + 8);

    text = name;
    text += "=";
    text += value ? "true" : "false";

    return write(
        level,
        source,
        tag,
        text);
}
//====================================================
// MEMORY LOG ACCESS
//====================================================

uint16_t Logger::count()
{
    return entryCount;
}

LogEntry Logger::get(uint16_t index)
{
    if (index >= entryCount)
    {
        return emptyEntry();
    }

    return entries[physicalIndex(index)];
}

LogEntry Logger::latest()
{
    if (entryCount == 0)
    {
        return emptyEntry();
    }

    return get(entryCount - 1);
}

uint16_t Logger::countByLevel(LogLevel level)
{
    if (!validLevel(level))
    {
        return 0;
    }

    uint16_t result = 0;

    for (uint16_t i = 0;
         i < entryCount;
         ++i)
    {
        const LogEntry& entry =
            entries[physicalIndex(i)];

        if (entry.valid &&
            entry.level == level)
        {
            ++result;
        }
    }

    return result;
}

uint16_t Logger::countBySource(LogSource source)
{
    if (!validSource(source))
    {
        return 0;
    }

    uint16_t result = 0;

    for (uint16_t i = 0;
         i < entryCount;
         ++i)
    {
        const LogEntry& entry =
            entries[physicalIndex(i)];

        if (entry.valid &&
            entry.source == source)
        {
            ++result;
        }
    }

    return result;
}

void Logger::clearMemory()
{
    for (uint16_t i = 0;
         i < MAX_MEMORY_ENTRIES;
         ++i)
    {
        entries[i] = emptyEntry();
    }

    firstIndex = 0;
    entryCount = 0;

    pendingFileCount = 0;
    lastFileChangeTime = 0;
}

//====================================================
// FILE LOG
//====================================================

bool Logger::flush()
{
    if (!initialized)
    {
        return false;
    }

    if (pendingFileCount == 0)
    {
        return true;
    }

    return writePendingToFile();
}

bool Logger::clearFile()
{
    if (!initialized ||
        !StorageManager::ready())
    {
        return false;
    }

    bool result = true;

    if (StorageManager::exists(FILE_NAME))
    {
        result =
            StorageManager::deleteFile(FILE_NAME) &&
            result;
    }

    if (StorageManager::exists(
            BACKUP_FILE_NAME))
    {
        result =
            StorageManager::deleteFile(
                BACKUP_FILE_NAME) &&
            result;
    }

    pendingFileCount = 0;
    lastFileChangeTime = 0;

    return result;
}

bool Logger::fileExists()
{
    return initialized &&
           StorageManager::ready() &&
           StorageManager::exists(FILE_NAME);
}

String Logger::filePath()
{
    return String(FILE_NAME);
}

bool Logger::hasPendingFileWrites()
{
    return pendingFileCount > 0;
}

