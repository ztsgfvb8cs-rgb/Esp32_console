bool AiDifficultyManager::submitSample(
    const AiPerformanceSample& sample)
{
    if (!currentStatus_.initialized)
    {
        setError(
            AiDifficultyError::
                NotInitialized);

        return false;
    }

    if (!currentStatus_.adaptiveActive)
    {
        setError(
            AiDifficultyError::InvalidSample);

        return false;
    }

    const uint16_t performance =
        clampPermille(
            sample.
                playerPerformancePermille);

    const uint16_t confidence =
        clampPermille(
            sample.confidencePermille);

    if (confidence == 0)
    {
        setError(
            AiDifficultyError::InvalidSample);

        return false;
    }

    const uint32_t timestampMs =
        sample.timestampMs == 0
            ? millis()
            : sample.timestampMs;

    if (currentStatus_.
            windowStartedAtMs == 0)
    {
        currentStatus_.
            windowStartedAtMs =
                timestampMs;
    }

    weightedPerformanceTotal_ +=
        static_cast<uint64_t>(
            performance) *
        static_cast<uint64_t>(
            confidence);

    confidenceTotal_ += confidence;

    if (currentStatus_.sampleCount <
        UINT32_MAX)
    {
        ++currentStatus_.sampleCount;
    }

    if (currentStatus_.
            windowSampleCount <
        UINT32_MAX)
    {
        ++currentStatus_.
            windowSampleCount;
    }

    currentStatus_.lastSampleAtMs =
        timestampMs;

    if (confidenceTotal_ > 0)
    {
        const uint64_t rolling =
            weightedPerformanceTotal_ /
            confidenceTotal_;

        currentStatus_.
            rollingPerformancePermille =
                rolling > AI_PERMILLE_MAX
                    ? AI_PERMILLE_MAX
                    : static_cast<uint16_t>(
                        rolling);
    }

    const uint64_t averageConfidence =
        confidenceTotal_ /
        currentStatus_.windowSampleCount;

    currentStatus_.
        rollingConfidencePermille =
            averageConfidence >
                AI_PERMILLE_MAX
                ? AI_PERMILLE_MAX
                : static_cast<uint16_t>(
                    averageConfidence);

    currentStatus_.adjustmentPending =
        currentStatus_.windowSampleCount >=
            adaptivePolicy_.minimumSamples;

    currentStatus_.error =
        AiDifficultyError::None;

    notifyStateChanged();

    return true;
}

void AiDifficultyManager::update(
    uint32_t nowMs)
{
    if (!currentStatus_.initialized ||
        !currentStatus_.adaptiveActive)
    {
        return;
    }

    if (nowMs == 0)
    {
        nowMs = millis();
    }

    evaluateAdaptiveWindow(
        nowMs,
        false);
}

void AiDifficultyManager::setAdaptivePolicy(
    const AiAdaptivePolicy& policy)
{
    if (!validatePolicy(policy))
    {
        setError(
            AiDifficultyError::InvalidPolicy);

        return;
    }

    adaptivePolicy_ = policy;

    if (!currentStatus_.initialized)
    {
        return;
    }

    const uint32_t nowMs = millis();

    currentStatus_.adaptiveActive =
        currentStatus_.requestedLevel ==
            AiDifficultyLevel::Adaptive &&
        adaptivePolicy_.enabled;

    clearAdaptiveWindow(nowMs);

    const AiDifficultyLevel nextLevel =
        currentStatus_.adaptiveActive
            ? clampedAdaptiveLevel(
                currentStatus_.
                    effectiveLevel)
            : currentStatus_.requestedLevel ==
                    AiDifficultyLevel::
                        Adaptive
                ? clampedAdaptiveLevel(
                    adaptivePolicy_.
                        initialLevel)
                : currentStatus_.
                    requestedLevel;

    applyEffectiveLevel(
        nextLevel,
        AiDifficultyAdjustmentReason::
            PolicyChanged,
        nowMs);

    currentStatus_.error =
        AiDifficultyError::None;

    notifyStateChanged();
}

