void PlaytimeManager::clearRecord(
    GamePlaytimeRecord& record
)
{
    memset(
        &record,
        0,
        sizeof(GamePlaytimeRecord)
    );


    record.gameName[0] =
        '\0';


    record.valid =
        false;


    record.modified =
        false;
}



void PlaytimeManager::clearSession()
{
    session.gameIndex =
        PLAYTIME_INVALID_GAME_INDEX;


    session.startMilliseconds =
        0;


    session.pauseStartMilliseconds =
        0;


    session.totalPausedMilliseconds =
        0;


    session.state =
        PLAYTIME_SESSION_STOPPED;


    session.active =
        false;
}



uint32_t PlaytimeManager::calculateSessionDuration()
{
    if(!session.active)
    {
        return 0;
    }


    uint32_t currentTime;


    if(session.state ==
       PLAYTIME_SESSION_PAUSED)
    {
        currentTime =
            session.pauseStartMilliseconds;
    }
    else
    {
        currentTime =
            millis();
    }


    uint32_t elapsedMilliseconds =
        currentTime -
        session.startMilliseconds;


    if(elapsedMilliseconds <
       session.totalPausedMilliseconds)
    {
        return 0;
    }


    return
        elapsedMilliseconds -
        session.totalPausedMilliseconds;
}



bool PlaytimeManager::finishSession(
    PlaytimeSessionResult result,
    bool saveSession
)
{
    if(!managerInitialized)
    {
        return false;
    }


    if(!session.active)
    {
        return false;
    }


    if(session.gameIndex < 0 ||
       session.gameIndex >=
           (int16_t)recordCount)
    {
        clearSession();

        return false;
    }


    GamePlaytimeRecord& record =
        records[
            session.gameIndex
        ];


    if(!record.valid)
    {
        clearSession();

        return false;
    }


    uint32_t durationMilliseconds =
        calculateSessionDuration();


    if(saveSession)
    {
        record.totalPlaytimeMilliseconds +=
            durationMilliseconds;


        record.sessionCount++;


        record.lastSessionMilliseconds =
            durationMilliseconds;


        if(durationMilliseconds >
           record.longestSessionMilliseconds)
        {
            record.longestSessionMilliseconds =
                durationMilliseconds;
        }


        applySessionResult(
            record,
            result
        );


        record.modified =
            true;


        dataModified =
            true;
    }


    clearSession();


    return true;
}



void PlaytimeManager::applySessionResult(
    GamePlaytimeRecord& record,
    PlaytimeSessionResult result
)
{
    switch(result)
    {
        case PLAYTIME_RESULT_COMPLETED:

            record.completedSessionCount++;

            break;


        case PLAYTIME_RESULT_FAILED:

            record.failedSessionCount++;

            break;


        case PLAYTIME_RESULT_ABORTED:

            record.abortedSessionCount++;

            break;


        default:

            break;
    }
}



bool PlaytimeManager::copyGameName(
    char* destination,
    const String& source
)
{
    if(destination == nullptr)
    {
        return false;
    }


    if(!validGameName(
        source
    ))
    {
        destination[0] =
            '\0';


        return false;
    }


    source.toCharArray(
        destination,
        PLAYTIME_GAME_NAME_LENGTH
    );


    destination[
        PLAYTIME_GAME_NAME_LENGTH - 1
    ] = '\0';


    return true;
}



bool PlaytimeManager::gameNamesEqual(
    const char* storedName,
    const String& gameName
)
{
    if(storedName == nullptr)
    {
        return false;
    }


    if(!validGameName(
        gameName
    ))
    {
        return false;
    }


    return gameName.equals(
        storedName
    );
}
