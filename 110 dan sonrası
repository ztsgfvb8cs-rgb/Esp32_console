void RuntimeHealthCoordinator::setPolicy(
    const RuntimeHealthPolicy& value)
{
    policy_ = value;

    if (policy_.criticalInternalFreeBytes >
        policy_.minimumInternalFreeBytes)
    {
        policy_.criticalInternalFreeBytes =
            policy_.minimumInternalFreeBytes;
    }

    if (policy_.criticalPsramFreeBytes >
        policy_.minimumPsramFreeBytes)
    {
        policy_.criticalPsramFreeBytes =
            policy_.minimumPsramFreeBytes;
    }

    if (policy_.
            maximumConsecutiveRenderFailures == 0)
    {
        policy_.
            maximumConsecutiveRenderFailures = 1;
    }

    if (policy_.maximumRecoveryAttempts == 0)
    {
        policy_.maximumRecoveryAttempts = 1;
    }

    if (currentStatus_.initialized)
    {
        sample(millis(), true);
    }
}

