    currentSnapshot.batteryVoltage = voltage;

    currentSnapshot.batteryPercent =
        percent > 100
            ? 100
            : percent;

    currentSnapshot.batteryAvailable = true;

    updateWarningValues();
    updateHealthLevel();
}


