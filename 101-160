#ifndef EGS_LOGGER_H
#define EGS_LOGGER_H

#include <Arduino.h>

//====================================================
// ESP32 GAME STATION
// LOGGER DEFINITIONS
// 101_logger.h
//====================================================

enum LogLevel : uint8_t
{
    LOG_LEVEL_DEBUG = 0,
    LOG_LEVEL_INFO,
    LOG_LEVEL_WARNING,
    LOG_LEVEL_ERROR,
    LOG_LEVEL_CRITICAL
};

enum LogSource : uint8_t
{
    LOG_SOURCE_SYSTEM = 0,
    LOG_SOURCE_HARDWARE,
    LOG_SOURCE_STORAGE,
    LOG_SOURCE_DISPLAY,
    LOG_SOURCE_INPUT,
    LOG_SOURCE_AUDIO,
    LOG_SOURCE_NETWORK,
    LOG_SOURCE_GAME,
    LOG_SOURCE_EMULATOR,
    LOG_SOURCE_APPLICATION,
    LOG_SOURCE_UNKNOWN
};

enum LogOutput : uint8_t
{
    LOG_OUTPUT_NONE   = 0,
    LOG_OUTPUT_SERIAL = 1 << 0,
    LOG_OUTPUT_MEMORY = 1 << 1,
    LOG_OUTPUT_FILE   = 1 << 2
};

struct LogEntry
{
    LogLevel level;
    LogSource source;
    uint32_t timestamp;
    String tag;
    String message;
    bool valid;
};

class Logger
{
public:
    static constexpr uint16_t MAX_MEMORY_ENTRIES = 128;
    static constexpr uint16_t MAX_TAG_LENGTH = 24;
    static constexpr uint16_t MAX_MESSAGE_LENGTH = 192;

    static constexpr uint32_t MAX_FILE_SIZE =
        256UL * 1024UL;

    static constexpr uint32_t AUTO_FLUSH_DELAY =
        2000UL;

    //================================================
    // SYSTEM
    //================================================

    static bool begin();
    static void update();
    static bool ready();
    static void reset();

    //================================================
    // OUTPUT CONTROL
    //================================================

    static void setOutputs(uint8_t outputsValue);
    static uint8_t outputs();

    static bool outputEnabled(LogOutput output);
    static void enableOutput(LogOutput output);
    static void disableOutput(LogOutput output);

    //================================================
    // LEVEL CONTROL
    //================================================

    static void setMinimumLevel(LogLevel level);
    static LogLevel minimumLevel();

    //================================================
    // LOG WRITING
    //================================================

    static bool write(
        LogLevel level,
        LogSource source,
        const String& tag,
        const String& message);

    static bool debug(
        LogSource source,
        const String& tag,
        const String& message);

    static bool info(
        LogSource source,
        const String& tag,
        const String& message);

    static bool warning(
        LogSource source,
        const String& tag,
        const String& message);

    static bool error(
        LogSource source,
        const String& tag,
        const String& message);

    static bool critical(
        LogSource source,
        const String& tag,
        const String& message);

    //================================================
    // FORMATTED VALUES
    //================================================

    static bool writeValue(
        LogLevel level,
        LogSource source,
        const String& tag,
        const String& name,
        int32_t value);

    static bool writeValue(
        LogLevel level,
        LogSource source,
        const String& tag,
        const String& name,
        uint32_t value);

    static bool writeValue(
        LogLevel level,
        LogSource source,
        const String& tag,
        const String& name,
        int64_t value);

    static bool writeValue(
        LogLevel level,
        LogSource source,
        const String& tag,
        const String& name,
        uint64_t value);

    static bool writeValue(
        LogLevel level,
        LogSource source,
        const String& tag,
        const String& name,
        float value,
        uint8_t decimalPlaces = 2);

    static bool writeValue(
        LogLevel level,
        LogSource source,
        const String& tag,
        const String& name,
        bool value);

    //================================================
    // MEMORY LOG ACCESS
    //================================================

    static uint16_t count();
    static LogEntry get(uint16_t index);
    static LogEntry latest();

    static uint16_t countByLevel(LogLevel level);
    static uint16_t countBySource(LogSource source);

    static void clearMemory();

    //================================================
    // FILE LOG
    //================================================

    static bool flush();
    static bool clearFile();
    static bool fileExists();

    static String filePath();
    static bool hasPendingFileWrites();

    //================================================
    // TEXT HELPERS
    //================================================

    static const char* levelText(LogLevel level);
    static const char* sourceText(LogSource source);

    static String format(const LogEntry& entry);

private:
    static LogEntry entries[MAX_MEMORY_ENTRIES];

    static uint16_t firstIndex;
    static uint16_t entryCount;

    static bool initialized;
    static uint8_t enabledOutputs;
    static LogLevel currentMinimumLevel;

    static uint16_t pendingFileCount;
    static uint32_t lastFileChangeTime;

    static const char* FILE_NAME;
    static const char* BACKUP_FILE_NAME;

    //================================================
    // VALIDATION
    //================================================

    static bool validLevel(LogLevel level);
    static bool validSource(LogSource source);

    static bool validTag(const String& tag);
    static bool validMessage(const String& message);

    static LogEntry emptyEntry();

    //================================================
    // MEMORY HELPERS
    //================================================

    static uint16_t physicalIndex(uint16_t logicalIndex);
    static bool storeInMemory(const LogEntry& entry);

    //================================================
    // OUTPUT HELPERS
    //================================================

    static bool writeToSerial(const LogEntry& entry);
    static bool writePendingToFile();
    static bool rotateFileIfNeeded();

    //================================================
    // VALUE HELPERS
    //================================================

    static String signed64ToString(int64_t value);
    static String unsigned64ToString(uint64_t value);

    //================================================
    // INTERNAL STATE
    //================================================

    static void markFilePending();
    static void clearState();
};

#endif
#include "101_logger.h"
#include "storage_manager.h"

//====================================================
// ESP32 GAME STATION
// LOGGER IMPLEMENTATION
// 102_logger.cpp
//====================================================

LogEntry Logger::entries[Logger::MAX_MEMORY_ENTRIES] = {};

uint16_t Logger::firstIndex = 0;
uint16_t Logger::entryCount = 0;

bool Logger::initialized = false;

uint8_t Logger::enabledOutputs =
    static_cast<uint8_t>(LOG_OUTPUT_SERIAL) |
    static_cast<uint8_t>(LOG_OUTPUT_MEMORY);

LogLevel Logger::currentMinimumLevel =
    LOG_LEVEL_DEBUG;

uint16_t Logger::pendingFileCount = 0;
uint32_t Logger::lastFileChangeTime = 0;

const char* Logger::FILE_NAME =
    "/CONFIG/system.log";

const char* Logger::BACKUP_FILE_NAME =
    "/CONFIG/system_previous.log";

//====================================================
// SYSTEM
//====================================================

bool Logger::begin()
{
    if (initialized)
    {
        return true;
    }

    clearState();

    initialized = true;
    return true;
}

void Logger::update()
{
    if (!initialized)
    {
        return;
    }

    if (pendingFileCount == 0)
    {
        return;
    }

    if (!outputEnabled(LOG_OUTPUT_FILE))
    {
        return;
    }

    const uint32_t now = millis();

    if (now - lastFileChangeTime < AUTO_FLUSH_DELAY)
    {
        return;
    }

    writePendingToFile();
}

bool Logger::ready()
{
    return initialized;
}

void Logger::reset()
{
    clearState();
}

//====================================================
// OUTPUT CONTROL
//====================================================

void Logger::setOutputs(uint8_t outputsValue)
{
    const uint8_t validMask =
        static_cast<uint8_t>(LOG_OUTPUT_SERIAL) |
        static_cast<uint8_t>(LOG_OUTPUT_MEMORY) |
        static_cast<uint8_t>(LOG_OUTPUT_FILE);

    enabledOutputs = outputsValue & validMask;
}

uint8_t Logger::outputs()
{
    return enabledOutputs;
}

bool Logger::outputEnabled(LogOutput output)
{
    const uint8_t value =
        static_cast<uint8_t>(output);

    if (value ==
        static_cast<uint8_t>(LOG_OUTPUT_NONE))
    {
        return false;
    }

    return (enabledOutputs & value) != 0;
}

void Logger::enableOutput(LogOutput output)
{
    const uint8_t value =
        static_cast<uint8_t>(output);

    if (value ==
        static_cast<uint8_t>(LOG_OUTPUT_NONE))
    {
        return;
    }

    enabledOutputs |= value;
}

void Logger::disableOutput(LogOutput output)
{
    const uint8_t value =
        static_cast<uint8_t>(output);

    if (value ==
        static_cast<uint8_t>(LOG_OUTPUT_NONE))
    {
        return;
    }

    enabledOutputs &=
        static_cast<uint8_t>(~value);
}

//====================================================
// LEVEL CONTROL
//====================================================

void Logger::setMinimumLevel(LogLevel level)
{
    if (validLevel(level))
    {
        currentMinimumLevel = level;
    }
}

LogLevel Logger::minimumLevel()
{
    return currentMinimumLevel;
}

//====================================================
// LOG WRITING
//====================================================

bool Logger::write(
    LogLevel level,
    LogSource source,
    const String& tag,
    const String& message)
{
    if (!initialized && !begin())
    {
        return false;
    }

    if (!validLevel(level) ||
        !validSource(source))
    {
        return false;
    }

    if (static_cast<uint8_t>(level) <
        static_cast<uint8_t>(currentMinimumLevel))
    {
        return false;
    }

    String safeTag = tag;
    String safeMessage = message;

    if (safeTag.length() > MAX_TAG_LENGTH)
    {
        safeTag =
            safeTag.substring(0, MAX_TAG_LENGTH);
    }

    if (safeMessage.length() > MAX_MESSAGE_LENGTH)
    {
        safeMessage =
            safeMessage.substring(
                0,
                MAX_MESSAGE_LENGTH);
    }

    if (!validTag(safeTag) ||
        !validMessage(safeMessage))
    {
        return false;
    }

    LogEntry entry;

    entry.level = level;
    entry.source = source;
    entry.timestamp = millis();
    entry.tag = safeTag;
    entry.message = safeMessage;
    entry.valid = true;

    bool attemptedOutput = false;
    bool successfulOutput = false;

    if (outputEnabled(LOG_OUTPUT_SERIAL))
    {
        attemptedOutput = true;

        successfulOutput =
            writeToSerial(entry) ||
            successfulOutput;
    }

    const bool needsMemory =
        outputEnabled(LOG_OUTPUT_MEMORY) ||
        outputEnabled(LOG_OUTPUT_FILE);

    if (needsMemory)
    {
        attemptedOutput = true;

        if (storeInMemory(entry))
        {
            successfulOutput = true;

            if (outputEnabled(LOG_OUTPUT_FILE))
            {
                markFilePending();
            }
        }
    }

    return attemptedOutput &&
           successfulOutput;
}

bool Logger::debug(
    LogSource source,
    const String& tag,
    const String& message)
{
    return write(
        LOG_LEVEL_DEBUG,
        source,
        tag,
        message);
}

