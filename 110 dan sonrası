RuntimeInputStatus RuntimeInputRouter::currentStatus_ = {};
RuntimeInputPolicy RuntimeInputRouter::policy_ = {};
RuntimeActionState RuntimeInputRouter::actionStates_[
    RUNTIME_INPUT_ACTION_COUNT] = {};
RuntimeInputObserver RuntimeInputRouter::observer_ = nullptr;

bool RuntimeInputRouter::begin()
{
    if (currentStatus_.initialized) return true;

    if (!RuntimeSessionBridge::ready() &&
        !RuntimeSessionBridge::begin())
    {
        currentStatus_ = {};
        currentStatus_.error =
            RuntimeInputError::SessionBridgeNotReady;
        currentStatus_.lastDisposition =
            RuntimeInputDisposition::Error;
        return false;
    }

    currentStatus_ = {};
    currentStatus_.initialized = true;
    currentStatus_.target = resolveTarget();
    currentStatus_.foregroundCaptured =
        RuntimeSessionBridge::sessionActive();

    policy_ = {};
    resetAllActions();
    return true;
}

void RuntimeInputRouter::update(uint32_t nowMs)
{
    if (!currentStatus_.initialized) return;

    clearTransientStates();
    ++currentStatus_.updateSequence;
    currentStatus_.eventsProcessedThisUpdate = 0;

    uint8_t budget = policy_.maximumEventsPerUpdate;
    if (budget == 0) budget = RUNTIME_INPUT_DEFAULT_EVENT_BUDGET;
    if (budget > RUNTIME_INPUT_MAX_EVENT_BUDGET)
        budget = RUNTIME_INPUT_MAX_EVENT_BUDGET;

    InputEvent event;
    while (currentStatus_.eventsProcessedThisUpdate < budget &&
           InputManager::next(event))
    {
        if (event.timestampMs == 0) event.timestampMs = nowMs;
        route(event);
        ++currentStatus_.eventsProcessedThisUpdate;
    }

    currentStatus_.target = resolveTarget();
    currentStatus_.foregroundCaptured =
        RuntimeSessionBridge::sessionActive();
}

void RuntimeInputRouter::end()
{
    if (!currentStatus_.initialized) return;

    resetAllActions();
    currentStatus_.initialized = false;
    currentStatus_.suspended = false;
    currentStatus_.foregroundCaptured = false;
    currentStatus_.target = RuntimeInputTarget::None;
    currentStatus_.lastDisposition =
        RuntimeInputDisposition::Ignored;
    currentStatus_.error = RuntimeInputError::None;
    currentStatus_.eventsProcessedThisUpdate = 0;
    observer_ = nullptr;
}

bool RuntimeInputRouter::ready()
{
    return currentStatus_.initialized;
}

RuntimeInputStatus RuntimeInputRouter::status()
{
    if (currentStatus_.initialized)
    {
        currentStatus_.target = resolveTarget();
        currentStatus_.foregroundCaptured =
            RuntimeSessionBridge::sessionActive();
    }
    return currentStatus_;
}

void RuntimeInputRouter::setSuspended(bool value)
{
    if (!currentStatus_.initialized ||
        currentStatus_.suspended == value)
        return;

    clearTransientStates();
    currentStatus_.suspended = value;
}

bool RuntimeInputRouter::suspended()
{
    return currentStatus_.suspended;
}

RuntimeInputDisposition RuntimeInputRouter::route(
    const InputEvent& event)
{
    if (!currentStatus_.initialized)
    {
        currentStatus_.error = RuntimeInputError::NotInitialized;
        currentStatus_.lastDisposition =
            RuntimeInputDisposition::Error;
        ++currentStatus_.errorEventCount;
        return RuntimeInputDisposition::Error;
    }

    if (!validAction(event.action))
    {
        return record(
            event,
            RuntimeInputTarget::None,
            RuntimeInputDisposition::Error,
            RuntimeInputError::InvalidAction);
    }

    if (!currentStatus_.suspended ||
        event.type == InputEventType::Released)
    {
        updateActionState(event);
    }

    const RuntimeInputTarget target = resolveTarget();

    if (currentStatus_.suspended)
    {
        return record(
            event,
            target,
            RuntimeInputDisposition::Ignored);
    }

    if (target == RuntimeInputTarget::ForegroundGame ||
        target == RuntimeInputTarget::ForegroundPdf)
    {
        if (!RuntimeSessionBridge::ready())
        {
            return record(
                event,
                target,
                RuntimeInputDisposition::Error,
                RuntimeInputError::SessionBridgeNotReady);
        }

        if (!RuntimeSessionBridge::sessionActive())
        {
            return record(
                event,
                target,
                RuntimeInputDisposition::Error,
                RuntimeInputError::ForegroundStateMismatch);
        }

        return routeForeground(event, target);
    }

    return routeScreen(event, target);
}

RuntimeInputDisposition RuntimeInputRouter::inject(
    InputAction action,
    InputEventType type,
    uint32_t timestampMs,
    int16_t x,
    int16_t y,
    char text)
{
    InputEvent event;
    event.action = action;
    event.type = type;
    event.timestampMs = timestampMs == 0
        ? millis()
        : timestampMs;
    event.x = x;
    event.y = y;
    event.text = text;
    return route(event);
}

RuntimeInputTarget RuntimeInputRouter::resolveTarget()
{
    if (RuntimeSessionBridge::ready() &&
        RuntimeSessionBridge::sessionActive())
    {
        switch (RuntimeSessionBridge::activeKind())
        {
            case RuntimeModuleKind::BuiltinGame:
            case RuntimeModuleKind::Emulator:
                return RuntimeInputTarget::ForegroundGame;

            case RuntimeModuleKind::PdfReader:
                return RuntimeInputTarget::ForegroundPdf;

            default:
                return RuntimeInputTarget::None;
        }
    }

    switch (ScreenManager::current())
    {
        case AppScreen::MainMenu:
            return RuntimeInputTarget::MainMenu;

        case AppScreen::GameList:
        case AppScreen::PdfList:
            return RuntimeInputTarget::FileBrowser;

        case AppScreen::Settings:
            return RuntimeInputTarget::Settings;

        case AppScreen::Search:
            return RuntimeInputTarget::Search;

        case AppScreen::Playing:
            return RuntimeInputTarget::ForegroundGame;

        case AppScreen::PdfReader:
            return RuntimeInputTarget::ForegroundPdf;

        default:
            return RuntimeInputTarget::SystemScreen;
    }
}

