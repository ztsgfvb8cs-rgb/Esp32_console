            config.overflowPolicy) &&
        validUnderflowPolicy(
            config.underflowPolicy) &&
        config.capacityFrames >=
            PCM_RING_BUFFER_MINIMUM_CAPACITY_FRAMES &&
        config.capacityFrames <=
            PCM_RING_BUFFER_MAXIMUM_CAPACITY_FRAMES &&
        config.lowWatermarkFrames <=
            config.highWatermarkFrames &&
        config.highWatermarkFrames <=
            config.capacityFrames &&
        requiredBytes(
            config.format,
            config.capacityFrames) > 0U;
}

size_t PcmRingBuffer::requiredBytes(
    const I2sAudioFormat& formatValue,
    size_t capacityFramesValue)
{
    if (!validFormat(formatValue) ||
        capacityFramesValue == 0U ||
        multiplyWouldOverflow(
            capacityFramesValue,
            static_cast<size_t>(
                formatValue.channelCount)))
    {
        return 0U;
    }

    const size_t sampleCount =
        capacityFramesValue *
        static_cast<size_t>(
            formatValue.channelCount);

    if (multiplyWouldOverflow(
            sampleCount,
            PCM_RING_BUFFER_SAMPLE_BYTES))
    {
        return 0U;
    }

    return
        sampleCount *
        PCM_RING_BUFFER_SAMPLE_BYTES;
}

