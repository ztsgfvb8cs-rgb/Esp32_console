ResourceOwnerBudgetStatus
ResourceBudgetCoordinator::ownerStatus(
    ResourceBudgetOwner owner)
{
    ResourceOwnerBudgetStatus result;
    result.owner = owner;

    if (!ready() || !validOwner(owner))
    {
        return result;
    }

    for (uint8_t index = 0;
         index < RESOURCE_BUDGET_MAX_RESERVATIONS;
         ++index)
    {
        const ReservationSlot& slot =
            reservations_[index];

        if (!slot.active ||
            slot.status.owner != owner)
        {
            continue;
        }

        if (result.reservationCount < UINT8_MAX)
        {
            ++result.reservationCount;
        }

        if (slot.status.persistent &&
            result.persistentReservationCount < UINT8_MAX)
        {
            ++result.persistentReservationCount;
        }

        result.reservedInternalBytes =
            saturatingAddSize(
                result.reservedInternalBytes,
                slot.status.reservedInternalBytes);

        result.reservedPsramBytes =
            saturatingAddSize(
                result.reservedPsramBytes,
                slot.status.reservedPsramBytes);

        result.reportedInternalBytes =
            saturatingAddSize(
                result.reportedInternalBytes,
                slot.status.reportedInternalBytes);

        result.reportedPsramBytes =
            saturatingAddSize(
                result.reportedPsramBytes,
                slot.status.reportedPsramBytes);

        result.reclaimableInternalBytes =
            saturatingAddSize(
                result.reclaimableInternalBytes,
                slot.status.reclaimableInternalBytes);

        result.reclaimablePsramBytes =
            saturatingAddSize(
                result.reclaimablePsramBytes,
                slot.status.reclaimablePsramBytes);
    }

    return result;
}

