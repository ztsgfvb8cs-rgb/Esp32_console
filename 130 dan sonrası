RuntimeResult PsramPool::releaseAll(
    PsramPoolClearMode clearMode)
{
    if (!ready())
    {
        return setError(
            PsramPoolError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!validClearMode(clearMode))
    {
        return setError(
            PsramPoolError::InvalidBlock,
            RuntimeResult::InvalidArgument);
    }

    const bool clearMemory =
        shouldClearOnRelease(clearMode);

    uint32_t releasedBlocks = 0;

    for (uint8_t classIndex = 0;
         classIndex < config_.classCount;
         ++classIndex)
    {
        if (clearMemory && backings_[classIndex])
        {
            memset(
                backings_[classIndex].data,
                0,
                backings_[classIndex].size);
        }

        releasedBlocks +=
            classUsedBlocks_[classIndex];

        classUsedBlocks_[classIndex] = 0;
        classRequestedBytes_[classIndex] = 0;

        const uint16_t classStart =
            classSlotStarts_[classIndex];

        const uint16_t classCount =
            config_.classes[classIndex].blockCount;

        for (uint16_t localSlot = 0;
             localSlot < classCount;
             ++localSlot)
        {
            SlotMetadata& metadata =
                slots_[static_cast<uint16_t>(
                    classStart + localSlot)];

            metadata.used = false;
            metadata.classIndex = classIndex;
            metadata.leaseId = 0;
            metadata.requestedBytes = 0;
        }
    }

    if (releasedBlocks >
        UINT32_MAX - status_.releaseCount)
    {
        status_.releaseCount = UINT32_MAX;
    }
    else
    {
        status_.releaseCount += releasedBlocks;
    }

    if (status_.releaseAllCount < UINT32_MAX)
    {
        ++status_.releaseAllCount;
    }

    status_.generation =
        nextGeneration(status_.generation);

    nextLeaseId_ = 1U;
    status_.error = PsramPoolError::None;

    refreshStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

bool PsramPool::owns(
    const PsramPoolBlock& block) const
{
    if (!ready() ||
        !block ||
        block.classIndex >= config_.classCount ||
        block.slotIndex >= PSRAM_POOL_MAX_BLOCKS ||
        block.generation != status_.generation ||
        block.leaseId == 0)
    {
        return false;
    }

    const uint16_t classStart =
        classSlotStarts_[block.classIndex];

    const uint16_t classEnd =
        static_cast<uint16_t>(
            classStart +
            config_.classes[block.classIndex].blockCount);

    if (block.slotIndex < classStart ||
        block.slotIndex >= classEnd)
    {
        return false;
    }

    const SlotMetadata& metadata =
        slots_[block.slotIndex];

    return
        metadata.used &&
        metadata.classIndex == block.classIndex &&
        metadata.leaseId == block.leaseId &&
        pointerForSlot(
            block.classIndex,
            block.slotIndex) == block.data;
}

bool PsramPool::contains(
    const void* pointer) const
{
    if (!ready() || pointer == nullptr)
    {
        return false;
    }

    const uintptr_t value =
        reinterpret_cast<uintptr_t>(pointer);

    for (uint8_t classIndex = 0;
         classIndex < config_.classCount;
         ++classIndex)
    {
        const uintptr_t base =
            reinterpret_cast<uintptr_t>(
                backings_[classIndex].data);

        if (value >= base &&
            static_cast<size_t>(value - base) <
                backings_[classIndex].size)
        {
            return true;
        }
    }

    return false;
}

uint8_t PsramPool::bestClassFor(
    size_t requestedBytes) const
