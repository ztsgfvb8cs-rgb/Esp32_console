//---------------- Validation ----------------

bool validateAchievementDefinition(
    const AchievementDefinition& definition
)
{
    if(!definition.valid)
    {
        return false;
    }


    if(definition.achievementID ==
       ACHIEVEMENT_INVALID_ID)
    {
        return false;
    }


    if(definition.name[0] ==
       '\0')
    {
        return false;
    }


    size_t nameLength =
        strnlen(
            definition.name,
            ACHIEVEMENT_NAME_LENGTH
        );


    if(nameLength == 0 ||
       nameLength >=
       ACHIEVEMENT_NAME_LENGTH)
    {
        return false;
    }


    if(definition.targetValue == 0)
    {
        return false;
    }


    return true;
}



bool validateAchievementProgress(
    const AchievementProgress& progress
)
{
    if(!progress.valid)
    {
        return false;
    }


    if(progress.achievementID ==
       ACHIEVEMENT_INVALID_ID)
    {
        return false;
    }


    if(progress.progressPercent >
       ACHIEVEMENT_PROGRESS_COMPLETE)
    {
        return false;
    }


    if(progress.unlocked &&
       progress.progressPercent !=
       ACHIEVEMENT_PROGRESS_COMPLETE)
    {
        return false;
    }


    return true;
}



bool validateAchievementRecord(
    const AchievementRecord& record
)
{
    if(!validateAchievementDefinition(
        record.definition
    ))
    {
        return false;
    }


    if(!validateAchievementProgress(
        record.progress
    ))
    {
        return false;
    }


    if(record.definition.achievementID !=
       record.progress.achievementID)
    {
        return false;
    }


    if(record.progress.currentValue >
       record.definition.targetValue)
    {
        return false;
    }


    return true;
}



bool validateAchievementManager()
{
    if(achievementCount >
       ACHIEVEMENT_MAX_COUNT)
    {
        return false;
    }


    if(achievementTrackerCount >
       ACHIEVEMENT_MAX_TRACKERS)
    {
        return false;
    }


    for(uint16_t i = 0;
        i < achievementCount;
        i++)
    {
        if(!validateAchievementRecord(
            achievementRecords[i]
        ))
        {
            return false;
        }


        for(uint16_t j = i + 1;
            j < achievementCount;
            j++)
        {
            if(achievementRecords[i].
                   definition.achievementID ==
               achievementRecords[j].
                   definition.achievementID)
            {
                return false;
            }
        }
    }


    for(uint8_t i = 0;
        i < achievementTrackerCount;
        i++)
    {
        if(!achievementTrackers[i].valid)
        {
            return false;
        }


        if(achievementTrackers[i].trackerID ==
           ACHIEVEMENT_INVALID_ID)
        {
            return false;
        }


        if(!achievementExists(
            achievementTrackers[i].
                achievementID
        ))
        {
            return false;
        }


        for(uint8_t j = i + 1;
            j < achievementTrackerCount;
            j++)
        {
            if(achievementTrackers[i].trackerID ==
               achievementTrackers[j].trackerID)
            {
                return false;
            }
        }
    }


    return true;
}



