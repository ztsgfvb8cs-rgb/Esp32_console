//====================================================
// ESP32 GAME STATION
// LOW-LEVEL BOARD HARDWARE MANAGER
// 106_hardware_manager.cpp
//====================================================

HardwareStatus HardwareManager::currentStatus =
{
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    0,
    HardwareInitStage::NONE,
    HardwareError::NONE
};

//====================================================
// LIFECYCLE
//====================================================

bool HardwareManager::begin()
{
    if (currentStatus.initialized)
    {
        return true;
    }

    clearState();
    currentStatus.stage = HardwareInitStage::VALIDATION;

    if (!validateRuntimeConfiguration())
    {
        return fail(
            HardwareError::INVALID_CONFIGURATION);
    }

    currentStatus.stage =
        HardwareInitStage::SAFE_OUTPUTS;

    if (!configureOutputPins())
    {
        return fail(
            HardwareError::OUTPUT_CONFIGURATION_FAILED);
    }

    currentStatus.stage =
        HardwareInitStage::INPUTS;

    if (!configureInputPins())
    {
        return fail(
            HardwareError::INPUT_CONFIGURATION_FAILED);
    }

    currentStatus.stage =
        HardwareInitStage::SPI_BUS;

    if (!configureSharedSpi())
    {
        return fail(
            HardwareError::INVALID_CONFIGURATION);
    }

    currentStatus.stage =
        HardwareInitStage::I2C_BUS;

    if (!configureRtcI2c())
    {
        return fail(
            HardwareError::I2C_INITIALIZATION_FAILED);
    }

    currentStatus.stage =
        HardwareInitStage::MEMORY_CHECK;

    if (!detectRequiredMemory())
    {
        return false;
    }

    currentStatus.stage =
        HardwareInitStage::POWER_ENABLE;

    if (!setBoostEnabled(true))
    {
        return fail(
            HardwareError::BOOST_ENABLE_FAILED);
    }

    delay(
        BoardConfig::POWER_STABILIZATION_TIME_MS);

    currentStatus.initialized = true;
    currentStatus.stage = HardwareInitStage::READY;
    currentStatus.error = HardwareError::NONE;

    return true;
}

void HardwareManager::end()
{
    makeOutputsSafe();

    if (currentStatus.i2cReady)
    {
        Wire.end();
    }

    if (currentStatus.spiReady)
    {
        SPI.end();
    }

    clearState();
}

bool HardwareManager::ready()
{
    return
        currentStatus.initialized &&
        currentStatus.stage ==
            HardwareInitStage::READY &&
        currentStatus.error ==
            HardwareError::NONE;
}

HardwareStatus HardwareManager::status()
{
    return currentStatus;
}

HardwareInitStage HardwareManager::stage()
{
    return currentStatus.stage;
}

HardwareError HardwareManager::lastError()
{
    return currentStatus.error;
}

//====================================================
// SHARED BUSES
//====================================================

SPIClass& HardwareManager::sharedSpi()
{
