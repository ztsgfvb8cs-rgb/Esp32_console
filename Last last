    entry.loginCount =
        profile.loginCount;


    entry.valid =
        true;
}



static bool updateProfileIndexEntry(
    const PlayerProfile& profile,
    uint32_t lastSavedUnix
)
{
    int8_t index =
        findProfileIndexPosition(
            profile.profileID
        );


    if(index < 0)
    {
        if(profileIndexCount >=
           PROFILE_STORAGE_MAX_PROFILES)
        {
            profileStorageStatus =
                PROFILE_STORAGE_PROFILE_LIMIT;


            return false;
        }


        index =
            profileIndexCount;


        profileIndexCount++;
    }


    fillProfileIndexEntry(
        profileIndex[index],
        profile,
        lastSavedUnix
    );


    return true;
}



