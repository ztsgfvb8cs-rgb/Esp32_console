RuntimeInputDisposition RuntimeInputRouter::requestSessionClose(
    const InputEvent& event)
{
    if (!RuntimeSessionBridge::ready())
    {
        return record(
            event,
            resolveTarget(),
            RuntimeInputDisposition::Error,
            RuntimeInputError::SessionBridgeNotReady);
    }

    const RuntimeResult result =
        RuntimeSessionBridge::requestClose(
            RuntimeSessionExitReason::UserRequest);

    if (result != RuntimeResult::Ok)
    {
        return record(
            event,
            resolveTarget(),
            RuntimeInputDisposition::Error,
            RuntimeInputError::DispatchFailed);
    }

    resetAllActions();

    return record(
        event,
        resolveTarget(),
        RuntimeInputDisposition::SessionCloseRequested);
}

bool RuntimeInputRouter::isForegroundExitEvent(
    const InputEvent& event)
{
    if (event.action == InputAction::Back &&
        event.type == InputEventType::Pressed)
    {
        return policy_.backClosesForeground;
    }

    if (event.action == InputAction::Menu &&
        event.type == InputEventType::Pressed)
    {
        return policy_.menuClosesForeground;
    }

    return event.action == InputAction::Menu &&
        event.type == InputEventType::LongPressed &&
        policy_.longMenuClosesForeground;
}

bool RuntimeInputRouter::eventVisibleToForeground(
    const InputEvent& event)
{
    if (event.action == InputAction::Touch &&
        !policy_.exposeTouchEventsToForeground)
    {
        return false;
    }

    if (event.action == InputAction::Text &&
        !policy_.exposeTextEventsToForeground)
    {
        return false;
    }

    switch (event.type)
    {
        case InputEventType::Pressed:
            return true;

        case InputEventType::Released:
            return policy_.exposeReleaseEventsToForeground;

        case InputEventType::Repeated:
            return policy_.exposeRepeatEventsToForeground;

        case InputEventType::LongPressed:
            return policy_.exposeLongPressEventsToForeground;

        case InputEventType::Moved:
            return event.action == InputAction::Touch &&
                policy_.exposeTouchEventsToForeground;

        default:
            return false;
    }
}

bool RuntimeInputRouter::eventEligibleForPdfNavigation(
    const InputEvent& event)
{
    const bool validType =
        event.type == InputEventType::Pressed ||
        (event.type == InputEventType::Repeated &&
         policy_.repeatedPdfNavigation);

    if (!validType)
        return false;

    if (policy_.directionalPdfNavigation &&
        (event.action == InputAction::Up ||
         event.action == InputAction::Down ||
         event.action == InputAction::Left ||
         event.action == InputAction::Right))
    {
        return true;
    }

    return policy_.faceButtonPdfNavigation &&
        (event.action == InputAction::A ||
         event.action == InputAction::B);
}

bool RuntimeInputRouter::validAction(InputAction action)
{
    const size_t index = static_cast<size_t>(action);

    return action != InputAction::None &&
        index < RUNTIME_INPUT_ACTION_COUNT;
}

size_t RuntimeInputRouter::actionIndex(InputAction action)
{
    return static_cast<size_t>(action);
}

void RuntimeInputRouter::updateActionState(
    const InputEvent& event)
{
    if (!validAction(event.action))
        return;

    RuntimeActionState& state =
        actionStates_[actionIndex(event.action)];

    ++currentStatus_.eventSequence;
    state.eventSequence = currentStatus_.eventSequence;
    state.changedAtMs = event.timestampMs;

    switch (event.type)
    {
        case InputEventType::Pressed:
            state.pressed = true;

            if (event.action != InputAction::Text)
            {
                state.held = true;
                state.pressedAtMs = event.timestampMs;
            }
            break;

        case InputEventType::Released:
            state.held = false;
            state.released = true;
            state.pressedAtMs = 0;
            break;

        case InputEventType::Repeated:
            state.held = true;
            state.repeated = true;

            if (state.pressedAtMs == 0)
                state.pressedAtMs = event.timestampMs;
            break;

        case InputEventType::LongPressed:
            state.held = true;
            state.longPressed = true;

            if (state.pressedAtMs == 0)
                state.pressedAtMs = event.timestampMs;
            break;

        case InputEventType::Moved:
        default:
            break;
    }
}

RuntimeInputDisposition RuntimeInputRouter::record(
    const InputEvent& event,
    RuntimeInputTarget target,
    RuntimeInputDisposition disposition,
    RuntimeInputError error)
{
    currentStatus_.target = target;
    currentStatus_.foregroundCaptured =
        RuntimeSessionBridge::ready() &&
        RuntimeSessionBridge::sessionActive();

    currentStatus_.lastDisposition = disposition;
    currentStatus_.error = error;
    currentStatus_.lastEvent = event;
    currentStatus_.lastEventAtMs = event.timestampMs;

    if (disposition == RuntimeInputDisposition::Ignored)
    {
        ++currentStatus_.ignoredEventCount;
    }
    else if (disposition == RuntimeInputDisposition::Error)
    {
        ++currentStatus_.errorEventCount;
    }
    else
    {
        ++currentStatus_.routedEventCount;
    }

    if (observer_ != nullptr)
    {
        observer_(
            event,
            target,
            disposition);
    }

    return disposition;
}
