bool RuntimeAudioCoordinator::begin()
{
    if (currentStatus_.initialized)
    {
        return true;
    }

    currentStatus_ = {};
    policy_ = {};
    settings_ = SettingsManager::settings();
    lastRuntimeTransitionSequence_ = 0;
    lastGainUpdateAtMs_ = millis();

    if (!AudioOutput::ready() && !AudioManager::begin())
    {
        currentStatus_.error =
            RuntimeAudioError::AudioOutputNotReady;

        return false;
    }

    if (!RuntimeModuleManager::ready() &&
        !RuntimeModuleManager::begin())
    {
        currentStatus_.error =
            RuntimeAudioError::RuntimePolicyUnavailable;

        return false;
    }

    settings_.masterVolume =
        clampedPercent(settings_.masterVolume);
    settings_.musicVolume =
        clampedPercent(settings_.musicVolume);
    settings_.gameVolume =
        clampedPercent(settings_.gameVolume);
    settings_.effectVolume =
        clampedPercent(settings_.effectVolume);

    AudioManager::setSettings(settings_);

    currentStatus_.initialized = true;
    currentStatus_.soundEnabled = settings_.soundEnabled;
    currentStatus_.route = AudioOutput::route();
    currentStatus_.error = RuntimeAudioError::None;

    refreshRequestedLevels();
    refreshRuntimeState(lastGainUpdateAtMs_);
    refreshTargetLevels();

    currentStatus_.backgroundMusic.effectivePercent =
        currentStatus_.backgroundMusic.targetPercent;
    currentStatus_.foreground.effectivePercent =
        currentStatus_.foreground.targetPercent;
    currentStatus_.uiEffects.effectivePercent =
        currentStatus_.uiEffects.targetPercent;

    refreshFinalGains();
    applyBackgroundPlaybackPolicy();

    Logger::info(
        LogSource::Audio,
        "AUDIO_RT",
        "Runtime audio coordinator ready");

    notifyStateChanged();
    return true;
}

void RuntimeAudioCoordinator::update(uint32_t nowMs)
{
    if (!currentStatus_.initialized ||
        currentStatus_.suspended)
    {
        return;
    }

    currentStatus_.lastUpdateAtMs = nowMs;

    AudioManager::update(nowMs);

    if (synchronizeRuntimePolicy(nowMs) !=
        RuntimeResult::Ok)
    {
        return;
    }

    advanceGainTransitions(nowMs);
    refreshFinalGains();
    notifyStateChanged();
}

void RuntimeAudioCoordinator::end()
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    if (currentStatus_.musicPausedByCoordinator &&
        policy_.restoreMusicAfterForeground &&
        AudioPlayer::state() == AudioPlayerState::Paused)
    {
        AudioPlayer::resume();
    }

    currentStatus_ = {};
    policy_ = {};
    settings_ = {};
    observer_ = nullptr;
    lastRuntimeTransitionSequence_ = 0;
    lastGainUpdateAtMs_ = 0;
}

