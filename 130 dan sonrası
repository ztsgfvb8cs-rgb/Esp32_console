bool MemoryArena::contains(
    const void* pointer) const
{
    if (!ready() || pointer == nullptr)
    {
        return false;
    }

    const uintptr_t base =
        reinterpret_cast<uintptr_t>(
            backing_.data);

    const uintptr_t value =
        reinterpret_cast<uintptr_t>(
            pointer);

    return
        value >= base &&
        static_cast<size_t>(
            value - base) <
            backing_.size;
}

size_t MemoryArena::capacity() const
{
    return ready()
        ? backing_.size
        : 0;
}

size_t MemoryArena::used() const
{
    return ready()
        ? offset_
        : 0;
}

size_t MemoryArena::remaining() const
{
    return ready()
        ? backing_.size - offset_
        : 0;
}

size_t MemoryArena::peakUsed() const
{
    return status_.peakUsedBytes;
}

bool MemoryArena::usingPsram() const
{
    return ready() && backing_.psram;
}

MemoryArenaError
MemoryArena::lastError() const
{
    return status_.error;
}

void MemoryArena::clearError()
{
    status_.error =
        MemoryArenaError::None;
}

bool MemoryArena::validAlignment(
    size_t alignment)
{
    return
        alignment > 0 &&
        alignment <=
            MEMORY_ARENA_MAXIMUM_ALIGNMENT_BYTES &&
        (alignment &
         (alignment - 1U)) == 0U;
}

const char* MemoryArena::errorText(
    MemoryArenaError value)
{
    switch (value)
    {
        case MemoryArenaError::None:
            return "NONE";

        case MemoryArenaError::
                AlreadyInitialized:
            return "ALREADY_INITIALIZED";

        case MemoryArenaError::
                NotInitialized:
            return "NOT_INITIALIZED";

        case MemoryArenaError::
                InvalidCapacity:
            return "INVALID_CAPACITY";

        case MemoryArenaError::
                InvalidAlignment:
            return "INVALID_ALIGNMENT";

        case MemoryArenaError::
                BackingAllocationFailed:
            return "BACKING_ALLOCATION_FAILED";

        case MemoryArenaError::OutOfSpace:
            return "OUT_OF_SPACE";

        case MemoryArenaError::InvalidMarker:
            return "INVALID_MARKER";

        case MemoryArenaError::ForeignPointer:
            return "FOREIGN_POINTER";

        default:
            return "UNKNOWN";
    }
}

bool MemoryArena::addWouldOverflow(
    size_t first,
    size_t second)
{
    return second > SIZE_MAX - first;
}

bool MemoryArena::alignOffset(
    size_t offset,
    size_t alignment,
    size_t* alignedOffset)
{
    if (alignedOffset == nullptr ||
        !validAlignment(alignment))
    {
        return false;
    }

    const size_t mask =
        alignment - 1U;

    if (addWouldOverflow(offset, mask))
    {
        return false;
    }

    *alignedOffset =
        (offset + mask) & ~mask;

    return true;
}

RuntimeResult MemoryArena::setError(
    MemoryArenaError error,
    RuntimeResult result)
{
    status_.error = error;

    return result;
}

void MemoryArena::moveFrom(
    MemoryArena& other) noexcept
{
    backing_ = other.backing_;
    config_ = other.config_;
    status_ = other.status_;
    offset_ = other.offset_;

    const uint32_t otherGeneration =
        nextGeneration(
            other.status_.generation);

    other.backing_ = {};
    other.config_ = {};
    other.status_ = {};

    other.status_.generation =
        otherGeneration;

    other.offset_ = 0;
}
