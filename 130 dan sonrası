bool Mp3Decoder::validConfig(
    const Mp3DecoderConfig& config)
{
    return
        validMemoryPreference(
            config.sourceBufferPreference) &&

        validMemoryPreference(
            config.decoderWorkingMemoryPreference) &&

        config.sourceBufferCapacityBytes >=
            SD_STREAM_MINIMUM_BUFFER_BYTES &&

        config.sourceBufferCapacityBytes <=
            SD_STREAM_MAXIMUM_BUFFER_BYTES &&

        config.sourceReadChunkBytes > 0U &&

        config.sourceReadChunkBytes <=
            config.sourceBufferCapacityBytes &&

        config.sourceInitialPrefetchBytes <=
            config.sourceBufferCapacityBytes &&

        config.sourceRefillThresholdBytes <=
            config.sourceBufferCapacityBytes &&

        config.maximumSyncSearchBytes >=
            MP3_DECODER_FRAME_HEADER_BYTES &&

        config.defaultPcmFramesPerDecodeCall > 0U &&

        config.defaultPcmFramesPerDecodeCall <=
            MP3_DECODER_MAX_FRAMES_PER_CALL &&

        config.maximumSeekIndexEntries <=
            MP3_DECODER_MAX_SEEK_INDEX_ENTRIES &&

        (!config.buildSparseSeekIndex ||
         (config.maximumSeekIndexEntries > 0U &&
          config.seekIndexIntervalMs > 0U));
}
bool Mp3Decoder::supportedFrame(
    const Mp3FrameInfo& frame,
    const Mp3DecoderConfig& config,
    Mp3DecoderError* rejectionReason)
{
    if (rejectionReason != nullptr)
    {
        *rejectionReason = Mp3DecoderError::None;
    }

    bool versionAllowed = false;

    switch (frame.version)
    {
        case Mp3MpegVersion::Mpeg1:
            versionAllowed = config.allowMpeg1;
            break;

        case Mp3MpegVersion::Mpeg2:
            versionAllowed = config.allowMpeg2;
            break;

        case Mp3MpegVersion::Mpeg25:
            versionAllowed = config.allowMpeg25;
            break;

        default:
            if (rejectionReason != nullptr)
            {
                *rejectionReason =
                    Mp3DecoderError::UnsupportedMpegVersion;
            }

            return false;
    }

    if (!versionAllowed)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                Mp3DecoderError::UnsupportedMpegVersion;
        }

        return false;
    }

    if (frame.layer != 3U)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                Mp3DecoderError::UnsupportedLayer;
        }

        return false;
    }

    if (frame.channelCount <
            MP3_DECODER_MIN_CHANNEL_COUNT ||
        frame.channelCount >
            MP3_DECODER_MAX_CHANNEL_COUNT)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                Mp3DecoderError::UnsupportedChannelCount;
        }

        return false;
    }

    if (frame.sampleRateHz <
            MP3_DECODER_MIN_SAMPLE_RATE_HZ ||
        frame.sampleRateHz >
            MP3_DECODER_MAX_SAMPLE_RATE_HZ)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                Mp3DecoderError::UnsupportedSampleRate;
        }

        return false;
    }

    const bool freeFormat =
        frame.bitrateKbps == 0U &&
        frame.frameSizeBytes == 0U;

    if (freeFormat && !config.allowFreeFormat)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                Mp3DecoderError::UnsupportedFreeFormat;
        }

        return false;
    }

    if (!freeFormat &&
        (frame.bitrateKbps <
             MP3_DECODER_MIN_BITRATE_KBPS ||
         frame.bitrateKbps >
             MP3_DECODER_MAX_BITRATE_KBPS))
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                Mp3DecoderError::UnsupportedBitrate;
        }

        return false;
    }

    if (frame.crcProtected &&
        !config.allowCrcProtectedFrames)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                Mp3DecoderError::ProtectedFrameUnsupported;
        }

        return false;
    }

    const size_t maximumFrameBytes =
        config.allowFreeFormat
            ? 2304U
            : MP3_DECODER_MAX_COMPRESSED_FRAME_BYTES;

    if (!freeFormat &&
        (frame.frameSizeBytes <
             MP3_DECODER_FRAME_HEADER_BYTES ||
         frame.frameSizeBytes >
             maximumFrameBytes))
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                Mp3DecoderError::FrameTooLarge;
        }

        return false;
    }

    return true;
}

