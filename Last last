#include "wifi_manager.h"


//====================================================
// STATIC DEFINITIONS
//====================================================

bool NetworkManager::initialized = false;


WiFiState NetworkManager::currentState =
    WIFI_DISABLED;


String NetworkManager::currentSSID = "";


IPAddress NetworkManager::currentIP(
    0,
    0,
    0,
    0
);


uint32_t NetworkManager::lastReconnect = 0;


//====================================================
// BEGIN
//====================================================

bool NetworkManager::begin()
{
    if (initialized)
        return true;


    WiFi.mode(WIFI_OFF);

    currentState = WIFI_DISABLED;

    currentSSID = "";

    currentIP = IPAddress(
        0,
        0,
        0,
        0
    );


    initialized = true;


    return true;
}


//====================================================
// UPDATE
//====================================================

void NetworkManager::update()
{
    if (!initialized)
        return;


    checkConnection();
}


//====================================================
// STOP
//====================================================

void NetworkManager::stop()
{
    WiFi.disconnect(true, true);

    WiFi.mode(WIFI_OFF);

    currentState = WIFI_DISABLED;

    currentSSID = "";

    currentIP = IPAddress(
        0,
        0,
        0,
        0
    );
}
//====================================================
// CONNECT
//====================================================

bool NetworkManager::connect(
    const String& ssid,
    const String& password)
{
    if (!initialized)
        return false;


    WiFi.mode(WIFI_STA);

    WiFi.begin(
        ssid.c_str(),
        password.c_str()
    );


    currentSSID = ssid;

    currentState = WIFI_CONNECTING;

    lastReconnect = millis();


    return true;
}


//====================================================
// DISCONNECT
//====================================================

void NetworkManager::disconnect()
{
    WiFi.disconnect();

    currentState = WIFI_DISABLED;

    currentSSID = "";

    currentIP = IPAddress(
        0,
        0,
        0,
        0
    );
}


//====================================================
// START ACCESS POINT
//====================================================

bool NetworkManager::startAP(
    const String& ssid,
    const String& password)
{
    if (!initialized)
        return false;


    WiFi.mode(WIFI_AP);


    if (!WiFi.softAP(
            ssid.c_str(),
            password.c_str()))
    {
        currentState = WIFI_ERROR;

        return false;
    }


    currentSSID = ssid;

    currentIP = WiFi.softAPIP();

    currentState = WIFI_AP_MODE;


    return true;
}


//====================================================
// STOP ACCESS POINT
//====================================================

void NetworkManager::stopAP()
{
    WiFi.softAPdisconnect(true);

    WiFi.mode(WIFI_OFF);

    currentState = WIFI_DISABLED;

    currentSSID = "";

    currentIP = IPAddress(
        0,
        0,
        0,
        0
    );
}
//====================================================
// CONNECTED
//====================================================

bool NetworkManager::connected()
{
    return currentState == WIFI_CONNECTED;
}


//====================================================
// AP MODE
//====================================================

bool NetworkManager::apMode()
{
    return currentState == WIFI_AP_MODE;
}


//====================================================
// STATE
//====================================================

WiFiState NetworkManager::state()
{
    return currentState;
}


//====================================================
// IP ADDRESS
//====================================================

IPAddress NetworkManager::ip()
{
    return currentIP;
}


//====================================================
// SSID
//====================================================

String NetworkManager::ssid()
{
    return currentSSID;
}


//====================================================
// SIGNAL STRENGTH
//====================================================

int32_t NetworkManager::signalStrength()
{
    if (currentState != WIFI_CONNECTED)
        return -127;


    return WiFi.RSSI();
}
//====================================================
// CHECK CONNECTION
//====================================================

void NetworkManager::checkConnection()
{
    if (currentState == WIFI_AP_MODE)
    {
        currentIP = WiFi.softAPIP();

        return;
    }


    if (currentState != WIFI_CONNECTING &&
        currentState != WIFI_CONNECTED)
    {
        return;
    }


    wl_status_t status = WiFi.status();


    if (status == WL_CONNECTED)
    {
        currentState = WIFI_CONNECTED;

        currentIP = WiFi.localIP();

        return;
    }


    currentState = WIFI_CONNECTING;


    if (millis() - lastReconnect < 5000)
        return;


    lastReconnect = millis();


    WiFi.disconnect();


    WiFi.begin(
        currentSSID.c_str()
    );
}
