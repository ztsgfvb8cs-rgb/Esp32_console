bool transitionTimedOut(
    RuntimeModuleState state,
    uint32_t nowMs,
    uint32_t enteredAtMs,
    const RuntimeHealthPolicy& policy)
{
    if (enteredAtMs == 0)
    {
        return false;
    }

    if (state == RuntimeModuleState::Starting)
    {
        return nowMs - enteredAtMs >=
            policy.startupTimeoutMs;
    }

    if (state == RuntimeModuleState::Stopping)
    {
        return nowMs - enteredAtMs >=
            policy.stopTimeoutMs;
    }

    return false;
}

bool isCriticalMemoryError(RuntimeHealthError error)
{
    return error == RuntimeHealthError::LowInternalMemory ||
        error == RuntimeHealthError::LowPsram;
}
