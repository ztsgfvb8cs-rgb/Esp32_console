uint32_t nextGeneration(uint32_t current)
{
    return current == UINT32_MAX
        ? 1U
        : current + 1U;
}

uint32_t saturatingIncrement32(uint32_t value)
{
    return value == UINT32_MAX
        ? UINT32_MAX
        : value + 1U;
}

uint64_t saturatingAdd64(
    uint64_t first,
    uint64_t second)
{
    return second > UINT64_MAX - first
        ? UINT64_MAX
        : first + second;
}

size_t minimumSize(
    size_t first,
    size_t second)
{
    return first < second
        ? first
        : second;
}

size_t boundedStringLength(
    const char* text,
    size_t capacity)
{
    if (text == nullptr)
    {
        return 0U;
    }

    size_t length = 0U;

    while (length < capacity &&
           text[length] != '\0')
    {
        ++length;
    }

    return length;
}

bool validMemoryPreference(
    MemoryPreference preference)
{
    switch (preference)
    {
        case MemoryPreference::InternalOnly:
        case MemoryPreference::PsramPreferred:
        case MemoryPreference::PsramOnly:
            return true;

        default:
            return false;
    }
}

uint32_t readLe32Local(const uint8_t* bytes)
{
    if (bytes == nullptr)
    {
        return 0U;
    }

    return
        static_cast<uint32_t>(bytes[0]) |
        (static_cast<uint32_t>(bytes[1]) << 8U) |
        (static_cast<uint32_t>(bytes[2]) << 16U) |
        (static_cast<uint32_t>(bytes[3]) << 24U);
}

uint16_t readBe16Local(const uint8_t* bytes)
{
    if (bytes == nullptr)
    {
        return 0U;
    }

    return static_cast<uint16_t>(
        (static_cast<uint16_t>(bytes[0]) << 8U) |
        static_cast<uint16_t>(bytes[1]));
}

bool signatureEquals(
    const uint8_t* bytes,
    const uint8_t* signature,
    size_t size)
{
    return
        bytes != nullptr &&
        signature != nullptr &&
        memcmp(bytes, signature, size) == 0;
}

uint32_t framesToMilliseconds(
    uint64_t frames,
    uint32_t sampleRateHz)
{
    if (sampleRateHz == 0U)
    {
        return 0U;
    }

    const uint64_t milliseconds =
        (frames * 1000ULL) /
        sampleRateHz;

    return milliseconds > UINT32_MAX
        ? UINT32_MAX
        : static_cast<uint32_t>(milliseconds);
}

uint64_t millisecondsToFrames(
    uint32_t milliseconds,
    uint32_t sampleRateHz)
{
    return
        (static_cast<uint64_t>(milliseconds) *
         sampleRateHz) /
        1000ULL;
}

bool isTemporaryResult(RuntimeResult result)
{
    return
        result == RuntimeResult::NotReady ||
        result == RuntimeResult::Busy;
}

uint32_t platformMillis()
{
#if defined(ARDUINO_ARCH_ESP32)
    return millis();
#else
    return 0U;
#endif
}
