bool PlaytimeManager::addWithoutOverflow(
    uint64_t currentValue,
    uint64_t amount,
    uint64_t& result
)
{
    if (currentValue >
        PLAYTIME_UINT64_MAX - amount)
    {
        return false;
    }

    result =
        currentValue + amount;

    return true;
}


bool PlaytimeManager::flushActiveTime()
{
    if (!active || paused)
        return true;

    if (activeIndex < 0 ||
        !validIndex(
            static_cast<uint16_t>(
                activeIndex
            )
        ))
    {
        return false;
    }

    uint32_t now = millis();

    uint32_t elapsed =
        now - lastTickTime;

    if (elapsed == 0)
        return true;

    PlaytimeInfo& entry =
        entries[activeIndex];

    uint64_t newTotal = 0;

    uint64_t newSessionTotal = 0;

    if (!addWithoutOverflow(
            entry.totalMilliseconds,
            static_cast<uint64_t>(
                elapsed
            ),
            newTotal
        ) ||
        !addWithoutOverflow(
            sessionMilliseconds,
            static_cast<uint64_t>(
                elapsed
            ),
            newSessionTotal
        ))
    {
        return false;
    }

    entry.totalMilliseconds =
        newTotal;

    sessionMilliseconds =
        newSessionTotal;

    lastTickTime = now;

    if (entry.persistent)
        markDirty();

    return true;
}


uint32_t
PlaytimeManager::pendingActiveMilliseconds()
{
    if (!active || paused)
        return 0;

    return millis() - lastTickTime;
}


void PlaytimeManager::markDirty()
{
    if (!dirty)
        lastChangeTime = millis();

    dirty = true;
}


uint32_t PlaytimeManager::getTimestamp()
{
    if (!RTCManager::available())
        return millis() / 1000UL;

    uint16_t currentYear =
        RTCManager::year();

    uint8_t currentMonth =
        RTCManager::month();

    uint8_t currentDay =
        RTCManager::day();

    uint8_t currentHour =
        RTCManager::hour();

    uint8_t currentMinute =
        RTCManager::minute();

    uint8_t currentSecond =
        RTCManager::second();

    if (currentYear < 2000 ||
        currentYear > 2135 ||
        currentMonth < 1 ||
        currentMonth > 12)
    {
        return millis() / 1000UL;
    }

    uint8_t maximumDay =
        daysInMonthValue(
            currentMonth,
            currentYear
        );

    if (currentDay < 1 ||
        currentDay > maximumDay ||
        currentHour > 23 ||
        currentMinute > 59 ||
        currentSecond > 59)
    {
        return millis() / 1000UL;
    }

    uint32_t totalDays = 0;

    for (uint16_t year = 2000;
         year < currentYear;
         year++)
    {
        totalDays +=
            isLeapYearValue(year)
                ? 366UL
                : 365UL;
    }

    for (uint8_t month = 1;
         month < currentMonth;
         month++)
    {
        totalDays +=
            daysInMonthValue(
                month,
                currentYear
            );
    }

    totalDays +=
        static_cast<uint32_t>(
            currentDay - 1
        );

    uint64_t timestamp =
        static_cast<uint64_t>(
            totalDays
        ) * 86400ULL;

    timestamp +=
        static_cast<uint64_t>(
            currentHour
        ) * 3600ULL;

    timestamp +=
        static_cast<uint64_t>(
            currentMinute
        ) * 60ULL;

    timestamp += currentSecond;

    if (timestamp > 0xFFFFFFFFULL)
        return millis() / 1000UL;

    return static_cast<uint32_t>(
        timestamp
    );
}


String PlaytimeManager::storagePath()
{
    return StorageManager::joinPath(
        StorageManager::configPath(),
        FILE_NAME
    );
}


