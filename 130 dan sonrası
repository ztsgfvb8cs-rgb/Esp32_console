//====================================================
// ESP32 GAME STATION
// GLOBAL RAM AND PSRAM BUDGET COORDINATOR CONTRACT
// 139_resource_budget_coordinator.h
//====================================================
//
// Responsibilities:
// - Reserves bounded internal-RAM and PSRAM budgets before allocation.
// - Preserves emergency memory headroom for input, logging and shutdown.
// - Tracks committed, reported and reclaimable bytes per subsystem.
// - Rejects sessions that cannot fit without entering critical pressure.
// - Detects stale reservation handles through slot generations and leases.
// - Supports owner-scoped cleanup without dynamic allocation.
// - Reports warning and critical pressure transitions to one observer.
//
// Ownership rule:
// - This coordinator grants accounting reservations; it does not allocate
//   or free the caller's actual memory blocks.
// - After admission, callers allocate through MemoryArena, PsramPool,
//   StreamRingBuffer or another approved backend.
// - A reservation must remain active until all memory covered by it has
//   been released by the owning subsystem.
//
// Safety rule:
// - Internal-RAM headroom is never borrowed for optional PSRAM content.
// - DMA-capable buffers must be requested as internal RAM.
// - Persistent reservations are not removed by ordinary owner cleanup.
// - Reclaimable reservations may be surfaced to higher-level recovery,
//   but are never silently invalidated while a caller still owns memory.
//
// Integration rule:
// - File 140 implements this contract using MemoryManager and the native
//   ESP32 free-heap/PSRAM queries when available.
// - RuntimeHealthCoordinator may use pressureLevel() and status().
// - PDF, audio, emulator and game sessions request budgets before begin().
//====================================================

namespace egs
{
inline constexpr uint8_t RESOURCE_BUDGET_MAX_RESERVATIONS = 24U;
inline constexpr size_t RESOURCE_BUDGET_LABEL_CAPACITY = 32U;
inline constexpr uint16_t RESOURCE_BUDGET_PERMILLE_MAX = 1000U;
inline constexpr uint8_t RESOURCE_BUDGET_INVALID_SLOT = 0xFFU;

enum class ResourceBudgetOwner : uint8_t
{
    None = 0,
    System,
    Runtime,
    Display,
    Audio,
    Pdf,
    Emulator,
    Asset,
    BuiltinGame,
    Network,
    Diagnostics,
    Count
};

enum class ResourceBudgetPriority : uint8_t
{
    Optional = 0,
    Normal,
    High,
    Critical
};

enum class ResourceMemoryKind : uint8_t
{
    Internal = 0,
    Psram,
    Both
};

enum class ResourcePressureLevel : uint8_t
{
    Normal = 0,
    Elevated,
    High,
    Critical
};

enum class ResourceBudgetError : uint8_t
{
    None = 0,
    AlreadyInitialized,
    NotInitialized,
    InvalidPolicy,
    InvalidRequest,
    InvalidOwner,
    InvalidHandle,
    StaleHandle,
    NoFreeReservationSlot,
    DuplicateReservation,
    InternalMemoryUnavailable,
    PsramUnavailable,
    InsufficientInternalBudget,
    InsufficientPsramBudget,
    CriticalPressure,
    ActualUsageExceedsReservation,
    PersistentReservation,
    Busy
};

struct ResourceBudgetPolicy
{
    // These bytes remain outside ordinary reservations so recovery,
    // logging, input and safe shutdown can still operate.
    size_t minimumFreeInternalBytes = 48UL * 1024UL;
    size_t minimumFreePsramBytes = 256UL * 1024UL;

    // Additional headroom applied while deciding whether a new session
    // may start. Critical requests may bypass only this extra margin,
    // never the minimum emergency reserves above.
    size_t admissionMarginInternalBytes = 8UL * 1024UL;
    size_t admissionMarginPsramBytes = 64UL * 1024UL;

    uint16_t elevatedPressurePermille = 700U;
    uint16_t highPressurePermille = 820U;
    uint16_t criticalPressurePermille = 920U;

    bool requirePsramForPsramRequests = true;
    bool rejectOptionalAtElevatedPressure = false;
    bool rejectNormalAtHighPressure = true;
    bool rejectAllAtCriticalPressure = true;
};

struct ResourceBudgetRequest
{
    ResourceBudgetOwner owner = ResourceBudgetOwner::None;
    ResourceBudgetPriority priority = ResourceBudgetPriority::Normal;

    size_t internalBytes = 0;
    size_t psramBytes = 0;

    // Reclaimable memory may be dropped by the owner during recovery.
    // It is still counted as committed until resize() or release().
    size_t reclaimableInternalBytes = 0;
    size_t reclaimablePsramBytes = 0;

    bool persistent = false;
    bool allowDuplicateLabel = false;

    char label[RESOURCE_BUDGET_LABEL_CAPACITY] = {};
};

struct ResourceBudgetHandle
{
    uint8_t slot = RESOURCE_BUDGET_INVALID_SLOT;
    uint32_t generation = 0;
    uint32_t leaseId = 0;

    explicit operator bool() const
    {
        return
            slot != RESOURCE_BUDGET_INVALID_SLOT &&
            generation != 0 &&
            leaseId != 0;
    }
};

struct ResourceReservationStatus
{
    bool active = false;
    bool persistent = false;

    ResourceBudgetOwner owner = ResourceBudgetOwner::None;
    ResourceBudgetPriority priority = ResourceBudgetPriority::Normal;
    ResourceBudgetError error = ResourceBudgetError::None;

    char label[RESOURCE_BUDGET_LABEL_CAPACITY] = {};

    size_t reservedInternalBytes = 0;
    size_t reservedPsramBytes = 0;
    size_t reportedInternalBytes = 0;
    size_t reportedPsramBytes = 0;
    size_t reclaimableInternalBytes = 0;
    size_t reclaimablePsramBytes = 0;

    uint32_t createdAtMs = 0;
    uint32_t updatedAtMs = 0;
    uint32_t generation = 0;
    uint32_t leaseId = 0;
};

struct ResourceOwnerBudgetStatus
{
    ResourceBudgetOwner owner = ResourceBudgetOwner::None;

    uint8_t reservationCount = 0;
    uint8_t persistentReservationCount = 0;

    size_t reservedInternalBytes = 0;
    size_t reservedPsramBytes = 0;
    size_t reportedInternalBytes = 0;
    size_t reportedPsramBytes = 0;
    size_t reclaimableInternalBytes = 0;
    size_t reclaimablePsramBytes = 0;
};

struct ResourceBudgetStatus
{
    bool initialized = false;
    bool psramAvailable = false;

    ResourcePressureLevel pressure = ResourcePressureLevel::Normal;
    ResourceBudgetError error = ResourceBudgetError::None;

    size_t physicalFreeInternalBytes = 0;
    size_t physicalFreePsramBytes = 0;

    size_t reservedInternalBytes = 0;
    size_t reservedPsramBytes = 0;
    size_t reportedInternalBytes = 0;
    size_t reportedPsramBytes = 0;
    size_t reclaimableInternalBytes = 0;
    size_t reclaimablePsramBytes = 0;

    size_t admissibleInternalBytes = 0;
    size_t admissiblePsramBytes = 0;

    uint16_t internalPressurePermille = 0;
    uint16_t psramPressurePermille = 0;

    uint8_t activeReservationCount = 0;
    uint8_t persistentReservationCount = 0;
    uint8_t reclaimableReservationCount = 0;

    uint32_t admissionCount = 0;
    uint32_t rejectionCount = 0;
    uint32_t releaseCount = 0;
    uint32_t resizeCount = 0;
    uint32_t reportCount = 0;
    uint32_t pressureSequence = 0;
    uint32_t generation = 0;
};

using ResourceBudgetObserver = void (*)(
    const ResourceBudgetStatus& status);

class ResourceBudgetCoordinator final
{
public:
    //================================================
    // LIFECYCLE
    //================================================

    static bool begin(
        const ResourceBudgetPolicy& policy =
            ResourceBudgetPolicy{});

    static void update(uint32_t nowMs = 0);
    static void end();

    static bool ready();
    static ResourceBudgetStatus status();

    //================================================
    // ADMISSION AND RESERVATION LIFECYCLE
    //================================================

    static RuntimeResult reserve(
        const ResourceBudgetRequest& request,
        ResourceBudgetHandle& handle,
        uint32_t nowMs = 0);

    static RuntimeResult resize(
        const ResourceBudgetHandle& handle,
        size_t internalBytes,
        size_t psramBytes,
        size_t reclaimableInternalBytes = 0,
        size_t reclaimablePsramBytes = 0,
        uint32_t nowMs = 0);

    // Reports actual usage without changing the granted maximum.
    // Values above the reservation are rejected and surfaced as errors.
    static RuntimeResult reportUsage(
        const ResourceBudgetHandle& handle,
        size_t actualInternalBytes,
        size_t actualPsramBytes,
        uint32_t nowMs = 0);

    static RuntimeResult release(
        ResourceBudgetHandle& handle);

    // Releases all non-persistent reservations belonging to owner.
    // Persistent reservations are included only when explicitly requested.
    static RuntimeResult releaseOwner(
        ResourceBudgetOwner owner,
        bool includePersistent = false);

    static void releaseAll(
        bool includePersistent = false);

    //================================================
    // VALIDATION AND QUERIES
    //================================================

    static bool canAdmit(
        const ResourceBudgetRequest& request,
        ResourceBudgetError* rejectionReason = nullptr);

    static bool valid(
        const ResourceBudgetHandle& handle);

    static ResourceReservationStatus reservationStatus(
        const ResourceBudgetHandle& handle);

    static ResourceOwnerBudgetStatus ownerStatus(
        ResourceBudgetOwner owner);

    static size_t availableInternalBytes();
    static size_t availablePsramBytes();

    static size_t reclaimableBytes(
        ResourceMemoryKind kind = ResourceMemoryKind::Both);

    static ResourcePressureLevel pressureLevel();

    //================================================
    // POLICY AND DIAGNOSTICS
    //================================================

    static RuntimeResult setPolicy(
        const ResourceBudgetPolicy& policy);

    static ResourceBudgetPolicy policy();

    static void setObserver(
        ResourceBudgetObserver observer);

    static ResourceBudgetError lastError();
    static void clearError();

    static const char* ownerText(
        ResourceBudgetOwner value);

    static const char* priorityText(
        ResourceBudgetPriority value);

