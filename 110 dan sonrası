enum class RuntimeOrchestratorState : uint8_t
{
    Stopped = 0,
    Starting,
    Running,
    Suspending,
    Suspended,
    Stopping,
    ShutdownPending,
    Failed
};

enum class RuntimeOrchestratorStage : uint8_t
{
    None = 0,
    ModuleManager,
    SessionBridge,
    InputRouter,
    AudioCoordinator,
    PowerCoordinator,
    ScreenRouter,
    HealthCoordinator,
    RuntimeUpdate,
    Shutdown
};

enum class RuntimeOrchestratorError : uint8_t
{
    None = 0,
    NotInitialized,
    AlreadyUpdating,
    ModuleManagerFailed,
    SessionBridgeFailed,
    InputRouterFailed,
    AudioCoordinatorFailed,
    PowerCoordinatorFailed,
    ScreenRouterFailed,
    HealthCoordinatorFailed,
    ForegroundCloseFailed,
    ShutdownRequestFailed,
    HealthFatal,
    UpdateOverrun
};

struct RuntimeOrchestratorPolicy
{
    // A runtime health fatal state may request a controlled shutdown.
    bool shutdownOnFatalHealth = true;

    // Foreground cleanup is performed before a user/software shutdown.
    bool closeForegroundBeforeShutdown = true;

    // The listed coordinators are suspended together. Power and health
    // may continue at a reduced cadence according to the flags below.
    bool suspendInput = true;
    bool suspendScreen = true;
    bool suspendAudio = true;
    bool continuePowerWhileSuspended = true;
    bool continueHealthWhileSuspended = true;

    // A routed physical event wakes/restores the power coordinator.
    bool notifyPowerOnInput = true;

    // Diagnostic limit only; the orchestrator does not delay the loop.
    uint32_t maximumUpdateDurationUs = 20000UL;
    uint8_t maximumConsecutiveOverruns = 3U;
};

struct RuntimeOrchestratorStatus
{
    bool initialized = false;
    bool updateInProgress = false;
    bool suspended = false;
    bool foregroundActive = false;
    bool shutdownPending = false;
    bool fatalHealth = false;

    RuntimeOrchestratorState state =
        RuntimeOrchestratorState::Stopped;

    RuntimeOrchestratorStage stage =
        RuntimeOrchestratorStage::None;

    RuntimeOrchestratorError error =
        RuntimeOrchestratorError::None;

    RuntimeResult lastResult = RuntimeResult::Ok;

    RuntimeModuleKind moduleKind = RuntimeModuleKind::None;
    RuntimeModuleState moduleState = RuntimeModuleState::Stopped;
    EngineKind engine = EngineKind::None;

    RuntimeHealthLevel healthLevel = RuntimeHealthLevel::Healthy;
    RuntimePowerMode powerMode = RuntimePowerMode::Normal;

    ShutdownReason shutdownReason = ShutdownReason::None;

    uint32_t startedAtMs = 0;
    uint32_t lastUpdateAtMs = 0;
    uint32_t lastUpdateDurationUs = 0;
    uint32_t updateSequence = 0;
    uint32_t stateSequence = 0;
    uint32_t observedInputEventSequence = 0;
    uint32_t overrunCount = 0;

