bool buildProfileFilePath(
    uint16_t profileID,
    char* buffer,
    size_t bufferSize
)
{
    if(buffer == nullptr ||
       bufferSize == 0)
    {
        return false;
    }


    if(profileID ==
       PROFILE_INVALID_ID)
    {
        buffer[0] =
            '\0';


        return false;
    }


    int result =
        snprintf(
            buffer,
            bufferSize,
            "%s/profile_%u.dat",
            PROFILE_STORAGE_FOLDER,
            profileID
        );


    return
        result > 0 &&
        (size_t)result < bufferSize;
}



