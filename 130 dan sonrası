    driverConfig.use_apll =
        config_.requestApll;
    driverConfig.tx_desc_auto_clear = true;
    driverConfig.fixed_mclk = 0;

    if (i2s_driver_install(
            LEGACY_I2S_PORT,
            &driverConfig,
            0,
            nullptr) != ESP_OK)
    {
        currentStatus_.driverErrorCount =
            saturatingIncrement32(
                currentStatus_.driverErrorCount);

        return setError(
            I2sAudioBackendError::DriverInstallFailed,
            RuntimeResult::IoError);
    }

    legacyDriverInstalled = true;

    i2s_pin_config_t pinConfig = {};
    pinConfig.mck_io_num =
        config_.masterClockPin;
    pinConfig.bck_io_num =
        config_.bitClockPin;
    pinConfig.ws_io_num =
        config_.wordSelectPin;
    pinConfig.data_out_num =
        config_.dataOutPin;
    pinConfig.data_in_num =
        I2S_PIN_NO_CHANGE;

    if (i2s_set_pin(
            LEGACY_I2S_PORT,
            &pinConfig) != ESP_OK)
    {
        i2s_driver_uninstall(
            LEGACY_I2S_PORT);
        legacyDriverInstalled = false;

        currentStatus_.driverErrorCount =
            saturatingIncrement32(
                currentStatus_.driverErrorCount);

        return setError(
            I2sAudioBackendError::PinConfigurationFailed,
            RuntimeResult::IoError);
    }

    currentStatus_.usingApll =
        config_.requestApll;
#else
    currentStatus_.usingApll = false;
#endif

    currentStatus_.driverInstalled = true;
    currentStatus_.error =
        I2sAudioBackendError::None;

    return RuntimeResult::Ok;
}

