bool AiDifficultyManager::begin(
    AiDifficultyLevel requestedLevelValue)
{
    if (currentStatus_.initialized)
    {
        return setRequestedLevel(
            requestedLevelValue);
    }

    if (!validLevel(
            requestedLevelValue,
            true) ||
        !validatePolicy(adaptivePolicy_))
    {
        currentStatus_ = {};

        currentStatus_.error =
            !validLevel(
                requestedLevelValue,
                true)
                ? AiDifficultyError::
                    InvalidLevel
                : AiDifficultyError::
                    InvalidPolicy;

        return false;
    }

    const uint32_t nowMs = millis();

    currentStatus_ = {};

    currentStatus_.initialized = true;

    currentStatus_.requestedLevel =
        requestedLevelValue;

    currentStatus_.adaptiveActive =
        requestedLevelValue ==
            AiDifficultyLevel::Adaptive &&
        adaptivePolicy_.enabled;

    currentStatus_.effectiveLevel =
        currentStatus_.adaptiveActive
            ? clampedAdaptiveLevel(
                adaptivePolicy_.initialLevel)
            : requestedLevelValue;

    currentStatus_.adjustmentReason =
        AiDifficultyAdjustmentReason::
            InitialSelection;

    currentStatus_.error =
        AiDifficultyError::None;

    currentStatus_.windowStartedAtMs =
        nowMs;

    currentStatus_.lastAdjustmentAtMs =
        nowMs;

    currentStatus_.adjustmentSequence =
        1U;

    weightedPerformanceTotal_ = 0;
    confidenceTotal_ = 0;

    notifyStateChanged();

    return true;
}

void AiDifficultyManager::reset(
    AiDifficultyLevel requestedLevelValue)
{
    if (!validLevel(
            requestedLevelValue,
            true))
    {
        setError(
            AiDifficultyError::InvalidLevel);

        return;
    }

    const uint32_t nowMs = millis();

    const bool wasInitialized =
        currentStatus_.initialized;

    currentStatus_ = {};

    currentStatus_.initialized =
        wasInitialized;

    currentStatus_.requestedLevel =
        requestedLevelValue;

    currentStatus_.adaptiveActive =
        requestedLevelValue ==
            AiDifficultyLevel::Adaptive &&
        adaptivePolicy_.enabled;

    currentStatus_.effectiveLevel =
        currentStatus_.adaptiveActive
            ? clampedAdaptiveLevel(
                adaptivePolicy_.initialLevel)
            : requestedLevelValue;

    currentStatus_.adjustmentReason =
        AiDifficultyAdjustmentReason::Reset;

    currentStatus_.error =
        wasInitialized
            ? AiDifficultyError::None
            : AiDifficultyError::
                NotInitialized;

    currentStatus_.windowStartedAtMs =
        nowMs;

    currentStatus_.lastAdjustmentAtMs =
        nowMs;

    currentStatus_.adjustmentSequence =
        wasInitialized ? 1U : 0U;

    weightedPerformanceTotal_ = 0;
    confidenceTotal_ = 0;

    notifyStateChanged();
}

void AiDifficultyManager::end()
{
    currentStatus_ = {};

    weightedPerformanceTotal_ = 0;
    confidenceTotal_ = 0;

    observer_ = nullptr;
}

bool AiDifficultyManager::ready()
{
    return
        currentStatus_.initialized &&
        currentStatus_.error ==
