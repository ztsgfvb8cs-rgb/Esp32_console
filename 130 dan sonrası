bool ResourceBudgetCoordinator::admissionAllowed(
    const ResourceBudgetRequest& request,
    size_t replacingInternalBytes,
    size_t replacingPsramBytes,
    ResourceBudgetError* rejectionReason)
{
    if (rejectionReason != nullptr)
    {
        *rejectionReason = ResourceBudgetError::None;
    }

    refreshStatus();

    if (request.psramBytes > 0 &&
        policy_.requirePsramForPsramRequests &&
        !currentStatus_.psramAvailable)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                ResourceBudgetError::PsramUnavailable;
        }

        return false;
    }

    const size_t currentInternal =
        subtractFloor(
            currentStatus_.reservedInternalBytes,
            replacingInternalBytes);

    const size_t currentPsram =
        subtractFloor(
            currentStatus_.reservedPsramBytes,
            replacingPsramBytes);

    const size_t projectedInternal =
        saturatingAddSize(
            currentInternal,
            request.internalBytes);

    const size_t projectedPsram =
        saturatingAddSize(
            currentPsram,
            request.psramBytes);

    const size_t internalCapacity =
        saturatingAddSize(
            currentStatus_.physicalFreeInternalBytes,
            currentStatus_.reportedInternalBytes);

    const size_t psramCapacity =
        saturatingAddSize(
            currentStatus_.physicalFreePsramBytes,
            currentStatus_.reportedPsramBytes);

    size_t protectedInternal =
        policy_.minimumFreeInternalBytes;

    size_t protectedPsram =
        policy_.minimumFreePsramBytes;

    if (request.priority !=
        ResourceBudgetPriority::Critical)
    {
        protectedInternal = saturatingAddSize(
            protectedInternal,
            policy_.admissionMarginInternalBytes);

        protectedPsram = saturatingAddSize(
            protectedPsram,
            policy_.admissionMarginPsramBytes);
    }

    if (projectedInternal >
        subtractFloor(
            internalCapacity,
            protectedInternal))
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                ResourceBudgetError::InsufficientInternalBudget;
        }

        return false;
    }

    if (projectedPsram > 0 &&
        projectedPsram >
            subtractFloor(
                psramCapacity,
                protectedPsram))
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                currentStatus_.psramAvailable
                    ? ResourceBudgetError::InsufficientPsramBudget
                    : ResourceBudgetError::PsramUnavailable;
        }

        return false;
    }

    const uint16_t projectedInternalPressure =
        pressurePermille(
            internalCapacity,
            policy_.minimumFreeInternalBytes,
            projectedInternal);

    uint16_t projectedPsramPressure = 0;

    if (currentStatus_.psramAvailable ||
        projectedPsram > 0)
    {
        projectedPsramPressure =
            pressurePermille(
                psramCapacity,
                policy_.minimumFreePsramBytes,
                projectedPsram);
    }

    const ResourcePressureLevel projectedPressure =
        calculatePressure(
            projectedInternalPressure,
            projectedPsramPressure);

    if (policy_.rejectAllAtCriticalPressure &&
        projectedPressure ==
            ResourcePressureLevel::Critical)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                ResourceBudgetError::CriticalPressure;
        }

        return false;
    }

    if (request.priority ==
            ResourceBudgetPriority::Optional &&
        policy_.rejectOptionalAtElevatedPressure &&
        projectedPressure >=
            ResourcePressureLevel::Elevated)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                ResourceBudgetError::CriticalPressure;
        }

        return false;
    }

    if (request.priority ==
            ResourceBudgetPriority::Normal &&
        policy_.rejectNormalAtHighPressure &&
        projectedPressure >=
            ResourcePressureLevel::High)
    {
        if (rejectionReason != nullptr)
        {
            *rejectionReason =
                ResourceBudgetError::CriticalPressure;
        }

        return false;
    }

    return true;
}

size_t ResourceBudgetCoordinator::physicalFreeInternalBytes()
{
#if defined(ARDUINO_ARCH_ESP32)
    return heap_caps_get_free_size(
        MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
#else
    const MemoryMetrics metrics = MemoryManager::metrics();

    return subtractFloor(
        HOST_INTERNAL_CAPACITY_BYTES,
        metrics.trackedInternalBytes);
#endif
}

size_t ResourceBudgetCoordinator::physicalFreePsramBytes()
{
#if defined(ARDUINO_ARCH_ESP32)
    if (!MemoryManager::psramAvailable())
    {
        return 0;
    }

    return heap_caps_get_free_size(
        MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
#else
    return 0;
#endif
}

void ResourceBudgetCoordinator::refreshStatus()
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    const ResourcePressureLevel oldPressure =
        currentStatus_.pressure;

    currentStatus_.psramAvailable =
        MemoryManager::psramAvailable();

    currentStatus_.physicalFreeInternalBytes =
        physicalFreeInternalBytes();

    currentStatus_.physicalFreePsramBytes =
        physicalFreePsramBytes();

    currentStatus_.reservedInternalBytes = 0;
    currentStatus_.reservedPsramBytes = 0;
    currentStatus_.reportedInternalBytes = 0;
    currentStatus_.reportedPsramBytes = 0;
    currentStatus_.reclaimableInternalBytes = 0;
    currentStatus_.reclaimablePsramBytes = 0;
    currentStatus_.activeReservationCount = 0;
    currentStatus_.persistentReservationCount = 0;
    currentStatus_.reclaimableReservationCount = 0;

    for (uint8_t index = 0;
         index < RESOURCE_BUDGET_MAX_RESERVATIONS;
         ++index)
    {
        const ReservationSlot& slot = reservations_[index];

        if (!slot.active || !slot.status.active)
        {
            continue;
        }

        if (currentStatus_.activeReservationCount < UINT8_MAX)
        {
            ++currentStatus_.activeReservationCount;
        }

        if (slot.status.persistent &&
            currentStatus_.persistentReservationCount < UINT8_MAX)
        {
            ++currentStatus_.persistentReservationCount;
        }

        if ((slot.status.reclaimableInternalBytes > 0 ||
             slot.status.reclaimablePsramBytes > 0) &&
            currentStatus_.reclaimableReservationCount < UINT8_MAX)
        {
            ++currentStatus_.reclaimableReservationCount;
        }

        currentStatus_.reservedInternalBytes =
            saturatingAddSize(
                currentStatus_.reservedInternalBytes,
                slot.status.reservedInternalBytes);

        currentStatus_.reservedPsramBytes =
            saturatingAddSize(
                currentStatus_.reservedPsramBytes,
                slot.status.reservedPsramBytes);

        currentStatus_.reportedInternalBytes =
            saturatingAddSize(
                currentStatus_.reportedInternalBytes,
                slot.status.reportedInternalBytes);

        currentStatus_.reportedPsramBytes =
            saturatingAddSize(
                currentStatus_.reportedPsramBytes,
                slot.status.reportedPsramBytes);

        currentStatus_.reclaimableInternalBytes =
            saturatingAddSize(
                currentStatus_.reclaimableInternalBytes,
                slot.status.reclaimableInternalBytes);

        currentStatus_.reclaimablePsramBytes =
            saturatingAddSize(
                currentStatus_.reclaimablePsramBytes,
                slot.status.reclaimablePsramBytes);
    }

    const size_t internalCapacity =
        saturatingAddSize(
            currentStatus_.physicalFreeInternalBytes,
            currentStatus_.reportedInternalBytes);

    const size_t psramCapacity =
        saturatingAddSize(
            currentStatus_.physicalFreePsramBytes,
            currentStatus_.reportedPsramBytes);

    currentStatus_.admissibleInternalBytes =
        subtractFloor(
            subtractFloor(
                internalCapacity,
                policy_.minimumFreeInternalBytes),
            currentStatus_.reservedInternalBytes);

    currentStatus_.admissiblePsramBytes =
        currentStatus_.psramAvailable
            ? subtractFloor(
                subtractFloor(
                    psramCapacity,
                    policy_.minimumFreePsramBytes),
                currentStatus_.reservedPsramBytes)
            : 0;

    currentStatus_.internalPressurePermille =
        pressurePermille(
            internalCapacity,
            policy_.minimumFreeInternalBytes,
            currentStatus_.reservedInternalBytes);

    currentStatus_.psramPressurePermille =
        currentStatus_.psramAvailable ||
                currentStatus_.reservedPsramBytes > 0
            ? pressurePermille(
                psramCapacity,
                policy_.minimumFreePsramBytes,
                currentStatus_.reservedPsramBytes)
            : 0;

    currentStatus_.pressure = calculatePressure(
        currentStatus_.internalPressurePermille,
        currentStatus_.psramPressurePermille);

    if (currentStatus_.pressure != oldPressure)
    {
        currentStatus_.pressureSequence =
            saturatingIncrement32(
                currentStatus_.pressureSequence);
    }
}

ResourcePressureLevel
ResourceBudgetCoordinator::calculatePressure(
    uint16_t internalPermille,
    uint16_t psramPermille)
{
    const uint16_t highest =
        internalPermille > psramPermille
            ? internalPermille
            : psramPermille;

    if (highest >= policy_.criticalPressurePermille)
    {
        return ResourcePressureLevel::Critical;
    }

    if (highest >= policy_.highPressurePermille)
    {
        return ResourcePressureLevel::High;
    }

    if (highest >= policy_.elevatedPressurePermille)
    {
        return ResourcePressureLevel::Elevated;
    }

    return ResourcePressureLevel::Normal;
}

uint16_t ResourceBudgetCoordinator::pressurePermille(
    size_t freeBytes,
    size_t protectedBytes,
    size_t committedBytes)
{
    if (freeBytes == 0)
    {
        return protectedBytes > 0 || committedBytes > 0
            ? RESOURCE_BUDGET_PERMILLE_MAX
            : 0U;
    }

    const size_t pressureBytes =
        saturatingAddSize(
            protectedBytes,
            committedBytes);

    if (pressureBytes >= freeBytes)
    {
        return RESOURCE_BUDGET_PERMILLE_MAX;
    }

    const uint64_t scaled =
        static_cast<uint64_t>(pressureBytes) *
        static_cast<uint64_t>(RESOURCE_BUDGET_PERMILLE_MAX);

    const uint64_t result =
        scaled / static_cast<uint64_t>(freeBytes);

    return result > RESOURCE_BUDGET_PERMILLE_MAX
        ? RESOURCE_BUDGET_PERMILLE_MAX
        : static_cast<uint16_t>(result);
}

RuntimeResult ResourceBudgetCoordinator::setError(
    ResourceBudgetError error,
    RuntimeResult result)
{
    currentStatus_.error = error;
    notifyStateChanged();

    return result;
}

void ResourceBudgetCoordinator::invalidateHandle(
    ResourceBudgetHandle& handle)
{
    handle.slot = RESOURCE_BUDGET_INVALID_SLOT;
    handle.generation = 0;
    handle.leaseId = 0;
}

void ResourceBudgetCoordinator::notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(currentStatus_);
    }
}
