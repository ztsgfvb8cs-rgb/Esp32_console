                     MemoryPreference::PsramOnly &&
                 !MemoryManager::psramAvailable())
                    ? PsramPoolError::PsramUnavailable
                    : PsramPoolError::BackingAllocationFailed;

            return setError(
                allocationError,
                RuntimeResult::OutOfMemory);
        }

        if (config_.requirePsram && !backing.psram)
        {
            MemoryManager::release(backing);

            for (uint8_t releaseIndex = 0;
                 releaseIndex < classIndex;
                 ++releaseIndex)
            {
                MemoryManager::release(
                    backings_[releaseIndex]);
            }

            resetMetadata(true);
            status_.generation = generation;

            return setError(
                PsramPoolError::PsramUnavailable,
                RuntimeResult::NotReady);
        }

        backings_[classIndex] = backing;
        classStrides_[classIndex] = stride;
        classSlotStarts_[classIndex] = nextSlot;

        for (uint16_t localSlot = 0;
             localSlot < classConfig.blockCount;
             ++localSlot)
        {
            const uint16_t globalSlot =
                static_cast<uint16_t>(
                    nextSlot + localSlot);

            slots_[globalSlot] = {};
            slots_[globalSlot].classIndex = classIndex;
