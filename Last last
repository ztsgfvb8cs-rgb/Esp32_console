bool SystemMonitorManager::begin()
{
    if (initialized)
        return true;

    currentSnapshot = emptySnapshot();

    uint32_t now = millis();

    lastUpdateTime = now;
    lastMillisValue = now;
    millisOverflowCount = 0;

    storageStatusOverridden = false;

    resetFrameStatistics();

    initialized = true;

    collectRuntimeInformation();
    updateStorageValues();

    currentSnapshot.uptimeMilliseconds =
        extendedUptimeMilliseconds();

    currentSnapshot.sampledAt = now;
    currentSnapshot.valid = true;

    updateWarningValues();
    updateHealthLevel();

    return true;
}


void SystemMonitorManager::update()
{
    if (!initialized)
        return;

    uint32_t now = millis();

    currentSnapshot.uptimeMilliseconds =
        extendedUptimeMilliseconds();

    updateFrameWindow(now);

    if (now - lastUpdateTime >= UPDATE_INTERVAL)
    {
        lastUpdateTime = now;

        collectRuntimeInformation();
        updateStorageValues();

        currentSnapshot.sampledAt = now;
        currentSnapshot.valid = true;
    }

    updateWarningValues();
    updateHealthLevel();
}


