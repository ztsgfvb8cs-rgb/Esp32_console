bool validatePlayerProfile()
{
    if(!playerProfile.initialized)
    {
        return false;
    }


    if(playerProfile.profileID ==
       PROFILE_INVALID_ID)
    {
        return false;
    }


    if(!validatePlayerName(
        playerProfile.playerName
    ))
    {
        return false;
    }


    if(playerProfile.favoriteGameCount >
       PROFILE_MAX_FAVORITES)
    {
        return false;
    }


    if(playerProfile.preferences.volume >
       100)
    {
        return false;
    }


    return true;
}



bool validatePlayerName(
    const char* playerName
)
{
    if(playerName == nullptr)
    {
        return false;
    }


    size_t length =
        strlen(
            playerName
        );


    if(length == 0)
    {
        return false;
    }


    if(length >=
       PROFILE_NAME_LENGTH)
    {
        return false;
    }


    for(size_t i = 0;
        i < length;
        i++)
    {
        char character =
            playerName[i];


        if(character < 32 ||
           character > 126)
        {
            return false;
        }
    }


    return true;
}



