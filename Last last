bool savePlaytimeRecord(
    const PlaytimeStatistics& statistics
)
{
    if(statistics.gameID ==
       PLAYTIME_INVALID_GAME_ID)
    {
        return false;
    }


    if(!statistics.initialized)
    {
        return false;
    }


    int16_t recordIndex =
        findRecordIndex(
            statistics.gameID
        );


    bool newRecord =
        recordIndex < 0;


    if(newRecord)
    {
        if(playtimeRecordCount >=
           MAX_PLAYTIME_RECORDS)
        {
            playtimeStorageStatus =
                PLAYTIME_STORAGE_FULL;


            return false;
        }


        recordIndex =
            playtimeRecordCount;
    }


    StoredPlaytimeRecord record;


    clearStoredRecord(
        record
    );


    record.gameID =
        statistics.gameID;


    record.reserved =
        0;


    record.statistics =
        statistics;


    uint32_t currentUnixTime =
        getCurrentStorageUnixTime();


    if(newRecord)
    {
        record.dateInfo.firstPlayedUnix =
            currentUnixTime;


        record.dateInfo.lastPlayedUnix =
            currentUnixTime;
    }
    else
    {
        record.dateInfo =
            playtimeRecords[
                recordIndex
            ].dateInfo;


        if(record.dateInfo.firstPlayedUnix == 0 &&
           currentUnixTime > 0)
        {
            record.dateInfo.firstPlayedUnix =
                currentUnixTime;
        }


        if(currentUnixTime > 0)
        {
            record.dateInfo.lastPlayedUnix =
                currentUnixTime;
        }
    }


    record.dateInfo.lastSavedUnix =
        currentUnixTime;


    record.dateInfo.rtcTimeValid =
        currentUnixTime > 0;


    record.valid =
        true;


    record.checksum =
        calculatePlaytimeRecordChecksum(
            record
        );


    playtimeRecords[
        recordIndex
    ] = record;


    if(newRecord)
    {
        playtimeRecordCount++;
    }


    if(!savePlaytimeStorage())
    {
        return false;
    }


    playtimeStorageStatus =
        PLAYTIME_STORAGE_READY;


    return true;
}



