void RuntimeScreenRouter::invalidate(
    RuntimeScreenRefreshReason reason)
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    currentStatus_.dirty = true;

    currentStatus_.refreshReason =
        reason == RuntimeScreenRefreshReason::None
            ? RuntimeScreenRefreshReason::Forced
            : reason;

    synchronizeStatus();

    if (!currentStatus_.foregroundOwned ||
        !policy_.suppressUiDuringForeground)
    {
        ScreenManager::invalidate();
    }
}

void RuntimeScreenRouter::requestImmediateRender(
    RuntimeScreenRefreshReason reason)
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    currentStatus_.dirty = true;
    currentStatus_.forceRequested = true;

    currentStatus_.refreshReason =
        reason == RuntimeScreenRefreshReason::None
            ? RuntimeScreenRefreshReason::Forced
            : reason;

    synchronizeStatus();

    if (!currentStatus_.foregroundOwned ||
        !policy_.suppressUiDuringForeground)
    {
        ScreenManager::invalidate();
    }
}

RuntimeResult RuntimeScreenRouter::renderNow(
    uint32_t nowMs,
    uint32_t nowUs)
{
    if (!currentStatus_.initialized)
    {
        return recordFailure(
            RuntimeScreenError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (currentStatus_.suspended ||
        currentStatus_.rendering)
    {
        ++currentStatus_.skippedFrameCount;

        return RuntimeResult::Busy;
    }

    if (!DisplayDriver::ready())
    {
        return recordFailure(
            RuntimeScreenError::DisplayNotReady,
            RuntimeResult::NotReady);
    }

    if (!RuntimeModuleManager::ready())
    {
        return recordFailure(
            RuntimeScreenError::ModuleManagerNotReady,
            RuntimeResult::NotReady);
    }

    if (!RuntimeSessionBridge::ready())
    {
        return recordFailure(
            RuntimeScreenError::SessionBridgeNotReady,
            RuntimeResult::NotReady);
    }

    synchronizeStatus();

    const RuntimeScreenMode mode =
        currentStatus_.mode;

    if ((mode == RuntimeScreenMode::ForegroundGame ||
         mode == RuntimeScreenMode::ForegroundPdf) &&
        !foregroundStateValid(mode))
    {
        return recordFailure(
            RuntimeScreenError::ForegroundScreenMismatch,
            RuntimeResult::InternalError);
    }

    if (mode == RuntimeScreenMode::ErrorScreen &&
        currentStatus_.foregroundOwned &&
        policy_.suppressUiDuringForeground)
    {
        return recordFailure(
            RuntimeScreenError::UnsupportedForeground,
            RuntimeResult::Unsupported);
    }

    if (!shouldRender(mode, nowMs, nowUs))
    {
        ++currentStatus_.skippedFrameCount;

        return RuntimeResult::Busy;
    }

    currentStatus_.rendering = true;

    const uint32_t startedUs = micros();

    const uint32_t frameBefore =
        FramePacer::metrics().frameNumber;

    RuntimeResult result =
        RuntimeResult::Unsupported;

    switch (mode)
    {
        case RuntimeScreenMode::UserInterface:
        case RuntimeScreenMode::ErrorScreen:
            result = renderUserInterface(nowMs);
            break;

        case RuntimeScreenMode::ForegroundGame:
        case RuntimeScreenMode::ForegroundPdf:
            result = renderForeground(nowUs);
            break;

        case RuntimeScreenMode::None:
        default:
            result = RuntimeResult::Unsupported;
            break;
    }

    const uint32_t finishedUs = micros();

    const uint32_t durationUs =
        finishedUs - startedUs;

    currentStatus_.rendering = false;

    if (result != RuntimeResult::Ok)
    {
        return recordFailure(
            RuntimeScreenError::RenderFailed,
            result);
    }

    if (mode == RuntimeScreenMode::UserInterface ||
        mode == RuntimeScreenMode::ErrorScreen)
    {
        const uint32_t frameAfter =
            FramePacer::metrics().frameNumber;

        if (frameAfter == frameBefore)
        {
            ++currentStatus_.skippedFrameCount;

            return RuntimeResult::Ok;
        }
    }

    recordSuccess(nowMs, durationUs);

    return RuntimeResult::Ok;
}

