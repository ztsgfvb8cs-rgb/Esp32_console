void PowerManager::clearState()
{
    currentStatus.initialized = false;
    currentStatus.automaticIdleEnabled = true;
    currentStatus.keepAwake = false;
    currentStatus.shutdownRequested = false;
    currentStatus.shutdownPreparationComplete = false;
    currentStatus.boostEnabled = false;
    currentStatus.backlightEnabled = false;

    currentStatus.lastActivityTime = 0;
    currentStatus.idleTimeMs = 0;
    currentStatus.dimTimeoutMs = DEFAULT_DIM_TIMEOUT_MS;
    currentStatus.displayOffTimeoutMs =
        DEFAULT_DISPLAY_OFF_TIMEOUT_MS;
    currentStatus.shutdownRequestTime = 0;

    currentStatus.state = PowerState::OFF;
    currentStatus.shutdownReason = ShutdownReason::NONE;
    currentStatus.error = PowerError::NONE;

    lastButtonPollTime = 0;
}

bool PowerManager::fail(PowerError error)
{
    currentStatus.initialized = false;
    currentStatus.error = error;
    synchronizeHardwareStatus();
    transitionTo(PowerState::FAILED);

    return false;
}

void PowerManager::processDirectButtonActivity(
    uint32_t now)
{
    if (now - lastButtonPollTime <
        DIRECT_BUTTON_POLL_INTERVAL_MS)
    {
        return;
    }

    lastButtonPollTime = now;

    if (anyDirectButtonPressed())
    {
        notifyActivity();
    }
}

void PowerManager::processIdle(uint32_t now)
{
    currentStatus.idleTimeMs =
        now - currentStatus.lastActivityTime;

    if (!currentStatus.automaticIdleEnabled ||
        currentStatus.keepAwake)
    {
        if (currentStatus.state == PowerState::DIMMED ||
            currentStatus.state == PowerState::DISPLAY_OFF)
        {
            wakeDisplay();
        }

        return;
    }

    if (currentStatus.idleTimeMs >=
        currentStatus.displayOffTimeoutMs)
    {
        if (currentStatus.state != PowerState::DISPLAY_OFF)
        {
            turnDisplayOff();
        }

        return;
    }

    if (currentStatus.idleTimeMs >=
            currentStatus.dimTimeoutMs &&
        currentStatus.state == PowerState::ACTIVE)
    {
        transitionTo(PowerState::DIMMED);
    }
}

void PowerManager::processShutdown(uint32_t now)
{
    const uint32_t elapsed =
        now - currentStatus.shutdownRequestTime;

    if (currentStatus.state == PowerState::SHUTDOWN_PENDING &&
        elapsed < SHUTDOWN_REQUEST_GRACE_MS)
    {
        return;
    }

    if (currentStatus.state == PowerState::SHUTDOWN_PENDING)
    {
        transitionTo(PowerState::SHUTTING_DOWN);

        HardwareManager::setHapticEnabled(false);

        if (BoardConfig::ENABLE_DISPLAY)
        {
            HardwareManager::setBacklightEnabled(false);
            currentStatus.backlightEnabled = false;
        }
    }

    if (!currentStatus.shutdownPreparationComplete)
    {
        if (shutdownCallback == nullptr ||
            shutdownCallback(currentStatus.shutdownReason))
        {
            currentStatus.shutdownPreparationComplete = true;
        }
    }

    if (!currentStatus.shutdownPreparationComplete &&
        elapsed < SHUTDOWN_PREPARATION_TIMEOUT_MS)
    {
        return;
    }

    (void)performPowerCut();
}

void PowerManager::transitionTo(PowerState newState)
{
    if (currentStatus.state == newState)
    {
        return;
    }

    const PowerState previousState = currentStatus.state;
    currentStatus.state = newState;

    if (stateCallback != nullptr)
    {
        stateCallback(previousState, newState);
    }
}

bool PowerManager::wakeDisplay()
{
    if (BoardConfig::ENABLE_DISPLAY &&
        !HardwareManager::backlightEnabled())
    {
        if (!HardwareManager::setBacklightEnabled(true))
        {
            return fail(
                PowerError::BACKLIGHT_CONTROL_FAILED);
        }
    }

    synchronizeHardwareStatus();
    transitionTo(PowerState::ACTIVE);

    return true;
}

bool PowerManager::turnDisplayOff()
{
    if (BoardConfig::ENABLE_DISPLAY &&
        HardwareManager::backlightEnabled())
    {
        if (!HardwareManager::setBacklightEnabled(false))
        {
            return fail(
                PowerError::BACKLIGHT_CONTROL_FAILED);
        }
    }

    synchronizeHardwareStatus();
    transitionTo(PowerState::DISPLAY_OFF);

    return true;
}

bool PowerManager::performPowerCut()
{
    HardwareManager::setHapticEnabled(false);

    if (BoardConfig::ENABLE_DISPLAY)
    {
        HardwareManager::setBacklightEnabled(false);
    }

    synchronizeHardwareStatus();

    if (!HardwareManager::setBoostEnabled(false))
    {
        return fail(PowerError::BOOST_CONTROL_FAILED);
    }

    // On a self-latching power circuit the MCU may lose power
    // during the call above. These assignments are still useful
    // for tests and for boards where EN does not cut instantly.
    currentStatus.boostEnabled = false;
    currentStatus.backlightEnabled = false;
    currentStatus.initialized = false;
    currentStatus.shutdownRequested = false;
    transitionTo(PowerState::POWER_DISABLED);

    return true;
}

bool PowerManager::validShutdownReason(
    ShutdownReason reason)
{
    return
        reason > ShutdownReason::NONE &&
        reason <= ShutdownReason::INTERNAL_ERROR;
}

bool PowerManager::anyDirectButtonPressed()
{
    for (uint8_t index = 0;
         index < static_cast<uint8_t>(DirectButton::COUNT);
         ++index)
    {
        if (HardwareManager::buttonPressed(
                static_cast<DirectButton>(index)))
        {
            return true;
        }
    }

    return false;
}

void PowerManager::synchronizeHardwareStatus()
{
    currentStatus.boostEnabled =
        HardwareManager::boostEnabled();

    currentStatus.backlightEnabled =
        BoardConfig::ENABLE_DISPLAY
            ? HardwareManager::backlightEnabled()
            : false;
}
