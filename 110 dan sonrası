void AiDifficultyManager::evaluateAdaptiveWindow(
    uint32_t nowMs,
    bool forceEvaluation)
{
    if (!currentStatus_.adaptiveActive ||
        !adaptivePolicy_.enabled)
    {
        return;
    }

    const bool enoughSamples =
        currentStatus_.windowSampleCount >=
            adaptivePolicy_.minimumSamples;

    const bool windowElapsed =
        currentStatus_.
                windowStartedAtMs != 0 &&
        nowMs -
                currentStatus_.
                    windowStartedAtMs >=
            adaptivePolicy_.
                evaluationWindowMs;

    if (!forceEvaluation &&
        !windowElapsed)
    {
        return;
    }

    if (!enoughSamples)
    {
        currentStatus_.adjustmentPending =
            false;

        currentStatus_.adjustmentReason =
            AiDifficultyAdjustmentReason::
                InsufficientSamples;

        clearAdaptiveWindow(nowMs);
        notifyStateChanged();

        return;
    }

    const bool cooldownActive =
        !forceEvaluation &&
        currentStatus_.
                lastAdjustmentAtMs != 0 &&
        nowMs -
                currentStatus_.
                    lastAdjustmentAtMs <
            adaptivePolicy_.
                adjustmentCooldownMs;

    if (cooldownActive)
    {
        currentStatus_.adjustmentPending =
            true;

        currentStatus_.adjustmentReason =
            AiDifficultyAdjustmentReason::
                CooldownActive;

        notifyStateChanged();

        return;
    }

    const uint16_t upperThreshold =
        addClampedPermille(
            adaptivePolicy_.
                stepUpThresholdPermille,
            adaptivePolicy_.
                stabilityMarginPermille);

    const uint16_t lowerThreshold =
        subtractClampedPermille(
            adaptivePolicy_.
                stepDownThresholdPermille,
            adaptivePolicy_.
                stabilityMarginPermille);

    const uint8_t current =
        fixedLevelIndex(
            currentStatus_.effectiveLevel);

    const uint8_t minimum =
        fixedLevelIndex(
            adaptivePolicy_.minimumLevel);

    const uint8_t maximum =
        fixedLevelIndex(
            adaptivePolicy_.maximumLevel);

    uint8_t target = current;

    AiDifficultyAdjustmentReason reason =
        AiDifficultyAdjustmentReason::
            BalancedPerformance;

    if (currentStatus_.
            rollingPerformancePermille >=
        upperThreshold)
    {
        const uint16_t stepped =
            static_cast<uint16_t>(current) +
            adaptivePolicy_.
                maximumLevelStep;

        target = stepped > maximum
            ? maximum
            : static_cast<uint8_t>(
                stepped);

        reason =
            AiDifficultyAdjustmentReason::
                PlayerDominating;
    }
    else if (
        currentStatus_.
            rollingPerformancePermille <=
        lowerThreshold)
    {
        target =
            adaptivePolicy_.
                    maximumLevelStep >=
                current
                ? 0U
                : static_cast<uint8_t>(
                    current -
                    adaptivePolicy_.
                        maximumLevelStep);

        if (target < minimum)
        {
            target = minimum;
        }

        reason =
            AiDifficultyAdjustmentReason::
                PlayerStruggling;
    }

    applyEffectiveLevel(
        fixedLevelFromIndex(target),
        reason,
        nowMs);

    clearAdaptiveWindow(nowMs);
    notifyStateChanged();
}

void AiDifficultyManager::clearAdaptiveWindow(
    uint32_t nowMs)
{
    weightedPerformanceTotal_ = 0;
    confidenceTotal_ = 0;

    currentStatus_.windowSampleCount =
        0;

    currentStatus_.windowStartedAtMs =
        nowMs;

    currentStatus_.
        rollingPerformancePermille =
            AI_PERMILLE_MIDPOINT;

    currentStatus_.
        rollingConfidencePermille =
            0;

    currentStatus_.adjustmentPending =
        false;
}

void AiDifficultyManager::applyEffectiveLevel(
    AiDifficultyLevel level,
    AiDifficultyAdjustmentReason reason,
    uint32_t nowMs)
{
    if (!validLevel(level, false))
    {
        setError(
            AiDifficultyError::InvalidLevel);

        return;
    }

    const bool changed =
        currentStatus_.effectiveLevel !=
            level;

    currentStatus_.effectiveLevel = level;

    currentStatus_.adjustmentReason =
        reason;

    currentStatus_.error =
        AiDifficultyError::None;

    if (changed ||
        reason ==
            AiDifficultyAdjustmentReason::
                InitialSelection ||
        reason ==
            AiDifficultyAdjustmentReason::
                ManualSelection ||
        reason ==
            AiDifficultyAdjustmentReason::
                PolicyChanged ||
        reason ==
            AiDifficultyAdjustmentReason::
                Reset)
    {
        currentStatus_.lastAdjustmentAtMs =
            nowMs;

        if (currentStatus_.
                adjustmentSequence <
            UINT32_MAX)
        {
            ++currentStatus_.
                adjustmentSequence;
        }
    }
}

uint16_t AiDifficultyManager::clampPermille(
    uint16_t value)
{
    return value > AI_PERMILLE_MAX
        ? AI_PERMILLE_MAX
        : value;
}

void AiDifficultyManager::setError(
    AiDifficultyError error)
{
    currentStatus_.error = error;

    notifyStateChanged();
}

void AiDifficultyManager::notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(
            currentStatus_,
            effectiveProfile());
    }
}
