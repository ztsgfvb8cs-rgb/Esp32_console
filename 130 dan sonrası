RuntimeResult WavDecoder::finalizeHeader()
{
    if (!formatChunkFound_)
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                MissingFormatChunk,
            RuntimeResult::CorruptData);
    }

    if (!dataChunkFound_)
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                MissingDataChunk,
            RuntimeResult::CorruptData);
    }

    WavDecoderError rejectionReason =
        WavDecoderError::None;

    if (!supportedSourceFormat(
            status_.sourceFormat,
            config_,
            &rejectionReason))
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            rejectionReason,
            RuntimeResult::Unsupported);
    }

    const uint16_t blockAlign =
        status_.sourceFormat.
            blockAlignBytes;

    if (blockAlign == 0U)
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                InvalidBlockAlignment,
            RuntimeResult::CorruptData);
    }

    const uint32_t trailingBytes =
        status_.dataSizeBytes %
        blockAlign;

    if (trailingBytes != 0U &&
        config_.rejectTrailingPartialFrame)
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                MisalignedDataChunk,
            RuntimeResult::CorruptData);
    }

    const uint64_t dataEnd =
        static_cast<uint64_t>(
            status_.dataOffsetBytes) +
        status_.dataSizeBytes;

    if (dataEnd > UINT32_MAX ||

        (status_.fileSizeBytes > 0U &&
         dataEnd >
            status_.fileSizeBytes) ||

        (status_.riffDeclaredSizeBytes > 0U &&
         dataEnd >
            status_.riffDeclaredSizeBytes))
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                TruncatedDataChunk,
            RuntimeResult::CorruptData);
    }

    status_.outputFormat.sampleRateHz =
        status_.sourceFormat.sampleRateHz;

    status_.outputFormat.bitsPerSample =
        I2S_AUDIO_SUPPORTED_BITS_PER_SAMPLE;

    status_.outputFormat.channelCount =
        static_cast<uint8_t>(
            status_.sourceFormat.
                channelCount);

    status_.totalFrames =
        status_.dataSizeBytes /
        blockAlign;

    if (SdStreamService::position(
            stream_) !=
        status_.dataOffsetBytes)
    {
        const RuntimeResult seekResult =
            SdStreamService::seek(
                stream_,
                status_.dataOffsetBytes,
                SdStreamSeekOrigin::Begin);

        if (seekResult != RuntimeResult::Ok)
        {
            status_.state =
                WavDecoderState::Failed;

            return setError(
                WavDecoderError::
                    SourceSeekFailed,
                seekResult);
        }
    }

    status_.dataBytesConsumed = 0U;
    status_.currentFrame = 0U;
    status_.headerReady = true;
    status_.sourceWouldBlock = false;
    status_.destinationBackpressure = false;

    status_.eof =
        status_.totalFrames == 0U;

    status_.state =
        status_.eof
            ? WavDecoderState::
                EndOfStream
            : WavDecoderState::Ready;

    status_.error =
        WavDecoderError::None;

    headerPhase_ =
        HeaderPhase::Complete;

    refreshDerivedStatus();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult WavDecoder::validateDestination(
    const PcmRingBuffer& destination) const
{
    if (!destination.ready())
    {
        return const_cast<WavDecoder*>(
            this)->setError(
                WavDecoderError::
                    DestinationNotReady,
                RuntimeResult::NotReady);
    }

    const I2sAudioFormat destinationFormat =
        destination.format();

    if (destinationFormat.sampleRateHz !=
            status_.outputFormat.sampleRateHz ||

        destinationFormat.bitsPerSample !=
            status_.outputFormat.bitsPerSample ||

        destinationFormat.channelCount !=
            status_.outputFormat.channelCount)
    {
        return const_cast<WavDecoder*>(
            this)->setError(
                WavDecoderError::
                    DestinationFormatMismatch,
                RuntimeResult::InvalidArgument);
    }

    return RuntimeResult::Ok;
}

RuntimeResult WavDecoder::decodeAvailableFrames(
    PcmRingBuffer& destination,
    uint32_t nowMs,
    size_t maximumFrames,
    size_t& decodedFrames)
{
    decodedFrames = 0U;

    const uint16_t blockAlign =
        status_.sourceFormat.
            blockAlignBytes;

    if (blockAlign == 0U)
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                InvalidBlockAlignment,
            RuntimeResult::CorruptData);
    }

    const uint32_t remainingBytes =
        remainingDataBytes();

    const size_t remainingFrames =
        remainingBytes /
        blockAlign;

    if (remainingFrames == 0U)
    {
        status_.eof = true;

        status_.state =
            WavDecoderState::EndOfStream;

        return setError(
            WavDecoderError::EndOfStream,
            RuntimeResult::NotReady);
    }

    const size_t destinationWritable =
        destination.writableFrames();

    if (destinationWritable == 0U)
    {
        status_.destinationBackpressure =
            true;

        status_.destinationWaitCount =
            saturatingIncrement32(
                status_.destinationWaitCount);

        return setError(
            WavDecoderError::
                DestinationFull,
            RuntimeResult::Busy);
    }

    const size_t requestedFrames =
        minimumSize(
            maximumFrames,

            minimumSize(
                remainingFrames,
                destinationWritable));

    PcmWritableSpans spans;

    const RuntimeResult reserveResult =
        destination.writableSpans(
            requestedFrames,
            spans,
            true);

    if (reserveResult != RuntimeResult::Ok ||
        spans.totalFrames() == 0U)
    {
        status_.destinationBackpressure =
            true;

        status_.destinationWaitCount =
            saturatingIncrement32(
                status_.destinationWaitCount);

        return setError(
            WavDecoderError::
                DestinationFull,

            reserveResult ==
                    RuntimeResult::Ok
                ? RuntimeResult::Busy
                : reserveResult);
    }

    RuntimeResult terminalResult =
        RuntimeResult::Ok;

    size_t producedFrames = 0U;

    PcmMutableSpan writableSpans[2] = {
        spans.first,
        spans.second
    };

    for (size_t spanIndex = 0U;
         spanIndex < 2U &&
         terminalResult == RuntimeResult::Ok;
         ++spanIndex)
    {
        PcmMutableSpan& span =
            writableSpans[spanIndex];

        for (size_t frameIndex = 0U;
             frameIndex < span.frameCount;
             ++frameIndex)
        {
            bool clippedAny = false;

            int16_t* const output =
                span.samples +

                frameIndex *
                status_.outputFormat.
                    channelCount;

            const RuntimeResult frameResult =
                consumeSourceFrame(
                    nowMs,
                    output,
                    clippedAny);

            if (frameResult !=
                RuntimeResult::Ok)
            {
                terminalResult =
                    frameResult;

                break;
            }

            ++producedFrames;
            ++status_.currentFrame;
            ++status_.totalDecodedFrames;

            status_.dataBytesConsumed +=
                blockAlign;
        }
    }

    RuntimeResult commitResult =
        RuntimeResult::Ok;

    if (producedFrames > 0U)
    {
        commitResult =
            destination.commitWrite(
                producedFrames);
    }
    else
    {
        commitResult =
            destination.cancelWrite();
    }

    if (commitResult != RuntimeResult::Ok)
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                DestinationWriteFailed,
            commitResult);
    }

    decodedFrames = producedFrames;

    status_.destinationBackpressure =
        false;

    if (status_.currentFrame >=
            status_.totalFrames ||

        status_.dataBytesConsumed >=
            status_.dataSizeBytes)
    {
        status_.eof = true;

        status_.state =
            WavDecoderState::EndOfStream;

        status_.error =
            WavDecoderError::None;

        return producedFrames > 0U
            ? RuntimeResult::Ok
            : RuntimeResult::NotReady;
    }

    if (terminalResult != RuntimeResult::Ok)
    {
        if (producedFrames > 0U &&

            (terminalResult ==
                 RuntimeResult::NotReady ||

             terminalResult ==
                 RuntimeResult::Busy))
        {
            return RuntimeResult::Ok;
        }

        return terminalResult;
    }

    status_.error =
        WavDecoderError::None;

    return RuntimeResult::Ok;
}

RuntimeResult WavDecoder::consumeSourceFrame(
    uint32_t nowMs,
    int16_t* outputSamples,
    bool& clippedAny)
{
    clippedAny = false;

    if (outputSamples == nullptr)
    {
        return setError(
            WavDecoderError::InternalError,
            RuntimeResult::InvalidArgument);
    }

    const uint16_t blockAlign =
        status_.sourceFormat.
            blockAlignBytes;

    if (blockAlign == 0U ||
        blockAlign >
            sizeof(sourceFrameScratch_))
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                InvalidBlockAlignment,
            RuntimeResult::CorruptData);
    }

    if (remainingDataBytes() <
        blockAlign)
    {
        if (remainingDataBytes() > 0U &&

            config_.
                rejectTrailingPartialFrame)
        {
            status_.state =
                WavDecoderState::Failed;

            return setError(
                WavDecoderError::
                    TruncatedDataChunk,
                RuntimeResult::CorruptData);
        }

        status_.eof = true;

        status_.state =
            WavDecoderState::EndOfStream;

        return setError(
            WavDecoderError::EndOfStream,
            RuntimeResult::NotReady);
    }

    const RuntimeResult readResult =
        readSourceExact(
            nowMs,
            sourceFrameScratch_,
            blockAlign);

    if (readResult != RuntimeResult::Ok)
    {
        return readResult;
    }

    const uint16_t bytesPerSample =
        status_.sourceFormat.
            bitsPerSample /
        8U;

    for (uint16_t channel = 0U;
         channel <
            status_.sourceFormat.channelCount;
         ++channel)
    {
        const uint8_t* const sampleBytes =
            sourceFrameScratch_ +
            channel * bytesPerSample;

        bool clipped = false;

        if (status_.sourceFormat.encoding ==
            WavSampleEncoding::PcmInteger)
        {
            outputSamples[channel] =
                decodeIntegerSample(
                    sampleBytes,

                    status_.sourceFormat.
                        bitsPerSample,

                    status_.sourceFormat.
                        validBitsPerSample,

                    config_.clampSamples,

                    clipped);
        }
        else if (
            status_.sourceFormat.encoding ==
            WavSampleEncoding::IeeeFloat)
        {
            outputSamples[channel] =
                decodeFloatSample(
                    sampleBytes,

                    config_.clampSamples,

                    clipped);
        }
        else
        {
            status_.state =
                WavDecoderState::Failed;

            return setError(
                WavDecoderError::
                    UnsupportedEncoding,
                RuntimeResult::Unsupported);
        }

        if (clipped)
        {
            clippedAny = true;

            status_.clippedSampleCount =
                saturatingAdd64(
                    status_.
                        clippedSampleCount,
                    1U);
        }
    }

    return RuntimeResult::Ok;
}

RuntimeResult WavDecoder::seekToDataByteOffset(
    uint32_t dataRelativeOffset)
{
    if (!status_.headerReady ||

        status_.sourceFormat.
            blockAlignBytes == 0U ||

        dataRelativeOffset >
            status_.dataSizeBytes ||

        (dataRelativeOffset %
         status_.sourceFormat.
             blockAlignBytes) != 0U)
    {
        return setError(
            WavDecoderError::InvalidSeek,
            RuntimeResult::InvalidArgument);
    }

    const uint64_t absoluteOffset =
        static_cast<uint64_t>(
            status_.dataOffsetBytes) +
        dataRelativeOffset;

    if (absoluteOffset > UINT32_MAX)
    {
        return setError(
            WavDecoderError::InvalidSeek,
            RuntimeResult::InvalidArgument);
    }

    status_.state =
        WavDecoderState::Seeking;

    notifyStateChanged();

    const RuntimeResult seekResult =
        SdStreamService::seek(
            stream_,
            static_cast<int64_t>(
                absoluteOffset),
            SdStreamSeekOrigin::Begin);

    if (seekResult != RuntimeResult::Ok)
    {
        status_.state =
            WavDecoderState::Failed;

        return setError(
            WavDecoderError::
                SourceSeekFailed,
            seekResult);
    }

    status_.dataBytesConsumed =
        dataRelativeOffset;

    status_.currentFrame =
        dataRelativeOffset /
        status_.sourceFormat.
            blockAlignBytes;

    status_.sourceWouldBlock = false;
    status_.destinationBackpressure = false;

    status_.eof =
        status_.currentFrame >=
        status_.totalFrames;

    status_.state =
        status_.eof
            ? WavDecoderState::EndOfStream
            : WavDecoderState::Ready;

    status_.error =
        WavDecoderError::None;

    return RuntimeResult::Ok;
}

void WavDecoder::refreshDerivedStatus()
{
    if (!status_.headerReady ||

        status_.sourceFormat.
            sampleRateHz == 0U)
    {
        status_.durationMilliseconds = 0U;
        status_.currentMilliseconds = 0U;

        return;
    }

    const uint64_t durationMs =
        (status_.totalFrames * 1000ULL) /
        status_.sourceFormat.sampleRateHz;

    const uint64_t currentMs =
        (status_.currentFrame * 1000ULL) /
        status_.sourceFormat.sampleRateHz;

    status_.durationMilliseconds =
        durationMs > UINT32_MAX
            ? UINT32_MAX
            : static_cast<uint32_t>(
                durationMs);

    status_.currentMilliseconds =
        currentMs > UINT32_MAX
            ? UINT32_MAX
            : static_cast<uint32_t>(
                currentMs);

    status_.eof =
        status_.currentFrame >=
        status_.totalFrames;
}

RuntimeResult WavDecoder::setError(
    WavDecoderError error,
    RuntimeResult result)
{
    status_.error = error;

    notifyStateChanged();

    return result;
}

void WavDecoder::notifyStateChanged() const
{
    if (observer_ != nullptr)
    {
        observer_(status_);
    }
}
