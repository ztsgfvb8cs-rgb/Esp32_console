size_t ResourceBudgetCoordinator::reclaimableBytes(
    ResourceMemoryKind kind)
{
    if (!ready())
    {
        return 0;
    }

    refreshStatus();

    switch (kind)
    {
        case ResourceMemoryKind::Internal:
            return currentStatus_.reclaimableInternalBytes;

        case ResourceMemoryKind::Psram:
            return currentStatus_.reclaimablePsramBytes;

        case ResourceMemoryKind::Both:
            return saturatingAddSize(
                currentStatus_.reclaimableInternalBytes,
                currentStatus_.reclaimablePsramBytes);

        default:
            return 0;
    }
}

