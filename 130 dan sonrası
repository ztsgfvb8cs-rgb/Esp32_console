uint32_t nextGeneration(uint32_t current)
{
    return current == UINT32_MAX
        ? 1U
        : current + 1U;
}

bool validPreference(MemoryPreference preference)
{
    switch (preference)
    {
        case MemoryPreference::InternalOnly:
        case MemoryPreference::PsramPreferred:
        case MemoryPreference::PsramOnly:
            return true;

        default:
            return false;
    }
}
}

MemoryArena::~MemoryArena()
{
    end();
}

MemoryArena::MemoryArena(
    MemoryArena&& other) noexcept
{
    moveFrom(other);
}

MemoryArena& MemoryArena::operator=(
    MemoryArena&& other) noexcept
{
    if (this != &other)
    {
        end();
        moveFrom(other);
    }

    return *this;
}

RuntimeResult MemoryArena::begin(
    const MemoryArenaConfig& config)
{
    if (status_.initialized || backing_)
    {
        return setError(
            MemoryArenaError::AlreadyInitialized,
            RuntimeResult::Busy);
    }

    const uint32_t generation =
        nextGeneration(status_.generation);

    status_ = {};
    status_.generation = generation;
    status_.preference = config.preference;
    status_.capacityBytes = config.capacityBytes;
    status_.defaultAlignment =
        config.defaultAlignment;

    if (config.capacityBytes <
        MEMORY_ARENA_MINIMUM_CAPACITY_BYTES)
    {
        return setError(
            MemoryArenaError::InvalidCapacity,
            RuntimeResult::InvalidArgument);
    }

    if (!validPreference(config.preference))
    {
        return setError(
            MemoryArenaError::
                BackingAllocationFailed,
            RuntimeResult::InvalidArgument);
    }

    if (!validAlignment(
            config.defaultAlignment))
    {
        return setError(
            MemoryArenaError::InvalidAlignment,
            RuntimeResult::InvalidArgument);
    }

    if (!MemoryManager::begin())
    {
        return setError(
            MemoryArenaError::
                BackingAllocationFailed,
            RuntimeResult::NotReady);
    }

    MemoryBlock block =
        MemoryManager::allocate(
            config.capacityBytes,
            config.preference,
            config.clearBackingStore);

    if (!block ||
        block.size < config.capacityBytes)
    {
        if (block)
        {
            MemoryManager::release(block);
        }

        return setError(
            MemoryArenaError::
                BackingAllocationFailed,
            RuntimeResult::OutOfMemory);
    }

    backing_ = block;
    config_ = config;
    offset_ = 0;

    status_.initialized = true;
    status_.psram = backing_.psram;
    status_.error = MemoryArenaError::None;
    status_.capacityBytes = backing_.size;
    status_.usedBytes = 0;
    status_.remainingBytes = backing_.size;
    status_.peakUsedBytes = 0;
    status_.largestAllocationBytes = 0;
    status_.allocationCount = 0;
    status_.failedAllocationCount = 0;
    status_.rewindCount = 0;
    status_.resetCount = 0;

    return RuntimeResult::Ok;
}

RuntimeResult MemoryArena::begin(
    size_t capacityBytes,
    MemoryPreference preference,
    bool clearBackingStore)
{
    MemoryArenaConfig config;

    config.capacityBytes = capacityBytes;
    config.preference = preference;
    config.clearBackingStore =
        clearBackingStore;

    return begin(config);
}

void MemoryArena::end()
{
    const uint32_t generation =
        nextGeneration(status_.generation);

    if (backing_)
    {
        MemoryManager::release(backing_);
    }

    backing_ = {};
    config_ = {};
    status_ = {};
    status_.generation = generation;
    offset_ = 0;
}

bool MemoryArena::ready() const
{
    return
        status_.initialized &&
        backing_.data != nullptr &&
        backing_.size >=
            status_.capacityBytes;
}

MemoryArenaStatus MemoryArena::status() const
{
    return status_;
}
