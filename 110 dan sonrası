RuntimeResult RuntimePowerCoordinator::synchronize(
    uint32_t nowMs,
    bool forceApply)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimePowerError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (currentStatus_.suspended &&
        !forceApply)
    {
        return RuntimeResult::Busy;
    }

    currentStatus_.lastUpdateAtMs = nowMs;

    refreshSourceState(nowMs);

    const bool keepAwake =
        resolveRuntimeKeepAwake();

    if (!keepAwakeStateKnown ||
        lastAppliedKeepAwake != keepAwake)
    {
        PowerManager::setKeepAwake(keepAwake);

        lastAppliedKeepAwake = keepAwake;
        keepAwakeStateKnown = true;

        currentStatus_.keepAwakeApplied =
            keepAwake;

        currentStatus_.lastAction =
            keepAwake
                ? RuntimePowerAction::
                    RuntimeStarted
                : RuntimePowerAction::
                    RuntimeStopped;

        refreshSourceState(nowMs);
    }
    else
    {
        currentStatus_.keepAwakeApplied =
            keepAwake;
    }

    if (policy_.followBatteryPolicy &&
        policy_.automaticCriticalShutdown &&
        currentStatus_.
            batteryPolicy.requestShutdown)
    {
        if (!PowerManager::shutdownPending())
        {
            const RuntimeResult shutdownResult =
                requestShutdown(
                    ShutdownReason::
                        CriticalBattery,
                    nowMs);

            if (shutdownResult !=
                RuntimeResult::Ok)
            {
                return shutdownResult;
            }
        }
        else if (
            PowerManager::status().reason ==
                ShutdownReason::CriticalBattery)
        {
            currentStatus_.
                shutdownRequestedByCoordinator =
                    true;
        }
    }
    else if (
        currentStatus_.
            shutdownRequestedByCoordinator &&
        PowerManager::state() ==
            PowerState::ShutdownPending &&
        PowerManager::status().reason ==
            ShutdownReason::CriticalBattery)
    {
        const RuntimeResult cancelResult =
            cancelShutdown(nowMs);

        if (cancelResult != RuntimeResult::Ok)
        {
            return cancelResult;
        }
    }

    refreshSourceState(nowMs);
    resolveEffectivePolicy();

    const RuntimeResult applyResult =
        applyEffectivePolicy(
            nowMs,
            forceApply);

    if (applyResult != RuntimeResult::Ok)
    {
        return applyResult;
    }

    currentStatus_.mode = resolveMode();

    currentStatus_.error =
        RuntimePowerError::None;

    notifyStateChanged();

    return RuntimeResult::Ok;
}
