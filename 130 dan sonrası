        }

        setError(
            PsramPoolError::PoolExhausted,
            RuntimeResult::OutOfMemory);

        return {};
    }

    const uint16_t slotIndex =
        static_cast<uint16_t>(freeSlot);

    void* const pointer =
        pointerForSlot(classIndex, slotIndex);

    if (pointer == nullptr)
    {
        if (status_.failedAllocationCount < UINT32_MAX)
        {
            ++status_.failedAllocationCount;
        }

        setError(
            PsramPoolError::BackingAllocationFailed,
            RuntimeResult::InternalError);

        return {};
    }

    if (shouldClearOnAcquire(classIndex, clearMode))
    {
        memset(
            pointer,
            0,
            classStrides_[classIndex]);
    }

    uint32_t leaseId = nextLeaseId_;

    if (leaseId == 0)
    {
        leaseId = 1U;
    }

    nextLeaseId_ = nextLease(leaseId);

    SlotMetadata& metadata = slots_[slotIndex];
    metadata.used = true;
    metadata.classIndex = classIndex;
    metadata.leaseId = leaseId;
    metadata.requestedBytes = requestedBytes;

    if (classUsedBlocks_[classIndex] < UINT16_MAX)
    {
        ++classUsedBlocks_[classIndex];
    }

    if (classUsedBlocks_[classIndex] >
        classPeakUsedBlocks_[classIndex])
    {
        classPeakUsedBlocks_[classIndex] =
            classUsedBlocks_[classIndex];
    }

    if (addWouldOverflow(
            classRequestedBytes_[classIndex],
            requestedBytes))
    {
        classRequestedBytes_[classIndex] = SIZE_MAX;
    }
    else
    {
        classRequestedBytes_[classIndex] +=
            requestedBytes;
    }

    if (status_.allocationCount < UINT32_MAX)
    {
        ++status_.allocationCount;
    }

    PsramPoolBlock block;
    block.data = pointer;
    block.requestedBytes = requestedBytes;
    block.capacityBytes =
        config_.classes[classIndex].blockSizeBytes;
    block.slotIndex = slotIndex;
    block.classIndex = classIndex;
    block.generation = status_.generation;
    block.leaseId = leaseId;

    status_.error = PsramPoolError::None;
    refreshStatus();
    notifyStateChanged();

    return block;
}

bool PsramPool::shouldClearOnAcquire(
    uint8_t classIndex,
    PsramPoolClearMode clearMode) const
{
    if (clearMode == PsramPoolClearMode::Clear)
    {
        return true;
    }

    if (clearMode == PsramPoolClearMode::Preserve)
    {
        return false;
    }

    return classIndex < config_.classCount &&
        config_.classes[classIndex].clearOnAcquire;
}

bool PsramPool::shouldClearOnRelease(
    PsramPoolClearMode clearMode) const
{
    if (clearMode == PsramPoolClearMode::Clear)
    {
        return true;
    }

    if (clearMode == PsramPoolClearMode::Preserve)
    {
        return false;
    }

    return config_.clearBlocksOnRelease;
}

void PsramPool::refreshStatus()
{
    if (!status_.initialized)
    {
        status_.allBackingsInPsram = false;
        status_.exhausted = false;
        status_.totalBlocks = 0;
        status_.usedBlocks = 0;
        status_.freeBlocks = 0;
        status_.reservedBytes = 0;
        status_.usedCapacityBytes = 0;
        status_.requestedBytes = 0;
        status_.wastedBytes = 0;
        return;
    }

    uint16_t totalBlocks = 0;
    uint16_t usedBlocks = 0;
    size_t reservedBytes = 0;
    size_t usedCapacityBytes = 0;
    size_t requestedBytes = 0;
    bool allInPsram = true;

    for (uint8_t classIndex = 0;
         classIndex < config_.classCount;
         ++classIndex)
    {
        const PsramPoolSizeClassConfig& classConfig =
            config_.classes[classIndex];

        totalBlocks = static_cast<uint16_t>(
            totalBlocks + classConfig.blockCount);

        usedBlocks = static_cast<uint16_t>(
            usedBlocks + classUsedBlocks_[classIndex]);

        reservedBytes += backings_[classIndex].size;

        usedCapacityBytes +=
            classConfig.blockSizeBytes *
            classUsedBlocks_[classIndex];

        requestedBytes +=
            classRequestedBytes_[classIndex];

        allInPsram =
            allInPsram && backings_[classIndex].psram;
    }

    status_.classCount = config_.classCount;
    status_.preference = config_.preference;
    status_.allBackingsInPsram = allInPsram;
    status_.totalBlocks = totalBlocks;
    status_.usedBlocks = usedBlocks;
    status_.freeBlocks = static_cast<uint16_t>(
        totalBlocks - usedBlocks);
    status_.exhausted =
        totalBlocks > 0 && usedBlocks == totalBlocks;
    status_.reservedBytes = reservedBytes;
    status_.usedCapacityBytes = usedCapacityBytes;
    status_.requestedBytes = requestedBytes;
    status_.wastedBytes =
        usedCapacityBytes >= requestedBytes
            ? usedCapacityBytes - requestedBytes
            : 0;

    if (usedBlocks > status_.peakUsedBlocks)
    {
        status_.peakUsedBlocks = usedBlocks;
    }

    if (usedCapacityBytes >
        status_.peakUsedCapacityBytes)
    {
        status_.peakUsedCapacityBytes =
            usedCapacityBytes;
    }
}

void PsramPool::resetMetadata(
    bool preserveGeneration)
{
    const uint32_t generation =
        preserveGeneration
            ? status_.generation
            : 0U;

    config_ = {};
    status_ = {};
    status_.generation = generation;

    for (uint8_t classIndex = 0;
         classIndex < PSRAM_POOL_MAX_SIZE_CLASSES;
         ++classIndex)
    {
        backings_[classIndex] = {};
        classStrides_[classIndex] = 0;
        classSlotStarts_[classIndex] = 0;
        classUsedBlocks_[classIndex] = 0;
        classPeakUsedBlocks_[classIndex] = 0;
        classRequestedBytes_[classIndex] = 0;
    }

    for (uint16_t slotIndex = 0;
         slotIndex < PSRAM_POOL_MAX_BLOCKS;
         ++slotIndex)
    {
        slots_[slotIndex] = {};
    }

    nextLeaseId_ = 1U;
}

RuntimeResult PsramPool::setError(
    PsramPoolError error,
    RuntimeResult result)
{
    status_.error = error;
    notifyStateChanged();

    return result;
}

void PsramPool::notifyStateChanged() const
{
    if (observer_ != nullptr)
    {
        observer_(status_);
    }
}
