std::atomic_flag reservationLock = ATOMIC_FLAG_INIT;

class ReservationLockGuard final
{
public:
    ReservationLockGuard()
    {
        while (reservationLock.test_and_set(
            std::memory_order_acquire))
        {
        }
    }

    ~ReservationLockGuard()
    {
        reservationLock.clear(
            std::memory_order_release);
    }

    ReservationLockGuard(
        const ReservationLockGuard&) = delete;

    ReservationLockGuard& operator=(
        const ReservationLockGuard&) = delete;
};

uint32_t nextGeneration(uint32_t current)
{
    return current == UINT32_MAX
        ? 1U
        : current + 1U;
}

size_t minimumSize(
    size_t first,
    size_t second)
{
    return first < second
        ? first
        : second;
}

uint32_t saturatingIncrement32(
    std::atomic<uint32_t>& value)
{
    uint32_t current =
        value.load(std::memory_order_relaxed);

    while (current != UINT32_MAX)
    {
        if (value.compare_exchange_weak(
                current,
                current + 1U,
                std::memory_order_relaxed,
                std::memory_order_relaxed))
        {
            return current + 1U;
        }
    }

    return UINT32_MAX;
}

uint64_t saturatingAdd64(
    std::atomic<uint64_t>& value,
    uint64_t amount)
{
    uint64_t current =
        value.load(std::memory_order_relaxed);

    while (true)
    {
        const uint64_t next =
            amount > UINT64_MAX - current
                ? UINT64_MAX
                : current + amount;

        if (value.compare_exchange_weak(
                current,
                next,
                std::memory_order_relaxed,
                std::memory_order_relaxed))
        {
            return next;
        }
    }
}

bool validPreference(
    MemoryPreference preference)
{
    switch (preference)
    {
        case MemoryPreference::InternalOnly:
        case MemoryPreference::PsramPreferred:
        case MemoryPreference::PsramOnly:
            return true;

        default:
            return false;
    }
}
