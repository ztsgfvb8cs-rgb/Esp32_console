    {
        return setError(
            I2sAudioBackendError::InvalidFormat,
            RuntimeResult::InvalidArgument);
    }

#if defined(EGS_I2S_USE_CHANNEL_DRIVER)
    if (transmitChannel == nullptr)
    {
        return setError(
            I2sAudioBackendError::NotInitialized,
            RuntimeResult::NotReady);
