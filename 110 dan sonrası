bool AiDifficultyManager::validLevel(
    AiDifficultyLevel level,
    bool allowAdaptive)
{
    if (level ==
        AiDifficultyLevel::Adaptive)
    {
        return allowAdaptive;
    }

    return fixedLevelIndex(level) <
        FIXED_DIFFICULTY_COUNT;
}

bool AiDifficultyManager::validatePolicy(
    const AiAdaptivePolicy& policy)
{
    if (!validLevel(
            policy.minimumLevel,
            false) ||
        !validLevel(
            policy.maximumLevel,
            false) ||
        !validLevel(
            policy.initialLevel,
            false))
    {
        return false;
    }

    const uint8_t minimum =
        fixedLevelIndex(
            policy.minimumLevel);

    const uint8_t maximum =
        fixedLevelIndex(
            policy.maximumLevel);

    const uint8_t initial =
        fixedLevelIndex(
            policy.initialLevel);

    return
        minimum <= maximum &&
        initial >= minimum &&
        initial <= maximum &&
        policy.evaluationWindowMs > 0 &&
        policy.minimumSamples > 0 &&
        policy.stepDownThresholdPermille <=
            AI_PERMILLE_MAX &&
        policy.stepUpThresholdPermille <=
            AI_PERMILLE_MAX &&
        policy.stepDownThresholdPermille <
            policy.stepUpThresholdPermille &&
        policy.stabilityMarginPermille <=
            AI_PERMILLE_MAX &&
        policy.maximumLevelStep > 0;
}

AiDifficultyLevel
AiDifficultyManager::clampedAdaptiveLevel(
    AiDifficultyLevel level)
{
    uint8_t index =
        validLevel(level, false)
            ? fixedLevelIndex(level)
            : fixedLevelIndex(
                adaptivePolicy_.
                    initialLevel);

    const uint8_t minimum =
        fixedLevelIndex(
            adaptivePolicy_.minimumLevel);

    const uint8_t maximum =
        fixedLevelIndex(
            adaptivePolicy_.maximumLevel);

    if (index < minimum)
    {
        index = minimum;
    }
    else if (index > maximum)
    {
        index = maximum;
    }

    return fixedLevelFromIndex(index);
}
