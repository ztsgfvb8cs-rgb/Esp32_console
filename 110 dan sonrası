bool RuntimeModuleManager::stopActiveBackend()
{
    switch (currentStatus_.kind)
    {
        case RuntimeModuleKind::BuiltinGame:
        case RuntimeModuleKind::Emulator:
            GameSession::stop();
            return !GameSession::active();

        case RuntimeModuleKind::PdfReader:
            PdfReader::close();
            return !PdfReader::isOpen();

        case RuntimeModuleKind::MediaViewer:
        case RuntimeModuleKind::SystemTool:
            return false;

        case RuntimeModuleKind::None:
        default:
            return true;
    }
}

RuntimeAudioPolicy
RuntimeModuleManager::resolveAudioPolicy(
    RuntimeModuleKind kind,
    EngineKind engine)
{
    RuntimeAudioPolicy policy;

    if (audioPolicyOverrideActive_)
    {
        policy = audioPolicyOverride_;

        if (policy.backgroundMusic ==
            BackgroundMusicPolicy::FollowPreference)
        {
            policy.backgroundMusic =
                preferenceAllowsMusic(kind, engine)
                    ? BackgroundMusicPolicy::Continue
                    : BackgroundMusicPolicy::Pause;
        }

        if (policy.duckedMusicPercent > 100)
        {
            policy.duckedMusicPercent = 100;
        }

        return policy;
    }

    const bool allowMusic =
        preferenceAllowsMusic(kind, engine);

    policy.backgroundMusic =
        allowMusic
            ? BackgroundMusicPolicy::Continue
            : BackgroundMusicPolicy::Pause;

    policy.foregroundAudioEnabled =
        kind == RuntimeModuleKind::BuiltinGame ||
        kind == RuntimeModuleKind::Emulator ||
        kind == RuntimeModuleKind::MediaViewer;

    policy.uiEffectsEnabled = true;

    policy.duckBackgroundMusic =
        allowMusic &&
        musicPreferences_.automaticDucking &&
        (kind == RuntimeModuleKind::BuiltinGame ||
         kind == RuntimeModuleKind::Emulator);

    policy.duckedMusicPercent =
        DEFAULT_DUCKED_MUSIC_PERCENT;

    return policy;
}

bool RuntimeModuleManager::preferenceAllowsMusic(
    RuntimeModuleKind kind,
    EngineKind engine)
{
    switch (kind)
    {
        case RuntimeModuleKind::BuiltinGame:
            return musicPreferences_.builtinGameMusic;

        case RuntimeModuleKind::Emulator:
            return engine ==
                    EngineKind::SnesExperimental
                ? musicPreferences_.snesMusic
                : musicPreferences_.emulatorMusic;

        case RuntimeModuleKind::PdfReader:
            return musicPreferences_.pdfReaderMusic;

        case RuntimeModuleKind::MediaViewer:
        case RuntimeModuleKind::SystemTool:
        case RuntimeModuleKind::None:
        default:
            return musicPreferences_.menuMusic;
    }
}

void RuntimeModuleManager::applyAudioPolicy()
{
    if (!currentStatus_.foregroundActive)
    {
        return;
    }

    if (currentStatus_.audio.duckedMusicPercent > 100)
    {
        currentStatus_.audio.duckedMusicPercent = 100;
    }

    currentStatus_.backgroundMusicAllowed =
        currentStatus_.audio.backgroundMusic ==
            BackgroundMusicPolicy::Continue;

    switch (currentStatus_.audio.backgroundMusic)
    {
        case BackgroundMusicPolicy::Pause:
        case BackgroundMusicPolicy::FollowPreference:
            if (AudioPlayer::state() ==
                AudioPlayerState::Playing)
            {
                AudioPlayer::pause();
                musicPausedByRuntimeManager = true;
            }
            break;

        case BackgroundMusicPolicy::Stop:
            AudioManager::stopMusic();
            musicPausedByRuntimeManager = false;
            break;

        case BackgroundMusicPolicy::Continue:
            if (musicPausedByRuntimeManager &&
                AudioPlayer::state() ==
                    AudioPlayerState::Paused)
            {
                AudioPlayer::resume();
            }

            musicPausedByRuntimeManager = false;
            break;

        default:
            break;
    }
}

void RuntimeModuleManager::clearActiveModule()
{
    currentStatus_.foregroundActive = false;
    currentStatus_.stopRequested = false;
    currentStatus_.memoryBudgetAccepted = false;
    currentStatus_.backgroundMusicAllowed = true;

    currentStatus_.kind =
        RuntimeModuleKind::None;

    currentStatus_.engine =
        EngineKind::None;

    currentStatus_.memory = {};
    currentStatus_.audio = {};
    currentStatus_.startedAtMs = 0;

    activeContent_ = {};
}

void RuntimeModuleManager::transitionTo(
    RuntimeModuleState newState)
{
    const RuntimeModuleState previousState =
        currentStatus_.state;

    if (previousState == newState)
    {
        return;
    }

    currentStatus_.state = newState;
    ++currentStatus_.transitionSequence;

    const uint32_t nowMs = millis();

    if (newState == RuntimeModuleState::Running)
    {
        currentStatus_.startedAtMs = nowMs;
        currentStatus_.stoppedAtMs = 0;
    }
    else if (
        newState == RuntimeModuleState::Stopped ||
        newState == RuntimeModuleState::Failed)
    {
        currentStatus_.stoppedAtMs = nowMs;
    }

    if (stateCallback_ != nullptr)
    {
        stateCallback_(
            previousState,
            newState,
            currentStatus_);
    }
}

RuntimeResult RuntimeModuleManager::fail(
    RuntimeModuleError error,
    RuntimeResult result)
{
    currentStatus_.error = error;

    if (Logger::ready())
    {
        Logger::error(
            LogSource::Application,
            "RUNTIME",
            errorText(error));
    }

    // A rejected second launch must not freeze or invalidate
    // the module that already owns the foreground.
    if (!currentStatus_.foregroundActive &&
        currentStatus_.state !=
            RuntimeModuleState::Starting &&
        currentStatus_.state !=
            RuntimeModuleState::Stopping)
    {
        transitionTo(RuntimeModuleState::Failed);
    }

    return result;
}
