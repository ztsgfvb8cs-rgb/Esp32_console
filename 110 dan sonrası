void RuntimeScreenRouter::synchronizeStatus()
{
    const AppScreen previousScreen =
        currentStatus_.screen;

    const RuntimeScreenMode previousMode =
        currentStatus_.mode;

    currentStatus_.screen =
        ScreenManager::current();

    if (RuntimeModuleManager::ready())
    {
        const RuntimeModuleStatus moduleStatus =
            RuntimeModuleManager::status();

        currentStatus_.moduleKind =
            moduleStatus.kind;

        currentStatus_.moduleState =
            moduleStatus.state;

        currentStatus_.foregroundOwned =
            moduleStatus.foregroundActive;
    }
    else
    {
        currentStatus_.moduleKind =
            RuntimeModuleKind::None;

        currentStatus_.moduleState =
            RuntimeModuleState::Stopped;

        currentStatus_.foregroundOwned = false;
    }

    if (RuntimeSessionBridge::ready() &&
        RuntimeSessionBridge::sessionActive())
    {
        currentStatus_.foregroundOwned = true;
    }

    currentStatus_.mode = resolveMode();

    if (currentStatus_.initialized &&
        (currentStatus_.screen != previousScreen ||
         currentStatus_.mode != previousMode))
    {
        currentStatus_.dirty = true;

        if (currentStatus_.refreshReason !=
            RuntimeScreenRefreshReason::Startup)
        {
            currentStatus_.refreshReason =
                RuntimeScreenRefreshReason::Navigation;
        }
    }
}

void RuntimeScreenRouter::recordSuccess(
    uint32_t nowMs,
    uint32_t renderDurationUs)
{
    currentStatus_.dirty = false;
    currentStatus_.forceRequested = false;
    currentStatus_.error =
        RuntimeScreenError::None;

    currentStatus_.lastRenderAtMs = nowMs;

    currentStatus_.lastRenderDurationUs =
        renderDurationUs;

    currentStatus_.consecutiveFailures = 0;

    ++currentStatus_.renderSequence;

    notifyStateChanged();
}

RuntimeResult RuntimeScreenRouter::recordFailure(
    RuntimeScreenError error,
    RuntimeResult result)
{
    currentStatus_.rendering = false;
    currentStatus_.error = error;

    ++currentStatus_.failedRenderCount;

    if (currentStatus_.consecutiveFailures <
        UINT8_MAX)
    {
        ++currentStatus_.consecutiveFailures;
    }

    if (Logger::ready())
    {
        const bool persistent =
            currentStatus_.consecutiveFailures >=
                policy_.maximumConsecutiveFailures;

        if (persistent)
        {
            Logger::error(
                LogSource::Display,
                "SCREEN_RT",
                errorText(error));
        }
        else
        {
            Logger::warning(
                LogSource::Display,
                "SCREEN_RT",
                errorText(error));
        }
    }

    notifyStateChanged();

    return result;
}

void RuntimeScreenRouter::notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(currentStatus_);
    }
}
