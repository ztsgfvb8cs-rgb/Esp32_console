bool StatisticsManager::begin()
{
    if (initialized)
        return true;

    clearMemory();

    if (!StorageManager::ready())
        return false;

    if (!load())
    {
        clearMemory();
        return false;
    }

    initialized = true;

    if (dirty)
        lastChangeTime = millis();

    return true;
}

void StatisticsManager::update()
{
    if (!initialized || !dirty)
        return;

    if (millis() - lastChangeTime <
        AUTO_SAVE_DELAY)
    {
        return;
    }

    if (!save())
        lastChangeTime = millis();
}

