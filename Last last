bool deleteProfileByIndex(
    uint8_t index
)
{
    if(!isValidSelectorIndex(
        index
    ))
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_INVALID_INDEX;


        return false;
    }


    return deleteProfileByID(
        selectorEntries[index].profileID
    );
}



bool deleteProfileByID(
    uint16_t profileID
)
{
    int8_t index =
        findProfileSelectorIndexByID(
            profileID
        );


    if(index < 0)
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_INVALID_PROFILE;


        return false;
    }


    if(!deleteStoredProfile(
        profileID
    ))
    {
        profileSelectorStatus =
            PROFILE_SELECTOR_DELETE_ERROR;


        return false;
    }


    if(!refreshProfileSelector())
    {
        return false;
    }


    if(selectorEntryCount > 0)
    {
        uint8_t nextIndex =
            (uint8_t)index;


        if(nextIndex >=
           selectorEntryCount)
        {
            nextIndex =
                selectorEntryCount - 1;
        }


        selectProfileByIndex(
            nextIndex
        );
    }
    else
    {
        clearProfileSelection();
    }


    profileSelectorStatus =
        selectorEntryCount > 0 ?
        PROFILE_SELECTOR_READY :
        PROFILE_SELECTOR_NO_PROFILES;


    return true;
}



