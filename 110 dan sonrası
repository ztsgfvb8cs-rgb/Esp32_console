void RuntimeAudioCoordinator::refreshTargetLevels()
{
    const bool outputMuted =
        !settings_.soundEnabled ||
        currentStatus_.route == AudioRoute::Muted;

    currentStatus_.soundEnabled = settings_.soundEnabled;

    RuntimeAudioBusState& music =
        currentStatus_.backgroundMusic;
    RuntimeAudioBusState& foreground =
        currentStatus_.foreground;
    RuntimeAudioBusState& effects =
        currentStatus_.uiEffects;

    music.enabled =
        settings_.soundEnabled &&
        currentStatus_.backgroundMusicAllowed;
    foreground.enabled =
        settings_.soundEnabled &&
        currentStatus_.foregroundActive &&
        currentStatus_.foregroundAudioEnabled;
    effects.enabled =
        settings_.soundEnabled &&
        currentStatus_.uiEffectsEnabled;

    music.muted = outputMuted || !music.enabled;
    foreground.muted = outputMuted || !foreground.enabled;
    effects.muted = outputMuted || !effects.enabled;

    uint8_t musicTarget = music.requestedPercent;

    const bool shouldDuck =
        currentStatus_.foregroundActive &&
        currentStatus_.backgroundMusicAllowed &&
        policy_.applyAutomaticDucking &&
        currentStatus_.runtimePolicy.
            duckBackgroundMusic;

    if (shouldDuck)
    {
        musicTarget = multipliedPercent(
            music.requestedPercent,
            currentStatus_.runtimePolicy.
                duckedMusicPercent);
    }

    if (music.muted)
    {
        musicTarget = 0;
    }

    music.targetPercent = musicTarget;
    foreground.targetPercent = foreground.muted
        ? 0
        : foreground.requestedPercent;
    effects.targetPercent = effects.muted
        ? 0
        : effects.requestedPercent;

    currentStatus_.backgroundMusicDucked =
        shouldDuck &&
        music.targetPercent < music.requestedPercent;
}

void RuntimeAudioCoordinator::advanceGainTransitions(
    uint32_t nowMs)
{
    const uint32_t elapsedMs =
        nowMs - lastGainUpdateAtMs_;

    bool changed = false;

    RuntimeAudioBusState* buses[] =
    {
        &currentStatus_.backgroundMusic,
        &currentStatus_.foreground,
        &currentStatus_.uiEffects
    };

    for (RuntimeAudioBusState* bus : buses)
    {
        const uint16_t transitionMs =
            bus->targetPercent < bus->effectivePercent
                ? policy_.duckAttackMs
                : policy_.duckReleaseMs;

        const uint8_t next = approachPercent(
            bus->effectivePercent,
            bus->targetPercent,
            elapsedMs,
            transitionMs);

        if (next != bus->effectivePercent)
        {
            bus->effectivePercent = next;
            changed = true;
        }
    }

    lastGainUpdateAtMs_ = nowMs;

    if (changed)
    {
        ++currentStatus_.gainSequence;
    }
}

void RuntimeAudioCoordinator::refreshFinalGains()
{
    uint8_t masterPercent =
        clampedPercent(settings_.masterVolume);

    const uint8_t managerMaster =
        AudioManager::effectiveMasterVolume();

    if (managerMaster < masterPercent)
    {
        masterPercent = managerMaster;
    }

    if (currentStatus_.criticalPowerLimited &&
        policy_.criticalMasterLimitPercent < masterPercent)
    {
        masterPercent =
            policy_.criticalMasterLimitPercent;
    }

    if (!settings_.soundEnabled ||
        currentStatus_.route == AudioRoute::Muted)
    {
        masterPercent = 0;
    }

    const uint16_t oldMusicGain =
        currentStatus_.backgroundMusic.gainPermille;
    const uint16_t oldForegroundGain =
        currentStatus_.foreground.gainPermille;
    const uint16_t oldEffectsGain =
        currentStatus_.uiEffects.gainPermille;

    currentStatus_.backgroundMusic.gainPermille =
        combineGainPermille(
            masterPercent,
            currentStatus_.backgroundMusic.
                effectivePercent,
            RUNTIME_AUDIO_MAX_PERCENT);

    currentStatus_.foreground.gainPermille =
        combineGainPermille(
            masterPercent,
            currentStatus_.foreground.
                effectivePercent,
            RUNTIME_AUDIO_MAX_PERCENT);

    currentStatus_.uiEffects.gainPermille =
        combineGainPermille(
            masterPercent,
            currentStatus_.uiEffects.
                effectivePercent,
            RUNTIME_AUDIO_MAX_PERCENT);

    if (oldMusicGain !=
            currentStatus_.backgroundMusic.gainPermille ||
        oldForegroundGain !=
            currentStatus_.foreground.gainPermille ||
        oldEffectsGain !=
            currentStatus_.uiEffects.gainPermille)
    {
        ++currentStatus_.gainSequence;
    }
}

void RuntimeAudioCoordinator::applyBackgroundPlaybackPolicy()
{
    const bool outputPermitsPlayback =
        settings_.soundEnabled &&
        currentStatus_.route != AudioRoute::Muted;

    if (currentStatus_.runtimePolicy.backgroundMusic ==
            BackgroundMusicPolicy::Stop &&
        policy_.stopMusicWhenPolicyRequests)
    {
        AudioManager::stopMusic();
        currentStatus_.musicPausedByCoordinator = false;
        return;
    }

    if ((!currentStatus_.backgroundMusicAllowed ||
         !outputPermitsPlayback) &&
        policy_.pauseMusicWhenDisallowed)
    {
        if (AudioPlayer::state() ==
            AudioPlayerState::Playing)
        {
            AudioPlayer::pause();
            currentStatus_.musicPausedByCoordinator = true;
        }

        return;
    }

    if (currentStatus_.backgroundMusicAllowed &&
        outputPermitsPlayback &&
        currentStatus_.musicPausedByCoordinator &&
        policy_.restoreMusicAfterForeground &&
        AudioPlayer::state() == AudioPlayerState::Paused)
    {
        AudioPlayer::resume();
        currentStatus_.musicPausedByCoordinator = false;
    }
}

uint8_t RuntimeAudioCoordinator::clampedPercent(
    uint8_t value)
{
    return value > RUNTIME_AUDIO_MAX_PERCENT
        ? RUNTIME_AUDIO_MAX_PERCENT
        : value;
}

uint8_t RuntimeAudioCoordinator::approachPercent(
    uint8_t current,
    uint8_t target,
    uint32_t elapsedMs,
    uint16_t transitionMs)
{
    if (current == target ||
        transitionMs == 0 ||
        elapsedMs >= transitionMs)
    {
        return target;
    }

    const uint8_t difference =
        current > target
            ? static_cast<uint8_t>(current - target)
            : static_cast<uint8_t>(target - current);

    uint32_t step =
        (static_cast<uint32_t>(difference) * elapsedMs +
         transitionMs - 1U) /
        transitionMs;

    if (step == 0)
    {
        step = 1;
    }

    if (step >= difference)
    {
        return target;
    }

    return current > target
        ? static_cast<uint8_t>(current - step)
        : static_cast<uint8_t>(current + step);
}

uint16_t RuntimeAudioCoordinator::combineGainPermille(
    uint8_t masterPercent,
    uint8_t busPercent,
    uint8_t runtimePercent)
{
    const uint64_t product =
        static_cast<uint64_t>(
            clampedPercent(masterPercent)) *
        static_cast<uint64_t>(
            clampedPercent(busPercent)) *
        static_cast<uint64_t>(
            clampedPercent(runtimePercent)) *
        RUNTIME_AUDIO_UNITY_PERMILLE;

    const uint64_t rounded =
        (product + 500000ULL) / 1000000ULL;

    return rounded > RUNTIME_AUDIO_UNITY_PERMILLE
        ? RUNTIME_AUDIO_UNITY_PERMILLE
        : static_cast<uint16_t>(rounded);
}

int16_t RuntimeAudioCoordinator::scaleSample(
    int16_t sample,
    uint16_t gainValuePermille)
{
    if (gainValuePermille == 0)
    {
        return 0;
    }

    if (gainValuePermille >= RUNTIME_AUDIO_UNITY_PERMILLE)
    {
        return sample;
    }

    int32_t scaled =
        static_cast<int32_t>(sample) *
        static_cast<int32_t>(gainValuePermille);

    scaled += scaled >= 0 ? 500 : -500;
    scaled /= static_cast<int32_t>(
        RUNTIME_AUDIO_UNITY_PERMILLE);

    if (scaled > INT16_MAX)
    {
        scaled = INT16_MAX;
    }
    else if (scaled < INT16_MIN)
    {
        scaled = INT16_MIN;
    }

    return static_cast<int16_t>(scaled);
}

RuntimeResult RuntimeAudioCoordinator::fail(
    RuntimeAudioError error,
    RuntimeResult result)
{
    currentStatus_.error = error;

    if (Logger::ready())
    {
        Logger::error(
            LogSource::Audio,
            "AUDIO_RT",
            errorText(error));
    }

    notifyStateChanged();
    return result;
}

void RuntimeAudioCoordinator::notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(currentStatus_);
    }
}
