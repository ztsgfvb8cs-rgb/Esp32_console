RuntimeMemoryBudget RuntimeModuleManager::defaultMemoryBudget(
    RuntimeModuleKind kind,
    EngineKind engine)
{
    RuntimeMemoryBudget budget;

    budget.reservedInternalBytes =
        DEFAULT_INTERNAL_RESERVE_BYTES;

    budget.reservedPsramBytes =
        DEFAULT_PSRAM_RESERVE_BYTES;

    switch (kind)
    {
        case RuntimeModuleKind::BuiltinGame:
            budget.requiredInternalBytes =
                kibibytes(48);

            budget.requiredPsramBytes =
                kibibytes(256);

            budget.requiredDmaBytes =
                kibibytes(8);
            break;

        case RuntimeModuleKind::PdfReader:
            budget.requiredInternalBytes =
                kibibytes(32);

            budget.requiredPsramBytes =
                (static_cast<size_t>(
                    BoardConfig::SCREEN_WIDTH) *
                 BoardConfig::SCREEN_HEIGHT *
                 sizeof(uint16_t)) +
                kibibytes(128);

            budget.requiredDmaBytes = 0;
            break;

        case RuntimeModuleKind::MediaViewer:
            budget.requiredInternalBytes =
                kibibytes(48);

            budget.requiredPsramBytes =
                kibibytes(512);

            budget.requiredDmaBytes =
                kibibytes(8);
            break;

        case RuntimeModuleKind::SystemTool:
            budget.requiredInternalBytes =
                kibibytes(32);

            budget.requiredPsramBytes =
                kibibytes(64);

            budget.requiredDmaBytes = 0;
            break;

        case RuntimeModuleKind::Emulator:
            switch (engine)
            {
                case EngineKind::Chip8:
                    budget.requiredInternalBytes =
                        kibibytes(32);

                    budget.requiredPsramBytes =
                        kibibytes(64);

                    budget.requiredDmaBytes =
                        kibibytes(8);
                    break;

                case EngineKind::Arduboy:
                    budget.requiredInternalBytes =
                        kibibytes(48);

                    budget.requiredPsramBytes =
                        kibibytes(128);

                    budget.requiredDmaBytes =
                        kibibytes(8);
                    break;

                case EngineKind::GameBoy:
                case EngineKind::GameBoyColor:
                    budget.requiredInternalBytes =
                        kibibytes(96);

                    budget.requiredPsramBytes =
                        kibibytes(512);

                    budget.requiredDmaBytes =
                        kibibytes(16);
                    break;

                case EngineKind::Nes:
                    budget.requiredInternalBytes =
                        kibibytes(128);

                    budget.requiredPsramBytes =
                        kibibytes(768);

                    budget.requiredDmaBytes =
                        kibibytes(24);
                    break;

                case EngineKind::Sms:
                case EngineKind::GameGear:
                case EngineKind::Sg1000:
                case EngineKind::ColecoVision:
                    budget.requiredInternalBytes =
                        kibibytes(128);

                    budget.requiredPsramBytes =
                        kibibytes(640);

                    budget.requiredDmaBytes =
                        kibibytes(24);
                    break;

                case EngineKind::GameAndWatch:
                    budget.requiredInternalBytes =
                        kibibytes(96);

                    budget.requiredPsramBytes =
                        kibibytes(512);

                    budget.requiredDmaBytes =
                        kibibytes(16);
                    break;

                case EngineKind::Atari2600:
                case EngineKind::Atari7800Experimental:
                    budget.requiredInternalBytes =
                        kibibytes(96);

                    budget.requiredPsramBytes =
                        kibibytes(512);

                    budget.requiredDmaBytes =
                        kibibytes(16);
                    break;

                case EngineKind::AtariLynx:
                case EngineKind::Msx1:
                    budget.requiredInternalBytes =
                        kibibytes(160);

                    budget.requiredPsramBytes =
                        kibibytes(1024);

                    budget.requiredDmaBytes =
                        kibibytes(24);
                    break;

                case EngineKind::SnesExperimental:
                    budget.requiredInternalBytes =
                        kibibytes(224);

                    budget.requiredPsramBytes =
                        kibibytes(2048);

                    budget.requiredDmaBytes =
                        kibibytes(32);
                    break;

                case EngineKind::None:
                case EngineKind::Builtin:
                default:
                    budget.requiredInternalBytes =
                        kibibytes(96);

                    budget.requiredPsramBytes =
                        kibibytes(512);

                    budget.requiredDmaBytes =
                        kibibytes(16);
                    break;
            }
            break;

        case RuntimeModuleKind::None:
        default:
            break;
    }

    return budget;
}

bool RuntimeModuleManager::memoryAvailable(
    const RuntimeMemoryBudget& budget,
    RuntimeModuleError* error)
{
    if (error != nullptr)
    {
        *error = RuntimeModuleError::None;
    }

#if defined(ARDUINO_ARCH_ESP32)
    const size_t internalFree =
        heap_caps_get_free_size(
            MALLOC_CAP_INTERNAL |
            MALLOC_CAP_8BIT);

    const size_t dmaFree =
        heap_caps_get_free_size(
            MALLOC_CAP_DMA |
            MALLOC_CAP_8BIT);

    const size_t psramFree =
        heap_caps_get_free_size(
            MALLOC_CAP_SPIRAM |
            MALLOC_CAP_8BIT);

    const size_t internalReserve =
        budget.reservedInternalBytes == 0
            ? DEFAULT_INTERNAL_RESERVE_BYTES
            : budget.reservedInternalBytes;

    const size_t psramReserve =
        budget.reservedPsramBytes == 0
            ? DEFAULT_PSRAM_RESERVE_BYTES
            : budget.reservedPsramBytes;

    if (budget.requiredInternalBytes >
        SIZE_MAX - budget.requiredDmaBytes)
    {
        if (error != nullptr)
        {
            *error =
                RuntimeModuleError::
                    InsufficientInternalRam;
        }

        return false;
    }

    const size_t combinedInternalRequirement =
        budget.requiredInternalBytes +
        budget.requiredDmaBytes;

    if (!safeFits(
            internalFree,
            combinedInternalRequirement,
            internalReserve))
    {
        if (error != nullptr)
        {
            *error =
                RuntimeModuleError::
                    InsufficientInternalRam;
        }

        return false;
    }

    if (budget.requiredDmaBytes > dmaFree)
    {
        if (error != nullptr)
        {
            *error =
                RuntimeModuleError::
                    InsufficientDmaMemory;
        }

        return false;
    }

    if (budget.requiredPsramBytes > 0)
    {
        if (!MemoryManager::psramAvailable() ||
            !safeFits(
                psramFree,
                budget.requiredPsramBytes,
                psramReserve))
        {
            if (error != nullptr)
            {
                *error =
                    RuntimeModuleError::
                        InsufficientPsram;
            }

            return false;
        }
    }
#else
    // Host-side validation has no ESP32 heap-capability
    // allocator. Exact admission is deferred to target.
    (void)budget;
#endif

    return true;
}

