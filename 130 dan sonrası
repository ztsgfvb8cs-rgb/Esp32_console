    RuntimeResult SdStreamService::seek(
        const SdStreamHandle& handle,
        int64_t offsetBytes,
        SdStreamSeekOrigin origin) {
        SdStreamError lookupError =
            SdStreamError::None;

        StreamSlot* const slot =
            slotFor(handle, &lookupError);

        if (slot == nullptr) {
            return setError(
                lookupError,
                RuntimeResult::InvalidArgument);
        }

        if (!validSeekOrigin(origin)) {
            slot->status.error =
                SdStreamError::InvalidSeek;

            return setError(
                SdStreamError::InvalidSeek,
                RuntimeResult::InvalidArgument);
        }

        if (slot->buffer.status().
                readReservationActive) {
            slot->status.error =
                SdStreamError::Busy;

            return setError(
                SdStreamError::Busy,
                RuntimeResult::Busy);
        }

        uint32_t targetOffset = 0;

        const RuntimeResult resolveResult =
            resolveSeekTarget(
                *slot,
                offsetBytes,
                origin,
                targetOffset);

        if (resolveResult !=
            RuntimeResult::Ok) {
            slot->status.error =
                SdStreamError::InvalidSeek;

            return setError(
                SdStreamError::InvalidSeek,
                resolveResult);
        }

        slot->status.state =
            SdStreamState::Seeking;

        notifyStreamChanged(*slot);

        if (!slot->file.seek(targetOffset)) {
            slot->status.state =
                SdStreamState::Failed;

            slot->status.error =
                SdStreamError::SeekFailed;

            notifyStreamChanged(*slot);

            return setError(
                SdStreamError::SeekFailed,
                RuntimeResult::IoError);
        }

        const RuntimeResult resetResult =
            slot->buffer.reset(
                StreamRingBufferClearMode::
                    Preserve);

        if (resetResult != RuntimeResult::Ok) {
            slot->status.state =
                SdStreamState::Failed;

            slot->status.error =
                SdStreamError::
                    BufferOperationFailed;

            notifyStreamChanged(*slot);

            return setError(
                SdStreamError::
                    BufferOperationFailed,
                resetResult);
        }

        slot->status.consumerOffsetBytes =
            targetOffset;

        slot->status.sourceOffsetBytes =
            targetOffset;

        slot->status.eof =
            targetOffset >=
            slot->status.fileSizeBytes;

        slot->status.retryPending = false;
        slot->status.nextRetryAtMs = 0;
        slot->status.error =
            SdStreamError::None;

        slot->status.seekCount =
            saturatingIncrement32(
                slot->status.seekCount);

        slot->consecutiveReadFailures = 0;

        slot->prefetchRequested =
            !slot->status.eof;

        refreshStreamStatus(*slot);
        refreshServiceStatus();
        notifyStreamChanged(*slot);

        currentStatus_.error =
            SdStreamError::None;

        return RuntimeResult::Ok;
    }

