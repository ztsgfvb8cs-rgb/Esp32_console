const AiPerceptionObservation* AiPerceptionSystem::nearest(
    const AiPerceptionQuery& query)
{
    const AiPerceptionObservation* selected = nullptr;

    for (size_t i = 0;
         i < currentStatus_.observationCount;
         ++i)
    {
        const AiPerceptionObservation& candidate =
            observations_[i];

        if (!queryMatches(candidate, query))
        {
            continue;
        }

        if (selected == nullptr ||
            candidate.distance < selected->distance ||
            (candidate.distance == selected->distance &&
             candidate.confidencePermille >
                 selected->confidencePermille))
        {
            selected = &candidate;
        }
    }

    return selected;
}

const AiPerceptionObservation*
AiPerceptionSystem::highestThreat(
    const AiPerceptionQuery& query)
{
    const AiPerceptionObservation* selected = nullptr;
    uint32_t selectedScore = 0;

    for (size_t i = 0;
         i < currentStatus_.observationCount;
         ++i)
    {
        const AiPerceptionObservation& candidate =
            observations_[i];

        if (!queryMatches(candidate, query))
        {
            continue;
        }

        const uint32_t score =
            static_cast<uint32_t>(
                candidate.threatPermille) *
            candidate.confidencePermille;

        if (selected == nullptr ||
            score > selectedScore ||
            (score == selectedScore &&
             candidate.distance < selected->distance))
        {
            selected = &candidate;
            selectedScore = score;
        }
    }

    return selected;
}

size_t AiPerceptionSystem::copyObservations(
    AiPerceptionObservation* destination,
    size_t capacity,
    const AiPerceptionQuery& query)
{
    if (capacity > 0 && destination == nullptr)
    {
        setError(AiPerceptionError::InvalidQuery);
        return 0;
    }

    size_t copied = 0;

    for (size_t i = 0;
         i < currentStatus_.observationCount &&
         copied < capacity;
         ++i)
    {
        if (!queryMatches(observations_[i], query))
        {
            continue;
        }

        destination[copied] = observations_[i];
        ++copied;
    }

    currentStatus_.error = AiPerceptionError::None;
    return copied;
}

