    RuntimeResult SdStreamService::prefetch(
        const SdStreamHandle& handle,
        uint32_t nowMs,
        size_t maximumBytes,
        size_t& loadedBytes) {
        loadedBytes = 0;

        SdStreamError lookupError =
            SdStreamError::None;

        StreamSlot* const slot =
            slotFor(handle, &lookupError);

        if (slot == nullptr) {
            return setError(
                lookupError,
                RuntimeResult::InvalidArgument);
        }

        if (currentStatus_.suspended) {
            slot->status.error =
                SdStreamError::Busy;

            return setError(
                SdStreamError::Busy,
                RuntimeResult::Busy);
        }

        const RuntimeResult result =
            prefetchSlot(
                *slot,
                nowMs,
                maximumBytes,
                loadedBytes);

        currentStatus_.bytesReadThisUpdate =
            loadedBytes;

        refreshServiceStatus();

        if (result == RuntimeResult::Ok) {
            currentStatus_.error =
                SdStreamError::None;
        } else {
            currentStatus_.error =
                slot->status.error;
        }

        return result;
    }

