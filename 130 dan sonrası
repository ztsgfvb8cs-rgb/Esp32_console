void* MemoryArena::allocate(
    size_t sizeBytes,
    size_t alignment,
    MemoryArenaClearMode clearMode)
{
    if (!ready())
    {
        setError(
            MemoryArenaError::NotInitialized,
            RuntimeResult::NotReady);

        return nullptr;
    }

    if (sizeBytes == 0)
    {
        ++status_.failedAllocationCount;

        setError(
            MemoryArenaError::InvalidCapacity,
            RuntimeResult::InvalidArgument);

        return nullptr;
    }

    const size_t effectiveAlignment =
        alignment == 0
            ? config_.defaultAlignment
            : alignment;

    if (!validAlignment(effectiveAlignment))
    {
        ++status_.failedAllocationCount;

        setError(
            MemoryArenaError::InvalidAlignment,
            RuntimeResult::InvalidArgument);

        return nullptr;
    }

    size_t alignedOffset = 0;

    if (!alignOffset(
            offset_,
            effectiveAlignment,
            &alignedOffset) ||
        addWouldOverflow(
            alignedOffset,
            sizeBytes))
    {
        ++status_.failedAllocationCount;

        setError(
            MemoryArenaError::OutOfSpace,
            RuntimeResult::OutOfMemory);

        return nullptr;
    }

    const size_t nextOffset =
        alignedOffset + sizeBytes;

    if (nextOffset > backing_.size)
    {
        ++status_.failedAllocationCount;

        setError(
            MemoryArenaError::OutOfSpace,
            RuntimeResult::OutOfMemory);

        return nullptr;
    }

    uint8_t* const base =
        static_cast<uint8_t*>(
            backing_.data);

    void* const result =
        static_cast<void*>(
            base + alignedOffset);

    if (clearMode ==
        MemoryArenaClearMode::Clear)
    {
        memset(result, 0, sizeBytes);
    }

    offset_ = nextOffset;

    status_.usedBytes = offset_;

    status_.remainingBytes =
        backing_.size - offset_;

    if (status_.usedBytes >
        status_.peakUsedBytes)
    {
        status_.peakUsedBytes =
            status_.usedBytes;
    }

    if (sizeBytes >
        status_.largestAllocationBytes)
    {
        status_.largestAllocationBytes =
            sizeBytes;
    }

    if (status_.allocationCount <
        UINT32_MAX)
    {
        ++status_.allocationCount;
    }

    status_.error =
        MemoryArenaError::None;

    return result;
}

void* MemoryArena::allocateDefault(
    size_t sizeBytes,
    size_t alignment)
{
    return allocate(
        sizeBytes,
        alignment,
        config_.clearAllocations
            ? MemoryArenaClearMode::Clear
            : MemoryArenaClearMode::Preserve);
}

MemoryArenaMarker MemoryArena::marker() const
{
    if (!ready())
    {
        return {};
    }

    MemoryArenaMarker result;

    result.offset = offset_;

    result.generation =
        status_.generation;

    return result;
}

RuntimeResult MemoryArena::rewind(
    const MemoryArenaMarker& markerValue,
    MemoryArenaClearMode
        clearReleasedMemory)
{
    if (!ready())
    {
        return setError(
            MemoryArenaError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (markerValue.generation == 0 ||
        markerValue.generation !=
            status_.generation ||
        markerValue.offset > offset_ ||
        markerValue.offset > backing_.size)
    {
        return setError(
            MemoryArenaError::InvalidMarker,
            RuntimeResult::InvalidArgument);
    }

    if (clearReleasedMemory ==
            MemoryArenaClearMode::Clear &&
        markerValue.offset < offset_)
    {
        uint8_t* const base =
            static_cast<uint8_t*>(
                backing_.data);

        memset(
            base + markerValue.offset,
            0,
            offset_ - markerValue.offset);
    }

    offset_ = markerValue.offset;

    status_.usedBytes = offset_;

    status_.remainingBytes =
        backing_.size - offset_;

    if (status_.rewindCount < UINT32_MAX)
    {
        ++status_.rewindCount;
    }

    status_.error =
        MemoryArenaError::None;

    return RuntimeResult::Ok;
}

RuntimeResult MemoryArena::reset(
    MemoryArenaClearMode clearMemory)
{
    if (!ready())
    {
        return setError(
            MemoryArenaError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (clearMemory ==
            MemoryArenaClearMode::Clear &&
        offset_ > 0)
    {
        memset(
            backing_.data,
            0,
            offset_);
    }

    offset_ = 0;

    status_.usedBytes = 0;

    status_.remainingBytes =
        backing_.size;

    status_.generation =
        nextGeneration(
            status_.generation);

    if (status_.resetCount < UINT32_MAX)
    {
        ++status_.resetCount;
    }

    status_.error =
        MemoryArenaError::None;

    return RuntimeResult::Ok;
}
