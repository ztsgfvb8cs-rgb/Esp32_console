constexpr uint8_t FIXED_DIFFICULTY_COUNT = 5U;

uint8_t fixedLevelIndex(AiDifficultyLevel level)
{
    return static_cast<uint8_t>(level);
}

AiDifficultyLevel fixedLevelFromIndex(uint8_t index)
{
    if (index >= FIXED_DIFFICULTY_COUNT)
    {
        index = FIXED_DIFFICULTY_COUNT - 1U;
    }

    return static_cast<AiDifficultyLevel>(index);
}

uint16_t addClampedPermille(
    uint16_t value,
    uint16_t addition)
{
    const uint32_t total =
        static_cast<uint32_t>(value) +
        static_cast<uint32_t>(addition);

    return total > AI_PERMILLE_MAX
        ? AI_PERMILLE_MAX
        : static_cast<uint16_t>(total);
}

uint16_t subtractClampedPermille(
    uint16_t value,
    uint16_t subtraction)
{
    return subtraction >= value
        ? 0U
        : static_cast<uint16_t>(
            value - subtraction);
}
}

