constexpr uint8_t RIFF_ID[4] = {'R', 'I', 'F', 'F'};
constexpr uint8_t RIFX_ID[4] = {'R', 'I', 'F', 'X'};
constexpr uint8_t RF64_ID[4] = {'R', 'F', '6', '4'};
