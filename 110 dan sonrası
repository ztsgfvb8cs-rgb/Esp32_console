RuntimeResult
RuntimePowerCoordinator::requestShutdown(
    ShutdownReason reason,
    uint32_t nowMs)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimePowerError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (reason == ShutdownReason::None)
    {
        return fail(
            RuntimePowerError::InvalidPolicy,
            RuntimeResult::InvalidArgument);
    }

    if (nowMs == 0)
    {
        nowMs = millis();
    }

    if (!PowerManager::requestShutdown(
            reason,
            nowMs))
    {
        return fail(
            RuntimePowerError::
                ShutdownRequestFailed,
            RuntimeResult::InternalError);
    }

    currentStatus_.
        shutdownRequestedByCoordinator = true;

    currentStatus_.shutdownReason = reason;

    currentStatus_.lastAction =
        RuntimePowerAction::ShutdownRequested;

    refreshSourceState(nowMs);
    resolveEffectivePolicy();
    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult
RuntimePowerCoordinator::cancelShutdown(
    uint32_t nowMs)
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimePowerError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!PowerManager::shutdownPending())
    {
        return RuntimeResult::NotReady;
    }

    if (nowMs == 0)
    {
        nowMs = millis();
    }

    if (!PowerManager::cancelShutdown(nowMs))
    {
        return fail(
            RuntimePowerError::
                ShutdownRequestFailed,
            RuntimeResult::Busy);
    }

    currentStatus_.
        shutdownRequestedByCoordinator = false;

    currentStatus_.shutdownReason =
        ShutdownReason::None;

    currentStatus_.lastAction =
        RuntimePowerAction::ShutdownCancelled;

    return synchronize(nowMs, true);
}

