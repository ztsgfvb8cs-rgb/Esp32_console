void RuntimePowerCoordinator::refreshSourceState(
    uint32_t nowMs)
{
    (void)nowMs;

    const PowerStatus powerStatus =
        PowerManager::status();

    const BatteryStatus batteryStatus =
        BatteryManager::status();

    const RuntimeModuleStatus runtimeStatus =
        RuntimeModuleManager::status();

    const bool runtimeChanged =
        runtimeStatus.transitionSequence !=
            lastRuntimeTransitionSequence_;

    const bool batteryChanged =
        batteryStatus.sampleSequence !=
            lastBatterySampleSequence_;

    currentStatus_.powerState =
        powerStatus.state;

    currentStatus_.shutdownReason =
        powerStatus.reason;

    currentStatus_.lastActivityAtMs =
        powerStatus.lastActivityMs;

    currentStatus_.batteryState =
        batteryStatus.state;

    currentStatus_.chargeState =
        batteryStatus.chargeState;

    currentStatus_.batteryPolicy =
        batteryStatus.policy;

    currentStatus_.foregroundActive =
        runtimeStatus.foregroundActive;

    currentStatus_.moduleKind =
        runtimeStatus.kind;

    currentStatus_.moduleState =
        runtimeStatus.state;

    currentStatus_.engine =
        runtimeStatus.engine;

    if (runtimeChanged)
    {
        lastRuntimeTransitionSequence_ =
            runtimeStatus.transitionSequence;
    }

    if (batteryChanged)
    {
        lastBatterySampleSequence_ =
            batteryStatus.sampleSequence;
    }

    if (runtimeChanged || batteryChanged)
    {
        ++currentStatus_.policySequence;
    }
}

bool RuntimePowerCoordinator::
    resolveRuntimeKeepAwake()
{
    if (!currentStatus_.foregroundActive ||
        currentStatus_.moduleState !=
            RuntimeModuleState::Running)
    {
        return false;
    }

    switch (currentStatus_.moduleKind)
    {
        case RuntimeModuleKind::BuiltinGame:
            return policy_.
                keepAwakeDuringBuiltinGames;

        case RuntimeModuleKind::Emulator:
            return policy_.
                keepAwakeDuringEmulators;

        case RuntimeModuleKind::PdfReader:
            return policy_.
                keepAwakeDuringPdfReader;

        case RuntimeModuleKind::MediaViewer:
        case RuntimeModuleKind::SystemTool:
        case RuntimeModuleKind::None:
        default:
            return false;
    }
}

RuntimePowerMode
RuntimePowerCoordinator::resolveMode()
{
    switch (currentStatus_.powerState)
    {
        case PowerState::ShutdownPending:
        case PowerState::ShuttingDown:
            return RuntimePowerMode::
                ShutdownPending;

        case PowerState::SafeHalted:
        case PowerState::PowerDisabled:
            return RuntimePowerMode::
                SafeHalted;

        case PowerState::Failed:
            return RuntimePowerMode::Failed;

        case PowerState::DisplayOff:
            return RuntimePowerMode::
                DisplaySleeping;

        default:
            break;
    }

    if (currentStatus_.batteryState ==
        BatteryState::Critical)
    {
        return RuntimePowerMode::
            CriticalBattery;
    }

    if (currentStatus_.batteryPolicyActive)
    {
        return RuntimePowerMode::
            BatterySaving;
    }

    if (currentStatus_.powerState ==
        PowerState::Dimmed)
    {
        return RuntimePowerMode::
            IdleDimmed;
    }

    return RuntimePowerMode::Normal;
}

void RuntimePowerCoordinator::
    resolveEffectivePolicy()
{
    currentStatus_.requestedBrightness =
        settings_.brightness;

    currentStatus_.batteryPolicyActive =
        policy_.followBatteryPolicy &&
        (currentStatus_.batteryState ==
                BatteryState::Low ||
         currentStatus_.batteryState ==
                BatteryState::Critical ||
         currentStatus_.
                batteryPolicy.reduceBrightness ||
         currentStatus_.
                batteryPolicy.reduceAudio ||
         currentStatus_.
                batteryPolicy.disableHaptic ||
         currentStatus_.
                batteryPolicy.requestShutdown);

    currentStatus_.effectiveBrightness =
        resolveBrightness();

    currentStatus_.
        effectiveAudioLimitPercent =
            resolveAudioLimit();

    currentStatus_.hapticAllowed =
        resolveHapticAllowed();

    currentStatus_.brightnessLimited =
        currentStatus_.effectiveBrightness <
            currentStatus_.requestedBrightness;

    currentStatus_.audioLimited =
        currentStatus_.
                effectiveAudioLimitPercent <
            RUNTIME_POWER_MAX_PERCENT;

    currentStatus_.mode = resolveMode();
}

RuntimeResult
RuntimePowerCoordinator::applyEffectivePolicy(
    uint32_t nowMs,
    bool forceApply)
{
    const bool applyIntervalElapsed =
        policy_.minimumApplyIntervalMs == 0 ||
        nowMs - currentStatus_.lastApplyAtMs >=
            policy_.minimumApplyIntervalMs;

    const bool targetBacklightEnabled =
        !stateRequiresBacklightOff(
            currentStatus_.powerState);

    const bool brightnessChanged =
        lastAppliedBrightness !=
            currentStatus_.
                effectiveBrightness;

    const bool backlightChanged =
        !backlightStateKnown ||
        lastAppliedBacklightEnabled !=
            targetBacklightEnabled;

    const bool audioChanged =
        lastAppliedAudioLimit !=
            currentStatus_.
                effectiveAudioLimitPercent;

    const bool hapticChanged =
        !hapticStateKnown ||
        lastAppliedHapticAllowed !=
            currentStatus_.hapticAllowed;

    if (!forceApply &&
        !applyIntervalElapsed &&
        (brightnessChanged ||
         backlightChanged ||
         audioChanged ||
         hapticChanged))
    {
        return RuntimeResult::Ok;
    }

    bool changed = false;

    if (forceApply ||
        brightnessChanged ||
        backlightChanged)
    {
        if (targetBacklightEnabled)
        {
            if (!HardwareManager::
                    setBacklightBrightness(
                        currentStatus_.
                            effectiveBrightness) ||
                !HardwareManager::
                    setBacklightEnabled(true))
            {
                return fail(
                    RuntimePowerError::
                        BacklightApplyFailed,
                    RuntimeResult::
                        InternalError);
            }
        }
        else if (
            !HardwareManager::
                setBacklightEnabled(false))
        {
            return fail(
                RuntimePowerError::
                    BacklightApplyFailed,
                RuntimeResult::InternalError);
        }

        lastAppliedBrightness =
            currentStatus_.
                effectiveBrightness;

        lastAppliedBacklightEnabled =
            targetBacklightEnabled;

        backlightStateKnown = true;
        changed = true;
    }

    if (forceApply || audioChanged)
    {
        RuntimeAudioCoordinatorPolicy
            audioPolicy =
                RuntimeAudioCoordinator::
                    policy();

        if (currentStatus_.
                effectiveAudioLimitPercent <
            RUNTIME_POWER_MAX_PERCENT)
        {
            audioPolicy.
                criticalMasterLimitPercent =
                    currentStatus_.
                        effectiveAudioLimitPercent;

            RuntimeAudioCoordinator::setPolicy(
                audioPolicy);

            RuntimeAudioCoordinator::
                setCriticalPowerLimit(true);
        }
        else
        {
            if (savedAudioPolicyValid)
            {
                RuntimeAudioCoordinator::
                    setPolicy(
                        savedAudioPolicy);
            }

            RuntimeAudioCoordinator::
                setCriticalPowerLimit(false);
        }

        lastAppliedAudioLimit =
            currentStatus_.
                effectiveAudioLimitPercent;

        changed = true;
    }

    if (forceApply || hapticChanged)
    {
        HapticDriver::setEnabled(
            currentStatus_.hapticAllowed);

        lastAppliedHapticAllowed =
            currentStatus_.hapticAllowed;

        hapticStateKnown = true;
        changed = true;
    }

    if (changed)
    {
        currentStatus_.lastApplyAtMs =
            nowMs;

        ++currentStatus_.applySequence;

        if (!currentStatus_.hapticAllowed)
        {
            currentStatus_.lastAction =
                RuntimePowerAction::
                    HapticDisabled;
        }
        else if (currentStatus_.audioLimited)
        {
            currentStatus_.lastAction =
                RuntimePowerAction::
                    AudioLimited;
        }
        else if (
            currentStatus_.brightnessLimited)
        {
            currentStatus_.lastAction =
                RuntimePowerAction::
                    BrightnessLimited;
        }
        else
        {
            currentStatus_.lastAction =
                RuntimePowerAction::
                    PolicyRestored;
        }
    }

    return RuntimeResult::Ok;
}
