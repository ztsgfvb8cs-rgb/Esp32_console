//====================================================
// VALIDATION
//====================================================

bool HardwareManager::
    validateRuntimeConfiguration()
{
    if (!BoardPins::allPinsSafe(
            BoardPins::ASSIGNED_PROJECT_PINS) ||
        !BoardPins::allPinsUnique(
            BoardPins::ASSIGNED_PROJECT_PINS))
    {
        return false;
    }

    if (BoardConfig::ENABLE_DISPLAY &&
        (!pinConnected(
            BoardPins::SPI_MOSI_PIN) ||
         !pinConnected(
            BoardPins::SPI_SCLK_PIN) ||
         !pinConnected(
            BoardPins::SPI_MISO_PIN) ||
         !pinConnected(
            BoardPins::TFT_CS_PIN) ||
         !pinConnected(
            BoardPins::TFT_DC_PIN) ||
         !pinConnected(
            BoardPins::TFT_BACKLIGHT_PIN)))
    {
        return false;
    }

    if (BoardConfig::ENABLE_TOUCH &&
        !pinConnected(
            BoardPins::TOUCH_CS_PIN))
    {
        return false;
    }

    if (BoardConfig::ENABLE_SD_CARD &&
        !pinConnected(
            BoardPins::SD_CS_PIN))
    {
        return false;
    }

    if (BoardConfig::ENABLE_AUDIO &&
        (!pinConnected(
            BoardPins::I2S_BCLK_PIN) ||
         !pinConnected(
            BoardPins::I2S_WS_PIN) ||
         !pinConnected(
            BoardPins::I2S_DATA_OUT_PIN)))
    {
        return false;
    }

    if (BoardConfig::ENABLE_RTC &&
        (!pinConnected(
            BoardPins::I2C_SDA_PIN) ||
         !pinConnected(
            BoardPins::I2C_SCL_PIN)))
    {
        return false;
    }

    if (BoardConfig::ENABLE_HAPTIC &&
        !pinConnected(
            BoardPins::HAPTIC_PWM_PIN))
    {
        return false;
    }

    if (BoardConfig::ENABLE_PHONE_KEYPAD)
    {
        return false;
    }

    return
        pinConnected(
            BoardPins::BOOST_ENABLE_PIN) &&
        pinConnected(
            BoardPins::BATTERY_ADC_PIN) &&
        BoardPins::DIRECT_BUTTON_COUNT ==
            static_cast<size_t>(
                DirectButton::COUNT);
}

