String SystemMonitorManager::summary()
{
    SystemMonitorSnapshot data = snapshot();

    String result;
    result.reserve(256);

    result += "UPTIME=";
    result += unsigned64ToString(
        data.uptimeMilliseconds / 1000ULL
    );
    result += "s";

    result += " HEAP=";
    result += String(data.freeHeapBytes);
    result += "/";
    result += String(data.totalHeapBytes);

    result += " PSRAM=";

    if (data.psramAvailable)
    {
        result += String(data.freePsramBytes);
        result += "/";
        result += String(data.totalPsramBytes);
    }
    else
    {
        result += "N/A";
    }

    result += " FPS=";
    result += String(data.framesPerSecond, 1);

    result += " BAT=";

    if (data.batteryAvailable)
    {
        result += String(data.batteryPercent);
        result += "%";
    }
    else
    {
        result += "N/A";
    }

    result += " STORAGE=";

    if (data.storageReady)
    {
        result += String(data.storageUsagePercent);
        result += "%";
    }
    else
    {
        result += "N/A";
    }

    result += " HEALTH=";
    result += healthLevelText(data.healthLevel);

    return result;
}


