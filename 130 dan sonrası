    const PsramPoolSizeClassConfig& classConfig =
        config_.classes[classIndex];

    result.enabled = true;
    result.psram = backings_[classIndex].psram;
    result.blockSizeBytes = classConfig.blockSizeBytes;
    result.strideBytes = classStrides_[classIndex];
    result.reservedBytes = backings_[classIndex].size;
    result.totalBlocks = classConfig.blockCount;
    result.usedBlocks = classUsedBlocks_[classIndex];
    result.freeBlocks = static_cast<uint16_t>(
        result.totalBlocks - result.usedBlocks);
    result.peakUsedBlocks =
        classPeakUsedBlocks_[classIndex];

    result.usedCapacityBytes =
        classConfig.blockSizeBytes *
        result.usedBlocks;

    result.requestedBytes =
        classRequestedBytes_[classIndex];

    result.wastedBytes =
        result.usedCapacityBytes >=
                result.requestedBytes
            ? result.usedCapacityBytes -
                result.requestedBytes
            : 0;

    return result;
}

