    if (!ready() || requestedBytes == 0)
    {
        return PSRAM_POOL_INVALID_CLASS;
    }

    for (uint8_t classIndex = 0;
         classIndex < config_.classCount;
         ++classIndex)
    {
        if (requestedBytes <=
            config_.classes[classIndex].blockSizeBytes)
        {
            return classIndex;
