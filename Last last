void SystemMonitorManager::collectRuntimeInformation()
{
    uint32_t totalHeapBytes =
        ESP.getHeapSize();

    uint32_t freeHeapBytes =
        ESP.getFreeHeap();

    if (freeHeapBytes > totalHeapBytes)
        totalHeapBytes = freeHeapBytes;

    currentSnapshot.totalHeapBytes =
        totalHeapBytes;

    currentSnapshot.freeHeapBytes =
        freeHeapBytes;

    currentSnapshot.minimumFreeHeapBytes =
        ESP.getMinFreeHeap();

    currentSnapshot.largestFreeHeapBlockBytes =
        ESP.getMaxAllocHeap();

    currentSnapshot.heapUsagePercent =
        calculateUsagePercent(
            totalHeapBytes,
            totalHeapBytes - freeHeapBytes
        );

    uint32_t totalPsramBytes =
        ESP.getPsramSize();

    currentSnapshot.psramAvailable =
        totalPsramBytes > 0;

    if (currentSnapshot.psramAvailable)
    {
        uint32_t freePsramBytes =
            ESP.getFreePsram();

        if (freePsramBytes > totalPsramBytes)
            totalPsramBytes = freePsramBytes;

        currentSnapshot.totalPsramBytes =
            totalPsramBytes;

        currentSnapshot.freePsramBytes =
            freePsramBytes;

        currentSnapshot.minimumFreePsramBytes =
            ESP.getMinFreePsram();

        currentSnapshot.largestFreePsramBlockBytes =
            ESP.getMaxAllocPsram();

        currentSnapshot.psramUsagePercent =
            calculateUsagePercent(
                totalPsramBytes,
                totalPsramBytes - freePsramBytes
            );
    }
    else
    {
        currentSnapshot.totalPsramBytes = 0;
        currentSnapshot.freePsramBytes = 0;
        currentSnapshot.minimumFreePsramBytes = 0;
        currentSnapshot.largestFreePsramBlockBytes = 0;
        currentSnapshot.psramUsagePercent = 0;
    }

    currentSnapshot.cpuFrequencyMHz =
        ESP.getCpuFreqMHz();

    currentSnapshot.cpuCoreCount =
        ESP.getChipCores();

    uint16_t revision =
        ESP.getChipRevision();

    currentSnapshot.chipRevision =
        revision > 255
            ? 255
            : static_cast<uint8_t>(revision);
}


void SystemMonitorManager::updateFrameWindow(
    uint32_t currentTime
)
{
    uint32_t elapsed =
        currentTime - frameWindowStart;

    if (elapsed < FRAME_WINDOW)
        return;

    if (frameCount > 0)
    {
        currentSnapshot.framesPerSecond =
            static_cast<float>(frameCount) *
            1000.0f /
            static_cast<float>(elapsed);

        if (frameTimeTotalMicroseconds > 0)
        {
            currentSnapshot.averageFrameMilliseconds =
                static_cast<float>(
                    frameTimeTotalMicroseconds
                ) /
                static_cast<float>(frameCount) /
                1000.0f;
        }
        else if (currentSnapshot.framesPerSecond > 0.0f)
        {
            currentSnapshot.averageFrameMilliseconds =
                1000.0f /
                currentSnapshot.framesPerSecond;
        }
        else
        {
            currentSnapshot.averageFrameMilliseconds =
                0.0f;
        }

        currentSnapshot.longestFrameMilliseconds =
            static_cast<float>(
                longestFrameMicroseconds
            ) / 1000.0f;

        frameMeasurementValid = true;
    }
    else
    {
        currentSnapshot.framesPerSecond = 0.0f;
        currentSnapshot.averageFrameMilliseconds = 0.0f;
        currentSnapshot.longestFrameMilliseconds = 0.0f;

        frameMeasurementValid = false;
    }

    frameWindowStart = currentTime;

    frameCount = 0;
    frameTimeTotalMicroseconds = 0;
    longestFrameMicroseconds = 0;
}


void SystemMonitorManager::updateStorageValues()
{
    if (storageStatusOverridden)
        return;

    bool readyValue =
        StorageManager::ready();

    currentSnapshot.storageReady =
        readyValue;

    if (!readyValue)
    {
        currentSnapshot.storageTotalBytes = 0;
        currentSnapshot.storageUsedBytes = 0;
        currentSnapshot.storageFreeBytes = 0;
        currentSnapshot.storageUsagePercent = 0;

        return;
    }

    uint64_t totalBytes =
        StorageManager::totalSpace();

    uint64_t usedBytes =
        StorageManager::usedSpace();

    if (usedBytes > totalBytes)
        usedBytes = totalBytes;

    currentSnapshot.storageTotalBytes =
        totalBytes;

    currentSnapshot.storageUsedBytes =
        usedBytes;

    currentSnapshot.storageFreeBytes =
        totalBytes - usedBytes;

    currentSnapshot.storageUsagePercent =
        calculateUsagePercent(
            totalBytes,
            usedBytes
        );
}


void SystemMonitorManager::updateWarningValues()
{
    currentSnapshot.lowBatteryWarning =
        currentSnapshot.batteryAvailable &&
        currentSnapshot.batteryPercent <=
            LOW_BATTERY_PERCENT;

    bool storageWarning =
        currentSnapshot.storageReady &&
        currentSnapshot.storageTotalBytes > 0 &&
        currentSnapshot.storageUsagePercent >=
            STORAGE_WARNING_PERCENT;

    bool temperatureWarning =
        currentSnapshot.temperatureAvailable &&
        currentSnapshot.cpuTemperatureCelsius >=
            TEMPERATURE_WARNING;

    bool heapWarning =
        currentSnapshot.freeHeapBytes <=
            LOW_HEAP_WARNING_BYTES;

    bool fpsWarning = false;

    if (frameMeasurementValid &&
        currentSnapshot.targetFPS > 0)
    {
        float minimumAcceptableFPS =
            static_cast<float>(
                currentSnapshot.targetFPS
            ) * 0.90f;

        fpsWarning =
            currentSnapshot.framesPerSecond <
            minimumAcceptableFPS;
    }

    currentSnapshot.performanceWarning =
        fpsWarning;

    (void)storageWarning;
    (void)temperatureWarning;
    (void)heapWarning;
}


void SystemMonitorManager::updateHealthLevel()
{
    bool heapCritical =
        currentSnapshot.freeHeapBytes <=
            LOW_HEAP_CRITICAL_BYTES;

    bool batteryCritical =
        currentSnapshot.batteryAvailable &&
        currentSnapshot.batteryPercent <=
            CRITICAL_BATTERY_PERCENT;

    bool storageCritical =
        currentSnapshot.storageReady &&
        currentSnapshot.storageTotalBytes > 0 &&
        currentSnapshot.storageUsagePercent >=
            STORAGE_CRITICAL_PERCENT;

    bool temperatureCritical =
        currentSnapshot.temperatureAvailable &&
        currentSnapshot.cpuTemperatureCelsius >=
            TEMPERATURE_CRITICAL;

    if (heapCritical ||
        batteryCritical ||
        storageCritical ||
        temperatureCritical)
    {
        currentSnapshot.healthLevel =
            SYSTEM_HEALTH_CRITICAL;

        return;
    }

    bool heapWarning =
        currentSnapshot.freeHeapBytes <=
            LOW_HEAP_WARNING_BYTES;

    bool storageWarning =
        currentSnapshot.storageReady &&
        currentSnapshot.storageTotalBytes > 0 &&
        currentSnapshot.storageUsagePercent >=
            STORAGE_WARNING_PERCENT;

    bool temperatureWarning =
        currentSnapshot.temperatureAvailable &&
        currentSnapshot.cpuTemperatureCelsius >=
            TEMPERATURE_WARNING;

    bool storageUnavailable =
        currentSnapshot.valid &&
        !currentSnapshot.storageReady;

    if (heapWarning ||
        currentSnapshot.lowBatteryWarning ||
        storageWarning ||
        temperatureWarning ||
        currentSnapshot.performanceWarning ||
        storageUnavailable)
    {
        currentSnapshot.healthLevel =
            SYSTEM_HEALTH_WARNING;

        return;
    }

    currentSnapshot.healthLevel =
        SYSTEM_HEALTH_NORMAL;
}


uint8_t SystemMonitorManager::calculateUsagePercent(
    uint64_t totalBytes,
    uint64_t usedBytes
)
{
    if (totalBytes == 0)
        return 0;

    if (usedBytes >= totalBytes)
        return 100;

    uint64_t percentage =
        (usedBytes * 100ULL) /
        totalBytes;

    if (percentage > 100ULL)
        percentage = 100ULL;

    return static_cast<uint8_t>(percentage);
}


uint64_t
SystemMonitorManager::extendedUptimeMilliseconds()
{
    uint32_t currentMillis = millis();

    if (currentMillis < lastMillisValue)
    {
        if (millisOverflowCount <
            0xFFFFFFFFUL)
        {
            millisOverflowCount++;
        }
    }

    lastMillisValue = currentMillis;

    return
        (static_cast<uint64_t>(
            millisOverflowCount
        ) << 32) |
        static_cast<uint64_t>(
            currentMillis
        );
}


SystemMonitorSnapshot
SystemMonitorManager::emptySnapshot()
{
    SystemMonitorSnapshot data;

    data.uptimeMilliseconds = 0;
    data.sampledAt = 0;

    data.totalHeapBytes = 0;
    data.freeHeapBytes = 0;
    data.minimumFreeHeapBytes = 0;
    data.largestFreeHeapBlockBytes = 0;
    data.heapUsagePercent = 0;

    data.psramAvailable = false;
    data.totalPsramBytes = 0;
    data.freePsramBytes = 0;
    data.minimumFreePsramBytes = 0;
    data.largestFreePsramBlockBytes = 0;
    data.psramUsagePercent = 0;

    data.cpuFrequencyMHz = 0;
    data.cpuCoreCount = 0;
    data.chipRevision = 0;
    data.cpuTemperatureCelsius = 0.0f;
    data.temperatureAvailable = false;

    data.framesPerSecond = 0.0f;
    data.averageFrameMilliseconds = 0.0f;
    data.lastFrameMilliseconds = 0.0f;
    data.longestFrameMilliseconds = 0.0f;
    data.targetFPS = 30;
    data.performanceWarning = false;

    data.batteryVoltage = 0.0f;
    data.batteryPercent = 0;
    data.batteryAvailable = false;
    data.lowBatteryWarning = false;

    data.storageReady = false;
    data.storageTotalBytes = 0;
    data.storageUsedBytes = 0;
    data.storageFreeBytes = 0;
    data.storageUsagePercent = 0;

    data.networkConnected = false;

    data.healthLevel = SYSTEM_HEALTH_NORMAL;
    data.valid = false;

    return data;
}
