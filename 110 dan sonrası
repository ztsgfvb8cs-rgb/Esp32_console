struct AiPerformanceSample
{
    // Overall player performance for the encounter/update window.
    // 0 means the player was completely overwhelmed, 1000 means the
    // player dominated. The manager clamps accepted values.
    uint16_t playerPerformancePermille = AI_PERMILLE_MIDPOINT;

    // Confidence expresses how representative this sample is.
    uint16_t confidencePermille = AI_PERMILLE_MAX;

    uint32_t timestampMs = 0;
};

struct AiDifficultyStatus
{
    bool initialized = false;
    bool adaptiveActive = false;
    bool adjustmentPending = false;

    AiDifficultyLevel requestedLevel = AiDifficultyLevel::Normal;
    AiDifficultyLevel effectiveLevel = AiDifficultyLevel::Normal;

    AiDifficultyAdjustmentReason adjustmentReason =
        AiDifficultyAdjustmentReason::None;

    AiDifficultyError error = AiDifficultyError::None;

    uint16_t rollingPerformancePermille = AI_PERMILLE_MIDPOINT;
    uint16_t rollingConfidencePermille = 0U;

    uint32_t sampleCount = 0;
    uint32_t windowSampleCount = 0;
    uint32_t windowStartedAtMs = 0;
    uint32_t lastSampleAtMs = 0;
    uint32_t lastAdjustmentAtMs = 0;
    uint32_t adjustmentSequence = 0;
};

using AiDifficultyObserver = void (*)(
    const AiDifficultyStatus& status,
    const AiDifficultyProfile& effectiveProfile);

