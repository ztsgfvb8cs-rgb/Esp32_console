bool PsramPool::addWouldOverflow(
    size_t first,
    size_t second)
{
    return second > SIZE_MAX - first;
}

bool PsramPool::multiplyWouldOverflow(
    size_t first,
    size_t second)
{
    return first != 0 &&
        second > SIZE_MAX / first;
}

bool PsramPool::alignSize(
    size_t value,
    size_t alignment,
    size_t* alignedValue)
{
    if (alignedValue == nullptr ||
        !validAlignment(alignment))
    {
        return false;
    }

    const size_t mask = alignment - 1U;

    if (addWouldOverflow(value, mask))
    {
        return false;
    }

    *alignedValue =
        (value + mask) & ~mask;

    return true;
}

