//---------------- Notifications ----------------

void updateAchievementNotifications()
{
    if(!achievementNotification.active)
    {
        uint16_t pendingAchievementID =
            getNextPendingAchievementNotification();


        if(pendingAchievementID !=
           ACHIEVEMENT_INVALID_ID)
        {
            startAchievementNotification(
                pendingAchievementID
            );
        }


        return;
    }


    uint32_t currentTime =
        millis();


    if(currentTime -
       achievementNotification.startTime >=
       achievementNotification.duration)
    {
        uint16_t completedAchievementID =
            achievementNotification.
                achievementID;


        stopAchievementNotification();


        clearAchievementNotificationPending(
            completedAchievementID
        );
    }
}



bool startAchievementNotification(
    uint16_t achievementID
)
{
    AchievementRecord* record =
        findMutableAchievement(
            achievementID
        );


    if(record == nullptr)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_NOT_FOUND;


        return false;
    }


    if(!record->progress.unlocked)
    {
        achievementManagerStatus =
            ACHIEVEMENT_STATUS_LOCKED;


        return false;
    }


    achievementNotification.achievementID =
        achievementID;


    achievementNotification.startTime =
        millis();


    achievementNotification.duration =
        ACHIEVEMENT_NOTIFICATION_DURATION;


    achievementNotification.active =
        true;


    achievementManagerStatus =
        ACHIEVEMENT_STATUS_READY;


    return true;
}



void stopAchievementNotification()
{
    achievementNotification.achievementID =
        ACHIEVEMENT_INVALID_ID;


    achievementNotification.startTime =
        0;


    achievementNotification.active =
        false;
}



