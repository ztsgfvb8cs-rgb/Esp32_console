    {
        return fail(
            RuntimeOrchestratorStage::
                HealthCoordinator,
            RuntimeOrchestratorError::
                HealthCoordinatorFailed,
            RuntimeResult::NotReady);
    }

    currentStatus_.stage =
        RuntimeOrchestratorStage::RuntimeUpdate;

    return RuntimeResult::Ok;
}

void RuntimeOrchestrator::synchronizeStatus()
{
    if (!currentStatus_.initialized)
    {
        return;
    }

    if (RuntimeModuleManager::ready() ||
        RuntimeModuleManager::status().initialized)
    {
        const RuntimeModuleStatus moduleStatus =
            RuntimeModuleManager::status();

        currentStatus_.foregroundActive =
            moduleStatus.foregroundActive;

        currentStatus_.moduleKind =
            moduleStatus.kind;

        currentStatus_.moduleState =
            moduleStatus.state;

        currentStatus_.engine =
            moduleStatus.engine;
    }

    if (RuntimeSessionBridge::ready())
    {
        const RuntimeSessionStatus sessionStatus =
            RuntimeSessionBridge::status();

        currentStatus_.foregroundActive =
            currentStatus_.foregroundActive ||
            sessionStatus.active;
    }

    if (RuntimeHealthCoordinator::
            status().initialized)
    {
        const RuntimeHealthStatus healthStatus =
            RuntimeHealthCoordinator::status();

        currentStatus_.healthLevel =
            healthStatus.level;

        currentStatus_.fatalHealth =
            healthStatus.fatalState;
    }

    if (RuntimePowerCoordinator::
            status().initialized)
    {
        const RuntimePowerCoordinatorStatus
            powerStatus =
                RuntimePowerCoordinator::status();

        currentStatus_.powerMode =
            powerStatus.mode;

        currentStatus_.shutdownReason =
            powerStatus.shutdownReason;

        currentStatus_.shutdownPending =
            RuntimePowerCoordinator::
                shutdownPending() ||
            powerStatus.mode ==
                RuntimePowerMode::
                    ShutdownPending;
    }
}

void RuntimeOrchestrator::processInputActivity(
    uint32_t nowMs)
{
    if (!policy_.notifyPowerOnInput)
    {
        return;
    }

    const RuntimeInputStatus inputStatus =
        RuntimeInputRouter::status();

    if (inputStatus.eventSequence ==
        currentStatus_.
            observedInputEventSequence)
    {
        return;
    }

    currentStatus_.observedInputEventSequence =
        inputStatus.eventSequence;

    if (inputStatus.lastEvent.action !=
        InputAction::None)
    {
        RuntimePowerCoordinator::
            notifyUserActivity(nowMs);
    }
}

RuntimeResult
RuntimeOrchestrator::processFatalHealth(
    uint32_t nowMs)
{
    if (!currentStatus_.fatalHealth)
    {
        return RuntimeResult::Ok;
    }

    currentStatus_.error =
        RuntimeOrchestratorError::HealthFatal;

    if (!policy_.shutdownOnFatalHealth)
    {
        return fail(
            RuntimeOrchestratorStage::
                HealthCoordinator,
            RuntimeOrchestratorError::HealthFatal,
            RuntimeResult::InternalError);
    }

    if (currentStatus_.shutdownPending ||
        RuntimePowerCoordinator::shutdownPending())
    {
        return RuntimeResult::Ok;
    }

    return requestShutdown(
        ShutdownReason::InternalError,
        nowMs);
}

void RuntimeOrchestrator::transitionTo(
    RuntimeOrchestratorState state,
    RuntimeOrchestratorStage stage)
{
    currentStatus_.stage = stage;

    if (currentStatus_.state == state)
    {
        return;
    }

    currentStatus_.state = state;

    ++currentStatus_.stateSequence;

    if (state ==
            RuntimeOrchestratorState::Running &&
        currentStatus_.startedAtMs == 0)
    {
        currentStatus_.startedAtMs = millis();
    }

    notifyStateChanged();
}

RuntimeResult RuntimeOrchestrator::fail(
    RuntimeOrchestratorStage stage,
    RuntimeOrchestratorError error,
    RuntimeResult result)
{
    currentStatus_.stage = stage;
    currentStatus_.error = error;
    currentStatus_.lastResult = result;

    if (Logger::ready())
    {
        Logger::error(
            LogSource::System,
            "RUNTIME_ORCH",
            errorText(error));
    }

    if (error !=
            RuntimeOrchestratorError::
                AlreadyUpdating &&
        error !=
            RuntimeOrchestratorError::
                UpdateOverrun &&
        error !=
            RuntimeOrchestratorError::
                NotInitialized)
    {
        transitionTo(
            RuntimeOrchestratorState::Failed,
            stage);
    }

    notifyStateChanged();

    return result;
}

void RuntimeOrchestrator::notifyStateChanged()
{
    if (observer_ != nullptr)
    {
        observer_(currentStatus_);
    }
}
