RuntimeResult RuntimeOrchestrator::suspend()
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeOrchestratorStage::RuntimeUpdate,
            RuntimeOrchestratorError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (currentStatus_.shutdownPending)
    {
        return RuntimeResult::Busy;
    }

    if (currentStatus_.suspended)
    {
        return RuntimeResult::Ok;
    }

    transitionTo(
        RuntimeOrchestratorState::Suspending,
        RuntimeOrchestratorStage::RuntimeUpdate);

    if (policy_.suspendInput)
    {
        RuntimeInputRouter::setSuspended(true);
    }

    if (policy_.suspendScreen)
    {
        RuntimeScreenRouter::setSuspended(true);
    }

    if (policy_.suspendAudio)
    {
        RuntimeAudioCoordinator::setSuspended(true);
    }

    RuntimePowerCoordinator::setSuspended(
        !policy_.continuePowerWhileSuspended);

    RuntimeHealthCoordinator::setSuspended(
        !policy_.continueHealthWhileSuspended);

    currentStatus_.suspended = true;

    transitionTo(
        RuntimeOrchestratorState::Suspended,
        RuntimeOrchestratorStage::None);

    notifyStateChanged();

    return RuntimeResult::Ok;
}

RuntimeResult RuntimeOrchestrator::resume()
{
    if (!currentStatus_.initialized)
    {
        return fail(
            RuntimeOrchestratorStage::RuntimeUpdate,
            RuntimeOrchestratorError::NotInitialized,
            RuntimeResult::NotReady);
    }

    if (!currentStatus_.suspended)
    {
        return RuntimeResult::Ok;
    }

    if (currentStatus_.shutdownPending)
    {
        return RuntimeResult::Busy;
    }

    RuntimePowerCoordinator::setSuspended(false);
    RuntimeHealthCoordinator::setSuspended(false);
    RuntimeAudioCoordinator::setSuspended(false);
    RuntimeScreenRouter::setSuspended(false);
    RuntimeInputRouter::setSuspended(false);

    RuntimeInputRouter::resetAllActions();

    currentStatus_.suspended = false;

    RuntimePowerCoordinator::notifyUserActivity(
        millis());

    RuntimeScreenRouter::requestImmediateRender(
        RuntimeScreenRefreshReason::Recovery);

    transitionTo(
        RuntimeOrchestratorState::Running,
        RuntimeOrchestratorStage::None);

    notifyStateChanged();

    return RuntimeResult::Ok;
}

