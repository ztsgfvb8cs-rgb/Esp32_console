bool ResourceBudgetCoordinator::validatePolicy(
    const ResourceBudgetPolicy& policy)
{
    if (policy.elevatedPressurePermille >=
            policy.highPressurePermille ||
        policy.highPressurePermille >=
            policy.criticalPressurePermille ||
        policy.criticalPressurePermille >
            RESOURCE_BUDGET_PERMILLE_MAX)
    {
        return false;
    }

    if (policy.admissionMarginInternalBytes >
            SIZE_MAX - policy.minimumFreeInternalBytes ||
        policy.admissionMarginPsramBytes >
            SIZE_MAX - policy.minimumFreePsramBytes)
    {
        return false;
    }

    return policy.minimumFreeInternalBytes > 0;
}

bool ResourceBudgetCoordinator::validateRequest(
    const ResourceBudgetRequest& request)
{
    if (!validOwner(request.owner) ||
        !validPriority(request.priority) ||
        (request.internalBytes == 0 &&
         request.psramBytes == 0) ||
        request.reclaimableInternalBytes >
            request.internalBytes ||
        request.reclaimablePsramBytes >
            request.psramBytes)
    {
        return false;
    }

    const size_t labelLength = boundedStringLength(
        request.label,
        RESOURCE_BUDGET_LABEL_CAPACITY);

    return
        labelLength > 0 &&
        labelLength < RESOURCE_BUDGET_LABEL_CAPACITY;
}

bool ResourceBudgetCoordinator::validOwner(
    ResourceBudgetOwner owner,
    bool allowNone)
{
    const uint8_t value =
        static_cast<uint8_t>(owner);

    const uint8_t firstValid =
        allowNone
            ? static_cast<uint8_t>(
                ResourceBudgetOwner::None)
            : static_cast<uint8_t>(
                ResourceBudgetOwner::System);

    return
        value >= firstValid &&
        value < static_cast<uint8_t>(
            ResourceBudgetOwner::Count);
}

bool ResourceBudgetCoordinator::validPriority(
    ResourceBudgetPriority priority)
{
    switch (priority)
    {
        case ResourceBudgetPriority::Optional:
        case ResourceBudgetPriority::Normal:
        case ResourceBudgetPriority::High:
        case ResourceBudgetPriority::Critical:
            return true;

        default:
            return false;
    }
}

ResourceBudgetCoordinator::ReservationSlot*
ResourceBudgetCoordinator::slotFor(
    const ResourceBudgetHandle& handle,
    ResourceBudgetError* error)
{
    if (error != nullptr)
    {
        *error = ResourceBudgetError::None;
    }

    if (!ready())
    {
        if (error != nullptr)
        {
            *error = ResourceBudgetError::NotInitialized;
        }

        return nullptr;
    }

    if (!handle ||
        handle.slot >= RESOURCE_BUDGET_MAX_RESERVATIONS)
    {
        if (error != nullptr)
        {
            *error = ResourceBudgetError::InvalidHandle;
        }

        return nullptr;
    }

    ReservationSlot& slot = reservations_[handle.slot];

    if (handle.generation != slot.status.generation ||
        handle.leaseId != slot.status.leaseId)
    {
        if (error != nullptr)
        {
            *error = ResourceBudgetError::StaleHandle;
        }

        return nullptr;
    }

    if (!slot.active || !slot.status.active)
    {
        if (error != nullptr)
        {
            *error = ResourceBudgetError::InvalidHandle;
        }

        return nullptr;
    }

    return &slot;
}

const ResourceBudgetCoordinator::ReservationSlot*
ResourceBudgetCoordinator::slotForConst(
    const ResourceBudgetHandle& handle,
    ResourceBudgetError* error)
{
    return slotFor(handle, error);
}

int ResourceBudgetCoordinator::findFreeSlot()
{
    for (uint8_t index = 0;
         index < RESOURCE_BUDGET_MAX_RESERVATIONS;
         ++index)
    {
        if (!reservations_[index].active)
        {
            return static_cast<int>(index);
        }
    }

    return -1;
}

bool ResourceBudgetCoordinator::duplicateLabelExists(
    const ResourceBudgetRequest& request)
{
    for (uint8_t index = 0;
         index < RESOURCE_BUDGET_MAX_RESERVATIONS;
         ++index)
    {
        const ReservationSlot& slot = reservations_[index];

        if (slot.active &&
            slot.status.owner == request.owner &&
            labelsEqual(slot.status.label, request.label))
        {
            return true;
        }
    }

    return false;
}
